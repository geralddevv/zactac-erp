<% layout('/layout/boilerplate') -%>

<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain mq-page" style="flex-direction: column; padding: 10px; gap: 14px;">
  <style>
    .mq-head h1 { font-size: 20px; color: #fff; margin: 0; }
    .mq-head .mq-sub { font-size: 13px; color: rgba(255, 255, 255, 0.85); margin-top: 2px; }

    .ap-card {
      width: 100%;
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      overflow: hidden;
    }
    .ap-card-title {
      background: #044a78;
      color: #fff; font-size: 14px; font-weight: 600; letter-spacing: 0.2px;
      padding: 9px 16px; display: flex; align-items: center; justify-content: space-between; gap: 10px;
    }

    .ap-table-wrap { overflow-x: hidden; }
    .ap-table { width: 100%; border-collapse: collapse; font-size: 13px; table-layout: fixed; }
    .ap-table th, .ap-table td {
      padding: 8px 10px; border-bottom: 1px solid #e5e7eb; border-right: 1px solid #e5e7eb;
      text-align: left; vertical-align: middle;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .ap-table tr > *:last-child { border-right: none; }
    .ap-table th { background: #f8fafc; color: #044a78; font-weight: 700; }
    .ap-table td { color: #1f2a44; font-weight: 600; }
    .ap-table tbody tr:hover { background: #fbfdff; }


    /* Slitting Jobs (grouped Tabulator): the app's standard Tabulator look
       (tableDisp.css) with the same expand toggle as the Label Stock page. */
    /* Full height like the other Tabulator pages: fills what is left of the
       .contain column under the heading; scrolls inside the table. */
    #slit-queue-table { width: 100%; height: 100%; flex: 1 1 auto; min-height: 260px; border-radius: 8px; overflow: hidden; }
    /* Tabulator's own expand control is hidden: the arrow has a column of its
       own (".sq-chev") and a click anywhere on a group row opens it. */
    #slit-queue-table .tabulator-data-tree-control { display: none !important; }
    #slit-queue-table .sq-chev {
      width: 20px; height: 20px; border-radius: 4px; background: rgba(4, 74, 120, 0.1);
      display: inline-flex; align-items: center; justify-content: center; transition: background-color 0.15s ease;
    }
    #slit-queue-table .sq-chev i { font-size: 11px; color: #044a78; transition: transform 0.2s ease; }
    #slit-queue-table .sq-chev.is-open i { transform: rotate(90deg); }
    #slit-queue-table .tabulator-row.sq-group:hover .sq-chev { background: rgba(4, 74, 120, 0.18); }
    /* tableDisp.css forces cursor: default !important on row hover. */
    /* The Deckle on the slitter now: green, as on the queue's "material matched" rows. */
    #slit-queue-table .tabulator-row.sq-child.sq-running { background-color: #dcfce7 !important; }
    #slit-queue-table .tabulator-row.sq-child.sq-running:hover { background-color: #bbf7d0 !important; }
    /* A closed group with a Deckle running inside it: green too, so the job reads as live. */
    #slit-queue-table .tabulator-row.sq-group.sq-running-group { background-color: #dcfce7 !important; }
    #slit-queue-table .tabulator-row.sq-group.sq-running-group:hover { background-color: #bbf7d0 !important; }
    /* "Running" tag beside the Deckle count (same line, no extra height): only while the group is closed (sq-running-group). */
    #slit-queue-table .sq-run-badge { display: none; align-items: center; gap: 5px; margin-left: 10px; color: #15803d; font-weight: 700; white-space: nowrap; }
    #slit-queue-table .sq-running-group .sq-run-badge { display: inline-flex; }
    #slit-queue-table .tabulator-row.sq-running:hover,
    #slit-queue-table .tabulator-row.sq-running:hover .tabulator-cell,
    #slit-queue-table .tabulator-row.sq-group:hover,
    #slit-queue-table .tabulator-row.sq-group:hover .tabulator-cell { cursor: pointer !important; }
    #slit-queue-table .tabulator-data-tree-branch,
    #slit-queue-table .tabulator-data-tree-branch-empty { display: none !important; }
    #slit-queue-table .tabulator-row.sq-child { background-color: #f8fafc; }
    /* Pending List (lamination queue) Tabulator: same sizing, buttons and row
       tints as the Slitting Jobs table below. */
    #pending-queue-table { width: 100%; height: 100%; flex: 1 1 auto; min-height: 260px; border-radius: 8px; overflow: hidden; }
    #pending-queue-table .btn-action {
      height: 24px; padding: 2px 10px; color: #fff; border: none; border-radius: 4px; cursor: pointer;
      font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600; text-decoration: none;
    }
    #pending-queue-table .btn-action:hover { opacity: 0.85; }
    #pending-queue-table .btn-action.is-off { background: #9ca3af !important; cursor: not-allowed; opacity: 0.7; pointer-events: none; }
    #pending-queue-table .tabulator-data-tree-branch { display: none !important; }
    #pending-queue-table .tabulator-row.pq-match { background-color: #dcfce7 !important; }
    #pending-queue-table .tabulator-row.pq-match:hover { background-color: #bbf7d0 !important; }
    #pending-queue-table .tabulator-row.pq-short { background-color: #fee2e2 !important; }
    #pending-queue-table .tabulator-row.pq-short:hover { background-color: #fecaca !important; }
    #pending-queue-table .tabulator-row.pq-partial { background-color: #fff8e1 !important; }
    #pending-queue-table .tabulator-row.pq-partial:hover { background-color: #fdf0c8 !important; }
    #pending-queue-table .tabulator-cell.pq-pool { cursor: pointer; }
    #slit-queue-table .btn-action {
      height: 24px; padding: 2px 10px; color: #fff; border: none; border-radius: 4px; cursor: pointer;
      font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600; text-decoration: none;
    }
    #slit-queue-table .btn-action:hover { opacity: 0.85; }
    #slit-queue-table .btn-action.is-off { background: #9ca3af !important; cursor: not-allowed; opacity: 0.7; pointer-events: none; }

    .ap-notice {
      background: #fff8e1; border: 1px solid #f0c36d; color: #7a5b00; border-radius: 8px;
      padding: 10px 14px; font-size: 13px; display: flex; align-items: center; gap: 8px;
    }

    .mq-actions { display: flex; align-items: center; justify-content: center; gap: 6px; flex-wrap: nowrap; }
    .mq-start-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px; background: #10b981; color: #fff;
      border: none; border-radius: 6px; padding: 6px 10px; font-size: 12.5px; font-weight: 600;
      cursor: pointer; text-decoration: none; white-space: nowrap; transition: opacity 0.2s;
    }
    .mq-start-btn:hover { opacity: 0.85; }
    .mq-start-btn.mq-start-disabled { background: #9ca3af; cursor: not-allowed; pointer-events: none; }
    /* Undo sits beside Edit -- outlined, not filled, so the one action that
       takes a job off a machine can't be hit by muscle memory. */
    .mq-undo-btn {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 8px 10px; border-radius: 8px; cursor: pointer;
      border: 1px solid #fca5a5; background: #fff; color: #b91c1c;
    }
    .mq-undo-btn:hover:not(:disabled) { background: #dc2626; border-color: #dc2626; color: #fff; }
    .mq-undo-btn.mq-undo-disabled, .mq-undo-btn:disabled {
      border-color: #e2e8f0; color: #94a3b8; cursor: not-allowed; background: #f8fafc;
    }
    .mq-edit-btn {
      display: inline-flex; align-items: center; justify-content: center; background: #fff; color: #044a78;
      border: 1px solid #044a78; border-radius: 6px; padding: 6px 9px; font-size: 12.5px; font-weight: 600;
      cursor: pointer; text-decoration: none; white-space: nowrap; transition: background 0.2s;
    }
    .mq-edit-btn:hover { background: #eef5fb; }

    .ap-table tbody tr.mq-row-match { background: #dcfce7; }
    .ap-table tbody tr.mq-row-match:hover { background: #bbf7d0; }
    .ap-table tbody tr.mq-row-short { background: #fee2e2; }
    .ap-table tbody tr.mq-row-short:hover { background: #fecaca; }
    /* Every layer is on the machine, but not enough of it to run the job out.
       Amber: the job starts, it just will not finish -- which is neither the
       green "ready" nor the red "cannot run". */
    .ap-table tbody tr.mq-row-partial { background: #fff8e1; }
    .ap-table tbody tr.mq-row-partial:hover { background: #fdf0c8; }
    /* "15   material for 2 of 15" -- one line, the note beside the figure
       rather than under it, so the row keeps a single-line height. The cell
       is already nowrap (.ap-table td), and inline-block keeps the note from
       being broken up if that ever changes. */
    .mq-cover {
      display: inline-block; margin-left: 7px; font-size: 11px; font-weight: 700;
      color: #b45309; white-space: nowrap; vertical-align: baseline;
    }
    .mq-cover.is-none { color: #b91c1c; }

    .mq-rolls-cell {
      cursor: pointer; color: #044a78; text-decoration: underline; text-decoration-style: dotted;
      text-underline-offset: 3px;
    }
    .mq-rolls-cell:hover { color: #023654; }

    .dialog-header {
      background: #044A78; padding: 18px 22px;
      display: flex; align-items: center; justify-content: space-between;
      border-radius: 14px 14px 0 0;
    }
    .dialog-header h2 { margin: 0; font-size: 1.05rem; font-weight: 700; color: #fff; }
    .dialog-close-btn {
      background: none; border: none; color: #fff; font-size: 26px;
      cursor: pointer; line-height: 1; width: 38px; height: 38px;
      display: inline-flex; align-items: center; justify-content: center;
      border-radius: 8px; opacity: 0.85; transition: opacity 0.15s, background 0.15s;
    }
    .dialog-close-btn:hover { opacity: 1; background: rgba(255, 255, 255, 0.18); }
    .dialog-body { padding: 20px 22px; background: #fff; border-radius: 0 0 14px 14px; }
    .rd-pairs { width: 100%; border-collapse: collapse; font-size: 13px; }
    .rd-pairs th, .rd-pairs td { padding: 8px 10px; border-bottom: 1px solid #e5e7eb; text-align: left; }
    .rd-pairs th { width: 42%; color: #5a6586; font-weight: 600; }
    .rd-pairs td { color: #1f2a44; font-weight: 700; }
    .rd-pairs tr:last-child th, .rd-pairs tr:last-child td { border-bottom: none; }
    .rd-section {
      margin: 14px 0 6px; padding-top: 12px; border-top: 1px solid #e5e7eb;
      color: #044a78; font-size: 13px; font-weight: 700;
    }

    .rd-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .rd-table th, .rd-table td { padding: 8px 10px; border-bottom: 1px solid #e5e7eb; text-align: left; }
    .rd-table th { color: #5a6586; font-weight: 600; white-space: nowrap; }
    .rd-table thead th { background: #f0f7ff; color: #03365a; font-weight: 700; font-size: 12px; }
    /* The second figure in a cell -- running metres under the kilograms it was
       worked out from, and the like. */
    .rd-table .rd-sub { display: block; font-size: 11px; font-weight: 600; color: #7c8ba1; }
    /* Every column but the reel IDs holds a short value and should keep it on
       one line; the IDs are a list and are the one thing allowed to wrap, so a
       job with six reels on a layer grows the row rather than the table. */
    .rd-table td { white-space: nowrap; }
    .rd-table td:last-child, .rd-table th:last-child { white-space: normal; min-width: 150px; }
    /* The app's own table scrollbar, on the dialog's two scrollers.
       Deliberately the `.ap-table-wrap` tokens from common.css -- 10px, not
       the 6px `.custom-scrollbar` variant some views carry -- because the
       queue table sitting right behind this dialog uses exactly these, and a
       6px hairline beside a 10px bar reads as a bar that failed to render
       rather than as a different one.
       The Firefox pair is not optional: every ::-webkit- rule above is
       ignored there, so without it the dialog falls back to the browser
       default and the styling looks like it did nothing at all. */
    .custom-scrollbar::-webkit-scrollbar { width: 10px; height: 10px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f0f2f5; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #044a78; border-radius: 6px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }
    /* .rd-scroll can show both bars at once -- the square where they meet is
       the browser default grey unless it is painted too. */
    .custom-scrollbar::-webkit-scrollbar-corner { background: #f0f2f5; }
    .custom-scrollbar { scrollbar-width: thin; scrollbar-color: #044a78 #f0f2f5; }
    /* A tall dialog on a short screen scrolls inside its body rather than
       running off the bottom of the window. */
    #rollDetailsBody { max-height: min(70vh, 720px); overflow-y: auto; }
    /* ...and on a window too narrow for six columns it is the TABLE that
       scrolls sideways, not the dialog that grows past the screen. The banner
       and the spec pairs above it stay put where they can be read. */
    .rd-scroll { overflow-x: auto; }
    /* How far the allotted material gets, at the top of the dialog where it is
       read before anything else. */
    .mq-cover-banner {
      border-radius: 10px; padding: 12px 14px; margin: 0 0 14px;
      border: 1px solid transparent; line-height: 1.5;
    }
    .mq-cover-banner.is-short { background: #fff8e1; border-color: #f0c36d; }
    .mq-cover-banner.is-ok { background: #ecfdf5; border-color: #a7f3d0; }
    .mq-cover-head { font-size: 14.5px; font-weight: 800; color: #1f2a44; }
    .mq-cover-banner.is-short .mq-cover-head { color: #92400e; }
    .mq-cover-banner.is-ok .mq-cover-head { color: #166534; }
    .mq-cover-head i { margin-right: 7px; }
    .mq-cover-sub { margin-top: 5px; font-size: 12.5px; font-weight: 600; color: #5b6b80; }
    .rd-table td { color: #1f2a44; font-weight: 700; }
    .rd-table tbody tr:last-child th, .rd-table tbody tr:last-child td { border-bottom: none; }

    @media screen and (max-width: 768px) {
      .mq-page { height: auto; min-height: 100%; padding: 8px; gap: 10px; }
      .mq-head { padding: 0.5rem 0.7rem; }
      .mq-head h1 { font-size: 17px; }
      .mq-head .mq-sub { font-size: 12px; }
      .ap-card-title { font-size: 13px; padding: 8px 12px; }

      .ap-table-wrap { overflow-x: visible; }
      .ap-table thead { display: none; }
      .ap-table, .ap-table tbody, .ap-table tr, .ap-table td { display: block; width: 100%; }
      .ap-table tbody tr {
        display: flex; flex-wrap: wrap;
        border: 1px solid #dbe3ec; border-radius: 8px; overflow: hidden; margin: 10px;
        width: auto;
      }
      .ap-table td {
        display: flex; align-items: center; gap: 10px;
        flex: 1 1 100%;
        padding: 7px 12px; border-right: none; white-space: normal; font-size: 13px;
      }
      .ap-table td::before {
        content: attr(data-label);
        flex: 0 0 34%; min-width: 0;
        color: #5a6586; font-weight: 700; font-size: 12px;
      }
      .ap-table td:last-child { border-bottom: none; justify-content: center; padding: 10px 12px; }
      .ap-table td:last-child::before { content: none; }
      .mq-actions { width: 100%; flex-direction: column; gap: 8px; }
      .mq-start-btn, .mq-edit-btn { width: 100%; justify-content: center; padding: 11px 12px; font-size: 14px; }

      .dialog-header { padding: 14px 16px; }
      .dialog-body { padding: 14px 16px; }
      .rd-table th, .rd-table td,
      .rd-pairs th, .rd-pairs td { padding: 7px 6px; font-size: 12.5px; }
    }
  </style>

  <div class="indi-head mq-head">
    <div>
      <h1><%= machine.machineName %></h1>
      <div class="mq-sub">
        <%= machine.machineType || "—" %><% if (machine.location && machine.location.locationName) { %> / <%= machine.location.locationName %><% } %>
      </div>
    </div>
  </div>

  <!-- This "Pending List" is Assign Production's lamination queue
       (PendingProduction.assignedMachineId) -- a Slitting machine is never a
       target for that, its queue is the "Slitting Jobs" card below instead
       -- so skip the card here rather than show a permanently-empty, and
       misleading, "No orders currently assigned" notice above the Slitting
       Jobs card that actually has this machine's real queue. -->
  <% if (machine.machineType !== "SLITTING") { %>
  <%# Same bar as the machine header above (.indi-head), then the queue as a
      Tabulator -- one row per order, built in the script at the foot of the
      page from #queue-rows-data. %>
  <div class="indi-head" style="padding: 0.5rem 0.8rem;">
    <h2 style="margin: 0; font-size: 1.3rem; font-weight: 600; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-layer-group"></i> Pending List</h2>
    <span style="font-size: 1.1rem; font-weight: 600;"><%= rows.length %> order<%= rows.length === 1 ? "" : "s" %></span>
  </div>
  <% if (rows.length === 0) { %>
    <div class="ap-notice">
      <i class="fa-solid fa-circle-info"></i>
      No orders currently assigned to this machine.
    </div>
  <% } else { %>
    <div id="pending-queue-table"></div>
    <script id="pending-queue-flags" type="application/json"><%- safeJson({ canEdit: !!(authUser && authUser.role !== "operator") }) %></script>
  <% } %>
  <% } %>

  <!-- Slitting jobs allocated to this machine (routes/system/slitting.js).
       A slitting card is not a PendingProduction, so it gets its own card
       rather than being forced into the lamination table's columns. -->
  <% const slitRows = (typeof slittingRows !== "undefined" && slittingRows) ? slittingRows : []; %>
  <% if (slitRows.length) { %>
  <%# Same bar as the machine header above (.indi-head) so the edges line up
      with it and the table, and the text is centred in the bar. %>
  <div class="indi-head" style="padding: 0.5rem 0.8rem;">
    <h2 style="margin: 0; font-size: 1.3rem; font-weight: 600; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-scissors"></i> Slitting Jobs</h2>
    <span style="font-size: 1.1rem; font-weight: 600;"><%= slitRows.length %> card<%= slitRows.length === 1 ? "" : "s" %></span>
  </div>
  <%# Cards cut to the same pattern for the same product are folded into one
      row (Tabulator dataTree); expanding it lists every Deckle ID allocated,
      under the card it belongs to. Built in the script at the foot of the page
      from #slit-queue-data. The table sits outside the heading's card. %>
  <div id="slit-queue-table"></div>
  <script id="slit-queue-data" type="application/json"><%- safeJson({ rows: slitRows, canEdit: !!(authUser && authUser.role !== "operator") }) %></script>
  <% } %>
</div>

<!-- ============ ROLL ALLOTMENT DETAILS DIALOG ============ -->
<div class="logout-modal" id="rollDetailsDialog" aria-hidden="true">
  <!-- Wider than the 560px house dialog: the Material Allocation table below
       carries six columns now (what is on the machine, what the job needs, how
       many rolls that covers, and the reel IDs), and at 600px they wrapped
       into unreadable stacks. `min()` still yields to a narrow window. -->
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="rollDetailsTitle"
    style="width: min(1040px, 96vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header">
      <h2 id="rollDetailsTitle">Item Allotment Details</h2>
      <button class="dialog-close-btn" type="button" onclick="closeModal('rollDetailsDialog')" aria-label="Close">×</button>
    </div>
    <div class="dialog-body custom-scrollbar" id="rollDetailsBody"></div>
  </div>
</div>

<!-- ============ UNDO (SEND BACK TO PENDING) DIALOG ============ -->
<!-- Taking a job off a machine is not a click-and-see action: it releases the
     reels and un-makes any Deckle laminated at Assign & Continue, so it is
     spelled out before it happens. -->
<div class="logout-modal" id="undoDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="undoTitle"
    style="width: min(480px, 95vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="undoTitle">Send this job back to Pending?</h2>
      <button class="dialog-close-btn" type="button" onclick="closeModal('undoDialog')" aria-label="Close">&times;</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div id="undoSummary" style="margin-bottom: 14px; padding: 10px 12px; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 8px; font-size: 13px; font-weight: 700; color: #9a3412;"></div>
      <p style="font-size: 13px; color: #4b5563; margin: 0 0 6px;">It comes off this machine and goes back to Pending Production:</p>
      <ul style="font-size: 13px; color: #4b5563; margin: 0 0 10px; padding-left: 18px; line-height: 1.7;">
        <li>the machine, operator and helper are cleared</li>
        <li>every reel and drum allotted to it is released for other jobs</li>
        <li>any Deckle laminated at Assign &amp; Continue is un-made, and that material goes back onto the reels it came off</li>
        <li>its Lot No is kept, so re-assigning it keeps the same number</li>
      </ul>
      <div id="undoError" class="dialog-error" style="color:#ef4444; font-size:12px; display:none;"></div>
      <div class="dialog-actions" style="display: flex; justify-content: flex-end; gap: 10px;">
        <button class="logout-btn" type="button" onclick="closeModal('undoDialog')">Cancel</button>
        <button class="logout-btn" type="button" id="undoConfirmBtn"
          style="background:#dc2626; color:#fff; border-color:#dc2626;">Yes, send it back</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ UNDO SLITTING ALLOCATION DIALOG ============ -->
<div class="logout-modal" id="slitUndoDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="slitUndoTitle"
    style="width: min(480px, 95vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="slitUndoTitle">Undo this slitting allocation?</h2>
      <button class="dialog-close-btn" type="button" onclick="closeModal('slitUndoDialog')" aria-label="Close">&times;</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div id="slitUndoSummary" style="margin-bottom: 14px; padding: 10px 12px; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 8px; font-size: 13px; font-weight: 700; color: #9a3412;"></div>
      <p style="font-size: 13px; color: #4b5563; margin: 0 0 6px;">The card is removed from this machine:</p>
      <ul style="font-size: 13px; color: #4b5563; margin: 0 0 10px; padding-left: 18px; line-height: 1.7;">
        <li>its Deckle goes back to the Slitting Queue, free for any job</li>
        <li>nothing has been cut, so no stock moves</li>
      </ul>
      <div id="slitUndoError" class="dialog-error" style="color:#ef4444; font-size:12px; display:none;"></div>
      <div class="dialog-actions" style="display: flex; justify-content: flex-end; gap: 10px;">
        <button class="logout-btn" type="button" onclick="closeModal('slitUndoDialog')">Cancel</button>
        <button class="logout-btn" type="button" id="slitUndoConfirmBtn"
          style="background:#dc2626; color:#fff; border-color:#dc2626;">Yes, undo it</button>
      </div>
    </div>
  </div>
</div>

<script id="queue-rows-data" type="application/json"><%- safeJson(rows) %></script>
<script>
  const QUEUE_ROWS = JSON.parse(document.getElementById("queue-rows-data").textContent);

  function openModal(id)  { const d = document.getElementById(id); d.classList.add("show");    d.setAttribute("aria-hidden", "false"); }
  function closeModal(id) { const d = document.getElementById(id); d.classList.remove("show"); d.setAttribute("aria-hidden", "true");  }

  function dash(v) { return v === undefined || v === null || v === "" ? "—" : v; }

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  function openRollDetails(id) {
    const row = QUEUE_ROWS.find((r) => r._id === id);
    if (!row) return;
    const ref = row.materialReference || {};
    const layers = row.layerAllotments || [];

    // Material Status: are the raw layers allotted -- the same thing that
    // colors the queue row. (Deckle Status/Deckle Rolls Produced used to
    // show here too, but the deckle itself isn't produced until after this
    // allotment step runs, so there's nothing meaningful to show yet.)
    const cov = row.coverage;
    const materialStatusLabel = row.materialStatus === "match" ? "Fully allotted"
      : row.materialStatus === "partial" ? "Partly allotted"
      : row.materialStatus === "short" ? "Not allotted"
      : "—";
    const materialStatusColor = row.materialStatus === "match" ? "#16a34a"
      : row.materialStatus === "partial" ? "#b45309"
      : row.materialStatus === "short" ? "#dc2626"
      : "#1f2a44";

    // The one line the floor actually needs: how far this material gets. Said
    // in ROLLS, because that is what the queue is counted in, with the layer
    // that runs out first named -- so topping it up means pulling one more
    // reel of that, not guessing.
    const fmtN = (n) => Number(n || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 });
    let coverBanner = "";
    if (cov && cov.rolls != null && cov.target != null) {
      const short = cov.rolls < cov.target;
      const pct = Math.round(Math.min(1, cov.covered) * 100);
      coverBanner = short
        ? `<div class="mq-cover-banner is-short">`
          + `<div class="mq-cover-head"><i class="fa-solid fa-triangle-exclamation"></i> `
          + `Material for <b>${cov.rolls}</b> of <b>${cov.target}</b> rolls`
          + (cov.rolls === 0 ? ` — not enough for one` : ``) + `</div>`
          + `<div class="mq-cover-sub">`
          + (cov.worstLabel
            ? `<b>${escapeHtml(cov.worstLabel)}</b> runs out first (${pct}% of what this job needs). `
            : `${pct}% of what this job needs is on the machine. `)
          + `The job can start and will stop when it runs out — top it up from the assignment to run the rest.`
          + `</div></div>`
        : `<div class="mq-cover-banner is-ok">`
          + `<div class="mq-cover-head"><i class="fa-solid fa-circle-check"></i> `
          + `Material for all <b>${cov.target}</b> rolls</div></div>`;
    }

    const pairs = [
      ["Facestock Type", dash(ref.facestockType)],
      ["Facestock Family", dash(ref.facestockFamily)],
      ["Adhesive Type", dash(ref.adhesiveType)],
      ["Release Liner Type", dash(ref.releaseLinerType)],
      ["Paper Size", dash(ref.paperSize || row.paperSize)],
    ];
    const pairsHtml = pairs.map(([k, v]) => `<tr><th>${k}</th><td>${escapeHtml(v)}</td></tr>`).join("")
      + `<tr><th>Material Status</th><td><span style="color:${materialStatusColor};">${materialStatusLabel}</span></td></tr>`;

    // One line per raw-material layer this item's recipe calls for --
    // Facestock/Release Liner are rolls, Adhesive is a drum (row.unit names
    // whichever it actually is, see LAYER_META in utils/labelStockProduction.js).
    // A layer can hold more than one picked reel now (Assign Production's
    // pickers are checkboxes -- combining two undersized reels onto one
    // order is the whole point), so Qty/ID summarize across l.reels instead
    // of assuming exactly one. Anything not yet picked reads "Not Allotted"
    // instead of a blank cell, so a partial pick (e.g. Facestock done,
    // Adhesive still open) is unambiguous.
    // Per layer: what is on the machine, what the job needs, and how far that
    // gets -- the three figures together, because any one of them alone is
    // what made "Allotted" mean a 27 kg remnant against a 770 kg job.
    const covOf = (key) => (cov ? cov.layers.find((x) => x.key === key) : null);
    const layersHtml = layers.length
      ? `<div class="rd-scroll custom-scrollbar"><table class="rd-table">` +
        `<thead><tr><th>Layer</th><th>Status</th><th>On the machine</th><th>Needs</th><th>Covers</th><th>ID</th></tr></thead>` +
        `<tbody>` + layers.map((l) => {
          const c = covOf(l.key);
          const under = !!c && c.covered < 0.9999;
          const statusHtml = !l.allocated
            ? `<span style="color:#dc2626;">Not Allotted</span>`
            : under
              ? `<span style="color:#b45309;">Part allotted</span>`
              : `<span style="color:#16a34a;">Allotted</span>`;
          const totalMtrs = l.reels.reduce((sum, r) => sum + (r.reelMtrs || 0), 0);
          const qty = l.allocated
            ? `${l.reels.length} ${escapeHtml(l.unit)}${l.reels.length === 1 ? "" : "s"} · ${fmtN(totalMtrs)} kg`
              + (c && c.gotMtrs > 0 ? `<span class="rd-sub">${fmtN(c.gotMtrs)} R.Mtrs</span>` : "")
            : "—";
          const needs = c && c.needKg != null
            ? `${fmtN(c.needKg)} kg` + (c.needMtrs != null ? `<span class="rd-sub">${fmtN(c.needMtrs)} R.Mtrs</span>` : "")
            : "—";
          // Rolls, not a bare percentage -- the same unit the queue counts in.
          const rollsHere = c && cov && cov.target != null
            ? Math.min(cov.target, Math.floor(cov.target * c.covered + 1e-9))
            : null;
          const covers = c
            ? `<span style="color:${under ? "#b45309" : "#16a34a"}; font-weight:700;">`
              + (rollsHere != null ? `${rollsHere} of ${cov.target} rolls` : `${Math.round(Math.min(1, c.covered) * 100)}%`)
              + `</span>`
              + (c.unmeasured ? `<span class="rd-sub">${c.unmeasured} reel(s) with no length</span>` : "")
            : "—";
          const ids = l.allocated ? l.reels.map((r) => escapeHtml(dash(r.rollId))).join(", ") : "—";
          return `<tr>` +
            `<td>${escapeHtml(l.label)}</td>` +
            `<td>${statusHtml}</td>` +
            `<td>${qty}</td>` +
            `<td>${needs}</td>` +
            `<td>${covers}</td>` +
            `<td>${ids}</td>` +
          `</tr>`;
        }).join("") + `</tbody></table></div>`
      : `<div class="ap-notice"><i class="fa-solid fa-circle-info"></i> ` +
        `This SKU has no raw-material recipe to allocate.</div>`;

    document.getElementById("rollDetailsBody").innerHTML =
      coverBanner +
      `<table class="rd-pairs"><tbody>${pairsHtml}</tbody></table>` +
      `<div class="rd-section">Material Allocation</div>` +
      layersHtml;
    openModal("rollDetailsDialog");
  }

  document.getElementById("rollDetailsDialog").addEventListener("click", (e) => {
    if (e.target.id === "rollDetailsDialog") closeModal("rollDetailsDialog");
  });

  /* ----- Undo: send this job back to Pending -----
     A plain POST form, not fetch: the route answers with a redirect and a
     flash, the same way the WIP tab's own Send Back button has always driven
     it. `from` brings us back to this queue instead of the Deckle Set page --
     undoing one job of several shouldn't move you off the machine you are
     looking at. */
  window.requestUndo = function (orderId, lotNo, productCode) {
    document.getElementById("undoSummary").textContent = `${lotNo || "This job"} · ${productCode || ""}`.trim();
    document.getElementById("undoError").style.display = "none";
    document.getElementById("undoConfirmBtn").onclick = () => {
      const form = document.createElement("form");
      form.method = "POST";
      form.action = `/app/labels/production/unassign/${orderId}`;
      const add = (name, value) => {
        const input = document.createElement("input");
        input.type = "hidden"; input.name = name; input.value = value;
        form.appendChild(input);
      };
      add("_csrf", "<%= csrfToken %>");
      add("from", location.pathname + location.search);
      document.body.appendChild(form);
      form.submit();
    };
    openModal("undoDialog");
  };

  document.getElementById("undoDialog").addEventListener("click", (e) => {
    if (e.target.id === "undoDialog") closeModal("undoDialog");
  });

  // Undo a slitting allocation (routes/system/slitting.js POST
  // /slitting/jobcard/:cardId/undo). The server re-checks everything the
  // button shows, so a card started on the floor since this page loaded is
  // refused with the reason, not removed.
  window.requestSlitUndo = function (cardId, cardCode, lotNo) {
    document.getElementById("slitUndoSummary").textContent = `${cardCode || "Slitting card"} · Deckle ${lotNo || "—"}`;
    document.getElementById("slitUndoError").style.display = "none";
    document.getElementById("slitUndoConfirmBtn").onclick = () => {
      const form = document.createElement("form");
      form.method = "POST";
      form.action = `/app/slitting/jobcard/${cardId}/undo`;
      const csrf = document.createElement("input");
      csrf.type = "hidden"; csrf.name = "_csrf"; csrf.value = "<%= csrfToken %>";
      form.appendChild(csrf);
      document.body.appendChild(form);
      form.submit();
    };
    openModal("slitUndoDialog");
  };

  document.getElementById("slitUndoDialog").addEventListener("click", (e) => {
    if (e.target.id === "slitUndoDialog") closeModal("slitUndoDialog");
  });
</script>

<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script>
  // Slitting Jobs: one row per (product + cut pattern), Deckle IDs inside.
  (function () {
    const mount = document.getElementById("slit-queue-table");
    if (!mount) return;
    const DATA = JSON.parse(document.getElementById("slit-queue-data").textContent);
    const cards = DATA.rows || [];
    const canEdit = !!DATA.canEdit;
    const esc = (v) => escapeHtml(v == null ? "" : String(v));
    const uniq = (arr) => [...new Set(arr.filter((x) => x && x !== "—"))];
    const joinShort = (arr, noun) => (arr.length <= 2 ? arr.join(", ") : arr.length + " " + noun) || "—";

    function actionsHtml(c) {
      // Starting is done in the mobile (operator) app only: no Start button here.
      let h = '<div style="display:inline-flex; gap:6px;">';
      if (canEdit && c.pendingProductionId && c.deckleStockId) {
        h += '<a href="/app/slitting/allocate/' + encodeURIComponent(c.pendingProductionId) + "?deckle=" + encodeURIComponent(c.deckleStockId) + '" class="btn-action" style="background:#044a78;" title="Edit this allocation" aria-label="Edit this allocation"><i class="fa-solid fa-pen"></i> Edit</a>';
      }
      if (canEdit) {
        if (c.canUndo) {
          h += '<button type="button" class="btn-action" style="background:#b91c1c;" data-id="' + esc(c._id) + '" data-card="' + esc(c.slittingJobCardId) + '" data-lot="' + esc(c.lotNo) + '" onclick="requestSlitUndo(this.dataset.id, this.dataset.card, this.dataset.lot)" title="Undo this allocation — the Deckle goes back to the Slitting Queue" aria-label="Undo this allocation"><i class="fa-solid fa-rotate-left"></i> Undo</button>';
        } else {
          h += '<span title="' + esc(c.undoBlockedReason) + '"><span class="btn-action is-off"><i class="fa-solid fa-rotate-left"></i> Undo</span></span>';
        }
      }
      return h + "</div>";
    }
    const curingHtml = (c) => c.curing
      ? '<div style="color:#b45309;font-weight:700;font-size:11px;margin-top:3px;"><i class="fa-solid fa-hourglass-half"></i> curing' + (c.curingUntilLabel ? " · ready " + esc(c.curingUntilLabel) : "") + "</div>"
      : "";

    // Group in first-seen order.
    const groups = new Map();
    cards.forEach((c) => {
      const key = c.productCode + "\u0000" + (c.layoutKey || "");
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key).push(c);
    });

    const tree = [];
    let n = 0, srNo = 0;
    groups.forEach((list) => {
      const first = list[0];
      const sr = ++srNo;
      const multi = list.length > 1;
      // Every Deckle of every card in the group, the one on the slitter now
      // first (the rest keep card order).
      const flat = [];
      list.forEach((c) => {
        const decks = Array.isArray(c.deckles) && c.deckles.length ? c.deckles : [{ id: "", done: false, running: false }];
        decks.forEach((d) => flat.push({ c, d }));
      });
      flat.sort((x, y) => (y.d.running ? 1 : 0) - (x.d.running ? 1 : 0));
      const seenCard = new Set();
      const children = flat.map(({ c, d }) => {
        const firstOfCard = !seenCard.has(c._id);
        seenCard.add(c._id);
        return {
          id: "c" + (++n),
          deckleId: d.id || "—",
          slit: c.slittingJobCardId,
          lot: c.lotNo,
          product: c.productCode,
          client: c.clientName,
          layout: c.layoutSummary || "—",
          status: d.done ? "done" : d.running ? "running" : "run",
          curing: c.curing ? curingHtml(c) : "",
          slice: "",
          actions: multi && firstOfCard ? actionsHtml(c) : "",
        };
      });
      const total = list.reduce((a, c) => a + c.deckleCount, 0);
      const done = list.reduce((a, c) => a + c.deckleDone, 0);
      const planned = list.reduce((a, c) => a + c.plannedRolls, 0);
      const made = list.reduce((a, c) => a + c.producedRolls, 0);
      tree.push({
        id: "g" + (++n),
        isGroup: true,
        hasRunning: list.some((c) => (c.deckles || []).some((d) => d.running)),
        sr: sr,
        deckleId: total + " Deckle" + (total === 1 ? "" : "s"),
        slit: joinShort(uniq(list.map((c) => c.slittingJobCardId)), "cards"),
        lot: (() => { const n = uniq(list.map((c) => c.lotNo)).length; return n + (n === 1 ? " lot" : " lots"); })(),
        product: first.productCode,
        client: joinShort(uniq(list.map((c) => c.clientName)), "clients"),
        layout: first.layoutKey || "—",
        left: total - done,
        done: done,
        total: total,
        curing: list.some((c) => c.curing) ? curingHtml(list.find((c) => c.curing)) : "",
        slice: made + " of " + planned,
        actions: multi ? "" : actionsHtml(first),
        _children: children,
      });
    });

    const html = (fn) => (cell) => fn(cell.getData(), cell.getValue());
    const table = new Tabulator(mount, {
      data: tree,
      layout: "fitColumns",
      dataTree: true,
      dataTreeStartExpanded: false,
      dataTreeChildIndent: 18,
      index: "id",
      columnDefaults: { vertAlign: "middle" },
      rowFormatter: (row) => {
        const d = row.getData(), el = row.getElement();
        el.classList.add(d.isGroup ? "sq-group" : "sq-child");
        if (d.status === "running") el.classList.add("sq-running");
        if (d.isGroup) el.classList.toggle("sq-running-group", !!d.hasRunning && !row.isTreeExpanded());
      },
      dataTreeElementColumn: "deckleId",
      placeholder: "No slitting jobs",
      columns: [
        { title: "", field: "_open", width: 44, hozAlign: "center", headerSort: false, resizable: false,
          formatter: (cell) => (cell.getData().isGroup
            ? '<span class="sq-chev' + (cell.getRow().isTreeExpanded() ? " is-open" : "") + '" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></span>'
            : "") },
        { title: "Sr. No.", field: "sr", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false,
          formatter: html((r, v) => (r.isGroup ? esc(v) : "")) },
        { title: "Deckle ID", field: "deckleId", widthGrow: 1.6, minWidth: 170, headerSort: false,
          formatter: html((r, v) => (r.isGroup
            ? '<span style="font-weight:700;white-space:nowrap;">' + esc(v) + "</span>" + (r.hasRunning ? '<span class="sq-run-badge"><i class="fa-solid fa-circle-play"></i> Running</span>' : "")
            : esc(v))) },
        { title: "Lot Count", field: "lot", widthGrow: 0.8, minWidth: 100, headerSort: false,
          formatter: html((r, v) => (!r.isGroup ? "" : v ? '<span style="font-weight:700;">' + esc(v) + "</span>" : '<span style="color:#9ca3af;">—</span>')) },
        { title: "Product Code", field: "product", widthGrow: 0.9, minWidth: 110, headerSort: false, headerFilter: "input", headerFilterPlaceholder: "Filter code...",
          formatter: html((r, v) => '<span style="font-weight:700;">' + esc(v || "N/A") + "</span>") },
        { title: "Client", field: "client", widthGrow: 1.5, minWidth: 130, headerSort: false, headerFilter: "input", headerFilterPlaceholder: "Filter client...",
          formatter: html((r, v) => (v && v !== "—" ? esc(v) : '<span style="color:#9ca3af;">—</span>')) },
        { title: "Layout", field: "layout", widthGrow: 1.5, minWidth: 140, headerSort: false, headerFilter: "input", headerFilterPlaceholder: "Filter layout...",
          formatter: html((r, v) => (v && v !== "—" ? esc(String(v).replace(/ \+ /g, " - ")) : '<span style="color:#9ca3af;">—</span>')) },
        { title: "Deckles", field: "status", widthGrow: 1.2, minWidth: 130, headerSort: false,
          formatter: html((r) => {
            if (r.isGroup) {
              return '<div style="display:flex;align-items:center;justify-content:flex-start;gap:10px;flex-wrap:wrap;"><span style="font-weight:700;white-space:nowrap;">' + esc(r.left) + " to run</span>" + (r.done > 0 ? '<span style="color:#64748b;font-weight:600;font-size:11px;white-space:nowrap;">(' + esc(r.done) + " of " + esc(r.total) + " done)</span>" : "")
                + '<div style="width:70px;height:3px;flex:none;border-radius:2px;background:#e2e8f0;overflow:hidden;" role="progressbar" aria-valuemin="0" aria-valuemax="' + esc(r.total) + '" aria-valuenow="' + esc(r.done) + '" title="' + esc(r.done) + " of " + esc(r.total) + ' done"><div style="height:100%;width:' + (r.total ? Math.round((r.done / r.total) * 100) : 0) + '%;background:#10b981;"></div></div>'
                + r.curing + "</div>";
            }
            return '<div>' + (r.status === "done"
              ? '<span style="color:#16a34a;font-weight:700;"><i class="fa-solid fa-check"></i> Done</span>'
              : r.status === "running"
                ? '<a href="/app/slitting/wip" style="color:#15803d;font-weight:700;text-decoration:underline;" title="Open the Slitting WIP"><i class="fa-solid fa-circle-play"></i> Running</a>'
                : "To run") + r.curing + "</div>";
          }) },
        { title: "Slice", field: "slice", width: 90, headerSort: false,
          formatter: html((r, v) => (v ? '<span style="font-weight:700;">' + esc(v) + "</span>" : "")) },
        { title: "Actions", field: "actions", width: 200, hozAlign: "center", headerHozAlign: "center", headerSort: false, formatter: html((r, v) => v || "") },
      ],
    });

    // A click anywhere on a group row opens/closes it (not on its buttons).
    // Tabulator 5 takes row events through table.on(), not as options.
    table.on("rowClick", (e, row) => {
      const d = row.getData();
      if (e.target.closest("a, button, input, select, textarea")) return;
      // The Deckle on the slitter now: a click opens the Slitting WIP.
      if (d.status === "running") { window.location.href = "/app/slitting/wip"; return; }
      if (!d.isGroup) return;
      row.treeToggle();
    });

    // Keep the arrow in step with the row, however it was toggled.
    const setChev = (row, open) => {
      const chev = row.getElement().querySelector(".sq-chev");
      if (chev) chev.classList.toggle("is-open", open);
      // Open: the running Deckle's own row is green, so the group goes back to normal.
      row.getElement().classList.toggle("sq-running-group", !!row.getData().hasRunning && !open);
    };
    table.on("dataTreeRowExpanded", (row) => setChev(row, true));
    table.on("dataTreeRowCollapsed", (row) => setChev(row, false));
  })();
</script>

<script>
  // Pending List: one row per order on this machine.
  (function () {
    const mount = document.getElementById("pending-queue-table");
    if (!mount) return;
    const canEdit = !!JSON.parse(document.getElementById("pending-queue-flags").textContent).canEdit;
    const esc = (v) => escapeHtml(v == null ? "" : String(v));
    const muted = '<span style="color:#9ca3af;">—</span>';
    const poolBadge = (status) => {
      if (status === "none") return '<span style="color:#dc2626; font-weight:700;"><i class="fa-solid fa-triangle-exclamation"></i> Not allotted</span>';
      if (status === "partial") return '<span style="color:#ca8a04; font-weight:700;"><i class="fa-solid fa-circle-half-stroke"></i> Partial</span>';
      if (status === "full") return '<span style="color:#16a34a; font-weight:700;"><i class="fa-solid fa-check"></i> Allotted</span>';
      return muted;
    };
    const rowClassOf = (r) => (r.materialStatus === "match" ? "pq-match" : r.materialStatus === "short" ? "pq-short" : r.materialStatus === "partial" ? "pq-partial" : "");

    function actionsHtml(r) {
      if (!canEdit) return "";
      let h = '<div style="display:inline-flex; gap:6px;"><a href="/app/labels/production/assign/' + encodeURIComponent(r._id) + '" class="btn-action" style="background:#044a78;" title="Edit this assignment" aria-label="Edit this assignment"><i class="fa-solid fa-pen"></i> Edit</a>';
      if (r.canUndo) {
        h += '<button type="button" class="btn-action" style="background:#b91c1c;" data-id="' + esc(r._id) + '" data-lot="' + esc(r.lotNo) + '" data-product="' + esc(r.productCode) + '" onclick="requestUndo(this.dataset.id, this.dataset.lot, this.dataset.product)" title="Send this job back to Pending — it comes off this machine" aria-label="Undo this assignment"><i class="fa-solid fa-rotate-left"></i> Undo</button>';
      } else {
        h += '<span title="' + esc(r.undoBlockedReason) + '"><span class="btn-action is-off"><i class="fa-solid fa-rotate-left"></i> Undo</span></span>';
      }
      return h + "</div>";
    }

    const data = QUEUE_ROWS.map((r, i) => ({ ...r, sr: i + 1 }));
    const poolCol = (title, field) => ({
      title, field, widthGrow: 1, minWidth: 120, headerSort: false, cssClass: "pq-pool",
      cellClick: (e, cell) => openRollDetails(cell.getRow().getData()._id),
      tooltip: () => "View roll allotment details",
      formatter: (cell) => poolBadge(cell.getValue()),
    });
    new Tabulator(mount, {
      data,
      layout: "fitColumns",
      index: "_id",
      columnDefaults: { vertAlign: "middle" },
      placeholder: "No orders currently assigned to this machine.",
      rowFormatter: (row) => {
        const d = row.getData(), el = row.getElement();
        const c = rowClassOf(d);
        if (c) el.classList.add(c);
        if (d.advance) el.classList.add("adv-row");
      },
      columns: [
        { title: "Sr. No.", field: "sr", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false },
        { title: "Lot No", field: "lotNo", widthGrow: 1.5, minWidth: 140, headerSort: false, headerFilter: "input", headerFilterPlaceholder: "Filter lot...",
          formatter: (cell) => '<span style="font-weight:700;">' + esc(cell.getValue() || "—") + "</span>" },
        { title: "Product Code", field: "productCode", widthGrow: 1.3, minWidth: 150, headerSort: false, headerFilter: "input", headerFilterPlaceholder: "Filter code...",
          formatter: (cell) => {
            const r = cell.getRow().getData();
            const tag = r.advance ? ' <span class="adv-tag" title="' + esc(r.advance.rolls) + ' roll(s) set in advance — no sales order yet">ADVANCE</span>' : "";
            return '<span style="font-weight:700;">' + esc(cell.getValue() || "—") + "</span>" + tag;
          } },
        { title: "Paper Size", field: "paperSize", widthGrow: 0.9, minWidth: 100, headerSort: false,
          formatter: (cell) => (cell.getValue() ? esc(cell.getValue()) : muted) },
        { title: "Required Rolls", field: "rolls", widthGrow: 1.4, minWidth: 140, headerSort: false,
          formatter: (cell) => {
            const r = cell.getRow().getData(), cov = r.coverage;
            let h = '<span style="font-weight:700;">' + esc(r.rolls) + "</span>";
            if (cov && cov.rolls != null && cov.target != null && cov.rolls < cov.target) {
              const tip = cov.rolls === 0
                ? "The material allotted is not enough for even one roll" + (cov.worstLabel ? " — " + cov.worstLabel + " is the short one" : "") + "."
                : "The allotted raw material runs out after " + cov.rolls + " of " + cov.target + " rolls" + (cov.worstLabel ? " — " + cov.worstLabel + " is the short one" : "") + ". Re-open the assignment to top it up.";
              h += ' <span class="mq-cover' + (cov.rolls === 0 ? " is-none" : "") + '" title="' + esc(tip) + '"><i class="fa-solid fa-triangle-exclamation"></i> material for ' + esc(cov.rolls) + " of " + esc(cov.target) + "</span>";
            }
            return h;
          } },
        poolCol("Facestock", "facestockStatus"),
        poolCol("Adhesive", "adhesiveStatus"),
        poolCol("Release", "releaseStatus"),
        { title: "Balance Rolls", field: "balanceRolls", widthGrow: 1.2, minWidth: 130, headerSort: false,
          formatter: (cell) => {
            const r = cell.getRow().getData();
            return '<span style="font-weight:700;">' + esc(r.balanceRolls) + "</span>" + (Number(r.producedRolls) > 0 ? ' <span style="color:#64748b;font-weight:600;font-size:11px;">(' + esc(r.producedRolls) + " of " + esc(r.rolls) + " done)</span>" : "");
          } },
        { title: "Status", field: "liveStatus", widthGrow: 1, minWidth: 120, headerSort: false,
          formatter: (cell) => {
            const v = cell.getValue();
            if (v === "running") return '<a href="/app/labels/production/pending?tab=wip" style="color:#15803d;font-weight:700;text-decoration:underline;" title="Open the WIP tab"><i class="fa-solid fa-circle-play"></i> Running</a>';
            if (v === "setting") return '<span style="color:#b45309;font-weight:700;"><i class="fa-solid fa-gear"></i> Job Setting</span>';
            if (v === "paused") return '<span style="color:#64748b;font-weight:700;"><i class="fa-solid fa-circle-pause"></i> Paused</span>';
            if (v === "started") return '<span style="color:#044a78;font-weight:700;"><i class="fa-solid fa-flag-checkered"></i> Started</span>';
            return '<span style="color:#9ca3af;">Not started</span>';
          } },
        { title: "Actions", field: "_actions", width: 170, hozAlign: "center", headerHozAlign: "center", headerSort: false,
          formatter: (cell) => actionsHtml(cell.getRow().getData()) },
      ],
    });
  })();
</script>


