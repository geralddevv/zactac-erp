<% layout('/layout/boilerplate') -%>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<body>
  <style>
    #master-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell {
      color: #dc2626 !important;
    }
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell * {
      color: #dc2626 !important;
      text-decoration-color: #dc2626 !important;
    }
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-active,
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-active * { color: #1a7f4b !important; }
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-pending,
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-pending * { color: #b9770e !important; }
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-inactive,
    #master-table .tabulator-row.row-missing-employee-details .tabulator-cell .status-badge-inactive * { color: #c0392b !important; }
  </style>
  <div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
    <div class="indi-head">
      <h1>Employees</h1>
      <div class="download-btns" style="display: flex; gap: 10px; align-items: center">
        <button
          type="button"
          class="header-action-btn"
          onclick="openAddEmployeeDialog()"
          style="
            height: 30px;
            padding: 0 14px;
            background: #f0f0f0;
            color: #044a78;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
          "
        >
          <i class="fa-solid fa-plus"></i>
          <span>Add Employee</span>
        </button>

        <div class="download-selector" id="downloadSelector">
          <button class="download-selector__trigger" style="height: 30px; display: flex; align-items: center; padding: 0 12px; border: 1.5px solid #94a3b8; border-radius: 6px; background: #fff; font-size: 14px; font-weight: 500; cursor: pointer;">
            <span>
              <i class="fa-solid fa-file-arrow-down"></i>
              <span class="download-typo">Download</span>
            </span>
            <i class="fas fa-chevron-down download-selector__trigger-icon" style="font-size: 12px; margin-left: 6px;"></i>
          </button>
          <div class="download-selector__menu" id="downloads">
            <span class="download-selector__option" id="download-pdf">
              <i class="fas fa-file-pdf download-selector__option-icon"></i>
              <span>PDF</span>
            </span>
            <span class="download-selector__option" id="download-xlsx">
              <i class="fas fa-file-excel download-selector__option-icon"></i>
              <span>Excel</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="table-spinner"><div class="spinner-circle"></div></div>
    <div id="master-table" class="tabulator tabulator-modern"></div>
  </div>

  <!-- Tabulator JS -->
  <script src="/js/verification.js"></script>
  <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.20/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

  <script>
      // ================= DOWNLOAD DROPDOWN =================

      const downloadSelector = document.getElementById("downloadSelector");
      const triggerBtn = downloadSelector.querySelector(".download-selector__trigger");

      triggerBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        downloadSelector.classList.toggle("download-selector--active");

        const icon = triggerBtn.querySelector(".download-selector__trigger-icon");
        icon.style.transform = downloadSelector.classList.contains("download-selector--active")
          ? "rotate(180deg)"
          : "rotate(0deg)";
      });

      document.addEventListener("click", () => {
        downloadSelector.classList.remove("download-selector--active");
        const icon = triggerBtn.querySelector(".download-selector__trigger-icon");
        icon.style.transform = "rotate(0deg)";
      });

      downloadSelector
        .querySelector(".download-selector__menu")
        .addEventListener("click", (e) => e.stopPropagation());

      // ================= DATA =================

      const tableData = <%- safeJson(jsonData) %>;

      function isMissingValue(value) {
        return value === null || value === undefined || String(value).trim() === "";
      }

      function formatEmployeeField(value, defaultColor = "#044A78", fontWeight = 500) {
        const missing = isMissingValue(value);
        const displayValue = missing ? "-" : value;
        const color = missing ? "#dc2626" : defaultColor;

        return `
          <span style="font-weight:${fontWeight};color:${color}">
            ${displayValue}
          </span>
        `;
      }

      // ================= TABULATOR =================

      let table;
      const requiredEmployeeFields = [
        "empId",
        "empName",
        "empDateOfJoining",
        "empType",
        "empLoc",
        "empDept",
        "empReportingManager",
        "empProfile",
        "empDob",
        "empGender",
        "empMobile1",
        "empEmergencyNo1",
        "empMartialStatus",
        "empPresentAddress",
        "empPermanentAddress",
        "empAadhaar",
        "empPan",
        "empBankName",
        "empAccountHolderName",
        "empAccNo",
        "empIfscCode",
      ];

      function hasMissingEmployeeDetails(row) {
        return requiredEmployeeFields.some((field) => isMissingValue(row?.[field]));
      }

      function initTable() {
      table = new Tabulator("#master-table", {
        data: tableData,
        height: "100%",
        // layout: "fitColumns",
        columnMinWidth: 120,
        resizableColumns: true,
        movableColumns: true,
        initialSort: [
          { column: "empName", dir: "asc" }
        ],
        rowFormatter: function (row) {
          const rowEl = row.getElement();
          if (hasMissingEmployeeDetails(row.getData())) {
            rowEl.classList.add("row-missing-employee-details");
          } else {
            rowEl.classList.remove("row-missing-employee-details");
          }
        },

        columns: [
          {
            title: "Status",
            field: "isActive",
            width: 110,
            hozAlign: "center",
            headerFilter: "list",
            headerFilterParams: { values: { "": "All", "active": "Active", "pending": "Pending", "inactive": "Inactive" } },
            headerFilterFunc: function(headerValue, rowValue, rowData) {
              if (!headerValue) return true;
              const givenAssets = [rowData.empAssets1, rowData.empAssets2, rowData.empAssets3, rowData.empAssets4].map(a => (a || "").trim()).filter(Boolean);
              const surrendered = new Set((rowData.empAssetsSurrendered || []).map(a => (a || "").trim()).filter(Boolean));
              const pendingAssets = givenAssets.filter(a => !surrendered.has(a)).length;
              const hasPendingBalance = (rowData.loanBalance > 0) || (rowData.advanceBalance > 0);
              const isInactive = rowData.isActive === false;
              if (headerValue === "active") return !isInactive;
              if (headerValue === "pending") return isInactive && (pendingAssets > 0 || hasPendingBalance);
              if (headerValue === "inactive") return isInactive && pendingAssets === 0 && !hasPendingBalance;
              return true;
            },
            formatter: function(cell) {
              const data = cell.getRow().getData();
              const givenAssets = [data.empAssets1, data.empAssets2, data.empAssets3, data.empAssets4].map(a => (a || "").trim()).filter(Boolean);
              const surrendered = new Set((data.empAssetsSurrendered || []).map(a => (a || "").trim()).filter(Boolean));
              const pendingAssets = givenAssets.filter(a => !surrendered.has(a)).length;
              const hasPendingBalance = (data.loanBalance > 0) || (data.advanceBalance > 0);
              const isInactive = data.isActive === false;
              if (!isInactive) return `<span class="status-badge-active" style="background:#e7f7ee;color:#1a7f4b;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:700;">Active</span>`;
              if (pendingAssets > 0 || hasPendingBalance) return `<span class="status-badge-pending" style="background:#fff3e0;color:#b9770e;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:700;">Pending</span>`;
              return `<span class="status-badge-inactive" style="background:#fdecec;color:#c0392b;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:700;">Inactive</span>`;
            }
          },
          {
            title: "Name",
            field: "empName",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              const value = cell.getValue();
              const missing = isMissingValue(value);
              return `
                <span style="font-weight:600;color:${missing ? "#dc2626" : "#044A78"};text-decoration:underline;text-decoration-color:${missing ? "#dc2626" : "#044A78"}">
                  ${missing ? "-" : value}
                </span>${verifiedBadgeFor(cell.getRow().getData(), 16)}
              `;
            },
            cellClick: function (e, cell) {
              const data = cell.getRow().getData();
              window.location.href = `/app/employee/profile/${data._id}`;
            },
          },

          {
            title: "Employee Id",
            field: "empId",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            width: 150,
            formatter: function (cell) {
              return `
                <span style="font-weight:600;font-size:14px;color:${isMissingValue(cell.getValue()) ? "#dc2626" : "#044A78"}">
                  ${isMissingValue(cell.getValue()) ? "-" : cell.getValue()}
                </span>
              `;
            }
          },
          {
            title: "Image",
            field: "empPhoto",
            width: 80,
            hozAlign: "center",
            formatter: function (cell) {
              const data = cell.getRow().getData();
              const hasPhoto = !isMissingValue(data.empPhoto);
              return `
                <i class="fa-solid fa-image"
                   style="font-size:16px;color:${hasPhoto ? '#044A78' : '#94a3b8'}">
                </i>
              `;
            },
            cellClick: function (e, cell) {
              const data = cell.getRow().getData();

              const imgSrc = data.empPhoto
                ? `/images/empimg/${data.empPhoto}`
                : `/images/empimg/${data.empGender === "FEMALE" ? "female.jpg" : "male.jpg"}`;

              openImgModal(imgSrc);
            }
          },
          {
            title: "Reporting Manager",
            field: "empReportingManager",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Office Mobile",
            field: "empOfficeMob",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Personal Mobile",
            field: "empMobile1",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Office Email",
            field: "empOfficeEmailId",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Employee Type",
            field: "empType",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Department",
            field: "empDept",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Profile",
            field: "empProfile",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
          {
            title: "Location",
            field: "empLoc",
            headerFilter: "input",
            headerFilterPlaceholder: "Search",
            formatter: function (cell) {
              return formatEmployeeField(cell.getValue(), "#111827");
            }
          },
        ],
      });
    }

      window.addEventListener("load", initTable);

      // ================= DOWNLOAD =================

      document.getElementById("download-pdf").addEventListener("click", () => {
        if (!table) return;

        table.download("pdf", "employee-data.pdf", {
          orientation: "landscape",
          title: "Employee Data",
        });

        downloadSelector.classList.remove("download-selector--active");
      });

      document.getElementById("download-xlsx").addEventListener("click", () => {
        if (!table) return;

        table.download("xlsx", "employee-data.xlsx", {
          sheetName: "Employees",
        });

        downloadSelector.classList.remove("download-selector--active");
      });
  </script>
  <!-- IMAGE PREVIEW MODAL -->
  <div
    id="imgModal"
    style="
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      justify-content: center;
      align-items: center;
      z-index: 9999;
    "
    onclick="closeImgModal()"
  >
    <img
      id="imgModalSrc"
      style="
        max-width: 90%;
        max-height: 90%;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
        background: #fff;
      "
    />
  </div>

  <script>
    function openImgModal(src) {
      document.getElementById("imgModalSrc").src = src;
      document.getElementById("imgModal").style.display = "flex";
    }

    function closeImgModal() {
      document.getElementById("imgModal").style.display = "none";
    }
  </script>

  <!-- ================= ADD EMPLOYEE DIALOG ================= -->
  <style>
    /* A fixed `height` (not just max-height) keeps the dialog box the same
       size on every tab -- otherwise a step with fewer fields (Banking) has
       less content than one with more (Employment), and with no explicit
       height the box would shrink/grow to fit whichever step is showing. */
    #addEmployeeDialog .ae-dialog {
      width: min(1400px, 98vw);
      height: min(920px, 92vh);
      max-height: 92vh;
      padding: 0;
      border-radius: 18px;
      display: flex;
      flex-direction: column;
      text-align: left;
    }
    /* Scrollbars inside this dialog: the app's own thin navy bar, the same
       one .custom-scrollbar draws on the stock and production pages, instead
       of the OS default.
       Scoped to the dialog rather than hung on a class, because it has more
       than one scroller and they are not all ours to put a class on: the
       body (.ae-body), the stepper strip when a narrow window makes it
       overflow sideways, and the Choices.js dropdown lists, which Choices
       builds itself. `scrollbar-width`/`scrollbar-color` are what Firefox
       reads; the ::-webkit- rules are for Chrome, where this runs. Keep the
       6px and #044A78 in step with the copies on the other pages -- there is
       no shared definition in common.css to change instead. */
    #addEmployeeDialog, #addEmployeeDialog * {
      scrollbar-width: thin;
      scrollbar-color: #044A78 #f1f5f9;
    }
    #addEmployeeDialog::-webkit-scrollbar,
    #addEmployeeDialog ::-webkit-scrollbar { width: 6px; height: 6px; }
    #addEmployeeDialog::-webkit-scrollbar-track,
    #addEmployeeDialog ::-webkit-scrollbar-track { background: #f1f5f9; }
    #addEmployeeDialog::-webkit-scrollbar-thumb,
    #addEmployeeDialog ::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
    #addEmployeeDialog::-webkit-scrollbar-thumb:hover,
    #addEmployeeDialog ::-webkit-scrollbar-thumb:hover { background: #03365a; }

    /* Brand blue with white type, the same bar every other dialog and card
       on the app wears (.dialog-header in the layout, .ap-card-title on the
       production pages): #044A78 behind, #fff in front. Everything else in
       this bar -- subtitle, the icon tile, the close button -- was coloured
       for a white background and is re-tinted off white here rather than left
       slate-on-navy, which is unreadable. No bottom hairline: the colour
       change against the white stepper below is the separation now. */
    #addEmployeeDialog .ae-header {
      background: #044A78;
      padding: 20px 26px;
      border-radius: 18px 18px 0 0;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      flex-shrink: 0;
    }
    #addEmployeeDialog .ae-header-title { display: flex; align-items: center; gap: 14px; }
    #addEmployeeDialog .ae-header-icon {
      width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
      background: rgba(255,255,255,0.14); color: #fff;
      display: flex; align-items: center; justify-content: center; font-size: 18px;
    }
    #addEmployeeDialog .ae-header h2 {
      margin: 0 0 2px;
      color: #fff;
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    #addEmployeeDialog .ae-subtitle { margin: 0; color: rgba(255,255,255,0.78); font-size: 0.86rem; }
    #addEmployeeDialog .ae-close-btn {
      background: rgba(255,255,255,0.14);
      border: none; color: #fff; width: 36px; height: 36px; border-radius: 10px;
      cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
      font-size: 15px; transition: background .15s; flex-shrink: 0;
    }
    #addEmployeeDialog .ae-close-btn:hover { background: rgba(255,255,255,0.28); color: #fff; }

    /* Sits between the header and the scrollable .ae-body as its own flex row
       (flex-shrink: 0), so it can never get carried away by the body's own
       scroll -- the stepper always stays pinned above the fields. The shadow
       is just to make that separation read clearly once the body scrolls.
       common.css has a global bare `.active { background-color: #03365a; }`
       rule -- every element here that carries "active"/"completed" pins its
       own background explicitly so it can never inherit that by accident. */
    #addEmployeeDialog .ae-tabs {
      display: flex; align-items: flex-start; justify-content: center;
      padding: 20px 26px 16px; background: #fff;
      border-bottom: 1px solid #94a3b8; overflow-x: auto; flex-shrink: 0;
      position: relative; z-index: 2; box-shadow: 0 4px 10px -6px rgba(15, 23, 42, 0.1);
    }
    #addEmployeeDialog .ae-step {
      display: flex; flex-direction: column; align-items: center; gap: 8px;
      flex: 0 0 auto; background: transparent; border: none; padding: 0 2px;
      cursor: pointer; -webkit-tap-highlight-color: transparent;
    }
    #addEmployeeDialog .ae-step-circle {
      width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 700; color: #94a3b8;
      background: #fff; border: 2px solid #64748b; transition: all .18s ease;
    }
    #addEmployeeDialog .ae-step-circle .ae-step-check { display: none; font-size: 12px; }
    #addEmployeeDialog .ae-step-label {
      font-size: 11.5px; font-weight: 600; color: #94a3b8; text-align: center;
      white-space: nowrap; transition: color .18s ease;
    }
    #addEmployeeDialog .ae-step:hover .ae-step-circle { border-color: #044A78; color: #044A78; }
    #addEmployeeDialog .ae-step:hover .ae-step-label { color: #044A78; }
    #addEmployeeDialog .ae-step.active { background: transparent; }
    #addEmployeeDialog .ae-step.active .ae-step-circle {
      background: #044A78; border-color: #044A78; color: #fff;
      box-shadow: 0 0 0 4px rgba(4,74,120,0.14);
    }
    #addEmployeeDialog .ae-step.active .ae-step-label { color: #044A78; }
    #addEmployeeDialog .ae-step.completed { background: transparent; }
    #addEmployeeDialog .ae-step.completed .ae-step-circle { background: #044A78; border-color: #044A78; color: #fff; }
    #addEmployeeDialog .ae-step.completed .ae-step-circle .ae-step-num { display: none; }
    #addEmployeeDialog .ae-step.completed .ae-step-circle .ae-step-check { display: inline-flex; }
    #addEmployeeDialog .ae-step.completed .ae-step-label { color: #475569; }

    #addEmployeeDialog .ae-step-line {
      flex: 0 1 60px; min-width: 20px; height: 2px; background: #94a3b8;
      margin-top: 15px; transition: background .18s ease;
    }
    #addEmployeeDialog .ae-step-line.completed { background: #044A78; }

    /* common.css sets a global `form { display: grid; grid-template-columns:
       repeat(32, 1fr); border: 2px solid ...; }` for the old span-N form
       layout -- #addEmployeeForm IS a <form>, so every one of those has to be
       explicitly undone here or the dialog's panels get auto-placed into a
       single ~1/32-width grid column instead of filling the dialog. */
    #addEmployeeDialog .ae-body {
      display: block;
      flex: 1 1 auto;
      overflow-y: auto;
      padding: 24px 26px;
      margin: 0;
      border: none;
      border-radius: 0;
      gap: 0;
    }
    /* common.css has a global bare `.active { background-color: #03365a; }`
       rule (for the nav's active state) -- since the tab panels are also
       toggled with a class named "active", every visible panel silently
       inherited that dark navy fill with nothing here to contest it. */
    #addEmployeeDialog .ae-panel { display: none; background: transparent; }
    #addEmployeeDialog .ae-panel.active { display: block; background: transparent; animation: aeFadeIn .18s ease; }
    @keyframes aeFadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

    /* auto-fit, not auto-fill -- a row that falls short of a full set of
       columns (Banking's 4 fields, Payroll's 7, etc.) stretches to fill the
       row instead of sitting at minmax width with empty track space after it. */
    #addEmployeeDialog .ae-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px 20px; }
    /* auto-fit (not auto-fill) collapses empty tracks and stretches the
       actual fields to fill the row -- with auto-fill the 3 textareas kept
       their minmax width and left the rest of a wide row empty. */
    #addEmployeeDialog .ae-grid-1 { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-top: 18px; }
    /* Exactly 7 equal columns, always one row -- Deductions and Payroll
       Details each have exactly 7 fields and read as one set at a glance. */
    #addEmployeeDialog .ae-grid-7 { grid-template-columns: repeat(7, 1fr); }
    @media (max-width: 900px) {
      #addEmployeeDialog .ae-grid-7 { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }
    }
    #addEmployeeDialog .ae-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    #addEmployeeDialog .ae-field-wide { grid-column: 1 / -1; }
    #addEmployeeDialog .ae-field label { font-size: 12.5px; font-weight: 600; color: #475569; letter-spacing: .01em; }
    #addEmployeeDialog .ae-mandatory-star { color: #ef4444; font-weight: 700; }

    /* tableDisp.css (loaded on this page for the table filters) sets a
       global `input { height: 20px; background-color: #f8f9fa !important;
       flex-grow: 1; ... }` -- with our 10px vertical padding that crushes
       every text/date/number/file input into a broken 20px box, and the
       !important beats a plain background declaration here. Every property
       that rule sets has to be pinned back explicitly (height as a real
       value, background with !important of our own) or the dialog's inputs
       render mangled. */
    #addEmployeeDialog .ae-input, #addEmployeeDialog .ae-select {
      width: 100%; height: auto; padding: 10px 13px; border-radius: 10px; border: 1.5px solid #94a3b8;
      background: #f8fafc !important; font-size: 13.5px; color: #0f172a; transition: all .15s ease;
      font-family: inherit; flex-grow: 0; outline: none;
    }
    #addEmployeeDialog .ae-input:focus, #addEmployeeDialog .ae-select:focus {
      outline: none; border-color: #044A78; background: #fff !important; box-shadow: 0 0 0 4px rgba(4,74,120,0.1);
    }
    #addEmployeeDialog .ae-input-readonly, #addEmployeeDialog .ae-input-readonly:focus {
      background: #eef1f5 !important; color: #64748b; cursor: not-allowed;
    }
    #addEmployeeDialog .ae-textarea { height: auto; resize: none; font-family: inherit; }
    #addEmployeeDialog .ae-select {
      /* common.css's global `select { height: 2.3rem; ... }` rule isn't beaten
         by specificity for a property this block never sets itself -- pin it
         explicitly or selects sit shorter than the text inputs next to them. */
      height: auto;
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E");
      background-repeat: no-repeat; background-position: right 13px center; padding-right: 32px;
    }

    #addEmployeeDialog .field-error { border-color: #dc3545 !important; background-color: #fdf2f3 !important; }
    #addEmployeeDialog .choices.field-error .choices__inner { border-color: #dc3545 !important; background-color: #fdf2f3 !important; }

    #addEmployeeDialog .ae-assets-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }

    #addEmployeeDialog .choices__inner {
      padding: 9px 13px !important; border-radius: 10px !important; border: 1.5px solid #94a3b8 !important;
      background-color: #f8fafc !important; font-size: 13.5px !important; min-height: 0 !important;
    }
    #addEmployeeDialog .choices__list--single { padding: 0 !important; }
    #addEmployeeDialog .choices.is-focused .choices__inner,
    #addEmployeeDialog .choices.is-open .choices__inner {
      border-color: #044A78 !important; background-color: #fff !important; box-shadow: 0 0 0 4px rgba(4,74,120,0.1) !important;
    }
    #addEmployeeDialog .choices__list--dropdown { z-index: 99999 !important; border-radius: 10px !important; border: 1.5px solid #94a3b8 !important; }

    /* ---- Identification -------------------------------------------------
       Employee Photo reads as a profile-picture uploader: a circular avatar
       you click directly (native <label for>), with a small camera badge
       and a floating remove (x). Aadhaar/PAN are click-or-drag dropzones
       sitting right under their own number field, so each document is one
       self-contained block instead of a bare <input type=file> (whose
       unstyled "No file chosen" text never matched the rest of the dialog)
       floating next to an unrelated text field. */
    #addEmployeeDialog .ae-photo-row {
      display: flex; align-items: center; gap: 20px; margin-bottom: 24px;
      padding-bottom: 22px; border-bottom: 1px solid #94a3b8; flex-wrap: wrap;
    }
    /* A plain line, not another boxed card, separates Photo from Biodata --
       same "if any separation, do it with a line" rule used everywhere else. */
    #addEmployeeDialog .ae-photo-row-divider { align-self: stretch; width: 1px; background: #94a3b8; flex-shrink: 0; }
    #addEmployeeDialog .ae-avatar-upload { position: relative; flex-shrink: 0; width: 92px; height: 92px; }
    #addEmployeeDialog .ae-biodata-tile { flex-shrink: 0; }
    #addEmployeeDialog .ae-dropzone-sm { width: 110px; height: 92px; }
    #addEmployeeDialog .ae-dropzone-sm .ae-upload-placeholder { font-size: 18px; }
    #addEmployeeDialog .ae-dropzone-sm .ae-upload-file-chip i { font-size: 20px; }
    #addEmployeeDialog .ae-dropzone-sm .ae-upload-file-chip .ae-file-chip-name { max-width: 96px; font-size: 10px; }
    #addEmployeeDialog .ae-avatar-circle {
      position: relative; display: block; width: 92px; height: 92px; border-radius: 50%;
      overflow: hidden; background: #eef1f5; border: 2px solid #94a3b8; cursor: pointer; transition: border-color .15s;
    }
    #addEmployeeDialog .ae-avatar-circle:hover { border-color: #044A78; }
    #addEmployeeDialog .ae-avatar-circle .ae-upload-placeholder { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 30px; }
    #addEmployeeDialog .ae-avatar-circle .ae-upload-preview { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none; }
    #addEmployeeDialog .ae-avatar-edit-icon {
      position: absolute; right: -2px; bottom: -2px; width: 30px; height: 30px; border-radius: 50%;
      background: #044A78; color: #fff; border: 3px solid #fff; display: flex; align-items: center; justify-content: center;
      font-size: 11px; cursor: pointer; z-index: 1; transition: background .15s;
    }
    #addEmployeeDialog .ae-avatar-edit-icon:hover { background: #0a6cad; }
    #addEmployeeDialog .ae-avatar-remove-btn {
      position: absolute; top: -4px; right: -4px; width: 22px; height: 22px; border-radius: 50%;
      background: #dc3545; color: #fff; border: 2px solid #fff; cursor: pointer;
      display: flex; align-items: center; justify-content: center; font-size: 10px; z-index: 2;
    }
    #addEmployeeDialog .ae-avatar-remove-btn:hover { background: #b91c2c; }
    #addEmployeeDialog .ae-avatar-info { display: flex; flex-direction: column; gap: 4px; }
    #addEmployeeDialog .ae-avatar-info .ae-doc-title { font-size: 13.5px; }

    /* A plain line divides Aadhaar from PAN instead of boxing each one in
       its own bordered/filled card -- separation without adding weight. */
    #addEmployeeDialog .ae-doc-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0 32px;
    }
    #addEmployeeDialog .ae-doc-card {
      display: flex; flex-direction: column; gap: 10px; padding: 0;
      border: none; background: transparent;
    }
    #addEmployeeDialog .ae-doc-card + .ae-doc-card { border-left: 1px solid #94a3b8; padding-left: 32px; }
    #addEmployeeDialog .ae-doc-title { font-size: 12.5px; font-weight: 700; color: #0f172a; }

    @media (max-width: 720px) {
      #addEmployeeDialog .ae-doc-card + .ae-doc-card {
        border-left: none; border-top: 1px solid #94a3b8; padding-left: 0; padding-top: 18px;
      }
    }

    #addEmployeeDialog .ae-dropzone-wrap { position: relative; }
    #addEmployeeDialog .ae-dropzone {
      position: relative; height: 110px; border-radius: 12px; border: 1.5px dashed #64748b;
      background: #fff; display: flex; align-items: center; justify-content: center; overflow: hidden;
      cursor: pointer; transition: border-color .15s, background .15s;
    }
    #addEmployeeDialog .ae-dropzone:hover, #addEmployeeDialog .ae-dropzone:focus-visible {
      border-color: #044A78; background: #f0f6fb; outline: none;
    }
    #addEmployeeDialog .ae-dropzone.is-dragover { border-color: #044A78; background: #e6f0f8; }
    #addEmployeeDialog .ae-dropzone .ae-upload-placeholder {
      position: static; display: flex; flex-direction: column; align-items: center; gap: 6px;
      color: #94a3b8; font-size: 20px; pointer-events: none;
    }
    #addEmployeeDialog .ae-dropzone .ae-upload-placeholder span { font-size: 11px; font-weight: 600; }
    #addEmployeeDialog .ae-dropzone .ae-upload-preview {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none;
    }
    /* Non-image files (a Biodata PDF) can't get a thumbnail -- this chip
       (icon + filename) stands in for the preview instead. */
    #addEmployeeDialog .ae-upload-file-chip {
      display: none; flex-direction: column; align-items: center; gap: 6px;
      color: #044A78; padding: 0 12px; pointer-events: none;
    }
    #addEmployeeDialog .ae-upload-file-chip i { font-size: 24px; }
    #addEmployeeDialog .ae-upload-file-chip .ae-file-chip-name {
      font-size: 11px; font-weight: 600; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    #addEmployeeDialog .ae-dropzone-remove {
      position: absolute; top: 8px; right: 8px; width: 26px; height: 26px; border-radius: 8px; border: none;
      background: rgba(15,23,42,0.65); color: #fff; display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 11px; transition: background .15s; z-index: 2;
    }
    #addEmployeeDialog .ae-dropzone-remove:hover { background: #dc3545; }

    /* Visually hidden but still focusable/keyboard-operable -- the avatar
       circle / dropzone above is what actually looks clickable. */
    #addEmployeeDialog .ae-file-input-hidden {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }
    #addEmployeeDialog .ae-upload-hint { font-size: 11px; color: #94a3b8; }

    #addEmployeeDialog .ae-section-label {
      font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #044A78;
      margin: 22px 0 12px; padding-bottom: 8px; border-bottom: 1.5px solid #94a3b8;
    }
    #addEmployeeDialog .ae-panel .ae-section-label:first-child { margin-top: 0; }

    #addEmployeeDialog .ae-dependents-header {
      display: none; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px;
      padding: 0 12px 6px; font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: .04em; color: #64748b;
    }
    #addEmployeeDialog .ae-dependents-list { display: flex; flex-direction: column; gap: 10px; }
    #addEmployeeDialog .ae-dependent-row {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px;
      padding: 12px; border: 1.5px solid #94a3b8; border-radius: 12px; background: #f8fafc;
    }

    #addEmployeeDialog .ae-footer {
      flex-shrink: 0; display: flex; align-items: center; justify-content: flex-end; gap: 10px;
      padding: 16px 26px; border-top: 1px solid #94a3b8; border-radius: 0 0 18px 18px; background: #fff;
    }
    #addEmployeeDialog .ae-btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 10px;
      font-size: 13.5px; font-weight: 600; cursor: pointer; border: 1.5px solid transparent; transition: all .15s ease;
    }
    #addEmployeeDialog .ae-btn-ghost { background: #fff; color: #475569; border-color: #94a3b8; }
    #addEmployeeDialog .ae-btn-ghost:hover { background: #f1f5f9; }
    /* Back on step 1 and Next on the last step are disabled, not hidden (see
       the footer markup), so they need a spent-looking state of their own --
       the :disabled rule below only covers .ae-btn-primary. The :hover above
       is undone too, or a dead button still lights up under the pointer and
       reads as clickable. */
    #addEmployeeDialog .ae-btn-ghost:disabled,
    #addEmployeeDialog .ae-btn-ghost:disabled:hover {
      background: #fff; color: #cbd5e1; border-color: #eef2f6;
      cursor: not-allowed; opacity: 1;
    }
    /* Flat, no hover lift/glow -- matches the plain .btn-grp submit buttons
       used everywhere else in the app (common.css), not a one-off style. */
    #addEmployeeDialog .ae-btn-primary { background: #044A78; color: #fff; transition: none; }
    #addEmployeeDialog .ae-btn-primary:disabled { opacity: .7; cursor: not-allowed; }
    /* Save Employee is hidden with the `hidden` property until the last step
       (see aeSwitchTab). The browser's own `[hidden] { display: none }` is a
       bare type-less rule, so .ae-btn's `display: inline-flex` above -- an id
       plus two classes -- outranks it and the button would stay on screen.
       This rule puts it back, and has to keep beating .ae-btn to do it. */
    #addEmployeeDialog .ae-btn[hidden] { display: none; }

    @media (max-width: 720px) {
      #addEmployeeDialog .ae-dialog { height: 95vh; max-height: 95vh; }
      #addEmployeeDialog .ae-header { padding: 16px 18px; }
      #addEmployeeDialog .ae-body { padding: 18px; }
      #addEmployeeDialog .ae-footer { padding: 14px 18px; flex-wrap: wrap; }
    }

    #aeInactiveModal.show { z-index: 10050; }
    /* .dialog-header/.dialog-body/.dialog-field-label/.dialog-actions aren't
       global classes -- other pages (e.g. coreMaster.ejs) define their own
       copies locally, so this dialog needs its own too or it renders bare. */
    #aeInactiveModal .logout-dialog { padding: 0; }
    #aeInactiveModal .dialog-header {
      background: #044A78; padding: 18px 22px;
    }
    #aeInactiveModal .dialog-header h2 { margin: 0; color: #fff; }
    #aeInactiveModal .dialog-body { padding: 22px; }
    #aeInactiveModal .dialog-field-label { display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 8px; }
    #aeInactiveModal .dialog-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
    #aeInactiveModal .ae-asset-checkboxes { display: flex; flex-wrap: wrap; gap: 8px 16px; padding: 6px 2px; }
    #aeInactiveModal .ae-asset-checkboxes label { display: flex; align-items: center; gap: 6px; font-size: .92rem; cursor: pointer; }
    #aeInactiveModal .ae-no-assets { color: #5b6b7a; font-style: italic; font-size: .9rem; }
  </style>

  <div class="logout-modal" id="addEmployeeDialog" aria-hidden="true">
    <div class="logout-dialog ae-dialog" role="dialog" aria-modal="true" aria-labelledby="addEmployeeDialogTitle">
      <div class="ae-header">
        <div class="ae-header-title">
          <div class="ae-header-icon"><i class="fa-solid fa-user-plus"></i></div>
          <div>
            <h2 id="addEmployeeDialogTitle">Add Employee</h2>
            <p class="ae-subtitle">Onboard a new team member — fill in the sections below.</p>
          </div>
        </div>
        <button type="button" class="ae-close-btn" onclick="closeAddEmployeeDialog()" aria-label="Close">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="ae-tabs" id="aeTabs">
        <button type="button" class="ae-step active" data-tab="employment">
          <span class="ae-step-circle"><span class="ae-step-num">1</span><i class="fa-solid fa-check ae-step-check"></i></span>
          <span class="ae-step-label">Employment</span>
        </button>
        <div class="ae-step-line" data-line="1"></div>
        <button type="button" class="ae-step" data-tab="personal">
          <span class="ae-step-circle"><span class="ae-step-num">2</span><i class="fa-solid fa-check ae-step-check"></i></span>
          <span class="ae-step-label">Personal</span>
        </button>
        <div class="ae-step-line" data-line="2"></div>
        <button type="button" class="ae-step" data-tab="identification">
          <span class="ae-step-circle"><span class="ae-step-num">3</span><i class="fa-solid fa-check ae-step-check"></i></span>
          <span class="ae-step-label">Identification</span>
        </button>
        <div class="ae-step-line" data-line="3"></div>
        <button type="button" class="ae-step" data-tab="banking">
          <span class="ae-step-circle"><span class="ae-step-num">4</span><i class="fa-solid fa-check ae-step-check"></i></span>
          <span class="ae-step-label">Banking</span>
        </button>
        <div class="ae-step-line" data-line="4"></div>
        <button type="button" class="ae-step" data-tab="payroll">
          <span class="ae-step-circle"><span class="ae-step-num">5</span><i class="fa-solid fa-check ae-step-check"></i></span>
          <span class="ae-step-label">Deductions &amp; Payroll</span>
        </button>
        <div class="ae-step-line" data-line="5"></div>
        <button type="button" class="ae-step" data-tab="dependents">
          <span class="ae-step-circle"><span class="ae-step-num">6</span><i class="fa-solid fa-check ae-step-check"></i></span>
          <span class="ae-step-label">Dependents</span>
        </button>
      </div>

      <form id="addEmployeeForm" class="ae-body" method="post" enctype="multipart/form-data" action="/app/employee/form" novalidate>

        <!-- ===== EMPLOYMENT ===== -->
        <div class="ae-panel active" data-panel="employment">
          <div class="ae-grid">
            <div class="ae-field">
              <label for="ae-emp-id">Employee ID</label>
              <input type="text" id="ae-emp-id" class="ae-input ae-input-readonly" name="empId"
                value="<%= `FS | EMPLOYEE | ${employeeCount.toString().padStart(3,'0')}` %>" readonly tabindex="-1">
            </div>
            <div class="ae-field">
              <label for="ae-date-of-joining">Date of Joining</label>
              <input type="date" id="ae-date-of-joining" class="ae-input" name="empDateOfJoining" required>
            </div>
            <div class="ae-field">
              <label for="ae-emp-type">Employee Type</label>
              <select id="ae-emp-type" class="ae-input ae-select" name="empType">
                <option value="" disabled selected hidden>Select</option>
                <option value="SKILLED">SKILLED</option>
                <option value="UNSKILLED">UNSKILLED</option>
              </select>
            </div>
            <div class="ae-field">
              <label for="ae-emp-under">Under</label>
              <select id="ae-emp-under" class="ae-input ae-select" name="empUnder" required>
                <option value="" disabled selected hidden>Select</option>
                <option value="TECH">TECH</option>
                <option value="TAGS">TAGS</option>
                <option value="SACHIKO">SACHIKO</option>
                <option value="CONTRACT">CONTRACT</option>
                <option value="ZACTAC">ZACTAC</option>
              </select>
            </div>
            <div class="ae-field">
              <label for="ae-emp-loc">Location</label>
              <select id="ae-emp-loc" class="ae-input ae-select" name="empLoc" required>
                <option value="" disabled selected hidden>Select</option>
                <% (locationNames || []).forEach(name => { %>
                  <option value="<%= name %>"><%= name %></option>
                <% }) %>
              </select>
            </div>
            <div class="ae-field">
              <label for="ae-emp-status">Status</label>
              <select id="ae-emp-status" class="ae-input ae-select" name="status">
                <option value="active" selected>Active</option>
                <option value="inactive">Inactive</option>
              </select>
              <input type="hidden" name="empInactiveReason" id="aeEmpInactiveReason" value="">
              <input type="hidden" name="empAssetsSurrenderedJson" id="aeEmpAssetsSurrenderedJson" value="[]">
            </div>
            <div class="ae-field">
              <label for="ae-emp-dept">Department</label>
              <input type="text" id="ae-emp-dept" class="ae-input" name="empDept" placeholder="Enter Department" autocomplete="off" required>
            </div>
            <div class="ae-field">
              <label for="ae-emp-reporting-manager">Reporting Manager</label>
              <%
                const AE_TOP_OF_HIERARCHY = "PROPRIETOR / DIRECTOR";
                const aeManagerNames = (managerEmployees || []).map(e => e?.empName).filter(Boolean);
                const aeTopSelected = !aeManagerNames.length;
              %>
              <select id="ae-emp-reporting-manager" class="ae-input ae-select" name="empReportingManager" required>
                <option value="" disabled <%= aeTopSelected ? '' : 'selected' %> hidden>Select</option>
                <option value="<%= AE_TOP_OF_HIERARCHY %>" <%= aeTopSelected ? 'selected' : '' %>><%= AE_TOP_OF_HIERARCHY %></option>
                <% aeManagerNames.forEach(name => { %>
                  <option value="<%= name %>"><%= name %></option>
                <% }) %>
              </select>
            </div>
            <div class="ae-field">
              <label for="ae-emp-profile">Profile</label>
              <input type="text" id="ae-emp-profile" class="ae-input" name="empProfile" placeholder="Enter Profile" autocomplete="off" required>
            </div>
            <div class="ae-field">
              <label for="ae-emp-profile-code">Profile Code</label>
              <input type="text" id="ae-emp-profile-code" class="ae-input" name="empProfileCode" placeholder="Enter Profile Code" autocomplete="off">
              <select id="ae-emp-profile-code-select" class="ae-input ae-select" name="empProfileCode" style="display:none;" disabled>
                <option value="" disabled selected hidden>Select Machine</option>
                <% (machineNames || []).forEach(name => { %>
                  <option value="<%= name %>"><%= name %></option>
                <% }) %>
              </select>
            </div>
            <div class="ae-field">
              <label for="ae-emp-office-mob">Office Mobile No</label>
              <input type="text" inputmode="numeric" id="ae-emp-office-mob" class="ae-input" name="empOfficeMob" placeholder="Enter Office Mobile No" autocomplete="off">
            </div>
            <div class="ae-field">
              <label for="ae-emp-office-email">Office Email ID</label>
              <input type="email" id="ae-emp-office-email" class="ae-input" name="empOfficeEmailId" placeholder="Enter Office Email ID" autocomplete="off">
            </div>
            <div class="ae-field ae-field-wide">
              <label>Assets</label>
              <div class="ae-assets-row">
                <input type="text" name="empAssets1" placeholder="Asset 1" class="ae-input">
                <input type="text" name="empAssets2" placeholder="Asset 2" class="ae-input">
                <input type="text" name="empAssets3" placeholder="Asset 3" class="ae-input">
                <input type="text" name="empAssets4" placeholder="Asset 4" class="ae-input">
              </div>
            </div>
          </div>
        </div>

        <!-- ===== PERSONAL ===== -->
        <div class="ae-panel" data-panel="personal">
          <div class="ae-grid">
            <div class="ae-field">
              <label for="ae-emp-name">Name</label>
              <input type="text" id="ae-emp-name" class="ae-input" name="empName" placeholder="Enter Name" autocomplete="off" required>
            </div>
            <div class="ae-field">
              <label for="ae-emp-nick-name">Nick Name</label>
              <input type="text" id="ae-emp-nick-name" class="ae-input" name="empNickName" placeholder="Enter Nick Name" autocomplete="off" required>
            </div>
            <div class="ae-field">
              <label for="ae-emp-dob">D.O.B</label>
              <input type="date" id="ae-emp-dob" class="ae-input" name="empDob" required>
            </div>
            <div class="ae-field">
              <label for="ae-emp-gender">Gender</label>
              <select id="ae-emp-gender" class="ae-input ae-select" name="empGender" required>
                <option value="" disabled selected hidden>Select</option>
                <option value="MALE">MALE</option>
                <option value="FEMALE">FEMALE</option>
              </select>
            </div>
            <div class="ae-field">
              <label for="ae-emp-mobile1">Mobile No 1</label>
              <input type="text" inputmode="numeric" id="ae-emp-mobile1" class="ae-input" name="empMobile1" placeholder="Enter Mobile No 1" autocomplete="off" required>
            </div>
            <div class="ae-field">
              <label for="ae-emp-mobile2">Mobile No 2</label>
              <input type="text" inputmode="numeric" id="ae-emp-mobile2" class="ae-input" name="empMobile2" placeholder="Enter Mobile No 2" autocomplete="off">
            </div>
            <div class="ae-field">
              <label for="ae-emp-emergency-no1">Emergency No 1</label>
              <input type="text" inputmode="numeric" id="ae-emp-emergency-no1" class="ae-input" name="empEmergencyNo1" placeholder="Enter Emergency No" autocomplete="off" required>
            </div>
            <div class="ae-field">
              <label for="ae-emp-emergency-no2">Emergency No 2</label>
              <input type="text" inputmode="numeric" id="ae-emp-emergency-no2" class="ae-input" name="empEmergencyNo2" placeholder="Enter Emergency No" autocomplete="off">
            </div>
            <div class="ae-field">
              <label for="ae-emp-email">Email</label>
              <input type="text" id="ae-emp-email" class="ae-input" name="empEmail" placeholder="Enter Email or NA" autocomplete="off">
            </div>
            <div class="ae-field">
              <label for="ae-emp-martial-status">Marital Status</label>
              <select id="ae-emp-martial-status" class="ae-input ae-select" name="empMartialStatus" required>
                <option value="" disabled selected hidden>Select</option>
                <option value="SINGLE">SINGLE</option>
                <option value="MARRIED">MARRIED</option>
              </select>
            </div>
            <div class="ae-field" id="aeMarriageAnnivField" style="display:none;">
