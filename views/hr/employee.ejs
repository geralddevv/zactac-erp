<script>
document.addEventListener("DOMContentLoaded", () => {
  const statusSelect     = document.getElementById("emp-status");
  const inactiveModal    = document.getElementById("inactiveModal");
  const reasonInput      = document.getElementById("inactiveReasonInput");
  const reasonError      = document.getElementById("inactiveReasonError");
  const assetCheckboxes  = document.getElementById("assetCheckboxes");
  const hiddenReason     = document.getElementById("empInactiveReason");
  const hiddenSurrender  = document.getElementById("empAssetsSurrenderedJson");
  const confirmBtn       = document.getElementById("inactiveConfirmBtn");
  const cancelBtn        = document.getElementById("inactiveCancelBtn");
  if (!statusSelect || !inactiveModal) return;

  const assetFields = ["empAssets1", "empAssets2", "empAssets3", "empAssets4"];
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  function currentAssets() {
    return assetFields
      .map((n) => (document.querySelector(`[name="${n}"]`)?.value || "").trim())
      .filter(Boolean);
  }

  function parseSurrendered() {
    try { const a = JSON.parse(hiddenSurrender.value || "[]"); return Array.isArray(a) ? a : []; }
    catch { return []; }
  }

  function openModal() {
    reasonInput.value = hiddenReason.value || "";
    reasonError.style.display = "none";
    const already = new Set(parseSurrendered());
    const assets = currentAssets();
    assetCheckboxes.innerHTML = assets.length
      ? assets.map((a) => `<label><input type="checkbox" value="${esc(a)}" ${already.has(a) ? "checked" : ""}/> <span>${esc(a)}</span></label>`).join("")
      : `<span class="no-assets">No assets recorded for this employee.</span>`;
    inactiveModal.style.display = "flex";
    reasonInput.focus();
  }

  function closeModal() { inactiveModal.style.display = "none"; }

  function clearInactiveData() {
    hiddenReason.value = "";
    hiddenSurrender.value = "[]";
  }

  function revertToActive() {
    statusSelect.value = "active";
    clearInactiveData();
    closeModal();
  }

  statusSelect.addEventListener("change", () => {
    if (statusSelect.value === "inactive") openModal();
    else clearInactiveData();
  });

  confirmBtn.addEventListener("click", () => {
    const reason = reasonInput.value.trim();
    if (!reason) { reasonError.style.display = "block"; reasonInput.focus(); return; }
    hiddenReason.value = reason;
    const checked = Array.from(assetCheckboxes.querySelectorAll('input[type="checkbox"]:checked')).map((cb) => cb.value);
    hiddenSurrender.value = JSON.stringify(checked);
    closeModal();
  });

  cancelBtn.addEventListener("click", revertToActive);
  inactiveModal.addEventListener("click", (e) => { if (e.target === inactiveModal) revertToActive(); });
});
</script>

