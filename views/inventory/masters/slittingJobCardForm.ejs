<% layout('/layout/boilerplate') %>

<%
  // Stage 2 of slitting, and the only place it moves stock. The planner has
  // already fixed everything (machine, operator, helper, Deckles, roll widths,
  // planned metres) on /sachiko/slitting/allocate/:pendingId -- so nothing
  // here is a picker. The operator scans a Deckle to confirm the physical
  // reel, punches Start, punches Stop, and confirms the metres that actually
  // ran; that Stop inwards the row's finished rolls and draws the metres off
  // the Deckle.
  const isEmpty = (v) => v === undefined || v === null || (typeof v === "string" && v.trim() === "");
  const dash = (v) => (isEmpty(v) ? "—" : v);
  const fmtN = (v) => (Number.isFinite(Number(v)) && !isEmpty(v) ? Number(v).toLocaleString("en-IN") : "—");
  const cardDate = card.date ? new Date(card.date).toLocaleDateString("en-GB") : "—";
  const pendingCount = (card.rows || []).filter((r) => r.status !== "done").length;
  // R. Meter is fixed per Deckle at allocation (every row on this card
  // shares it, same Deckle-group), so the first row's is the card's -- Rolls
  // is the total finished rolls every row will produce once run.
  const plannedRunningMeter = card.rows && card.rows[0] ? card.rows[0].plannedRunningMeter : null;
  const totalPlannedRolls = (card.rows || []).reduce((n, r) => n + (r.cuts || []).length, 0);
%>

<style>
  .span-full { padding: 0 !important; }
  .span-full.form-heading, .span-full.form-subheading { padding: 10px !important; }
  .sl-panel { align-self: stretch; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
  .sl-head-chip {
    background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.3); color: #fff;
    font-size: 12.5px; font-weight: 700; padding: 3px 11px; border-radius: 999px; white-space: nowrap;
  }
  .sl-mini-btn {
    display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(255,255,255,0.55);
    background: transparent; color: #fff; border-radius: 6px; padding: 5px 11px;
    font-size: 12.5px; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .sl-mini-btn:hover { background: rgba(255,255,255,0.14); }

  .sl-job-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; background: #e2e8f0; }
  .sl-job-cell { background: #f8fafc; padding: 11px 14px; display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .sl-job-label {
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: #7c8ba1; white-space: nowrap;
  }
  .sl-job-value { font-size: 15px; font-weight: 800; color: #1f2a44; line-height: 1.3; overflow-wrap: anywhere; }

  /* ---- Job Setting: setup Start/Stop readings before the first Deckle is
     cut -- same shape as the lamination Job Card's own Job Setting table
     (views/inventory/masters/jobCardForm.ejs), themed to this page's colors. */
  .sl-js-table { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
  .sl-js-table th {
    background: #044a78; color: #fff; font-size: 11.5px; font-weight: 600; padding: 8px 10px;
    text-align: left; border-right: 1px solid rgba(255,255,255,0.22); white-space: nowrap;
  }
  .sl-js-table th:last-child { border-right: none; }
  .sl-js-table td {
    padding: 6px 8px; border-bottom: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;
    font-size: 12.5px; vertical-align: middle;
  }
  .sl-js-table td:last-child { border-right: none; }
  .sl-js-table tbody tr:last-child td { border-bottom: none; }
  .sl-js-table input.form-control {
    height: 32px !important; font-size: 12.5px !important; padding: 4px 8px !important;
    border-radius: 6px !important; border: 1px solid #cbd5e1 !important; width: 100%;
  }
  .sl-js-table input.form-control:focus { outline: none; border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4,74,120,0.12); }
  .sl-js-table input.form-control[readonly] { background: #f8fafc; color: #64748b; }
  .sl-js-counter-btn {
    width: 28px; height: 28px; border: 1px solid #044a78; background: #fff; color: #044a78;
    border-radius: 6px; font-size: 16px; line-height: 1; cursor: pointer;
  }
  .sl-js-count { width: 48px !important; height: 28px !important; text-align: center; }
  .sl-js-btn {
    width: 30px; height: 26px; padding: 0; font-size: 11px; border: none; border-radius: 5px;
    cursor: not-allowed; background: #cbd5e1; color: #fff; display: inline-flex;
    align-items: center; justify-content: center; flex-shrink: 0;
  }
  .sl-hidden { display: none !important; }

  /* ---- Scan strip ------------------------------------------------------ */
  .sl-scan-wrap {
    align-self: stretch; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 14px;
  }
  .sl-scan-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #7c8ba1;
  }
  .sl-scan-field { flex: 1 1 260px; display: flex; align-items: center; gap: 8px; min-width: 0; }
  .sl-scan-field input.form-control {
    flex: 1 1 auto; min-width: 0; height: 40px !important; font-size: 14px !important;
    padding: 6px 12px !important; border-radius: 8px !important; border: 1px solid #cbd5e1 !important;
  }
  .sl-scan-field input.form-control:focus { outline: none; border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4,74,120,0.12); }
  .sl-scan-btn {
    flex: 0 0 auto; height: 40px; width: 44px; border: 1px solid #044a78; background: #044a78; color: #fff;
    border-radius: 8px; font-size: 15px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
  }
  .sl-scan-btn:hover { background: #03365a; }
  .sl-scan-msg { flex: 1 1 100%; font-size: 12.5px; font-weight: 600; color: #64748b; }
  .sl-scan-msg.sl-bad { color: #b91c1c; }
  .sl-scan-msg.sl-ok { color: #15803d; }

  /* ---- Production Log: one row per allocated Deckle, same visual language
     as the lamination Job Card's own Production Log table (jc-log-table). -- */
  .sl-log-table { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
  .sl-log-table th {
    background: #044a78; color: #fff; font-size: 11.5px; font-weight: 600; padding: 8px 10px;
    text-align: center; border-right: 1px solid rgba(255,255,255,0.22); white-space: nowrap;
  }
  .sl-log-table th:last-child { border-right: none; }
  .sl-log-table th.group-head { border-bottom: 1px solid rgba(255,255,255,0.3); }
  .sl-log-table th.sub-head { background: #055690; font-size: 11.5px; font-weight: 500; padding: 5px 6px; }
  .sl-log-table td {
    padding: 7px 8px; border-bottom: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;
    font-size: 12.5px; font-variant-numeric: tabular-nums; vertical-align: middle;
  }
  .sl-log-table td:last-child { border-right: none; }
  .sl-log-table tbody tr:last-child td { border-bottom: none; }
  .sl-log-table tbody tr.is-running td { background: #fffbeb; }
  .sl-log-table tbody tr.is-curing td { background: #fffbf3; }
  /* Scanned and confirmed, waiting on Start. With no Status column left,
     this tint (plus the Start button going live) is what says so. */
  .sl-log-table tbody tr.is-armed td { background: #f4f9ff; }
  .sl-log-table input.sl-start-mtrs,
  .sl-log-table input.sl-stop-mtrs,
  .sl-log-table input.sl-row-jointmtr,
  .sl-log-table select.sl-row-joint {
    height: 28px !important; font-size: 12px !important; padding: 3px 6px !important; width: 100%;
    border-radius: 5px !important; border: 1px solid #cbd5e1 !important;
  }
  .sl-log-table input.sl-start-mtrs:focus,
  .sl-log-table input.sl-stop-mtrs:focus,
  .sl-log-table input.sl-row-jointmtr:focus,
  .sl-log-table select.sl-row-joint:focus { outline: none; border-color: #044a78 !important; box-shadow: 0 0 0 2px rgba(4,74,120,0.12); }
  .sl-log-table input.sl-start-mtrs[readonly] { background: #f8fafc; color: #64748b; }
  /* Already-entered rows -- read-only, same treatment as the lamination Job
     Card's own jc-row-readonly, themed to this page's colors. */
  .sl-row-readonly td { background: #f8fdfa; }
  .sl-row-edit-cell { text-align: center; width: 44px; }
  .sl-row-edit-btn {
    width: 28px; height: 26px; padding: 0; border: 1px solid #044a78; background: #fff; color: #044a78;
    border-radius: 4px; font-size: 11px; cursor: pointer; display: inline-flex;
    align-items: center; justify-content: center;
  }
  .sl-row-edit-btn:hover { background: #044a78; color: #fff; }
  .sl-row-edit-btn.editing { background: #10b981; border-color: #10b981; color: #fff; }
  .sl-joint-cell input.form-control {
    height: 26px !important; font-size: 11.5px !important; padding: 2px 6px !important;
    width: 68px; display: inline-block;
  }
  .sl-log-btn {
    width: 30px; height: 26px; padding: 0; font-size: 11px; border: none; border-radius: 5px;
    cursor: not-allowed; background: #cbd5e1; color: #fff; display: inline-flex;
    align-items: center; justify-content: center; flex-shrink: 0;
  }
  .sl-log-btn.is-start:not(:disabled) { background: #10b981; cursor: pointer; }
  .sl-log-btn.is-stop:not(:disabled) { background: #dc2626; cursor: pointer; }

  /* ---- Requirement (read-only) ----------------------------------------- */
  .sl-req-table { width: 100%; border-collapse: separate; border-spacing: 0; }
  .sl-req-table th {
    background: #044a78; color: #fff; font-size: 11.5px; font-weight: 600; padding: 7px 10px;
    text-align: left; border-right: 1px solid rgba(255,255,255,0.22); white-space: nowrap;
  }
  .sl-req-table th:last-child { border-right: none; }
  .sl-req-table td {
    padding: 7px 10px; border-bottom: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;
    font-size: 12.5px; font-weight: 700; color: #1f2a44; font-variant-numeric: tabular-nums;
  }
  .sl-req-table td:last-child { border-right: none; }
  .sl-req-table tbody tr:last-child td { border-bottom: none; }

  /* Web view: A..L drawn to scale across the Deckle's web, same look as the
     allocation page's own strip (views/inventory/masters/slittingAllocation.ejs)
     -- just read-only here, off the roll widths already fixed at allocation. */
  .sl-web-sub td {
    background: #f8fafc !important; padding: 8px 10px 10px !important;
    text-align: left !important; border-bottom: 1px solid #e2e8f0 !important;
  }
  .sl-web-caption {
    display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;
    max-width: 960px; margin: 0 auto 5px;
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #7c8ba1;
  }
  .sl-web-flag { text-transform: none; letter-spacing: 0; font-size: 11px; font-weight: 700; }
  .sl-web-flag.sl-bad { color: #b91c1c; }
  .sl-web-flag.sl-ok { color: #15803d; }
  .sl-web {
    display: flex; align-items: stretch; height: 32px; width: 100%; max-width: 960px; margin: 0 auto;
    border: 1px solid #cbd5e1; border-radius: 7px; overflow: hidden; background: #fff;
  }
  .sl-web.is-over { border-color: #ef4444; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.15); }
  .sl-web-seg {
    flex-basis: 0; min-width: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 1px;
    border-right: 1px solid #fff; overflow: hidden; white-space: nowrap;
    background: #16a34a; color: #fff;
  }
  .sl-web-seg:nth-child(even) { background: #15803d; }
  .sl-web-seg:last-child { border-right: none; }
  .sl-web-seg .sl-seg-slot { font-size: 9px; font-weight: 700; opacity: 0.8; letter-spacing: 0.06em; }
  .sl-web-seg .sl-seg-w { font-size: 11.5px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .sl-web-seg.sl-web-trim { background: #dc2626; color: #fff; }
  .sl-web-seg.sl-web-edge { background: #f97316; color: #fff; }
  .sl-web-empty {
    display: flex; align-items: center; justify-content: center; width: 100%; height: 32px;
    max-width: 960px; margin: 0 auto;
    font-size: 11.5px; font-weight: 600; color: #94a3b8;
    background: repeating-linear-gradient(45deg, #f1f5f9, #f1f5f9 6px, #f8fafc 6px, #f8fafc 12px);
    border: 1px solid #e2e8f0; border-radius: 7px;
  }

  .sl-done-note {
    align-self: stretch; background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46;
    border-radius: 10px; padding: 14px 16px; font-size: 13.5px; font-weight: 700; line-height: 1.6;
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .sl-done-note a { color: #065f46; font-weight: 800; }

  /* ---- Stop dialog ------------------------------------------------------ */
  .dialog-header {
    background: #044a78; padding: 16px 20px; display: flex; align-items: center;
    justify-content: space-between; border-radius: 14px 14px 0 0;
  }
  .dialog-header h2 { margin: 0; font-size: 1rem; font-weight: 700; color: #fff; }
  .dialog-close-btn {
    background: none; border: none; color: #fff; font-size: 26px; cursor: pointer;
    line-height: 1; width: 38px; height: 38px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 8px; opacity: 0.85; transition: opacity 0.15s, background 0.15s;
  }
  .dialog-close-btn:hover { opacity: 1; background: rgba(255, 255, 255, 0.18); }
  .dialog-body { padding: 18px 20px; background: #fff; border-radius: 0 0 14px 14px; }
  .sl-dlg-plan {
    font-size: 13px; font-weight: 600; color: #1f2a44; line-height: 1.6; margin: 0 0 6px;
  }
  .sl-dlg-err { display: none; color: #b91c1c; font-size: 12.5px; font-weight: 700; margin-top: 4px; }
  .sl-dlg-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }
  .sl-dlg-btn {
    border-radius: 8px; padding: 10px 18px; font-size: 13.5px; font-weight: 700; cursor: pointer;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .sl-dlg-btn.is-ghost { background: #fff; border: 1px solid #cbd5e1; color: #64748b; }
  .sl-dlg-btn.is-primary { background: #044a78; border: 1px solid #044a78; color: #fff; }
  .sl-dlg-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  #scanVideo { width: 100%; border-radius: 10px; background: #000; aspect-ratio: 4 / 3; object-fit: cover; }
  .sl-scan-status { margin-top: 10px; font-size: 12.5px; font-weight: 600; color: #64748b; text-align: center; }
  .sl-scan-status.sl-bad { color: #b91c1c; }

  @media screen and (max-width: 768px) {
    .sl-job-grid { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
  }
</style>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px">
  <div class="span-full form-heading" style="display:flex; flex-direction:row; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
    <h1>Slitting Job Card</h1>
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
      <span class="sl-head-chip"><%= card.slittingJobCardId %></span>
      <span class="sl-head-chip"><%= dash(card.machineName) %></span>
    </div>
  </div>

  <!-- Everything here was fixed at allocation. Nothing on this page is a
       picker -- the operator only confirms the reel and punches the clock. -->
  <div class="span-full" style="border:none !important;">
    <div class="sl-panel">
      <div class="sl-job-grid">
        <div class="sl-job-cell">
          <span class="sl-job-label">Date</span>
          <span class="sl-job-value"><%= cardDate %></span>
        </div>
        <div class="sl-job-cell">
          <span class="sl-job-label">Product Code</span>
          <span class="sl-job-value"><%= dash(card.productCode) %></span>
        </div>
        <div class="sl-job-cell">
          <span class="sl-job-label">R. Meter</span>
          <span class="sl-job-value"><%= isEmpty(plannedRunningMeter) ? "—" : `${fmtN(plannedRunningMeter)} mtrs` %></span>
        </div>
        <div class="sl-job-cell">
          <span class="sl-job-label">Rolls</span>
          <span class="sl-job-value"><%= totalPlannedRolls %></span>
        </div>
        <%# This Deckle counted through its knife layout's RUN, not through this
            card -- one card is one Deckle, so the useful figure is where it
            sits among every Deckle at this setting on this machine, across
            cards and Product Codes and counting the ones already slit
            (buildLayoutRuns in routes/system/slitting.js). The machine queue
            and the operator app number the same Deckle the same way. %>
        <% if (card.layoutRun) { %>
        <div class="sl-job-cell">
          <span class="sl-job-label">Deckle</span>
          <span class="sl-job-value"><%= card.layoutRun.from %> of <%= card.layoutRun.total %></span>
        </div>
        <% } %>
      </div>
    </div>
  </div>


  <!-- Deckle Description: what's allocated to this card, read straight off
       the Deckle rows -- same role as the lamination Job Card's own order
       info + recipe strip up top. Always visible, purely descriptive. -->
  <div class="span-full form-subheading" style="margin-top:10px;"><h1>Deckle Description</h1></div>
  <div class="span-full" style="border:none !important;">
    <div class="sl-panel" style="overflow-x:auto;">
      <table class="sl-req-table" style="min-width:520px;">
        <thead>
          <tr><th>Deckle</th><th>Web Width</th><th>Planned Mtrs</th><th>Roll Widths</th></tr>
        </thead>
        <tbody id="slDescBody"></tbody>
      </table>
    </div>
  </div>

  <!-- Scan Deckle: scan the reel to confirm it before Start is live below --
       same role as the lamination Job Card's Scan Materials strip. -->
  <div class="span-full form-subheading" style="margin-top:10px;"><h1>Scan Deckle</h1></div>
  <div class="span-full" style="border:none !important;">
    <div class="sl-scan-wrap">
      <span class="sl-scan-label">Deckle ID</span>
      <div class="sl-scan-field">
        <input type="text" id="slScanInput" class="form-control" placeholder="Scan or type the Deckle ID" autocomplete="off" />
        <button type="button" id="slScanBtn" class="sl-scan-btn" title="Scan the QR code on the reel">
          <i class="fa-solid fa-camera"></i>
        </button>
      </div>
      <span class="sl-scan-msg" id="slScanMsg">Scan the Deckle you are about to run.</span>
    </div>
  </div>

  <!-- Job Setting: setup Start/Stop meter readings taken before the first
       Deckle is cut -- same shape, name, position and gate as the lamination
       Job Card's own Job Setting table: Production Log below stays hidden
       until every row here is punched and "Start Production Log" is clicked. -->
  <div class="span-full form-subheading" style="display:flex; align-items:center; gap:12px; margin-top:10px;">
    <h1>Job Setting</h1>
    <div style="display:inline-flex; align-items:center; gap:6px; margin-left:10px;">
      <button type="button" id="slJsMinus" class="sl-js-counter-btn">-</button>
      <input type="text" id="slJsCount" class="form-control sl-js-count" value="1" readonly />
      <button type="button" id="slJsPlus" class="sl-js-counter-btn">+</button>
    </div>
  </div>
  <div class="span-full" style="border:none !important;">
    <table class="sl-js-table">
      <thead>
        <tr>
          <th style="width:44px; text-align:center;">#</th>
          <th>Mtrs</th>
          <th style="text-align:center; white-space:nowrap;">Start</th>
          <th>Mtrs</th>
          <th style="text-align:center; white-space:nowrap;">Stop</th>
        </tr>
      </thead>
      <tbody id="slJsBody"></tbody>
    </table>
  </div>
  <div class="span-full btn-grp sl-hidden" id="slStartProdWrap" style="margin-top:10px;">
    <button type="button" id="slStartProdBtn" class="submit-btn">
      <i class="fa-solid fa-play" aria-hidden="true"></i> Start Production Log
    </button>
  </div>

  <!-- Production Log: same structure as the lamination Job Card's own
       Production Log (hidden until Job Setting is done) -- a read-only
       "already entered" history (grouped Start/Stop header, Edit pencil for
       the Joint note only) with the still-open Deckle(s) live below it. -->
  <div class="span-full form-subheading sl-prod-block sl-hidden" style="margin-top:10px;"><h1>Production Log</h1></div>

  <!-- Already-entered rows -- a running record of every Deckle already run on
       this card. Read-only; the Edit pencil only ever unlocks the Joint note,
       never the meters/rolls a Stop already moved stock for. Hidden until
       the first row is done. -->
  <div class="span-full sl-prod-block sl-hidden" style="border:none !important; display:none;" id="slLogDoneWrap">
    <table class="sl-log-table">
      <thead>
        <tr>
          <th rowspan="2" style="width:32px; vertical-align:middle;">#</th>
          <th colspan="4" class="group-head">Start / Stop</th>
          <th rowspan="2" style="vertical-align:middle;">Mtrs</th>
          <th rowspan="2" style="text-align:left; vertical-align:middle;">Rolls</th>
          <th rowspan="2" style="vertical-align:middle;">Joint</th>
          <th rowspan="2" style="width:44px; vertical-align:middle;">Edit</th>
        </tr>
        <tr>
          <th class="sub-head">Mtrs</th>
          <th class="sub-head">Start</th>
          <th class="sub-head">Mtrs</th>
          <th class="sub-head">Stop</th>
        </tr>
      </thead>
      <tbody id="slLogDoneBody"></tbody>
    </table>
  </div>

  <!-- The Deckle(s) still to run -- Start/Stop punched inline, Mtrs/R. Meter
       read as planned until Stop confirms the actual and moves the row up
       into the history table above. -->
  <div class="span-full sl-prod-block sl-hidden" style="border:none !important; margin-top:10px;" id="slLogLiveWrap">
    <table class="sl-log-table">
      <thead>
        <tr>
          <th rowspan="2" style="width:32px; vertical-align:middle;">#</th>
          <th colspan="4" class="group-head">Start / Stop</th>
          <th rowspan="2" style="vertical-align:middle;">Mtrs</th>
          <th rowspan="2" style="text-align:left; vertical-align:middle;">Rolls</th>
          <th rowspan="2" style="vertical-align:middle;">Joint</th>
          <th rowspan="2" style="vertical-align:middle;">Joint Mtrs</th>
        </tr>
        <tr>
          <th class="sub-head">Mtrs</th>
          <th class="sub-head">Start</th>
          <th class="sub-head">Mtrs</th>
          <th class="sub-head">Stop</th>
        </tr>
      </thead>
      <tbody id="slLogBody"></tbody>
    </table>
  </div>

  <div class="span-full sl-prod-block sl-hidden" style="border:none !important; display:none;" id="slDoneWrap">
    <div class="sl-done-note">
      <i class="fa-solid fa-circle-check"></i>
      <span>Every Deckle on this card has been run — the card is finished.</span>
      <a href="/app/slitting/jobcard/view" style="margin-left:auto;">Slitting Logs →</a>
    </div>
  </div>
</div>

<!-- ============ STOP: plain yes/no, same shape as the lamination Job
     Card's own stopConfirmDialog -- everything it would confirm (metres run,
     R. Meter, Joint) is already on the row itself by the time this opens. -->
<div class="logout-modal" id="stopDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="stopDialogTitle"
    style="width: min(440px, 95vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header">
      <h2 id="stopDialogTitle">Move roll(s) to Finished Stock?</h2>
      <button type="button" class="dialog-close-btn" onclick="closeStopDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <p class="sl-dlg-plan" id="stopPlan"></p>
      <div class="sl-dlg-err" id="stopErr"></div>
      <div class="sl-dlg-actions">
        <button type="button" class="sl-dlg-btn is-ghost" onclick="closeStopDialog()">Cancel</button>
        <button type="button" class="sl-dlg-btn is-primary" id="stopConfirmBtn">
          <i class="fa-solid fa-check"></i> Confirm &amp; Move
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ============ CAMERA SCAN ============ -->
<div class="logout-modal" id="scanDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="scanDialogTitle"
    style="width: min(420px, 95vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header">
      <h2 id="scanDialogTitle">Scan the Deckle label</h2>
      <button type="button" class="dialog-close-btn" onclick="closeScanDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <video id="scanVideo" playsinline muted autoplay></video>
      <div class="sl-scan-status" id="scanStatus">Point the camera at the QR code on the reel.</div>
    </div>
  </div>
</div>

<script src="/js/jsQR.min.js" defer></script>
<script id="sl-card-data" type="application/json"><%- safeJson(card) %></script>

<script>
  const CARD = JSON.parse(document.getElementById("sl-card-data").textContent);
  const ROWS = CARD.rows;

  const esc = (v) => String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const round2 = (n) => Math.round(Number(n) * 100) / 100;
  const fmt = (n) => (Number.isFinite(Number(n)) && n !== null && n !== "" ? round2(n).toLocaleString("en-IN") : "—");
  const norm = (v) => String(v ?? "").trim().replace(/\s+/g, "").toUpperCase();
  const nowHHMM = () => {
    const d = new Date();
    return `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
  };
  const toast = (msg, type) => { if (typeof showToast === "function") showToast(msg, type); };

  // Same two choices as the lamination Job Card's own Face/Release Joint
  // selects (jointOptionHtml there) -- just one of them here, since a Deckle
  // is a single web, not a facestock+release laminate.
  const jointOptionHtml = (selected) => `
    <option value="" ${selected ? "" : "selected"}>—</option>
    <option value="Joint" ${selected === "Joint" ? "selected" : ""}>Joint</option>
    <option value="Wrinkle" ${selected === "Wrinkle" ? "selected" : ""}>Wrinkle</option>`;

  // ---- Job Setting -------------------------------------------------------
  // Setup Start/Stop meter readings taken before the first Deckle is cut --
  // same shape and gate as the lamination Job Card's own Job Setting section
  // (views/inventory/masters/jobCardForm.ejs): Production Log below stays
  // hidden until every row here is punched and "Start Production Log" is
  // clicked. Unlike a Deckle row's Start/Stop, nothing here moves stock, so
  // the whole set of rows is saved in one call rather than per punch.
  const jsBody = document.getElementById("slJsBody");
  const jsCountEl = document.getElementById("slJsCount");
  const jsPlusBtn = document.getElementById("slJsPlus");
  const jsMinusBtn = document.getElementById("slJsMinus");
  const startProdWrap = document.getElementById("slStartProdWrap");
  const startProdBtn = document.getElementById("slStartProdBtn");

  const hasValue = (row, sel) => String(row?.querySelector(sel)?.value ?? "").trim() !== "";

  function setJsPunchReady(btn, ready, lockedTitle) {
    if (!btn || btn.dataset.punched === "1") return;
    btn.disabled = !ready;
    btn.style.background = ready ? (btn.dataset.color || "#10b981") : "#cbd5e1";
    btn.style.cursor = ready ? "pointer" : "not-allowed";
    btn.title = ready ? "" : lockedTitle;
  }

  function syncJsRowButtons(row) {
    if (!row) return;
    setJsPunchReady(row.querySelector(".sl-js-start-btn"), hasValue(row, ".sl-js-mtrs1"), "Enter the start mtrs first");
    setJsPunchReady(row.querySelector(".sl-js-stop-btn"), hasValue(row, ".sl-js-mtrs2"), "Enter the stop mtrs first");
  }

  function jsRenumber() {
    Array.from(jsBody.rows).forEach((row, i) => { row.cells[0].textContent = i + 1; });
    jsCountEl.value = jsBody.rows.length;
  }

  function jsAllRowsPunched() {
    const rows = Array.from(jsBody.rows);
    if (!rows.length) return false;
    return rows.every((row) =>
      row.querySelector(".sl-js-start-btn")?.dataset.punched === "1" &&
      row.querySelector(".sl-js-stop-btn")?.dataset.punched === "1");
  }

  function updateStartProdButton() {
    startProdWrap.classList.toggle("sl-hidden", !jsAllRowsPunched());
  }

  // Reveals Production Log (and its Done note) -- called once Job Setting is
  // saved, or immediately on load if the gate was already cleared before
  // (see the bottom of this script).
  let productionRevealed = false;
  function revealProduction() {
    productionRevealed = true;
    startProdWrap.classList.add("sl-hidden");
    document.querySelectorAll(".sl-prod-block").forEach((el) => el.classList.remove("sl-hidden"));
  }

  const jsRowPayload = () => Array.from(jsBody.rows).map((row) => ({
    mtrs1: row.querySelector(".sl-js-mtrs1").value,
    startTime: row.querySelector(".sl-js-start-display").textContent.trim(),
    mtrs2: row.querySelector(".sl-js-mtrs2").value,
    stopTime: row.querySelector(".sl-js-stop-display").textContent.trim(),
  })).map((r) => ({ ...r, startTime: r.startTime === "—" ? "" : r.startTime, stopTime: r.stopTime === "—" ? "" : r.stopTime }));

  // Once Production Log is open there is no "Start Production Log" button
  // left to re-submit Job Setting with, so a reading corrected up there
  // (one punched before it was captured) saves itself. The route overwrites
  // jobSetting wholesale, so this is just the same save, quietly.
  async function saveJobSettingQuietly() {
    if (!productionRevealed) return;
    try {
      await fetch("/app/slitting/jobcard/setting", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cardId: CARD._id, rows: jsRowPayload() }),
      });
    } catch (_) { /* a correction that doesn't reach the server is retried on the next edit */ }
  }

  // The machine counter is continuous -- Job Setting's last Stop reading is
  // exactly where the first Deckle's Start reading begins, so the operator
  // shouldn't have to re-key it. Only ever seeds the very first not-yet-
  // started row, and only while it's still blank (never overwrites a real
  // punch or something the operator already typed in).
  function seedFirstRowStartMtrs(mtrs2) {
    const val = Number(mtrs2);
    if (!Number.isFinite(val)) return;
    const firstRow = document.querySelector("#slLogBody tr.sl-log-row");
    const input = firstRow?.querySelector(".sl-start-mtrs");
    if (input && !input.readOnly && !input.value) {
      input.value = val;
      syncLogRowButtons(firstRow);
    }
  }

  function createJsRow(preset) {
    const punchedStart = Boolean(preset && preset.startTime);
    const punchedStop = Boolean(preset && preset.stopTime);
    // A punch locks its reading in -- but only once there IS one. A row
    // punched before the reading was captured (or one whose 0 was dropped by
    // the old falsy-zero save) must stay editable, or the field is blank and
    // locked with no way left to correct it.
    const lockStart = punchedStart && preset.mtrs1 != null;
    const lockStop = punchedStop && preset.mtrs2 != null;
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td style="text-align:center; font-weight:700; color:#044a78;"></td>
      <td><input type="number" class="form-control sl-js-mtrs1" placeholder="Mtrs" min="0" step="any" ${lockStart ? "readonly" : ""} /></td>
      <td style="text-align:center; white-space:nowrap;">
        <span class="sl-js-start-display" style="font-size:11.5px; font-weight:700; color:#03365a; margin-right:3px;">${punchedStart ? esc(preset.startTime) : "—"}</span>
        <button type="button" class="sl-js-btn sl-js-start-btn" data-color="#10b981" disabled title="Enter the start mtrs first">
          <i class="fa-solid ${punchedStart ? "fa-check" : "fa-play"}"></i>
        </button>
      </td>
      <td><input type="number" class="form-control sl-js-mtrs2" placeholder="Mtrs" min="0" step="any" ${lockStop ? "readonly" : ""} /></td>
      <td style="text-align:center; white-space:nowrap;">
        <span class="sl-js-stop-display" style="font-size:11.5px; font-weight:700; color:#dc2626; margin-right:3px;">${punchedStop ? esc(preset.stopTime) : "—"}</span>
        <button type="button" class="sl-js-btn sl-js-stop-btn" data-color="#ef4444" disabled title="Enter the stop mtrs first">
          <i class="fa-solid ${punchedStop ? "fa-check" : "fa-stop"}"></i>
        </button>
      </td>`;

    const mtrs1 = tr.querySelector(".sl-js-mtrs1");
    const mtrs2 = tr.querySelector(".sl-js-mtrs2");
    if (preset && preset.mtrs1 != null) mtrs1.value = preset.mtrs1;
    if (preset && preset.mtrs2 != null) mtrs2.value = preset.mtrs2;

    const startBtn = tr.querySelector(".sl-js-start-btn");
    const stopBtn = tr.querySelector(".sl-js-stop-btn");
    if (punchedStart) {
      startBtn.dataset.punched = "1";
      startBtn.disabled = true;
      startBtn.style.background = "#6b7280";
      startBtn.style.cursor = "default";
    }
    if (punchedStop) {
      stopBtn.dataset.punched = "1";
      stopBtn.disabled = true;
      stopBtn.style.background = "#6b7280";
      stopBtn.style.cursor = "default";
    }
    return tr;
  }

  jsBody.addEventListener("input", (e) => {
    if (e.target.classList.contains("sl-js-mtrs1") || e.target.classList.contains("sl-js-mtrs2")) {
      syncJsRowButtons(e.target.closest("tr"));
    }
  });

  jsBody.addEventListener("change", (e) => {
    if (e.target.classList.contains("sl-js-mtrs1") || e.target.classList.contains("sl-js-mtrs2")) {
      saveJobSettingQuietly();
    }
  });

  jsBody.addEventListener("click", (e) => {
    const startBtn = e.target.closest(".sl-js-start-btn");
    if (startBtn) {
      if (startBtn.disabled) return;
      const row = startBtn.closest("tr");
      if (!hasValue(row, ".sl-js-mtrs1")) {
        toast("Enter the start mtrs first.", "error");
        row.querySelector(".sl-js-mtrs1")?.focus();
        return;
      }
      const time = nowHHMM();
      row.querySelector(".sl-js-start-display").textContent = time;
      startBtn.dataset.punched = "1";
      startBtn.disabled = true;
      startBtn.title = "";
      startBtn.innerHTML = '<i class="fa-solid fa-check"></i>';
      startBtn.style.background = "#6b7280";
      startBtn.style.cursor = "default";
      updateStartProdButton();
      return;
    }
    const stopBtn = e.target.closest(".sl-js-stop-btn");
    if (stopBtn) {
      if (stopBtn.disabled) return;
      const row = stopBtn.closest("tr");
      if (!hasValue(row, ".sl-js-mtrs2")) {
        toast("Enter the stop mtrs first.", "error");
        row.querySelector(".sl-js-mtrs2")?.focus();
        return;
      }
      const time = nowHHMM();
      row.querySelector(".sl-js-stop-display").textContent = time;
      stopBtn.dataset.punched = "1";
      stopBtn.disabled = true;
      stopBtn.title = "";
      stopBtn.innerHTML = '<i class="fa-solid fa-check"></i>';
      stopBtn.style.background = "#6b7280";
      stopBtn.style.cursor = "default";
      updateStartProdButton();
    }
  });

  jsPlusBtn.addEventListener("click", () => {
    jsBody.appendChild(createJsRow());
    jsRenumber();
    updateStartProdButton();
  });
  jsMinusBtn.addEventListener("click", () => {
    if (jsBody.rows.length > 1) { jsBody.removeChild(jsBody.lastElementChild); jsRenumber(); updateStartProdButton(); }
  });

  startProdBtn.addEventListener("click", async () => {
    const rows = jsRowPayload();

    startProdBtn.disabled = true;
    try {
      const res = await fetch("/app/slitting/jobcard/setting", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cardId: CARD._id, rows }),
      });
      const data = await res.json();
      if (!data.success) {
        toast(data.message || "Couldn't save Job Setting.", "error");
        startProdBtn.disabled = false;
        return;
      }
      revealProduction();
      seedFirstRowStartMtrs(rows.length ? rows[rows.length - 1].mtrs2 : null);
    } catch {
      toast("Server error — Job Setting was not saved.", "error");
      startProdBtn.disabled = false;
    }
  });

  // Curing gate: a Deckle can't be run until its adhesive has cured (CHROMO
  // 6 h, PP 8 h after lamination -- the server works out which, per Deckle).
  // The server sends `cured`; re-check the clock here too so a card left open
  // unlocks on its own when the time passes. Hot-melt builds carry no curedAt
  // and are never gated.
  function curedNow(row) {
    const c = row.curing;
    if (!c || c.hotMelt || c.cured) return true;
    if (c.curedAt) return Date.now() >= Date.parse(c.curedAt);
    return false;
  }

  // " (8 h after lamination)" for this Deckle's own curing window.
  function cureWindow(row) {
    const h = Number(row.curing && row.curing.hours);
    return h > 0 ? ` (${h} h after lamination)` : "";
  }

  // Which row the scan has confirmed. Only that row's Start is live -- a
  // Deckle has to be identified before it can be run.
  let armedIndex = null;

  // A printed label's QR payload ENDS with the Roll ID (the older format
  // STARTS with it) and a typed entry is the id itself, so matching against
  // this card's own allocated ids covers every case without re-implementing
  // the full Roll ID grammar. Longest match wins, so one id that is a suffix
  // of another can't shadow it.
  function matchDeckle(raw) {
    const compact = norm(raw);
    if (!compact) return null;
    const hits = ROWS
      .map((r, i) => ({ i, id: norm(r.deckleId) }))
      .filter((x) => x.id && (compact === x.id || compact.endsWith(x.id) || compact.startsWith(x.id)))
      .sort((a, b) => b.id.length - a.id.length);
    return hits.length ? hits[0].i : null;
  }

  // Web view: A..L drawn to scale across the Deckle's web, same look as the
  // allocation page's own strip -- read-only, off the roll layout already
  // fixed there. row.width is the net cuttable width (post edge-trim); the
  // edge trim itself isn't stored per row, but row.webWidth (the reel's own
  // MaterialStock.size, mm) is the raw web it was cut from, so the two edge
  // segments -- (webWidth - width) split evenly -- can still be drawn, same
  // as the allocation page's EDGE_TRIM_MM either side.
  function edgeTrimSeg(side, mm) {
    return `
      <div class="sl-web-seg sl-web-edge" style="flex-grow:${mm}" title="${side} edge trim — ${esc(fmt(mm))} mm">
        <span class="sl-seg-slot">EDGE</span><span class="sl-seg-w">${esc(fmt(mm))}</span>
      </div>`;
  }

  function webViewHtml(row) {
    const cuts = (row.cuts || []).filter((c) => Number(c.width) > 0);
    if (!cuts.length || row.width === null) {
      const label = row.width !== null
        ? `${esc(fmt(row.width))} mm web — no roll widths recorded`
        : "No web width recorded";
      return `<div class="sl-web-empty">${label}</div>`;
    }
    const widthTotal = round2(cuts.reduce((s, c) => s + Number(c.width), 0));
    const trimW = round2(row.width - widthTotal);
    const over = trimW < 0;
    const edgeMM = row.webWidth !== null && row.webWidth > row.width
      ? round2((row.webWidth - row.width) / 2)
      : null;
    const segs = cuts.map((c) => `
      <div class="sl-web-seg" style="flex-grow:${c.width}" title="${esc(c.slot)} — ${esc(fmt(c.width))} mm">
        <span class="sl-seg-slot">${esc(c.slot)}</span><span class="sl-seg-w">${esc(fmt(c.width))}</span>
      </div>`);
    if (!over && trimW > 0) {
      segs.push(`
        <div class="sl-web-seg sl-web-trim" style="flex-grow:${trimW}" title="Trim (uncut slack) — ${esc(fmt(trimW))} mm">
          <span class="sl-seg-slot">TRIM</span><span class="sl-seg-w">${esc(fmt(trimW))}</span>
        </div>`);
    }
    const strip = edgeMM !== null
      ? `${edgeTrimSeg("Left", edgeMM)}${segs.join("")}${edgeTrimSeg("Right", edgeMM)}`
      : segs.join("");
    const flagText = over
      ? `Over the web by ${esc(fmt(widthTotal - row.width))} mm`
      : `${cuts.length} roll${cuts.length === 1 ? "" : "s"} · ${esc(fmt(widthTotal))} of ${esc(fmt(row.width))} mm`
        + (trimW > 0 ? ` · ${esc(fmt(trimW))} mm trim` : "")
        + (edgeMM !== null ? ` · ${esc(fmt(edgeMM * 2))} mm edge` : "");
    return `
      <div class="sl-web-caption"><span class="sl-web-flag${over ? " sl-bad" : " sl-ok"}">${flagText}</span></div>
      <div class="sl-web${over ? " is-over" : ""}">${strip}</div>`;
  }

  // Deckle Description: one row per allocated Deckle, read straight off what
  // the planner already fixed at allocation -- static for the life of the
  // card, so this is built once rather than on every render().
  function renderDescription() {
    const body = document.getElementById("slDescBody");
    body.innerHTML = ROWS.map((row) => {
      const cuts = (row.cuts || []).filter((c) => Number(c.width) > 0);
      const cutsText = cuts.length ? cuts.map((c) => `${esc(c.slot)}: ${esc(fmt(c.width))} mm`).join(", ") : "—";
      return `
        <tr>
          <td>${esc(row.deckleId || "—")}</td>
          <td>${esc(fmt(row.width))} mm</td>
          <td>${esc(fmt(row.plannedMeter))} mtrs</td>
          <td>${cutsText}</td>
        </tr>
        <tr class="sl-web-sub">
          <td colspan="4">${webViewHtml(row)}</td>
        </tr>`;
    }).join("");
  }

  // Already-entered rows -- read-only, same role as the lamination Job
  // Card's own "already entered" table. The Edit pencil only ever unlocks
  // the Joint note (see POST /slitting/jobcard/row/edit): meter, runningMeter
  // and the produced roll ids already moved stock at Stop and are never
  // reopened, here or anywhere else.
  function renderDone() {
    const doneBody = document.getElementById("slLogDoneBody");
    const doneIdx = ROWS.map((_, i) => i).filter((i) => ROWS[i].status === "done");
    document.getElementById("slLogDoneWrap").style.display = doneIdx.length ? "" : "none";

    doneBody.innerHTML = doneIdx.map((i) => {
      const row = ROWS[i];
      const rolls = (row.cuts || []).length;
      const producedIds = (row.cuts || []).map((c) => c.rollId).filter(Boolean);
      // Same confirmation the lamination Job Card gives a row once its
      // Deckle is inwarded (setLogDeckleNote's "✓ … — in Semi Finished
      // Stock") -- here it names every roll this Stop actually made.
      const rollsText = producedIds.length
        ? `<span style="color:#059669;font-weight:700;">✓ ${esc(producedIds.join(", "))} — in Finished Stock</span>`
        : `${rolls} roll${rolls === 1 ? "" : "s"} planned`;
      const jointText = row.joint
        ? `${esc(row.joint)}${row.jointMtr != null && row.jointMtr !== "" ? ` @ ${esc(fmt(row.jointMtr))} mtrs` : ""}`
        : "—";
      return `
        <tr class="sl-row-readonly" data-index="${i}">
          <td style="text-align:center; font-weight:700; color:#044a78;">${i + 1}</td>
          <td style="text-align:center;">${esc(fmt(row.startMtrs))}</td>
          <td style="text-align:center; white-space:nowrap;">${esc(row.startTime || "—")}</td>
          <td style="text-align:center;">${esc(fmt(row.stopMtrs))}</td>
          <td style="text-align:center; white-space:nowrap;">${esc(row.endTime || "—")}</td>
          <td style="text-align:center;">${esc(fmt(row.meter))}</td>
          <td style="overflow-wrap:anywhere;">${rollsText}</td>
          <td class="sl-joint-cell"><span class="sl-joint-text">${jointText}</span></td>
          <td class="sl-row-edit-cell">
            <button type="button" class="sl-row-edit-btn" data-index="${i}" title="Edit the joint note"><i class="fa-solid fa-pen"></i></button>
          </td>
        </tr>`;
    }).join("");

    doneBody.querySelectorAll(".sl-row-edit-btn").forEach((btn) => {
      btn.addEventListener("click", () => toggleJointEdit(Number(btn.dataset.index)));
    });
  }

  // Turns one done row's Joint cell into inputs (pencil -> checkmark, same
  // as the lamination Job Card's own jc-row-edit-btn); a second click saves.
  function toggleJointEdit(i) {
    const tr = document.querySelector(`#slLogDoneBody tr[data-index="${i}"]`);
    if (!tr) return;
    const btn = tr.querySelector(".sl-row-edit-btn");
    const cell = tr.querySelector(".sl-joint-cell");

    if (!btn.classList.contains("editing")) {
      const row = ROWS[i];
      cell.innerHTML = `
        <input type="text" class="form-control sl-joint-input" placeholder="Joint" value="${esc(row.joint || "")}" />
        <input type="number" step="any" min="0" class="form-control sl-jointmtr-input" placeholder="Mtrs" value="${row.jointMtr ?? ""}" style="margin-left:4px;" />`;
      btn.classList.add("editing");
      btn.innerHTML = '<i class="fa-solid fa-check"></i>';
      btn.title = "Save";
      return;
    }
    saveJointEdit(i, btn, cell);
  }

  async function saveJointEdit(i, btn, cell) {
    const joint = cell.querySelector(".sl-joint-input")?.value.trim() || "";
    const jointMtrRaw = cell.querySelector(".sl-jointmtr-input")?.value;
    const jointMtr = jointMtrRaw === "" || jointMtrRaw == null ? null : Number(jointMtrRaw);

    btn.disabled = true;
    try {
      const res = await fetch("/app/slitting/jobcard/row/edit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cardId: CARD._id, index: i, joint, jointMtr }),
      });
      const data = await res.json();
      if (!data.success) {
        toast(data.message || "Couldn't save the joint note.", "error");
        btn.disabled = false;
        return;
      }
      ROWS[i].joint = data.joint ?? joint;
      ROWS[i].jointMtr = data.jointMtr ?? jointMtr;
      renderDone();
      toast("Joint note updated.", "success");
    } catch {
      toast("Server error — the note was not saved.", "error");
      btn.disabled = false;
    }
  }

  // Enables/disables one row's Start/Stop buttons off whatever is currently
  // typed into its counter-reading inputs -- same "won't punch without its
  // reading" gate as the lamination Job Card's own log-start-mtrs/
  // log-stop-mtrs (and this card's own Job Setting table above). Also keeps
  // the Mtrs cell showing the metres those two readings actually imply --
  // we already have both ends of the run, so there is nothing left to ask
  // the operator to type or confirm separately.
  function syncLogRowButtons(tr) {
    if (!tr) return;
    const running = tr.classList.contains("is-running");
    const curing = tr.classList.contains("is-curing");
    const armed = tr.classList.contains("is-armed");
    const startVal = tr.querySelector(".sl-start-mtrs")?.value.trim();
    const stopVal = tr.querySelector(".sl-stop-mtrs")?.value.trim();
    const start = parseFloat(startVal);
    const stop = parseFloat(stopVal);
    const meter = Number.isFinite(start) && Number.isFinite(stop) && stop > start ? round2(stop - start) : null;

    const meterCell = tr.querySelector(".sl-row-meter-display");
    if (meterCell && meter != null) meterCell.textContent = fmt(meter);

    const startBtn = tr.querySelector(".sl-log-btn.is-start");
    if (startBtn && !running) {
      const ready = armed && !curing && !!startVal;
      startBtn.disabled = !ready;
      startBtn.title = !armed ? "Scan this Deckle first" : curing ? startBtn.title : !startVal ? "Enter the machine's counter reading first" : "";
    }
    const stopBtn = tr.querySelector(".sl-log-btn.is-stop");
    if (stopBtn && running) {
      stopBtn.disabled = !(stopVal && meter);
      stopBtn.title = !stopVal ? "Enter the machine's counter reading first" : !meter ? "Stop reading must be past the Start reading" : "";
    }
  }

  // The Deckle(s) still to run -- Start/Stop punched inline, driven by the
  // scan bar above. Never shows a done row: Stop moves it straight into
  // renderDone() above instead of leaving it here relabelled.
  function renderLive() {
    const body = document.getElementById("slLogBody");
    const pendingIdx = ROWS.map((_, i) => i).filter((i) => ROWS[i].status !== "done");
    document.getElementById("slLogLiveWrap").style.display = pendingIdx.length ? "" : "none";

    // A re-render can be triggered by something unrelated to what's on
    // screen (the curing-tick poll below) -- preserve whatever the operator
    // has already typed into the counter-reading inputs, since that draft
    // isn't part of ROWS until its punch actually commits.
    const draft = {};
    body.querySelectorAll("tr.sl-log-row").forEach((tr) => {
      draft[tr.dataset.index] = {
        startMtrs: tr.querySelector(".sl-start-mtrs")?.value ?? "",
        stopMtrs: tr.querySelector(".sl-stop-mtrs")?.value ?? "",
        joint: tr.querySelector(".sl-row-joint")?.value ?? "",
        jointMtr: tr.querySelector(".sl-row-jointmtr")?.value ?? "",
      };
    });

    body.innerHTML = pendingIdx.map((i) => {
      const row = ROWS[i];
      const running = Boolean(row.startTime);
      const curing = !running && !curedNow(row);
      const armed = !running && !curing && armedIndex === i;
      // Drives the row tint and the Start/Stop gating in syncLogRowButtons --
      // there is no Status column to spell it out in any more.
      const state = running ? "running" : curing ? "curing" : armed ? "armed" : "pending";
      const cureMsg = curing
        ? `Adhesive still curing${row.curing && row.curing.curedAtLabel ? ` — ready at ${esc(row.curing.curedAtLabel)}` : ""}${cureWindow(row)}`
        : "";

      const rolls = (row.cuts || []).length;
      const short = row.reelMtrs != null && Number(row.plannedMeter) > Number(row.reelMtrs);
      const shortNote = short
        ? `${fmt(row.reelMtrs)} mtrs left on the reel — short of the ${fmt(row.plannedMeter)} planned`
        : "";
      const noteTitle = [shortNote, cureMsg].filter(Boolean).join(" · ");
      const rollsText = `${rolls} roll${rolls === 1 ? "" : "s"} planned`;
      const d = draft[i] || {};
      const startVal = row.startMtrs ?? d.startMtrs ?? "";

      return `
        <tr class="sl-log-row is-${state}" data-index="${i}" title="${esc(noteTitle)}">
          <td style="text-align:center; font-weight:700; color:#044a78;">${i + 1}</td>
          <td>
            <input type="number" class="form-control sl-start-mtrs" placeholder="Mtrs" min="0" step="any"
              value="${esc(startVal)}" ${running && row.startMtrs != null ? "readonly" : ""} />
          </td>
          <td style="text-align:center; white-space:nowrap;">
            <span style="font-size:11.5px; font-weight:700; color:#03365a; margin-right:3px;">${row.startTime ? esc(row.startTime) : "—"}</span>
            <button type="button" class="sl-log-btn is-start" data-act="start" data-index="${i}" disabled
              title="${running ? "Already started" : curing ? cureMsg : armed ? "" : "Scan this Deckle first"}">
              <i class="fa-solid ${running ? "fa-check" : "fa-play"}"></i>
            </button>
          </td>
          <td>
            <input type="number" class="form-control sl-stop-mtrs" placeholder="Mtrs" min="0" step="any"
              value="${esc(running ? (d.stopMtrs ?? "") : "")}" ${running ? "" : "disabled"} />
          </td>
          <td style="text-align:center; white-space:nowrap;">
            <span style="font-size:11.5px; font-weight:700; color:#dc2626; margin-right:3px;">—</span>
            <button type="button" class="sl-log-btn is-stop" data-act="stop" data-index="${i}" disabled
              title="${running ? "" : curing ? cureMsg : "Punch Start first"}">
              <i class="fa-solid fa-stop"></i>
            </button>
          </td>
          <td class="sl-row-meter-display" style="text-align:center;" title="Filled in from Start/Stop mtrs once both are entered -- not typed directly.">${esc(fmt(row.plannedMeter))}</td>
          <td style="overflow-wrap:anywhere;">${rollsText}${short ? ' <span style="color:#b91c1c;" title="Short reel">⚠</span>' : ""}${curing ? ' <span style="color:#b45309;" title="Still curing">⏳</span>' : ""}</td>
          <td>
            <select class="form-control sl-row-joint">${jointOptionHtml(d.joint || "")}</select>
          </td>
          <td>
            <input type="number" class="form-control sl-row-jointmtr" placeholder="Mtrs" min="0" step="any" value="${esc(d.jointMtr || "")}" />
          </td>
        </tr>`;
    }).join("");

    body.querySelectorAll("tr.sl-log-row").forEach((tr) => syncLogRowButtons(tr));

    body.querySelectorAll("[data-act]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const i = Number(btn.dataset.index);
        if (btn.dataset.act === "start") punchStart(i);
        else openStopDialog(i);
      });
    });
    body.querySelectorAll(".sl-start-mtrs, .sl-stop-mtrs").forEach((input) => {
      input.addEventListener("input", () => syncLogRowButtons(input.closest("tr")));
    });

    document.getElementById("slDoneWrap").style.display = pendingIdx.length ? "none" : "";
  }

  function render() {
    renderDone();
    renderLive();
  }

  function setScanMsg(msg, kind) {
    const el = document.getElementById("slScanMsg");
    el.textContent = msg;
    el.className = "sl-scan-msg" + (kind ? ` sl-${kind}` : "");
  }

  function armRow(i, { scroll } = { scroll: true }) {
    armedIndex = i;
    render();
    setScanMsg(`${ROWS[i].deckleId} confirmed — punch Start when the machine runs.`, "ok");
    if (scroll) {
      document.querySelector(`tr.sl-log-row[data-index="${i}"]`)?.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }

  // Arm the row a scanned/typed id identifies, and scroll it into view. A
  // scan doesn't have to be the exact Deckle this row was allocated with --
  // any free web of this card's Product Code + raw size can be swapped in
  // (POST /slitting/jobcard/row/swap-deckle re-points the row at it server-
  // side, which is also what frees the old one and locks the new one to this
  // card). Only reached once the id fails to match a row already on the card.
  async function armFrom(raw) {
    const i = matchDeckle(raw);
    if (i !== null) {
      if (ROWS[i].status === "done") {
        armedIndex = null;
        render();
        setScanMsg(`${ROWS[i].deckleId} has already been run on this card.`, "bad");
        return false;
      }
      if (!curedNow(ROWS[i])) {
        armedIndex = null;
        render();
        const lbl = ROWS[i].curing && ROWS[i].curing.curedAtLabel ? ` — ready at ${ROWS[i].curing.curedAtLabel}` : "";
        setScanMsg(`${ROWS[i].deckleId} is still curing${cureWindow(ROWS[i])}${lbl}. It can't be run yet.`, "bad");
        return false;
      }
      armRow(i);
      return true;
    }

    const target = ROWS.findIndex((r) => r.status !== "done");
    if (target === -1) {
      armedIndex = null;
      render();
      setScanMsg("Every Deckle on this card has already been run.", "bad");
      return false;
    }

    setScanMsg("Checking that reel…", "");
    let data;
    try {
      const res = await fetch("/app/slitting/jobcard/row/swap-deckle", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cardId: CARD._id, index: target, rollId: raw }),
      });
      data = await res.json().catch(() => ({ success: false }));
    } catch (_) {
      data = { success: false, message: "Network error — try again." };
    }

    if (!data.success) {
      armedIndex = null;
      render();
      setScanMsg(data.message || "That Deckle is not on this card.", "bad");
      return false;
    }

    if (!data.unchanged && data.row) {
      Object.assign(ROWS[target], data.row);
      renderDescription();
    }
    armRow(target);
    return true;
  }

  const scanInput = document.getElementById("slScanInput");
  scanInput.addEventListener("keydown", (e) => {
    if (e.key !== "Enter") return;
    e.preventDefault();
    armFrom(scanInput.value);
  });
  scanInput.addEventListener("change", () => { if (scanInput.value.trim()) armFrom(scanInput.value); });

  async function punchStart(i) {
    const row = ROWS[i];
    if (!row || row.status === "done" || row.startTime) return;
    if (!curedNow(row)) return toast("That Deckle is still curing — it can't be run yet.", "error");

    const tr = document.querySelector(`#slLogBody tr[data-index="${i}"]`);
    const startMtrsRaw = tr?.querySelector(".sl-start-mtrs")?.value.trim();
    if (!startMtrsRaw) return toast("Enter the machine's counter reading before punching Start.", "error");
    const startMtrs = Number(startMtrsRaw);
    if (!Number.isFinite(startMtrs) || startMtrs < 0) return toast("Enter a valid counter reading.", "error");

    const startTime = nowHHMM();
    try {
      const res = await fetch("/app/slitting/jobcard/row/start", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cardId: CARD._id, index: i, startTime, startMtrs }),
      });
      const data = await res.json();
      if (!data.success) return toast(data.message || "Couldn't record the start.", "error");
      row.startTime = data.startTime || startTime;
      row.startMtrs = data.startMtrs ?? startMtrs;
      render();
      toast(`Started ${row.deckleId} at ${row.startTime}`, "success");
    } catch {
      toast("Server error — the start was not recorded.", "error");
    }
  }

  // ---- Stop ------------------------------------------------------------
  let stopIndex = null;

  function openModal(id) {
    const m = document.getElementById(id);
    m.classList.add("show");
    m.setAttribute("aria-hidden", "false");
  }
  function closeModal(id) {
    const m = document.getElementById(id);
    m.classList.remove("show");
    m.setAttribute("aria-hidden", "true");
  }

  let stopMtrsValue = null;
  // The Start reading this Stop is measured against -- normally the row's
  // own, or the one just typed in for a row started before it was captured.
  let stopStartMtrs = null;

  // Same shape as the lamination Job Card's own stopConfirmDialog: by the
  // time Stop is punched, everything is already on the row (Start/Stop mtrs
  // give the metres run, R. Meter is the plan's own fixed figure, Joint is
  // its own inline field) -- so this is a plain yes/no, never a form.
  function openStopDialog(i) {
    const row = ROWS[i];
    if (!row || row.status === "done" || !row.startTime) return;
    if (!curedNow(row)) return toast("That Deckle is still curing — it can't be run yet.", "error");

    const tr = document.querySelector(`#slLogBody tr[data-index="${i}"]`);
    const stopMtrsRaw = tr?.querySelector(".sl-stop-mtrs")?.value.trim();
    if (!stopMtrsRaw) return toast("Enter the machine's counter reading before punching Stop.", "error");
    const stopMtrs = Number(stopMtrsRaw);
    if (!Number.isFinite(stopMtrs) || stopMtrs < 0) return toast("Enter a valid counter reading.", "error");

    // Normally the Start reading is already on the row (punched with Start).
    // A row started before this field existed has none -- its input is left
    // editable for exactly that case, so take the reading from there and let
    // the Stop below record it.
    const startFromInput = Number(tr?.querySelector(".sl-start-mtrs")?.value.trim());
    const startMtrs = row.startMtrs != null ? Number(row.startMtrs)
      : (Number.isFinite(startFromInput) ? startFromInput : null);
    if (startMtrs == null) return toast("Enter the Start counter reading for this row first.", "error");
    if (stopMtrs <= startMtrs) {
      return toast(`Stop reading must be past the Start reading (${fmt(startMtrs)}).`, "error");
    }
    stopStartMtrs = startMtrs;

    // The metres run is exactly the counter difference -- already have both
    // ends of it, nothing left to separately type or confirm.
    const meter = round2(stopMtrs - startMtrs);
    if (row.reelMtrs != null && meter > Number(row.reelMtrs)) {
      return toast(`Only ${fmt(row.reelMtrs)} mtrs are left on this reel — that reading implies ${fmt(meter)}.`, "error");
    }
    stopMtrsValue = stopMtrs;

    stopIndex = i;
    document.getElementById("stopPlan").innerHTML =
      `This records <strong>${esc(row.deckleId)}</strong> — <strong>${esc(fmt(meter))} mtrs</strong> into Finished Stock now.`;
    document.getElementById("stopErr").style.display = "none";
    openModal("stopDialog");
    document.getElementById("stopConfirmBtn")?.focus();
  }
  window.closeStopDialog = () => { closeModal("stopDialog"); stopIndex = null; stopMtrsValue = null; stopStartMtrs = null; };

  document.getElementById("stopConfirmBtn").addEventListener("click", async () => {
    if (stopIndex === null) return;
    const row = ROWS[stopIndex];
    const errEl = document.getElementById("stopErr");
    const showErr = (m) => { errEl.textContent = m; errEl.style.display = "block"; };

    // Re-derive rather than trust anything stashed earlier -- the dialog
    // never re-collects it, so this has to be the same figure openStopDialog
    // just checked.
    const meter = round2(stopMtrsValue - stopStartMtrs);
    const runningMeter = row.plannedRunningMeter;
    if (!(runningMeter > 0)) return showErr("This row has no R. Meter planned — reopen it from Slitting Allocation.");
    errEl.style.display = "none";

    // Joint/Joint Mtrs live on the row itself now (Materials Mounted-style
    // inline fields), not in this dialog -- read them off it directly.
    const liveTr = document.querySelector(`#slLogBody tr[data-index="${stopIndex}"]`);
    const joint = liveTr?.querySelector(".sl-row-joint")?.value || "";
    const jointMtr = liveTr?.querySelector(".sl-row-jointmtr")?.value || "";

    const btn = document.getElementById("stopConfirmBtn");
    btn.disabled = true;
    const endTime = nowHHMM();
    try {
      const res = await fetch("/app/slitting/jobcard/row/produce", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          cardId: CARD._id,
          index: stopIndex,
          meter,
          runningMeter,
          stopMtrs: stopMtrsValue,
          // Only used to fill in a row that was started before the reading
          // was captured; the server ignores it once the row has one.
          startMtrs: stopStartMtrs,
          joint,
          jointMtr,
          endTime,
        }),
      });
      const data = await res.json();
      if (!data.success) { btn.disabled = false; return showErr(data.message || "Failed to move the rolls."); }

      row.status = "done";
      row.meter = data.meter;
      row.runningMeter = data.runningMeter;
      row.stopMtrs = data.stopMtrs ?? stopMtrsValue;
      row.joint = joint || "";
      row.jointMtr = jointMtr === "" ? null : Number(jointMtr);
      row.endTime = data.endTime || endTime;
      (data.rollIds || []).forEach((id, n) => { if (row.cuts[n]) row.cuts[n].rollId = id; });
      if (row.reelMtrs != null) row.reelMtrs = round2(Number(row.reelMtrs) - Number(data.meter || 0));
      armedIndex = null;
      scanInput.value = "";
      closeStopDialog();
      render();
      setScanMsg("Scan the next Deckle.", "");
      toast(`${(data.rollIds || []).length} roll(s) inwarded from ${row.deckleId}.`, "success");
    } catch {
      showErr("Server error. Please try again.");
    }
    btn.disabled = false;
  });

  // ---- Camera scan -----------------------------------------------------
  let scanStream = null;
  let scanRafId = null;
  const scanVideo = document.getElementById("scanVideo");
  const scanCanvas = document.createElement("canvas");

  function setScanStatus(msg, bad) {
    const el = document.getElementById("scanStatus");
    el.textContent = msg;
    el.className = "sl-scan-status" + (bad ? " sl-bad" : "");
  }

  function stopScanCamera() {
    if (scanRafId) cancelAnimationFrame(scanRafId);
    scanRafId = null;
    if (scanStream) {
      scanStream.getTracks().forEach((t) => t.stop());
      scanStream = null;
    }
    scanVideo.srcObject = null;
  }
  window.closeScanDialog = () => { closeModal("scanDialog"); stopScanCamera(); };

  function scanFrame() {
    if (!scanStream) return;
    if (scanVideo.readyState === scanVideo.HAVE_ENOUGH_DATA) {
      const vw = scanVideo.videoWidth;
      const vh = scanVideo.videoHeight;
      if (vw && vh) {
        const scale = Math.min(1, 640 / Math.max(vw, vh));
        scanCanvas.width = Math.round(vw * scale);
        scanCanvas.height = Math.round(vh * scale);
        const ctx = scanCanvas.getContext("2d");
        ctx.drawImage(scanVideo, 0, 0, scanCanvas.width, scanCanvas.height);
        const frame = ctx.getImageData(0, 0, scanCanvas.width, scanCanvas.height);
        const code = window.jsQR
          ? window.jsQR(frame.data, frame.width, frame.height, { inversionAttempts: "dontInvert" })
          : null;
        if (code && code.data) {
          closeScanDialog();
          scanInput.value = code.data;
          armFrom(code.data);
          return;
        }
      }
    }
    scanRafId = requestAnimationFrame(scanFrame);
  }

  document.getElementById("slScanBtn").addEventListener("click", async () => {
    setScanStatus("Point the camera at the QR code on the reel.");
    openModal("scanDialog");
    if (!navigator.mediaDevices?.getUserMedia) {
      return setScanStatus("Camera scanning needs a secure (https) connection here. Please type the ID instead.", true);
    }
    if (typeof window.jsQR !== "function") {
      return setScanStatus("Scanner failed to load. Please type the ID instead.", true);
    }
    try {
      scanStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: "environment" } }, audio: false });
      scanVideo.srcObject = scanStream;
      await scanVideo.play();
      scanRafId = requestAnimationFrame(scanFrame);
    } catch {
      setScanStatus("Couldn't open the camera. Please allow camera access, or type the ID instead.", true);
    }
  });

  document.getElementById("scanDialog").addEventListener("click", (e) => {
    if (e.target === e.currentTarget) closeScanDialog();
  });
  document.getElementById("stopDialog").addEventListener("click", (e) => {
    if (e.target === e.currentTarget) closeStopDialog();
  });
  document.addEventListener("visibilitychange", () => { if (document.hidden) closeScanDialog(); });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (document.getElementById("scanDialog").classList.contains("show")) closeScanDialog();
    if (document.getElementById("stopDialog").classList.contains("show")) closeStopDialog();
  });

  renderDescription();
  render();

  // Prefill Job Setting from whatever was already saved (a reload mid-way
  // through punching it, or after it was already completed) -- otherwise
  // start with one blank row, same as the lamination Job Card.
  const savedJs = Array.isArray(CARD.jobSetting) ? CARD.jobSetting : [];
  if (savedJs.length) savedJs.forEach((r) => jsBody.appendChild(createJsRow(r)));
  else jsBody.appendChild(createJsRow());
  jsRenumber();
  updateStartProdButton();

  // Skip the gate entirely once it has already been cleared -- either Job
  // Setting is saved and every row punched, or a Deckle has already been
  // worked (an older card from before this gate existed, or one reopened
  // mid-run, should never get stuck behind Job Setting again).
  const jsAlreadyDone = savedJs.length > 0 && savedJs.every((r) => r.startTime && r.stopTime);
  const productionAlreadyStarted = ROWS.some((r) => r.startTime || r.status === "done");
  if (jsAlreadyDone || productionAlreadyStarted) revealProduction();
  if (jsAlreadyDone) seedFirstRowStartMtrs(savedJs[savedJs.length - 1].mtrs2);

  // A card left open across a Deckle's curing deadline should unlock itself.
  // Only re-render while something is actually curing, and never while the
  // Stop dialog is open (it would rebuild the list under the operator).
  if (ROWS.some((r) => r.status !== "done" && !curedNow(r))) {
    setInterval(() => {
      if (document.getElementById("stopDialog").classList.contains("show")) return;
      if (ROWS.some((r) => r.status !== "done" && !curedNow(r))) render();
    }, 60000);
  }
</script>
