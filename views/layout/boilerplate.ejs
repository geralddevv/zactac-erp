        <a href="<%= home %>" title="Dashboard" class="<%= title === 'Welcome' ? 'nav-items active' : 'nav-items' %>" style="text-decoration: none; color: inherit; display: flex; align-items: center;">
          <i class="fa-solid fa-house" style="color: #ffffff"></i>
