<% layout('/layout/boilerplate') -%>

<%
  const item = pp.itemId || {};
  const isEmpty = (v) => v === undefined || v === null || (typeof v === "string" && v.trim() === "");
  const dash = (v) => (isEmpty(v) ? "—" : v);
  const escHtml = (v) => String(v).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const fmtDate = (v) => {
    if (!v) return "—";
    const d = new Date(v);
    if (isNaN(d)) return "—";
    return String(d.getDate()).padStart(2, "0") + "/" + String(d.getMonth() + 1).padStart(2, "0") + "/" + d.getFullYear();
  };
  const fmtQty = (v) => (Number.isFinite(Number(v)) && v !== '' && v != null)
    ? Number(v).toLocaleString('en-IN')
    : (v || '—');

  // Every field POOL_MATCH_FIELDS (utils/labelStockProduction.js) actually
  // checks to decide a raw-material reel counts as this layer's material,
  // grouped into one card per physical layer -- Facestock / Adhesive /
  // Release Liner never share a box, so the spec reads as distinct materials
  // rather than one mixed list. Nothing else (Vendor Name, Size, Adhesive's
  // Viscosity/Cohesion/Shear/Density, Release's Size) is part of that match,
  // so it isn't shown here either -- same trim as this page's own
  // reelDetail()/specSummary() further down, keep all three in step.
  //
  // GSM is the exception on all three layers. It is not matched on, but every
  // figure in Raw Material Required is worked out from it -- the kilograms
  // directly, and the metres through it -- and the Adhesive's is what its wet
  // coat weight is derived from. Leaving it off the Adhesive and Release
  // blocks meant the one input those numbers hang on was only visible for the
  // Facestock.
  // Layer order and keys mirror LAYER_ORDER/LAYER_META in utils/
  // labelStockProduction.js (the same grouping the raw-material columns
  // further down this page use) -- keep the two in step.
  const gsm = (v) => (v !== undefined && v !== null && v !== "" ? v + " GSM" : null);
  const mic = (v) => (v !== undefined && v !== null && v !== "" ? v + " MIC" : null);
  const rollType = item.rollType || "NORMAL";

  const LAYER_ORDER = {
    NORMAL: ["facestock", "adhesive", "releaseLiner"],
    "DOUBLE RELEASE": ["facestock", "adhesive", "releaseLiner", "adhesive2", "releaseLiner2"],
    "DOUBLE FACESTOCK": ["facestock", "adhesive", "facestock2", "adhesive2", "releaseLiner"],
  };
  const LAYER_GROUPS = {
    facestock: {
      title: "Facestock", swatch: "facestock",
      fields: (s) => [
        ["Family", s?.facestockFamily], ["Make", s?.facestockMake],
        ["Vendor SKU Code", s?.facestockVendorSkuCode], ["Type", s?.facestockType],
        ["GSM", gsm(s?.facestockGsm)], ["Micron", mic(s?.facestockMicron)],
      ],
    },
    adhesive: {
      title: "Adhesive", swatch: "adhesive",
      fields: (s) => [
        ["Type", s?.adhesiveType], ["Make", s?.adhesiveMake],
        ["Vendor SKU Code", s?.adhesiveVendorSkuCode],
        // The DRY coat weight -- what the wet figure in Raw Material Required
        // is worked out from (dry / ADHESIVE_SOLIDS_PCT x 100).
        ["GSM", gsm(s?.adhesiveGsm)],
      ],
    },
    releaseLiner: {
      title: "Release Liner", swatch: "release",
      fields: (s) => [
        ["Type", s?.releaseLinerType], ["Make", s?.releaseLinerMake],
        ["Vendor SKU Code", s?.releaseLinerVendorSkuCode], ["Color", s?.releaseLinerColor],
        ["GSM", gsm(s?.releaseLinerGsm)],
      ],
    },
  };
  const specFieldFor = { facestock: "facestock", facestock2: "facestock2", adhesive: "adhesive", adhesive2: "adhesive2", releaseLiner: "releaseLiner", releaseLiner2: "releaseLiner2" };
  const baseKeyFor = (key) => key.replace(/2$/, "");

  const materialGroups = (LAYER_ORDER[rollType] || LAYER_ORDER.NORMAL).map((key) => {
    const base = LAYER_GROUPS[baseKeyFor(key)];
    const isLayer2 = key.endsWith("2");
    return {
      title: base.title + (isLayer2 ? " (Layer 2)" : ""),
      swatch: base.swatch,
      fields: base.fields(item[specFieldFor[key]]),
    };
  });
%>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 14px;">
  <style>
    .ap-head h1 { font-size: 20px; color: #fff; margin: 0; }

    .ap-card {
      width: 100%;
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      overflow: visible;
    }
    .ap-card-title {
      background: #044a78;
      color: #fff; font-size: 14px; font-weight: 600; letter-spacing: 0.2px;
      padding: 9px 16px; display: flex; align-items: center; justify-content: space-between; gap: 10px;
      border-radius: 9px 9px 0 0;
    }
    .ap-card .choices__list--dropdown { z-index: 60; }
    /* Choices ships its dropdown at z-index: 1 (choices.min.css), which the
       layer tables' sticky header (z-index below) beat -- so the Machine/
       Operator/Helper lists opened *behind* those headers. The .ap-card rule
       above only covers the two cards up top, not the form, so the form's
       selects need their own lift. Keep this above the sticky header. */
    #assign-form .choices__list--dropdown { z-index: 60; }

    .ap-table-wrap { overflow-x: auto; border: 1px solid #e5e7eb; border-radius: 8px; }
    .ap-table { width: 100%; border-collapse: collapse; font-size: 13px; table-layout: fixed; }
    .ap-table th, .ap-table td { padding: 8px 14px; border-bottom: 1px solid #e5e7eb; border-right: 1px solid #e5e7eb; text-align: left; }
    .ap-table tr > *:last-child { border-right: none; }
    .ap-table th { background: #f8fafc; color: #044a78; font-weight: 700; white-space: nowrap; width: 10%; }
    .ap-table td { color: #1f2a44; font-weight: 600; word-break: break-word; }

    .ap-notice {
      background: #fff8e1; border: 1px solid #f0c36d; color: #7a5b00; border-radius: 8px;
      padding: 10px 14px; font-size: 13px; display: flex; align-items: center; gap: 8px;
    }

    /* ---- Material Details -- physical layer stack (top-to-bottom), same
       layer order/styling as the Sales Order item picker (views/inventory/
       orders/salesOrderForm.ejs renderOrderLabelStockLayerStack()), the Label
       Stock Binding form (views/sachiko/labelStockBindingForm.ejs) and the
       Label Stock View page (views/sachiko/labelStockView.ejs) -- kept in
       sync with all three so the same SKU always renders the same stack
       everywhere. Layer 2 blocks reuse their base material's colour but get
       a dashed border, marking them as the recipe's second pass of that
       material. ---- */
    /* Same strip as the Set Deckle page's job facts: one panel, cells side by
       side, a thin rule between each. Scrolls sideways rather than wrapping. */
    .material-id-row {
      display: grid; grid-auto-flow: column; grid-auto-columns: minmax(155px, auto); justify-content: start; gap: 0;
      width: 100%;
      overflow-x: auto; padding: 0;
      border: 1px solid #e2e8f0; border-radius: 10px; background: #f8fafc; margin-bottom: 12px;
    }
    .material-id-row .mid-item {
      display: flex; flex-direction: column; gap: 4px; min-width: 155px;
      padding: 14px 16px; border-right: 1px solid #e2e8f0;
    }
    .material-id-row .mid-item:first-child { min-width: 170px; }
    /* The strip's own border closes the last cell (Deckle Qty), so that cell
       drops its divider rather than drawing a second line beside it. */
    .material-id-row .mid-item:last-child { border-right: none; }
    .material-id-row .mid-label { font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #7c8ba1; }
    .material-id-row .mid-value { font-size: 19px; font-weight: 800; color: #1f2a44; }
    /* Deckle Qty: the same edit as Edge Trim on the Deckle Set page -- value
       text, a pencil pinned top-right, and the input in its place on click. */
    .material-id-row .dq-cell { position: relative; padding-right: 32px; max-width: 110px; }
    .material-id-row .dq-cell.is-input { background: #fff; padding-right: 12px; }
    .material-id-row .dq-cell.is-input .dq-edit-ic { display: none; }
    /* The input itself: the Edge Trim input's own rules (Deckle Set page). */
    /* Sized in ch, not px: the value is at most 4 digits (max="9999"), so the
       box is 6 characters of this font plus a little padding -- enough for the
       digits, no more. A fixed 96px left a wide empty box around a short
       number. A percentage would be measured against the input's own default
       size (about 20 characters), which is what made it too wide before. */
    .material-id-row .dq-cell .mid-label {
      font-size: 10.5px; letter-spacing: 0.06em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .material-id-row .dq-cell .mid-value {
      font-size: 20px; line-height: 1.3; letter-spacing: 0.02em;
    }
    #dq-cell {
      position: relative;
      padding-right: 32px;
      max-width: none;
      min-width: 0;
    }
    #dq-cell.is-input {
      background: transparent;
    }
    .dq-edit-ic {
      position: absolute; top: 7px; right: 7px;
      border: none; background: rgba(4,74,120,0.09); color: #044a78; cursor: pointer;
      width: 24px; height: 24px; border-radius: 6px; font-size: 11px;
      display: inline-flex; align-items: center; justify-content: center;
    }
    .dq-edit-ic:hover { background: rgba(4,74,120,0.18); }
    .dq-form { margin: 0; }
    .dq-form[hidden] { display: none; }

    /* Lot No & Deckle Qty input fields - match Edge Trim styling */
    #ln-input, #dq-input {
      height: 40px !important; font-size: 19px !important; font-weight: 800 !important; color: #1f2a44;
      width: 100%; padding: 4px 8px; border-radius: 6px; border: 1px solid #044a78; background: #f4f9ff;
      box-sizing: border-box;
    }
    #ln-input:focus, #dq-input:focus { outline: none; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.14); }

    .layer-stack { display: flex; flex-direction: column; gap: 2px; max-height: 340px; overflow-y: auto; padding: 2px; }
    .layer-block {
      background: var(--mg-bg); border: 1.5px solid var(--mg-border); border-radius: 6px;
      padding: 8px 14px; display: flex; justify-content: flex-start; align-items: center; gap: 10px;
    }
    .layer-block.is-layer2 { border-style: dashed; }
    .layer-block-label { font-size: 13px; font-weight: 800; letter-spacing: 0.04em; color: var(--mg-text); white-space: nowrap; width: 130px; flex: 0 0 auto; }
    .layer-block-sep { font-size: 13px; font-weight: 700; color: var(--mg-border); }
    .layer-block-detail { font-size: 13px; font-weight: 800; color: #334155; text-align: left; }
    /* Sized to content, not a fixed column width -- a fixed width here used
       to exist to cap Vendor Name (the one field long enough to need
       truncating), but that field's gone from this card now (see
       LAYER_GROUPS above -- only POOL_MATCH_FIELDS's own fields show here),
       and a fixed width too narrow for "Vendor SKU Code:" made its value
       overflow into the next pair (no visible gap) or get ellipsis-cut even
       when short. */
    .layer-block-detail .lbd-pair { display: inline-flex; align-items: baseline; vertical-align: top; margin-right: 14px; }
    .layer-block-detail .lbd-field { color: #000; font-weight: 600; white-space: nowrap; flex: 0 0 auto; margin-right: 4px; }
    .layer-block-detail .lbd-value { white-space: nowrap; }
    .layer-caret { display: flex; justify-content: center; margin: -2px 0; color: #cbd5e1; font-size: 11px; }

    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }

    /* ---- Raw Material Required (utils/rawMaterialNeed.js) ----
       One strip, same as the Material Details head above, with a rule between
       each layer's compartment. Each compartment carries just "kg | GSM". ---- */
    .rm-need-row {
      /* One row, always. It used to wrap, which dropped the third compartment
         onto a line of its own as soon as the adhesive one grew (it carries the
         most: wet GSM, the dry coat, and the area). The compartments shrink
         instead, and the grey tail inside each wraps if it has to. */
      display: flex; flex-wrap: nowrap; align-items: stretch;
      padding: 14px 18px; border: 1px solid #e5e7eb; border-radius: 8px; background: #f8fafc;
    }
    .rm-need-cell {
      /* Share the strip's width -- each grows out of its own content, so the
         wider adhesive one keeps its room, and all three give way together
         when there isn't enough. */
      flex: 1 1 auto; min-width: 0;
      display: flex; flex-direction: column; gap: 4px; padding: 0 18px;
      border-left: 1px solid #dbe3ec;
    }
    .rm-need-cell:first-child { border-left: none; padding-left: 0; }
    .rm-need-label {
      font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
      color: #7c8ba1;
    }
    .rm-need-value {
      font-size: 18px; font-weight: 800; color: #1f2a44; font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .rm-need-sep { color: #94a3b8; font-weight: 700; padding: 0 3px; }
    /* The adhesive's kilograms carry the whole figure in yellow -- "66.65 kg
       wet" -- because it is the one layer whose weight is a derived wet coat
       rather than the material as stocked. Yellow-600: a true yellow, dark
       enough to stay readable on the strip's near-white background. Every
       other layer's kg keeps the default ink. */
    .rm-need-kg.is-wet, .rm-need-kg.is-wet .rm-need-wet { color: #ca8a04; }
    .rm-need-wet { font-size: 12.5px; font-weight: 700; white-space: nowrap; }
    .rm-need-none { font-size: 12.5px; font-weight: 700; color: #b45309; white-space: nowrap; }
    /* Rides on the same line as the big figure -- the adhesive's dry coat and
       the area its wet weight works out to. */
    /* One row is what a normal desktop gets. Narrower than this the three
       compartments genuinely cannot sit side by side without the figures
       colliding, so they wrap again -- the left rules go and each gets its own
       line, which reads better than a clipped strip. Without this, nowrap above
       would simply overflow: there are no other media queries on this page. */
    @media (max-width: 1100px) {
      .rm-need-row { flex-wrap: wrap; row-gap: 12px; }
      .rm-need-cell { flex: 1 1 260px; border-left: none; padding-left: 0; }
    }

    /* The grey tail after the big figure. Rides on the same line while there is
       room, and is the one part allowed to wrap when there isn't -- the kg and
       R.Mtrs in front never break. */
    .rm-need-sub {
      font-size: 12px; font-weight: 700; color: #64748b;
      font-variant-numeric: tabular-nums; white-space: normal;
    }
    /* Allotment progress -- how much of this layer the ticked reels cover. */
    .rm-need-track {
      display: block; height: 5px; border-radius: 999px; background: #e2e8f0; overflow: hidden; margin-top: 2px;
    }
    .rm-need-track i { display: block; height: 100%; width: 0; background: #b45309; border-radius: 999px; transition: width 0.18s ease; }
    .rm-need-track.is-covered i { background: #15803d; }
    .rm-need-left {
      font-size: 12.5px; font-weight: 700; color: #b45309;
      font-variant-numeric: tabular-nums; display: flex; flex-wrap: wrap; gap: 2px 0;
    }
    .rm-need-left.is-covered { color: #15803d; }
    .rm-need-left b { font-weight: 800; }
    .rm-need-left .rm-need-of { color: #94a3b8; font-weight: 600; }
    .rm-need-left .rm-need-unknown { color: #b45309; font-weight: 700; margin-left: 10px; }
    /* One clause per unit -- kg and mtrs sit side by side, each coloured by
       whether that side is covered. */
    .rm-need-left .rm-part { color: #b45309; }
    .rm-need-left .rm-part.is-covered { color: #15803d; }
    /* A reel narrower than EVERY web this batch runs -- it cannot be mounted
       for any of its deckles, however many metres it holds. A reel that fits
       some of the webs but not the widest is NOT this: it is the right reel
       for part of a mixed-web plan, and says so in its tooltip instead.
       Still tickable; just never silently. */
    .raw-layer-table tbody tr.raw-layer-row-narrow td[data-col="size"],
    .raw-layer-table tbody tr.raw-layer-row-narrow td[data-col="mtrs"] { color: #b45309; font-weight: 700; }
    .rm-need-left .rm-part + .rm-part { margin-left: 12px; padding-left: 12px; border-left: 1px solid #dbe3ec; }
    .mid-mixed {
      display: inline-block; margin-left: 7px; font-size: 10px; font-weight: 800;
      letter-spacing: 0.04em; text-transform: uppercase; color: #b45309;
      background: #fff8e1; border: 1px solid #f0c36d; border-radius: 999px; padding: 1px 8px;
      vertical-align: middle;
    }

    /* ---- "How this was worked out": the derivation, collapsed by default. ---- */
    .rm-work { margin-top: 12px; border-top: 1px solid #e5e7eb; padding-top: 10px; }
    .rm-work > summary {
      cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: 7px;
      font-size: 12px; font-weight: 700; color: #044a78; letter-spacing: 0.02em; user-select: none;
    }
    .rm-work > summary::-webkit-details-marker { display: none; }
    .rm-work > summary::before {
      font-family: "Font Awesome 6 Free"; font-weight: 900; content: "\f054";
      font-size: 9px; transition: transform 0.18s ease;
    }
    .rm-work[open] > summary::before { transform: rotate(90deg); }
    .rm-work > summary:hover { color: #03365a; }
    .rm-work-body { padding: 10px 2px 2px; }
    .rm-work-step { display: flex; align-items: center; gap: 8px; margin: 12px 0 6px; }
    .rm-work-step:first-child { margin-top: 2px; }
    .rm-work-no {
      flex: none; width: 18px; height: 18px; border-radius: 50%; background: #044a78; color: #fff;
      font-size: 10.5px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center;
    }
    .rm-work-label { font-size: 12px; font-weight: 700; color: #1f2a44; }
    .rm-work-table {
      width: 100%; border-collapse: separate; border-spacing: 0; background: #fff;
      border: 1px solid #e5e7eb; border-radius: 7px; overflow: hidden; font-size: 12px;
    }
    .rm-work-table th {
      background: #f8fafc; color: #64748b; font-size: 10px; font-weight: 700;
      letter-spacing: 0.05em; text-transform: uppercase; padding: 5px 10px; text-align: left; white-space: nowrap;
    }
    .rm-work-table td { padding: 5px 10px; border-top: 1px solid #f1f5f9; color: #1f2a44; font-variant-numeric: tabular-nums; }
    .rm-work-table .ta-r { text-align: right; }
    .rm-work-table .rm-work-total td { background: #f8fafc; font-weight: 800; }
    .rm-work-note { color: #64748b; font-weight: 600; font-variant-numeric: normal; }
    .rm-work-eqline { margin: 0; font-size: 12px; color: #475569; line-height: 1.6; }
    .rm-work-eq { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; color: #044a78; }
    .rm-work-warn { color: #b45309; font-weight: 700; }
    .rm-work-sub { font-size: 11.5px; font-weight: 800; color: #044a78; margin: 10px 0 5px; }
    .rm-work-table tr.rm-work-sum td { background: #f8fafc; font-weight: 800; }
    .rm-work-table tr.rm-work-sum td.is-short { color: #b45309; }
    .rm-work-table tr.rm-work-sum td.is-covered { color: #15803d; }
    .rm-work-roll { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; }

    .material-group--facestock { --mg-border: #93c5fd; --mg-bg: #eff6ff; --mg-text: #1d4ed8; }
    .material-group--adhesive  { --mg-border: #fcd34d; --mg-bg: #fffbeb; --mg-text: #b45309; }
    .material-group--release   { --mg-border: #cbd5e1; --mg-bg: #f8fafc; --mg-text: #475569; }

    .material-wordfile { margin-top: 12px; }
    .material-wordfile a { display: inline-flex; align-items: center; gap: 6px; color: #044a78; font-weight: 600; text-decoration: none; font-size: 13px; }

    /* ---- Deckle Size dialog -- shown once, on load, before the rest of the
       page is worth acting on: the value it captures is echoed onto the
       Material Details card (mid-item below) and pre-fills the Size filter
       box on every Facestock/Release Liner allotment column further down
       (see the DOMContentLoaded handler). No close button/backdrop-dismiss
       -- unlike every other dialog on this page there's nothing sensible to
       fall back to if it's dismissed unanswered, so it isn't offered. ---- */
    .dialog-header {
      background: #044a78; padding: 18px 22px;
      display: flex; align-items: center; justify-content: space-between;
      border-radius: 14px 14px 0 0;
    }
    .dialog-header h2 { margin: 0; font-size: 1.05rem; font-weight: 700; color: #fff; }
    .dialog-body { padding: 18px 20px; background: #fff; border-radius: 0 0 14px 14px; }
    .dialog-field-label {
      display: block; font-size: 13px; font-weight: 800; letter-spacing: 0.02em;
      color: #334155; text-transform: uppercase; margin-bottom: 7px;
    }
    .dialog-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 14px; }

    .ap-form-card {
      width: 100%; background: #fff; border-radius: 10px;
      border: 1px solid #e2e8f0; padding: 16px 18px; display: flex; flex-direction: column; gap: 14px;
    }
    .ap-submit-btn {
      background: #044a78; color: #fff; border: none; border-radius: 8px;
      padding: 10px 22px; font-size: 14.5px; font-weight: 600; cursor: pointer; transition: opacity 0.2s;
    }
    .ap-submit-btn:hover { opacity: 0.88; }
    /* .btn-grp (common.css) declares justify-content/align-items but never
       display:flex, so its buttons default to plain left-aligned block flow
       -- scope the fix to this page rather than the shared class. */
    #assign-form .btn-grp { display: flex; justify-content: center; }

    .jc-readonly {
      background: #f0f7ff !important;
      color: #044a78 !important;
      font-weight: 700 !important;
      cursor: default !important;
    }

    .span-three input.form-control, .span-four input.form-control, .span-five input.form-control,
    .span-six input.form-control, .span-dual input.form-control,
    .span-three select.form-control, .span-four select.form-control, .span-five select.form-control,
    .span-six select.form-control, .span-dual select.form-control {
      padding: 0.375rem 0.5rem !important;
      font-size: 1rem !important;
      height: auto !important;
      width: 100%;
    }
    .span-three .choices__inner, .span-four .choices__inner, .span-five .choices__inner,
    .span-six .choices__inner, .span-dual .choices__inner {
      min-height: 2.3rem;
      padding: 0.375rem 0.5rem !important;
      display: flex;
      align-items: center;
    }
    .span-three .choices__list--single, .span-four .choices__list--single,
    .span-five .choices__list--single, .span-six .choices__list--single,
    .span-dual .choices__list--single { padding: 0; }

    /* ---- Machine / Operator / Helper ----
       One strip across the form, styled like the Material Details card at the
       top of the page (small-caps label, thin rule between compartments) so
       the two read as the same page. Each label sits BESIDE its control
       rather than above it: three stacked label/control cards is most of a
       screenful for three picks that are made once and then scrolled past.
       Wraps to two rows only when the window is genuinely too narrow to hold
       three controls at a usable width. */
    .ap-picks {
      grid-column: 1 / -1;
      display: flex; flex-wrap: wrap; align-items: center; gap: 4px 0;
      padding: 9px 14px; border: 1px solid #e5e7eb; border-radius: 8px; background: #f8fafc;
    }
    .ap-pick {
      position: relative;
      flex: 1 1 240px; min-width: 0;
      display: flex; flex-direction: row; align-items: center; gap: 9px;
      padding: 0 14px; border-left: 1px solid #dbe3ec;
    }
    .ap-pick:first-child { border-left: none; padding-left: 0; }
    .ap-pick:last-child { padding-right: 0; }
    .ap-pick > label {
      flex: 0 0 auto; margin: 0;
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em;
      /* common.css paints every label with --primary-dark; these are captions
         beside their control, not headings, so they take the same muted grey
         the rest of this page's small-caps labels use. */
      text-transform: uppercase; color: #7c8ba1 !important; white-space: nowrap;
    }
    /* The bare <select> for the moment before Choices wraps it (and if the
       script ever fails to load) -- same size and shape, so there is no jump
       on first paint and the strip still works without JS. */
    .ap-pick > select.form-control {
      flex: 1 1 auto; min-width: 0;
      height: 34px !important; padding: 0 26px 0 11px !important;
      background: #fff; border: 1.5px solid #cbd5e1; border-radius: 7px;
      font-size: 13.5px !important; font-weight: 600; color: #1f2a44;
      appearance: none; -webkit-appearance: none;
    }
    /* Choices renders the real control; the <select> itself is hidden. These
       override common.css, which pins .choices__inner to a 1px black border
       with !important. */
    /* basis 0 rather than auto: common.css puts `width: 100%` on .choices, and
       next to a label in a flex row that would size it off the whole strip and
       lean on shrink to claw it back. */
    .ap-pick .choices { flex: 1 1 0%; width: auto; min-width: 0; margin-bottom: 0; }
    .ap-pick .choices__inner {
      min-height: 34px !important; height: 34px;
      padding: 0 26px 0 11px !important;
      display: flex; align-items: center;
      background: #fff; border: 1.5px solid #cbd5e1 !important; border-radius: 7px;
      font-size: 13.5px; font-weight: 600; color: #1f2a44;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .ap-pick .choices:hover .choices__inner { border-color: #94a3b8 !important; }
    .ap-pick .choices__list--single { padding: 0; width: 100%; }
    .ap-pick .choices__list--single .choices__item {
      font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;
    }
    .ap-pick .choices__placeholder { color: #94a3b8; opacity: 1; font-weight: 500; }
    /* The chevron. Choices' own ::after arrow is switched off globally in
       common.css, so this draws one on the field instead -- pointer-events
       off, or it would swallow the click that opens the dropdown. */
    .ap-pick::after {
      content: ""; position: absolute; right: 24px; top: 50%; margin-top: -4px;
      width: 6px; height: 6px; transform: rotate(45deg);
      border-right: 1.6px solid #94a3b8; border-bottom: 1.6px solid #94a3b8;
      pointer-events: none;
    }
    .ap-pick:last-child::after { right: 10px; }
    /* The strip is compact, so the focus ring is drawn tight rather than the
       3px one common.css puts on a full-size field. */
    .ap-pick .choices.is-open .choices__inner,
    .ap-pick .choices.is-focused .choices__inner,
    .ap-pick .choices.choices--focused .choices__inner {
      border-color: #044a78 !important; box-shadow: 0 0 0 2.5px rgba(4, 74, 120, 0.14) !important;
    }
    @media (max-width: 860px) {
      .ap-picks { gap: 8px 0; }
      .ap-pick { flex: 1 1 100%; border-left: none; padding: 0; }
    }

    #assign-form {
      display: grid !important;
      grid-template-columns: repeat(32, 1fr);
      gap: 1rem;
    }

    .roll-table { table-layout: auto; }
    .roll-table th { width: auto; font-size: 12.5px; }
    .roll-table td { font-size: 13.5px; }
    .roll-table tbody tr { cursor: pointer; user-select: none; }
    .roll-table tbody tr:hover { background: #eff6ff; }
    .roll-table .roll-check-cell { width: 56px; text-align: center; }
    .roll-table th:not(.roll-fill), .roll-table td:not(.roll-fill) { white-space: nowrap; width: 1%; }
    .roll-table .roll-fill { width: 100%; border-right: none; }
    .roll-table input[type="checkbox"] {
      width: 20px; height: 20px; margin: 0; vertical-align: middle;
      cursor: pointer; accent-color: #044a78;
    }
    .roll-table tbody tr.roll-locked,
    .roll-table tbody tr.roll-locked:hover { background: #f8fafc; cursor: not-allowed; }
    .roll-table tbody tr.roll-locked td { color: #94a3b8; }
    .roll-table tbody tr.roll-locked input[type="checkbox"] { cursor: not-allowed; }

    /* A reel with no invoice number recorded can't be assigned -- flagged
       red rather than the greyed-out .roll-locked treatment above, since
       this signals a data problem to go fix (missing invoice), not just
       "unavailable right now". */
    .raw-layer-table tbody tr.raw-layer-row-no-invoice,
    .raw-layer-table tbody tr.raw-layer-row-no-invoice:hover { background: #fef2f2; cursor: not-allowed; }
    .raw-layer-table tbody tr.raw-layer-row-no-invoice td { color: #b91c1c; }
    .raw-layer-table tbody tr.raw-layer-row-no-invoice input[type="checkbox"] { cursor: not-allowed; }

    /* ---- Raw Material Allotment -- one inline column per raw-material
       layer, styled like .roll-table above. NORMAL needs 3 (Facestock/
       Adhesive/Release Liner); DOUBLE RELEASE and DOUBLE FACESTOCK need 5 --
       the grid is auto-fit rather than a fixed 3 columns so those extra
       columns just wrap onto a second row instead of needing their own
       layout.

       ---- knob: the 430px min track ----
       This is what decides how many layer columns sit side by side, and it
       has to be at least what one column's table needs, because the table
       runs `table-layout: fixed` over a <colgroup>: the fixed columns
       (checkbox/Size/GSM/Kg/R.Mtrs, ~270px on a facestock column) take their
       declared widths first and the flexible text columns -- Vendor, Make,
       Code -- divide whatever is LEFT. Squeeze the track and that leftover
       goes to nothing, so the three columns a reel is actually recognised by
       collapse to a few pixels of ellipsis and the table reads as empty.

       At 230px it did exactly that: three columns were forced onto one row on
       any normal laptop (~410px each, after the sidebar, page and form
       padding), leaving ~37px apiece for Vendor/Make/Code.

       430px means a laptop shows two layers per row and a wide monitor three,
       each ~600px, which is room for every column to hold its value. Extra
       columns wrap onto another row; nothing is hidden. `min(100%, ...)`
       keeps a viewport narrower than one track from overflowing the page --
       the column scrolls sideways inside itself instead
       (.raw-layer-scroll). ---- */
    #rawLayersGrid {
      grid-column: 1 / -1; display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 430px), 1fr));
      gap: 14px;
    }
    .raw-layer-col { min-width: 0; }
    /* Last-resort horizontal scroll for one column, holding BOTH of its
       tables (the header table and the scrolling body) so they can never
       drift out of line -- they slide together as one. It only bites when the
       track is narrower than the min-width below, which the 430px min track
       above is chosen to avoid on any real screen; it is here so a narrow
       window degrades into "scroll to see the rest" rather than into the
       collapsed, unreadable columns described above. */
    .raw-layer-scroll { overflow-x: auto; }
    .raw-layer-scroll > * { min-width: var(--rl-min, 500px); }
    /* Per pool, because the pools don't carry the same columns: facestock has
       Size/GSM on top of Vendor/Make/Code, release swaps Make/Code for
       Sensing, adhesive has neither Size nor GSM (see POOL_COLUMNS). Each
       figure is that pool's fixed <colgroup> widths plus a readable share for
       its flexible text columns. Set on .raw-layer-col -- the grid item -- so
       the value is in scope for the wrapper inside it. */
    .raw-layer-col[data-pool="facestock"] { --rl-min: 500px; }
    .raw-layer-col[data-pool="release"]   { --rl-min: 460px; }
    .raw-layer-col[data-pool="adhesive"]  { --rl-min: 400px; }
    /* The body table keeps its own vertical scroll, but must NOT open a
       horizontal scroller of its own inside .raw-layer-scroll -- that is the
       one that would scroll independently of the header sitting above it.
       `hidden` rather than `visible`, because an element whose overflow-y is
       `auto` computes an overflow-x of `visible` back to `auto` and the
       second scrollbar would return. Nothing is lost to the clip: the wrap
       carries the same min-width as the header table above it and the table
       inside is width:100% of that, so there is no horizontal overflow here
       to hide -- the sideways scrolling all happens one level up, where both
       tables move together. */
    .raw-layer-table-wrap.ap-table-wrap { overflow-x: hidden; }
    /* Layer heading -- the layer's name and the recipe it has to match sit
       on one line. They only drop onto a second line when the column is too
       narrow to hold both, so nothing is ever clipped or hidden behind a
       tooltip. */
    .raw-layer-head {
      display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; margin-bottom: 6px;
    }
    .raw-layer-title { font-size: 13px; font-weight: 700; color: #044a78; }
    .raw-layer-spec { font-size: 13px; font-weight: 600; color: #1f2a44; }
    .raw-layer-table td, .raw-layer-table th { white-space: normal; }
    /* ================= LAYER TABLE COLUMN WIDTHS -- THE knob =================
       Change the px values below (each paired with the side padding that
       goes with it); that is the whole control over one table's columns.
       How many of these tables sit side by side is the other knob, the min
       track on #rawLayersGrid above -- the two together decide whether
       Vendor/Make/Code have room, so read that note as well.

       Why it has to work this way: these tables inherit `.roll-table`'s
       `table-layout: auto` plus `.roll-table td:not(.roll-fill) {width: 1%}`
       on EVERY cell, and none of the columns is marked `.roll-fill`. With
       the table at width:100% and no column willing to absorb the slack,
       an auto layout hands the leftover space out across all four columns
       -- so the checkbox column stayed fat no matter what width it was
       given (5px included). Switching these tables to `table-layout: fixed`
       and declaring the widths on a <colgroup> (built in layerColumnHtml())
       makes the numbers below authoritative, and neutralising that `1%`
       stops the leftover from being sprayed back over them.

       Columns with no width here are deliberate: Facestock's and
       Adhesive's Vendor/Make/Code, and Release Liner's Vendor, are flexible
       -- fixed table
       layout splits whatever the fixed columns leave over equally between
       them, and each ellipsises past its share. See POOL_COLUMNS. */
    .raw-layer-table.roll-table { table-layout: fixed; }
    .raw-layer-table.roll-table th,
    .raw-layer-table.roll-table td { width: auto; padding-left: 12px; padding-right: 12px; }
    /* Size/Kg/R.Mtrs carry the 12px side padding above on both sides, so their
       widths are 24px of padding plus room for the value itself. R.Mtrs needs
       the most: a 516 kg reel is 12,647 metres, four or five digits, and the
       header word is longer than the numbers under it. */
    .raw-layer-table col.rl-col-check { width: 34px; }  /* 20px checkbox + 7px each side */
    .raw-layer-table col.rl-col-size  { width: 54px; }  /* facestock columns only */
    .raw-layer-table col.rl-col-gsm   { width: 50px; }  /* facestock columns only */
    .raw-layer-table col.rl-col-kg    { width: 58px; }
    .raw-layer-table col.rl-col-sqm   { width: 70px; }
    .raw-layer-table col.rl-col-sensing { width: 84px; }  /* release column only */
    /* ...and those six widths are 8px narrower than they look, because the
       fixed columns take 8px of side padding instead of the 12px above. The
       two were cut together, so every one of these columns has exactly the
       room for its value that it had before -- the 8px each saves goes to
       Vendor/Make/Code, which are the columns that actually run out of width
       and ellipsise. Move a width and its padding together, or the header
       word ("R.Mtrs" is wider than the figures under it) starts to clip.
       The search row underneath sets its own, tighter padding. */
    .raw-layer-table th[data-sort="size"], .raw-layer-table td[data-col="size"],
    .raw-layer-table th[data-sort="gsm"], .raw-layer-table td[data-col="gsm"],
    .raw-layer-table th[data-sort="kg"], .raw-layer-table td[data-col="kg"],
    .raw-layer-table th[data-sort="mtrs"], .raw-layer-table td[data-col="mtrs"],
    .raw-layer-table th[data-sort="sensing"], .raw-layer-table td[data-col="sensing"] {
      padding-left: 8px; padding-right: 8px;
    }
    /* Checkbox cell keeps a tighter padding than the rest -- the two have to
       be kept in step with the col width above: 20px box + these two
       paddings. The checkbox itself is 20px square, set in
       `.roll-table input[type="checkbox"]` further up -- shrink that first
       if you ever want this column under 20px + padding. */
    .raw-layer-table td.roll-check-cell,
    .raw-layer-table th.roll-check-cell { padding-left: 7px; padding-right: 7px; }
    /* ---- Layer table height -- knob: the height below ----
       A location can hold far more reels of one material than fit on
       screen, so each layer table is a fixed height and scrolls past that
       (styled by .custom-scrollbar, defined further up). A hard `height`,
       not `max-height`: every layer column stays the same height whether it
       has two candidate reels or fifty, so the columns line up instead of
       going ragged -- a short one just leaves empty space under its last
       row. */
    .raw-layer-table-wrap {
      height: 320px; overflow-y: auto;
      /* Loses the top corners/border edge to the header table sitting
         directly above it (see .raw-layer-table-head below), so the seam
         between the two is a single hairline instead of a doubled-up border. */
      border-top: none; border-radius: 0 0 8px 8px;
    }
    /* Header rows aren't "stuck" over a scrolling table at all -- they live
       in their own separate, non-scrolling <table> directly above the
       scrollable body table (see layerColumnHtml's raw-layer-table-head),
       both sharing one <colgroup> so their columns line up. That replaces
       position: sticky entirely: a sticky header re-pins itself against the
       viewport on every scroll frame, and any sub-pixel rounding in that
       process is what made the header and search row visibly drift apart
       and back together while scrolling. A header that was never part of
       the scrolling content in the first place has nothing left to drift
       against.
       Border/radius: .ap-table-wrap (below) still frames the body table with
       its own border+radius; this table gets the matching top corners and a
       border on the three sides the wrap doesn't share, so the two tables
       read as one continuous box with a seam exactly where the header ends. */
    .raw-layer-table-head {
      border: 1px solid #e5e7eb; border-bottom: none;
      border-radius: 8px 8px 0 0;
    }
    .raw-layer-table-head th { background: #f8fafc; }
    /* Column headings sort their own table -- click once for ascending, again
       for descending (see the th[data-sort] handler). No direction marker is
       drawn on the heading; the pointer cursor and hover colour are all that
       say it's clickable. */
    .raw-layer-table th.rl-sortable { cursor: pointer; user-select: none; }
    .raw-layer-table th.rl-sortable:hover { color: #0b6ea8; }
    .raw-layer-table-head tr.raw-layer-search-row th {
      background: #fff;
      /* Tighter than the 12px the data cells carry -- every px of a 58px
         column is needed by the input itself. */
      padding: 5px 5px;
    }
    .raw-layer-table-head tr.raw-layer-search-row th.roll-check-cell { padding: 5px 3px; }
    /* Text cells (Details, and Adhesive's Vendor/Make/Code -- whichever
       POOL_COLUMNS marks `trunc`) can run longer than these narrow columns.
       Truncate with an ellipsis instead of wrapping or pushing the table
       wider; the cell's title attribute carries the full text as a hover
       tooltip, and the filter box above it searches that tooltip too, so
       nothing becomes unfindable by being cut off. No max-width: the
       <colgroup> and table-layout: fixed decide the width now. */
    .raw-layer-detail-cell {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* Per-layer search box -- one per raw-material column, filtering only
       that column's own candidate reels (see filterLayerRows below). */
    /* One filter box per searchable column, living in the table's own header
       (a search row under the column labels, see layerColumnHtml) -- so no
       outer margins, and no magnifier icon: Size/GSM/Kg are only ~60px wide
       and an icon would eat the room the value needs. */
    .raw-layer-search {
      /* tableDisp.css (loaded by this page) pins every input to
         `height: 20px`, and common.css puts `box-sizing: border-box` on
         everything -- together that leaves the padding below no room to
         show. Height has to go back to auto for the box to grow around it.
         Background is left to that same global rule, which sets it
         !important. */
      height: auto;
      width: 100%; padding: 6px 7px; font-size: 12px; line-height: 1.3;
      border: 1px solid #cbd5e1; border-radius: 6px; color: #0f172a;
      /* Narrow columns: never let the box force the column wider than the
         <colgroup> width it was given. */
      min-width: 0;
    }
    .raw-layer-search:focus {
      outline: none; border-color: #044a78; box-shadow: 0 0 0 2px rgba(4, 74, 120, 0.12);
    }
    .raw-layer-search::-webkit-search-cancel-button { cursor: pointer; }
    /* Rides under the search box in the same header cell. `white-space` is
       reset because .roll-table's `th:not(.roll-fill) { white-space: nowrap }`
       is inherited into it here, and this note is a sentence, not a value. */
    .raw-layer-hidden-note {
      font-size: 11px; color: #b45309; margin: 4px 0 0; white-space: normal; line-height: 1.35;
    }
    /* The width this column is listing, beside the layer's name. */
    .raw-layer-web {
      font-size: 11px; font-weight: 700; color: #0f766e; background: #ecfdf5;
      border: 1px solid #a7f3d0; border-radius: 999px; padding: 1px 8px; white-space: nowrap;
    }
    .raw-layer-web.is-open { color: #b45309; background: #fff8e1; border-color: #f0c36d; }
    .rl-web-toggle {
      border: none; background: none; padding: 0 0 0 6px; margin: 0; cursor: pointer;
      font-size: 11px; font-weight: 700; color: #7c8ba1; text-decoration: underline;
      text-underline-offset: 2px;
    }
    .rl-web-toggle:hover { color: #044a78; }
    .raw-layer-web.is-open .rl-web-toggle { color: #b45309; }
    /* Ticked reels are pinned to the top of their table (see sortedReelsFor),
       so they read as one block rather than as scattered rows. */
    .raw-layer-table tbody tr.raw-layer-row-picked { background: #f4f9ff; }
    .raw-layer-table tbody tr.raw-layer-row-picked td { font-weight: 700; }

    /* ---- Auto Allot (FIFO) ----
       Same panel/chip/notes furniture as AI Deckle Set on the Deckle Set page
       (views/inventory/orders/deckleSetForm.ejs's .dsa-* block) -- the two are
       the same kind of thing (a read-only suggestion dropped into a form the
       user still has to submit), so they look the same. ---- */
    .rma-panel {
      /* The .span-full wrapper this sits in is a flex column with
         `align-items: flex-start` (common.css), which shrinks a child to its
         own content width -- the panel came out as wide as its longest note
         instead of as wide as the page. Same fix .dsa-panel carries on the
         Deckle Set page. */
      align-self: stretch; width: 100%;
      background: #fff; border: 1.5px solid #cfe0f0; border-radius: 10px;
      overflow: hidden; margin: 0 0 12px;
    }
    .rma-bar {
      display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
      padding: 11px 14px; background: linear-gradient(180deg, #f6fbff, #eef5fc);
      border-bottom: 1px solid #dfeaf5;
    }
    .rma-spacer { flex: 1 1 auto; }
    .rma-run {
      display: inline-flex; align-items: center; gap: 8px; border: none;
      background: #044a78; color: #fff; border-radius: 8px;
      padding: 9px 18px; font-size: 13px; font-weight: 800; cursor: pointer;
      letter-spacing: 0.02em; white-space: nowrap;
    }
    .rma-run:hover { background: #06639f; }
    .rma-run:disabled { opacity: 0.5; cursor: not-allowed; }
    .rma-clear {
      display: inline-flex; align-items: center; gap: 7px; border: 1.5px solid #cbd5e1;
      background: #fff; color: #1f2a44; border-radius: 8px;
      padding: 8px 14px; font-size: 12.5px; font-weight: 700; cursor: pointer; white-space: nowrap;
    }
    .rma-clear:hover { border-color: #044a78; color: #044a78; }
    .rma-check {
      display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
      margin: 0; padding: 5px 10px 5px 8px; border: 1.5px solid #cbd5e1;
      border-radius: 8px; background: #fff; height: 34px;
    }
    .rma-check:hover { border-color: #044a78; }
    .rma-check input { width: 16px; height: 16px; accent-color: #044a78; cursor: pointer; flex: none; margin: 0; }
    .rma-check span.t { display: block; font-size: 12px; font-weight: 700; color: #1f2a44; white-space: nowrap; }
    .rma-check:has(input:checked) { border-color: #044a78; background: #f4f9ff; }
    .rma-body { padding: 0; }
    .rma-body:empty { display: none; }
    .rma-result { display: flex; flex-wrap: wrap; gap: 0; border-bottom: 1px solid #eef1f6; }
    .rma-stat {
      flex: 1 1 auto; min-width: max-content; padding: 14px 20px;
      border-right: 1px solid #eef1f6; display: flex; flex-direction: column; gap: 6px;
    }
    .rma-stat:last-child { border-right: none; }
    .rma-stat .k {
      font-size: 10px; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; color: #7c8ba1; white-space: nowrap;
    }
    .rma-stat .v {
      font-size: 19px; font-weight: 800; color: #1f2a44;
      font-variant-numeric: tabular-nums; white-space: nowrap;
    }
    .rma-stat .v.good { color: #15803d; }
    .rma-stat .v.warn { color: #b45309; }
    .rma-stat .v.bad { color: #b91c1c; }
    /* The per-layer table, folded away -- see renderAutoSummary. */
    .rma-detail { border-bottom: 1px solid #eef1f6; }
    .rma-detail > summary {
      display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none;
      padding: 8px 14px; background: #f8fafc; list-style: none;
      font-size: 10px; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; color: #7c8ba1;
    }
    .rma-detail > summary::-webkit-details-marker { display: none; }
    .rma-detail > summary:hover { color: #044a78; }
    .rma-caret { font-size: 9px; transition: transform 0.15s ease; }
    .rma-detail[open] > summary .rma-caret { transform: rotate(90deg); }
    .rma-detail-sub {
      text-transform: none; letter-spacing: 0; font-weight: 600; color: #94a3b8;
    }
    .rma-detail .rma-table { border-top: 1px solid #eef1f6; }
    .rma-detail .rma-table tr:last-child td { border-bottom: none; }
    .rma-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .rma-table th, .rma-table td {
      padding: 7px 14px; text-align: left; border-bottom: 1px solid #eef1f6; white-space: nowrap;
    }
    .rma-table th {
      font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      color: #7c8ba1; background: #f8fafc;
    }
    .rma-table td.ta-r, .rma-table th.ta-r { text-align: right; font-variant-numeric: tabular-nums; }
    .rma-table td.rma-reels { white-space: normal; color: #5b6b80; font-size: 11.5px; line-height: 1.5; }
    .rma-table .rma-layer { font-weight: 800; color: #1f2a44; }
    .rma-tag {
      display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: 0.04em;
      border-radius: 999px; padding: 2px 8px; white-space: nowrap;
    }
    .rma-tag.ok { color: #15803d; background: #ecfdf5; border: 1px solid #a7f3d0; }
    .rma-tag.short { color: #b45309; background: #fff8e1; border: 1px solid #f0c36d; }
    .rma-tag.none { color: #b91c1c; background: #fef2f2; border: 1px solid #fecaca; }
    .rma-notes { padding: 9px 14px; font-size: 12px; line-height: 1.6; color: #5b6b80; }
    .rma-notes ul { margin: 0; padding-left: 17px; }
    .rma-notes li { margin: 3px 0; }
    .rma-notes li.is-warn { color: #b45309; font-weight: 600; }
    .rma-notes li.is-bad { color: #b91c1c; font-weight: 700; }
    .rma-err {
      padding: 10px 14px; background: #fef2f2; color: #991b1b;
      font-size: 12.5px; font-weight: 700; line-height: 1.5;
    }
    /* Reels the run picked -- marked in the layer tables themselves so a pick
       can be traced back to the row it came from, and so a reel ticked by hand
       afterwards is visibly not part of the plan. */
    .raw-layer-table tbody tr.raw-layer-row-auto { background: #f4f9ff; }
    .raw-layer-table tbody tr.raw-layer-row-auto td:first-child { box-shadow: inset 3px 0 0 #044a78; }

    .ap-lotno-row {
      display: flex; align-items: center; gap: 8px; justify-content: flex-end;
      flex-wrap: wrap; margin-top: 2px;
    }
    .ap-lotno-row label {
      font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      color: rgba(255,255,255,0.75);
    }
    .lotno-input {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 15px; font-weight: 700; color: #fff;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.4);
      border-radius: 8px; padding: 6px 12px;
      width: 300px; max-width: 100%;
      text-align: left; letter-spacing: 0.01em;
      transition: border-color .15s ease, background .15s ease, box-shadow .15s ease;
    }
    .lotno-input::placeholder { color: rgba(255,255,255,0.45); font-weight: 500; }
    .lotno-input:hover { border-color: rgba(255,255,255,0.6); }
    .lotno-input:focus {
      outline: none; border-color: #7dd3fc; background: rgba(255,255,255,0.18);
      box-shadow: 0 0 0 3px rgba(125,211,252,0.28);
    }
  </style>

  <div class="indi-head ap-head" style="display:flex; align-items:center; justify-content:space-between; gap:14px;">
    <div>
      <h1>Assign Production</h1>
    </div>
    <div style="text-align:right; color:#fff; line-height:1.4;">
      <div style="font-size:20px; font-weight:600;">Date: <%= fmtDate(new Date()) %></div>
    </div>
  </div>

  <% if (advance) { %>
    <div class="adv-banner">
      <i class="fa-solid fa-calendar-plus"></i>
      <span>ADVANCE — <%= advance.rolls %> of <%= pp.quantity %> roll(s) in this deckle were set before their sales order was placed. They stay flagged until the order comes in.</span>
    </div>
  <% } %>

  <div class="ap-card">
    <div class="ap-card-title"><span><i class="fa-solid fa-layer-group"></i> Material Details</span></div>
    <div style="padding: 14px;">
      <div class="material-id-row">
        <div id="ln-cell" data-lot-own="<%= pp.lotNo && pp.lotNo === previewLotNo ? "1" : "0" %>" style="position: relative; display: flex; flex-direction: column; gap: 4px; min-width: 320px; padding: 11px 12px; border-right: 1px solid #e2e8f0;">
          <span class="mid-label">Lot No</span>
          <!-- Inline editing is switched off for now: the last Lot No used is
               set once per product in the Lot No Setup dialog (bottom of this
               page), which this gear opens. POST .../lot-no is refused
               server-side too. Only the roles that may change the series see
               the gear. -->
          <% if (authUser && ["proprietor", "admin", "hod"].includes(authUser.role)) { %>
          <button type="button" id="ln-edit" class="dq-edit-ic" title="Set the last Lot No and Deckle No used (Lot &amp; Deckle No Setup)" aria-label="Open Lot No and Deckle No Setup" aria-haspopup="dialog">
            <i class="fa-solid fa-gear"></i>
          </button>
          <% } %>
          <span class="mid-value" id="ln-text"><%= dash(previewLotNo) %></span>
          <input type="hidden" id="ln-input" name="lotNo" value="<%= previewLotNo || "" %>" />
        </div>
        <div class="mid-item"><span class="mid-label">Product Code</span><span class="mid-value"><%= dash(item.productCode || item.skuCode) %></span></div>
        <!-- Set on the Deckle Set page (before an order ever reaches Assign
             Production); the dialog below only asks again for a legacy
             order that somehow got here without one.

             A mixed-web plan laminates several WIDTHS off one batch, and
             `pp.deckleSize` is only the one carrying the most webs -- showing
             it alone read as though the whole job ran at that width, which is
             how a 635 mm web could turn up in the raw-material working with
             nothing on this card admitting it existed. Every width in play is
             named here instead, widest first, with the web count against each. -->
        <%
          const layoutWidths = (Array.isArray(pp.deckleLayout) ? pp.deckleLayout : [])
            .map((L) => ({ w: Number(L.deckleSize) > 0 ? Number(L.deckleSize) : Number(pp.deckleSize),
                           n: Math.max(1, Math.floor(Number(L.count) || 1)) }))
            .filter((x) => x.w > 0);
          const byWidth = new Map();
          layoutWidths.forEach((x) => byWidth.set(x.w, (byWidth.get(x.w) || 0) + x.n));
          const widths = [...byWidth.entries()].sort((a, b) => b[0] - a[0]);
          const mixedWebs = widths.length > 1;
        %>
        <div class="mid-item">
          <span class="mid-label">Deckle Size<%= mixedWebs ? "s" : "" %></span>
          <span class="mid-value" id="midDeckleSize" title="<%= mixedWebs ? "This batch was planned on mixed webs — each layout cut from whichever width suits it. Set on the Deckle Set page." : "" %>">
            <% if (mixedWebs) { %>
              <%= widths.map(function (x) { return fmtQty(x[0]) + " × " + x[1]; }).join("  +  ") %>
              <span class="mid-mixed">mixed webs</span>
            <% } else { %>
              <%= dash(pp.deckleSize) %>
            <% } %>
          </span>
        </div>
        <!-- The two lengths kept apart, same as the Deckle Queue: one deckle
             web, then the whole job across every roll slit off it. -->
        <div class="mid-item"><span class="mid-label">Running Mtrs</span><span class="mid-value"><%= pp.deckleRunningMeters ? fmtQty(pp.deckleRunningMeters) : "—" %></span></div>
        <%# One web's length x how many webs, worked out in the route with
            utils/deckleTotals.js -- pp.runningMeters is not a usable total on
            a batch (it holds a sum of the member orders' per-roll lengths). %>
        <% const webCount = Number(pp.noOfRolls) || 0, webLen = Number(pp.deckleRunningMeters) || 0; %>
        <div class="mid-item">
          <span class="mid-label">Total Running Mtrs</span>
          <span class="mid-value" title="<%= webLen > 0 && webCount > 0 ? `${fmtQty(webLen)} m per deckle × ${fmtQty(webCount)} deckles` : "" %>"><%= fmtQty(totalRunningMeters) %></span>
        </div>
        <div id="dq-cell" style="position: relative; display: flex; flex-direction: column; gap: 4px; min-width: 0; padding: 11px 12px; border-right: 1px solid #e2e8f0;">
          <span class="mid-label">Deckle Qty</span>
          <% if (deckleQtyEditable) { %>
            <button type="button" id="dq-edit" class="dq-edit-ic" title="Edit Deckle Qty" aria-label="Edit Deckle Qty">
              <i class="fa-solid fa-pen"></i>
            </button>
            <span class="mid-value" id="dq-text"><%= dash(pp.noOfRolls) %></span>
            <input type="number" id="dq-input" name="noOfRolls" min="1" max="9999" step="1" value="<%= pp.noOfRolls || "" %>" class="form-control" hidden />
          <% } else { %>
            <span class="mid-value"><%= dash(pp.noOfRolls) %></span>
          <% } %>
        </div>
          <script>
            (function () {
              const edit = document.getElementById("dq-edit");
              const text = document.getElementById("dq-text");
              const input = document.getElementById("dq-input");
              const current = String(input.value).trim();
              const orderId = "<%= pp._id %>";
              let cancelled = false;

              function showText() {
                input.hidden = true;
                text.hidden = false;
              }
              function editDeckleQty() {
                cancelled = false;
                text.hidden = true;
                input.hidden = false;
                input.focus();
                input.select();
              }
              function saveDeckleQty() {
                if (cancelled) {
                  input.value = current;
                  showText();
                  return;
                }
                const v = String(input.value).trim();
                const n = Number(v);
                if (!Number.isInteger(n) || n < 1 || n > 9999) {
                  alert("Deckle Qty must be a whole number from 1 to 9999.");
                  input.focus();
                  return;
                }
                if (v === current) {
                  showText();
                  return;
                }
                fetch(`/app/labels/production/assign/${orderId}/deckle-count`, {
                  method: "POST",
                  headers: { "Content-Type": "application/x-www-form-urlencoded", "x-csrf-token": document.querySelector('input[name="_csrf"]')?.value || "" },
                  body: `noOfRolls=${encodeURIComponent(v)}`
                })
                .then(r => r.ok ? location.reload() : r.text().then(t => { alert("Failed to save: " + t); input.focus(); }))
                .catch(e => { alert("Error: " + e.message); input.focus(); });
              }

              edit.addEventListener("click", editDeckleQty);
              input.addEventListener("blur", saveDeckleQty);
              input.addEventListener("keydown", (ev) => {
                if (ev.key === "Enter") { ev.preventDefault(); input.blur(); }
                else if (ev.key === "Escape") { cancelled = true; input.blur(); }
              });
            })();
          </script>
        </div>

      <div class="layer-stack custom-scrollbar">
        <% materialGroups.forEach(function (g, idx) { %>
          <div class="layer-block material-group--<%= g.swatch %><%= g.title.indexOf('(Layer 2)') !== -1 ? ' is-layer2' : '' %>">
            <span class="layer-block-label"><%= g.title.toUpperCase() %></span>
            <span class="layer-block-sep">|</span>
            <%
              const detailParts = g.fields
                .filter(function (f) { return !isEmpty(f[1]); })
                .map(function (f) {
                  return '<span class="lbd-pair" title="' + escHtml(f[1]) + '">'
                    + '<span class="lbd-field">' + escHtml(f[0]) + ':</span>'
                    + '<span class="lbd-value">' + escHtml(f[1]) + '</span></span>';
                });
            %>
            <span class="layer-block-detail"><%- detailParts.length ? detailParts.join(" | ") : "—" %></span>
          </div>
          <% if (idx < materialGroups.length - 1) { %>
            <div class="layer-caret"><i class="fa-solid fa-caret-down"></i></div>
          <% } %>
        <% }) %>
      </div>

    </div>
  </div>

  <!-- Raw material this deckle will eat, in SQUARE METRES -- the quantity a
       lamination actually consumes, and the one the reel picker below is
       measured in too. Every layer covers the whole deckle, so each needs the
       same area (the job's area + wastage) whatever its GSM; that also means a
       layer recorded in microns, too thin to weigh, still states a requirement
       here. Area is also the only unit that compares reels of different widths
       -- 2,300 m of 510 mm web is less material than 2,000 m of 660 mm, which
       running metres would get backwards. The kilograms it works out to ride
       alongside in grey, because that is what the store issues against and
       what stock is actually held in. Worked out in utils/rawMaterialNeed.js
       from the deckle's own webs and the recipe's GSMs, using the formulas in
       "raw material formula.xlsx". Read-only: the reels are still picked by
       hand in Raw Material Allotment below.

       data-need / data-gsm are what updateRawNeed() converts each ticked
       reel's kg with -- see the comment on that function. -->
  <% if (rawNeed) { %>
    <div class="ap-card">
      <div class="ap-card-title"><span><i class="fa-solid fa-ruler-horizontal"></i> Raw Material Required</span></div>
      <div style="padding: 14px;">
        <div class="rm-need-row">
          <% rawNeed.rows.forEach(function (r) { %>
            <div class="rm-need-cell" data-layer="<%= r.key %>"
                 data-need-kg="<%= r.needKg != null ? r.needKg : "" %>"
                 data-need-mtrs="<%= r.needMtrs != null ? r.needMtrs : "" %>"
                 data-gsm="<%= r.mtrsGsm != null ? r.mtrsGsm : "" %>"
                 data-width="<%= r.mtrsWidthMm != null ? r.mtrsWidthMm : "" %>"
                 data-jobwidth="<%= rawNeed.budgetWidthMm != null ? rawNeed.budgetWidthMm : "" %>">
              <span class="rm-need-label"><%= r.title.toUpperCase() %></span>
              <%# Both sides of the same material: the WEIGHT the store issues
                  against and the LENGTH the machine runs. A reel has both, so
                  the allotment below is tallied on both. Metres are only
                  comparable because the job is budgeted at one width (see
                  webRunsFor) -- metres of a 510 mm reel and of a 660 mm one
                  are not the same material.
                  The adhesive's kg is the WET figure, what actually comes off
                  the drum, with the dry coat it was converted from alongside. %>
              <span class="rm-need-value">
                <% if (r.needKg != null) { %><span class="rm-need-kg<%= r.wetKg != null ? " is-wet" : "" %>"><%= fmtQty(r.needKg) %> kg<% if (r.wetKg != null) { %> <span class="rm-need-wet">wet</span><% } %></span><% } else { %><span class="rm-need-none" title="No GSM on this layer<%= r.micron != null ? " (recorded as " + fmtQty(r.micron) + " microns)" : "" %>, so it cannot be weighed -- the R.Mtrs still stand.">no GSM</span><% } %>
                <span class="rm-need-sep">|</span> <%= fmtQty(r.needMtrs) %> R.Mtrs
                <span class="rm-need-sub">
                  <% if (r.wetKg != null) { %><span class="rm-need-sep">·</span> dry <%= fmtQty(r.kg) %> kg<% } %>
                  <span class="rm-need-sep">·</span> <%= fmtQty(r.sqM) %> sq.mtrs
                </span>
              </span>
              <!-- Filled in live as reels are ticked in Raw Material Allotment
                   below: the bar fills, and the text counts what is still
                   needed down to zero. Hidden until something is picked. -->
              <span class="rm-need-track" hidden><i></i></span>
              <span class="rm-need-left" hidden></span>
            </div>
          <% }) %>
        </div>

        <!-- How the numbers above were arrived at, for THIS batch's deckle
             config. Worth showing on the page rather than only in
             docs/raw-material-math.md, because the Material Details card
             above carries only the batch's headline width ("Deckle Size 660,
             Deckle Qty 3") -- a mixed-web plan runs several widths, and the
             area is summed per layout, so the working is the only place the
             real config is visible. Collapsed by default: a <details>, no JS.
             Every figure is the one computeRawMaterialNeed() actually used --
             nothing is recomputed here. -->
        <details class="rm-work">
          <% const budgetWidth = rawNeed.runs[0] ? rawNeed.runs[0].width : null;
             const budgetWebs = rawNeed.runs.reduce(function (n, r) { return n + r.webs; }, 0); %>
          <summary>How this was worked out — <%= fmtQty(budgetWidth) %> mm × <%= fmtQty(budgetWebs) %> deckle<%= budgetWebs === 1 ? "" : "s" %></summary>
          <div class="rm-work-body">

            <div class="rm-work-step">
              <span class="rm-work-no">1</span>
              <span class="rm-work-label">Area the deckle laminates</span>
            </div>
            <% if (mixedWebs) { %>
              <p class="rm-work-eqline" style="margin-bottom:6px;">
                Budgeted at <b><%= fmtQty(budgetWidth) %> mm</b> for every deckle. The plan cuts some of them
                to a narrower layout (<%= widths.map(function (x) { return fmtQty(x[0]) + " mm"; }).join(", ") %>),
                but that is a slitting choice — the laminator mounts one reel and runs the job off it, and one
                reel width is all this page can allot against.
              </p>
            <% } %>
            <table class="rm-work-table">
              <thead><tr><th>Deckle Size</th><th>Running Mtrs</th><th>Deckle Count</th><th class="ta-r">Sq.Mtrs</th></tr></thead>
              <tbody>
                <% rawNeed.runs.forEach(function (run) { %>
                  <tr>
                    <td><%= fmtQty(run.width) %> mm</td>
                    <td><%= fmtQty(run.length) %> m</td>
                    <td><%= fmtQty(run.webs) %></td>
                    <td class="ta-r"><%= fmtQty(Math.round((run.width / 1000) * run.length * run.webs * 100) / 100) %></td>
                  </tr>
                <% }) %>
                <tr class="rm-work-total">
                  <td colspan="3">Area &nbsp;<span class="rm-work-eq">Σ (size ÷ 1000) × mtrs × deckle count</span></td>
                  <td class="ta-r"><%= fmtQty(rawNeed.areaSqM) %></td>
                </tr>
              </tbody>
            </table>

            <div class="rm-work-step">
              <span class="rm-work-no">2</span>
              <span class="rm-work-label">Every layer covers the whole deckle, plus <%= rawNeed.wastagePct %>% wastage</span>
            </div>
            <p class="rm-work-eqline">
              <%= fmtQty(rawNeed.webMetres) %> × <%= (1 + rawNeed.wastagePct / 100).toFixed(2) %>
              = <b><%= fmtQty(rawNeed.needMetres) %> R.Mtrs</b>,
              and <%= fmtQty(rawNeed.areaSqM) %> × <%= (1 + rawNeed.wastagePct / 100).toFixed(2) %>
              = <%= fmtQty(rawNeed.needSqM) %> sq.mtrs — the same for every layer. The weight each one needs
              is its own, and is worked out in step 3.
            </p>

            <div class="rm-work-step">
              <span class="rm-work-no">3</span>
              <span class="rm-work-label">What that weighs, per layer</span>
            </div>
            <table class="rm-work-table">
              <thead><tr><th>Layer</th><th>GSM</th><th class="ta-r">Kg</th><th>= area × GSM ÷ 1000 × <%= (1 + rawNeed.wastagePct / 100).toFixed(2) %></th></tr></thead>
              <tbody>
                <% rawNeed.rows.forEach(function (r) { %>
                  <tr>
                    <td><%= r.title %></td>
                    <td><%= r.gsm != null ? fmtQty(r.gsm) : "—" %></td>
                    <td class="ta-r"><%= r.kg != null ? fmtQty(r.kg) : "—" %></td>
                    <td class="rm-work-note">
                      <% if (r.kg == null) { %>
                        no GSM<%= r.micron != null ? " · recorded as " + fmtQty(r.micron) + " microns" : "" %> — cannot be weighed
                      <% } else if (r.wetKg != null) { %>
                        wet: <%= fmtQty(r.gsm) %> ÷ <%= rawNeed.adhesiveSolidsPct %> × 100 = <%= fmtQty(r.wetGsm) %> GSM → <b><%= fmtQty(r.wetKg) %> kg</b> off the drum
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>

            <div class="rm-work-step">
              <span class="rm-work-no">4</span>
              <span class="rm-work-label">Turning stock into kg and R.Mtrs to tick against it</span>
            </div>
            <p class="rm-work-eqline" style="margin-bottom:6px;">
              Every layer is tallied against its own pool, on both sides of the same material. <b>Kg</b> comes
              straight off the reel — <span class="rm-work-eq">reelMtrs</span> on every raw pool is really kilograms,
              so nothing is converted. <b>R.Mtrs</b> is
              <span class="rm-work-eq">kg × 1e6 ÷ (GSM × width)</span>, which is only comparable because this job is
              budgeted at one web width (step 1).
            </p>
            <table class="rm-work-table">
              <thead><tr><th>Layer</th><th class="ta-r">Needs</th><th>GSM used</th><th>Width used</th></tr></thead>
              <tbody>
                <% rawNeed.rows.forEach(function (r) { %>
                  <tr>
                    <td><%= r.title %></td>
                    <td class="ta-r"><b><%= r.needKg != null ? fmtQty(r.needKg) + " kg" : "—" %></b>
                      <span class="rm-work-note">· <%= fmtQty(r.needMtrs) %> R.Mtrs</span></td>
                    <td class="rm-work-note">
                      <% if (r.wetGsm != null) { %>
                        <%= fmtQty(r.wetGsm) %> wet — recipe <%= fmtQty(r.gsm) %> dry ÷ <%= rawNeed.adhesiveSolidsPct %> × 100, since no drum records one
                      <% } else if (r.gsm != null) { %>
                        the reel's own, falling back to the recipe's <%= fmtQty(r.gsm) %>
                      <% } else { %>
                        <span class="rm-work-warn">none</span><%= r.micron != null ? " — recorded as " + fmtQty(r.micron) + " microns" : "" %>
                      <% } %>
                    </td>
                    <td class="rm-work-note">
                      <%= r.mtrsWidthMm != null
                        ? "this job's web, " + fmtQty(r.mtrsWidthMm) + " mm — a drum has none of its own"
                        : "the reel's own" %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>

            <!-- Filled in live by renderPickedWorking() as reels are ticked in
                 Raw Material Allotment below: the same sum the bar above runs,
                 written out reel by reel so the total can be checked by hand. -->
            <div id="rm-work-picked"></div>
          </div>
        </details>
      </div>
    </div>
  <% } %>

  <form id="assign-form" class="ap-form-card needs-validation" action="/app/labels/production/assign/<%= pp._id %>" method="post" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <!-- Who runs this job -- one strip, the same furniture as the Material
         Details card above (label in small caps, thin rule between each) so
         the page reads as one thing. They were three .span-dual boxes: a
         bordered card each, 10px of padding and an 18px label above a
         full-height control, which is a lot of the screen for three picks
         that are usually made once and then scrolled past. The label now sits
         beside its control rather than above it, which takes the strip from
         ~90px to ~52px without shrinking the thing you actually click. -->
    <div class="ap-picks">
      <div class="ap-pick">
        <label for="machine-select">Machine</label>
        <select id="machine-select" name="machineId" class="form-control select-tag" required>
          <option value="" disabled selected hidden>Select Machine</option>
        </select>
      </div>

      <div class="ap-pick">
        <label for="operator-select">Operator</label>
        <select id="operator-select" name="operatorId" class="form-control select-tag">
          <option value="" selected>Select Operator</option>
          <% operatorEmployees.forEach((emp) => { %>
            <option value="<%= emp._id %>" data-profilecode="<%= emp.empProfileCode || '' %>"><%= emp.empName %></option>
          <% }) %>
        </select>
      </div>

      <div class="ap-pick">
        <label for="helper-select">Helper</label>
        <select id="helper-select" name="helperId" class="form-control select-tag">
          <option value="" selected>Select Helper</option>
          <% helperEmployees.forEach((emp) => { %>
            <option value="<%= emp._id %>" data-profilecode="<%= emp.empProfileCode || '' %>"><%= emp.empName %></option>
          <% }) %>
        </select>
      </div>
    </div>


    <!-- ============ RAW MATERIAL ALLOTMENT ============
         Lets a reel of each raw-material layer this item's recipe calls for
         (Facestock/Adhesive/Release Liner -- +2 more layers for DOUBLE
         FACESTOCK/DOUBLE RELEASE, see models/sachiko/sachikoLabelStock.js)
         be picked and reserved to this order (allottedLayers, via this same
         Assign & Continue submit). Select a machine first -- these columns
         are scoped to its location.
         No Kg-to-produce quantity is taken here for now -- reel picks are
         just recorded as allotted; producing an actual Deckle from them is a
         separate step, not part of this submit (the POST handler in
         fairdesk_route.js only calls produceDeckle() when rawProduceMtrs is
         submitted > 0, which nothing on this page does anymore). -->
    <div class="span-full form-subheading raw-produce-row" style="grid-column: 1 / -1; margin: 10px 0 0; display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 18px;">
      <h1>Raw Material Allotment</h1>
    </div>

    <!-- Auto Allot -- ticks the reels this job needs, oldest stock first.
         Read-only in the same sense AI Deckle Set is: it only ticks the
         checkboxes below, which the planner reviews and then submits with
         Assign & Continue like any hand-made pick. Nothing is reserved until
         that submit, so a suggestion can always simply be re-done or cleared.

         The rule it follows, and why, is spelled out in autoAllot() further
         down -- in short: FIFO within whatever actually fits, and every layer
         matched to the SHORTEST one rather than to the order, so a job that
         can only half run doesn't lock up a full order's worth of the
         materials that weren't short. -->
    <div class="span-full" style="grid-column: 1 / -1; border: none !important; padding: 0; width: 100%;">
      <div class="rma-panel">
        <div class="rma-bar">
          <div class="rma-spacer"></div>
          <label class="rma-check" for="rmaBalance"
                 title="On: every layer is allotted only as much as the shortest layer can actually run, so material that isn't short doesn't get locked to a job that cannot use it. Off: every layer is allotted the job's full requirement wherever the stock exists.">
            <input type="checkbox" id="rmaBalance" checked />
            <span class="t">Match layers to the shortest</span>
          </label>
          <button type="button" id="rmaClear" class="rma-clear">
            <i class="fa-solid fa-eraser"></i> Clear picks
          </button>
          <button type="button" id="rmaRun" class="rma-run">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Auto Allot (FIFO)
          </button>
        </div>
        <div class="rma-body" id="rmaBody"></div>
      </div>
    </div>

    <div id="rawLayersGrid"></div>

    <div class="btn-grp span-full">
      <button type="button" id="assignSubmitBtn" class="ap-submit-btn">Assign &amp; Continue</button>
    </div>
  </form>
</div>

<%# Lot No & Deckle No Setup -- TEMPORARY. Opened by the gear beside Lot No.
    Production was already running before the ERP kept either series, so each
    product is told where its numbering stands, in one place:
      - Lot No    : the last serial used this year (G014 -> 14), per product
      - Deckle No : the last Deckle serial made this year (0123 -> 123), per
                    product, running across lots
    Rows load from GET .../lot-no-setup and GET /machine/deckle-no-setup when it
    opens and are merged by product code; Save posts whichever of the two
    changed (JSON), so nothing here reloads the page -- a reload would drop the
    reels already ticked below. Kept outside every <form> on this page. %>
<style>
  #lotNoDialog { width: min(1080px, 95vw); padding: 0; border-radius: 14px; border: none; background: #fff; }
  #lotNoDialog::backdrop { background: rgba(15, 23, 42, 0.55); backdrop-filter: blur(4px); }
  #lotNoDialog .logout-dialog { width: 100%; padding: 0; border: none; box-shadow: none; background: transparent; }
  .lnd-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; background: #044a78; color: #fff; border-radius: 14px 14px 0 0; }
  .lnd-head h2 { margin: 0; font-size: 1.15rem; font-weight: 700; }
  .lnd-head-meta { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .lnd-chip { display: inline-flex; gap: 6px; padding: 3px 11px; border-radius: 999px; background: rgba(255,255,255,0.16); font-size: 0.8rem; font-weight: 600; white-space: nowrap; }
  .lnd-chip b { font-weight: 800; }
  .lnd-close { background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25); color: #fff; border-radius: 999px; padding: 5px 12px; cursor: pointer; }
  .lnd-close:hover { background: rgba(255,255,255,0.28); }
  .lnd-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 12px; border-radius: 0 0 14px 14px; background: #fff; }
  .lnd-note { padding: 10px 14px; border-radius: 10px; background: #fff8e1; border: 1px solid #f0d58a; border-left: 4px solid #e0a800; color: #5b4a12; font-size: 0.88rem; line-height: 1.5; }
  .lnd-note code { background: rgba(0,0,0,0.06); padding: 1px 6px; border-radius: 4px; font-weight: 700; color: #3f3200; }
  .lnd-note ul { margin: 4px 0 0; padding-left: 18px; }
  .lnd-force { display: flex; align-items: flex-start; gap: 10px; padding: 9px 14px; border-radius: 10px; background: #fdecea; border: 1px solid #f0b7b0; border-left: 4px solid #c0392b; color: #6b1d14; font-size: 0.86rem; line-height: 1.45; cursor: pointer; }
  .lnd-force input { margin-top: 3px; width: 16px; height: 16px; accent-color: #c0392b; flex: none; }
  .lnd-force:has(input:checked) { background: #f9d6d2; }
  .lnd-preview { display: none; align-items: center; gap: 8px 22px; flex-wrap: wrap; padding: 9px 14px; border-radius: 10px; background: #eef6ff; border: 1px solid #c5dcf3; font-size: 0.88rem; color: #1f2a44; }
  .lnd-preview.is-on { display: flex; }
  .lnd-preview > span { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .lnd-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .lnd-search-wrap { position: relative; flex: 0 1 300px; min-width: 180px; }
  .lnd-search-wrap i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.85rem; pointer-events: none; }
  #lnd-search { width: 100%; height: 38px; padding: 2px 12px 2px 34px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; font-size: 0.92rem; box-sizing: border-box; }
  #lnd-search:focus { outline: none; border-color: #044a78; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.14); }
  .lnd-count { font-size: 0.85rem; color: #64748b; }
  .lnd-count b { color: #1f2a44; }
  .lnd-msg { min-height: 18px; margin: -4px 0; font-size: 0.88rem; font-weight: 600; }
  .lnd-msg.is-ok { color: #1a7a3f; }
  .lnd-msg.is-err { color: #c0392b; }

  .lnd-card { border: 1px solid #d5dde8; border-radius: 12px; overflow: hidden; }
  .lnd-hrow, .lnd-row {
    display: grid; align-items: center; column-gap: 12px; padding: 0 14px;
    grid-template-columns: minmax(120px, 1.1fr) 100px minmax(170px, 1.3fr) 100px 90px 76px;
  }
  /* The header sits OUTSIDE the scrolling rows, so the scrollbar starts under it. */
  .lnd-hrow { background: #044a78; color: #fff; min-height: 40px; overflow: hidden; scrollbar-gutter: stable; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; line-height: 1.25; }
  .lnd-scroll { max-height: min(44vh, 400px); overflow-y: auto; overflow-x: hidden; scrollbar-gutter: stable; scrollbar-width: thin; scrollbar-color: #044a78 #f0f2f5; }
  .lnd-scroll::-webkit-scrollbar { width: 10px; height: 10px; }
  .lnd-scroll::-webkit-scrollbar-track { background: #f0f2f5; }
  .lnd-scroll::-webkit-scrollbar-thumb { background: #044a78; border-radius: 6px; }
  .lnd-scroll::-webkit-scrollbar-thumb:hover { background: #044a78; }
  .lnd-row { min-height: 56px; padding-top: 7px; padding-bottom: 7px; border-top: 1px solid #e8edf3; font-size: 0.92rem; background: #fff; }
  .lnd-row:first-child { border-top: 0; }
  .lnd-row:hover { background: #f6faff; }
  .lnd-row[hidden] { display: none; }
  .lnd-row.is-dirty { background: #fffbea; }
  .lnd-row.is-current { background: #eef6ff; box-shadow: inset 4px 0 0 #044a78; }
  .lnd-row.is-current.is-dirty { background: #fff6d6; }
  .lnd-code { font-weight: 800; color: #1f2a44; }
  .lnd-tag { display: inline-block; margin-left: 6px; padding: 1px 7px; border-radius: 999px; background: #044a78; color: #fff; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.04em; vertical-align: middle; }
  .lnd-tag.is-family { background: #64748b; }
  .lnd-serial { width: 88px; height: 36px; padding: 2px 10px; font-size: 1.02rem; font-weight: 800; color: #1f2a44; text-align: right; border: 1px solid #b8c7d9; border-radius: 8px; background: #f4f9ff; box-sizing: border-box; }
  .lnd-serial:focus { outline: none; border-color: #044a78; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.14); background: #fff; }
  .lnd-id { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.84rem; font-weight: 700; white-space: nowrap; }
  .lnd-id.is-next { display: inline-block; padding: 3px 10px; border-radius: 6px; background: #eaf3fb; color: #044a78; }
  .lnd-save { height: 36px; min-width: 72px; padding: 0 14px; border: 0; border-radius: 8px; background: #044a78; color: #fff; font-weight: 700; font-size: 0.88rem; cursor: pointer; }
  .lnd-save:hover:not(:disabled) { background: #03365a; }
  .lnd-save:disabled { background: #e2e8f0; color: #94a3b8; cursor: default; }
  .lnd-empty { text-align: center; padding: 30px 16px; color: #94a3b8; font-size: 0.92rem; }

  @media (max-width: 860px) {
    .lnd-col-next { display: none; }
    .lnd-hrow, .lnd-row { grid-template-columns: minmax(64px, 1fr) 80px 80px 62px; column-gap: 8px; padding: 0 8px; }
    .lnd-hrow { font-size: 0.66rem; letter-spacing: 0.03em; padding-top: 6px; padding-bottom: 6px; }
    .lnd-chip-year { display: none; }
    .lnd-head-meta { flex-wrap: nowrap; }
    .lnd-search-wrap { flex: 1 1 100%; }
    .lnd-scroll { max-height: 38vh; }
    .lnd-serial { width: 72px; padding: 2px 6px; }
    .lnd-save { min-width: 0; padding: 0 10px; }
  }
</style>

<dialog id="lotNoDialog" class="logout-modal" aria-labelledby="lotNoDialogTitle">
  <div class="logout-dialog">
    <div class="lnd-head">
      <h2 id="lotNoDialogTitle"><i class="fa-solid fa-hashtag" style="margin-right: 8px; opacity: .85;"></i>Lot No &amp; Deckle No Setup</h2>
      <div class="lnd-head-meta">
        <span class="lnd-chip lnd-chip-year">Financial year <b id="lnd-fy">&mdash;</b></span>
        <button type="button" class="lnd-close" id="lnd-close" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
      </div>
    </div>
    <div class="lnd-body">
      <div class="lnd-note">
        <strong>Temporary setup.</strong> Type the number each product is on <em>right now</em> this financial year &mdash; the next lot / deckle made gets exactly that number.
        <ul>
          <li><strong>Current Lot No</strong> &mdash; the lot being used now (<code>14</code> means <code>G014</code>; this order's Lot No becomes <code>G014</code>, the next one <code>G015</code>).</li>
          <li><strong>Current Deckle</strong> &mdash; the serial of the Deckle being made now, running across lots (<code>123</code> means <code>0123</code>; the next Deckle made is <code>0123</code>, then <code>0124</code>). Web job card and operator app both continue from it. A variant (<code>-A</code>, <code>-B</code>) isn't listed: it counts on its master's series, and only the product code in its Deckle ID differs.</li>
        </ul>
        Either can be moved forward later, never below a lot or Deckle the system already holds &mdash; unless <strong>Force override</strong> is ticked.
      </div>
      <label class="lnd-force" for="lnd-force">
        <input type="checkbox" id="lnd-force" />
        <span><strong>Force override</strong> &mdash; allow the last Lot No / Deckle No to be set <em>below</em> lots or Deckles already on file. The series is set exactly as typed and only lots / Deckles made from now on count toward it; existing ones are not changed or deleted, so a number can repeat across lots. Applies to the next Save only.</span>
      </label>
      <div class="lnd-preview" id="lnd-preview">
        <span>This Lot No: <b class="lnd-id is-next" id="lnd-pv-lot">&mdash;</b></span>
        <span>This Deckle ID: <b class="lnd-id is-next" id="lnd-pv-deckle">&mdash;</b></span>
      </div>
      <div class="lnd-toolbar">
        <div class="lnd-search-wrap">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="lnd-search" placeholder="Filter by product code" autocomplete="off" aria-label="Filter by product code" />
        </div>
        <div class="lnd-count"><b id="lnd-shown">0</b> of <span id="lnd-total">0</span> products</div>
      </div>
      <div class="lnd-msg" id="lnd-msg" role="status" aria-live="polite"></div>
      <div class="lnd-card">
        <div class="lnd-hrow">
          <div>Product Code</div>
          <div>Current Lot No (serial)</div>
          <div class="lnd-col-next">Lot No</div>
          <div>Current Deckle (serial)</div>
          <div class="lnd-col-next">Deckle</div>
          <div></div>
        </div>
        <div class="lnd-scroll" id="lnd-body"></div>
        <div class="lnd-empty" id="lnd-empty">Loading&hellip;</div>
      </div>
    </div>
  </div>
</dialog>
<script id="lot-no-ctx-data" type="application/json"><%- safeJson({ code: String(item.productCode || "").trim().toUpperCase(), orderId: String(pp._id) }) %></script>
<script>
  (function () {
    const openBtn = document.getElementById("ln-edit");
    if (!openBtn) return; // role may not change the series: no gear, no dialog wiring
    const URL_LOT = "/app/labels/production/lot-no-setup";
    const URL_DECKLE = "/app/machine/deckle-no-setup";
    const CTX = JSON.parse(document.getElementById("lot-no-ctx-data").textContent);
    const ORDER_ID = CTX.orderId;
    const CURRENT_ID = CTX.code;   // the code this order's Deckle ids are written under
    let CURRENT = CTX.code;        // the (master) row it sits on -- set on load
    const dlg = document.getElementById("lotNoDialog");
    const body = document.getElementById("lnd-body");
    const empty = document.getElementById("lnd-empty");
    const search = document.getElementById("lnd-search");
    const msg = document.getElementById("lnd-msg");
    const shown = document.getElementById("lnd-shown");
    const total = document.getElementById("lnd-total");
    const preview = document.getElementById("lnd-preview");
    const pvLot = document.getElementById("lnd-pv-lot");
    const pvDeckle = document.getElementById("lnd-pv-deckle");
    const forceBox = document.getElementById("lnd-force");
    let fy = "", letter = "";
    let curLotNext = "";   // this order's product: next Lot No
    let curDeckleNext = 1; // this order's product: next Deckle serial

    const pad4 = function (n) { return String(n).padStart(4, "0"); };
    function say(text, ok) {
      msg.textContent = text || "";
      msg.className = "lnd-msg" + (text ? (ok ? " is-ok" : " is-err") : "");
    }
    function el(tag, cls, text) {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text !== undefined) n.textContent = text;
      return n;
    }
    // Same shape the server mints: CODE / FY / <letter><3+ digit serial>.
    function lotFor(code, serial) {
      return code + " / " + fy + " / " + letter + String(serial).padStart(3, "0");
    }
    // The Lot No this order will carry (shown on the page), read as the server
    // reads it: the digits it ends in, four-padded, are what a Deckle ID holds.
    function pageLotDigits() {
      const m = /(\d+)\s*$/.exec(String((document.getElementById("ln-input") || {}).value || ""));
      return m ? m[1].padStart(4, "0") : "";
    }
    // Both "next" figures for THIS order's product, shown above the table.
    function showPreview() {
      if (!CURRENT) { preview.classList.remove("is-on"); return; }
      pvLot.textContent = curLotNext || "—";
      const lot = pageLotDigits();
      pvDeckle.textContent = lot ? CURRENT_ID + "/" + fy + "/" + letter + lot + "/" + pad4(curDeckleNext) : "—";
      preview.classList.add("is-on");
    }

    // d = { code, lot:{highest,last,next}, deckle:{highest,last,next} }
    function renderRow(d) {
      const isCurrent = d.code === CURRENT;
      const row = el("div", "lnd-row" + (isCurrent ? " is-current" : ""));
      row.dataset.code = d.code;
      // The boxes hold the CURRENT number (the one the next lot / deckle is minted with); the server stores "last used" = current - 1.
      const init = { lot: String(Number(d.lot.highest) + 1), deckle: String(Number(d.deckle.highest) + 1) };

      const c1 = el("div");
      c1.appendChild(el("span", "lnd-code", d.code));
      if (isCurrent) c1.appendChild(el("span", "lnd-tag", "THIS ORDER"));

      function serialInput(value, label, max) {
        const i = el("input", "lnd-serial");
        i.type = "number"; i.min = "1"; i.max = String(max); i.step = "1";
        i.inputMode = "numeric"; i.placeholder = "1";
        i.value = value;
        i.setAttribute("aria-label", label + " for " + d.code);
        return i;
      }
      const lotIn = serialInput(init.lot, "Last Lot No serial", 999999);
      const deckleIn = serialInput(init.deckle, "Last Deckle serial", 9999);

      const c2 = el("div"); c2.appendChild(lotIn);
      const lotNext = el("span", "lnd-id is-next", d.lot.next);
      const c3 = el("div", "lnd-col-next"); c3.appendChild(lotNext);
      const c4 = el("div"); c4.appendChild(deckleIn);
      const deckleNext = el("span", "lnd-id is-next", d.deckle.next);
      const c5 = el("div", "lnd-col-next"); c5.appendChild(deckleNext);
      const save = el("button", "lnd-save", "Save");
      save.type = "button"; save.disabled = true;
      const c6 = el("div"); c6.appendChild(save);
      [c1, c2, c3, c4, c5, c6].forEach(function (c) { row.appendChild(c); });

      const lotNextDefault = d.lot.next;
      const deckleNextDefault = Number(d.deckle.highest) + 1;
      function state() {
        const lv = lotIn.value.trim(), dv = deckleIn.value.trim();
        const lotDirty = lv !== init.lot, deckleDirty = dv !== init.deckle;
        const lotOk = /^\d{1,6}$/.test(lv) && Number(lv) >= 1, deckleOk = /^\d{1,4}$/.test(dv) && Number(dv) >= 1 && Number(dv) <= 9999;
        return { lv: lv, dv: dv, lotDirty: lotDirty, deckleDirty: deckleDirty, lotOk: lotOk, deckleOk: deckleOk };
      }
      function refresh() {
        const st = state();
        row.classList.toggle("is-dirty", st.lotDirty || st.deckleDirty);
        // Save wakes only when something changed and every changed box is valid.
        save.disabled = !((st.lotDirty || st.deckleDirty) && (!st.lotDirty || st.lotOk) && (!st.deckleDirty || st.deckleOk));
        const lotSerial = st.lotDirty && st.lotOk ? Number(st.lv) : null;
        const deckleSerial = st.deckleDirty && st.deckleOk ? Number(st.dv) : deckleNextDefault;
        lotNext.textContent = lotSerial !== null ? lotFor(d.code, lotSerial) : lotNextDefault;
        deckleNext.textContent = pad4(deckleSerial);
        if (isCurrent) {
          curLotNext = lotNext.textContent;
          curDeckleNext = deckleSerial;
          showPreview();
        }
      }
      [lotIn, deckleIn].forEach(function (i) {
        i.addEventListener("input", refresh);
        i.addEventListener("keydown", function (ev) {
          if (ev.key === "Enter") { ev.preventDefault(); if (!save.disabled) save.click(); }
        });
      });
      save.addEventListener("click", function () { saveRow(row, d, state(), save); });
      row._lotIn = lotIn;
      return row;
    }

    function post(url, params) {
      // Force override is read at click time and covers this save only.
      if (forceBox.checked) params.force = "1";
      return fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json" },
        body: new URLSearchParams(params).toString(),
      }).then(function (res) { return res.json().catch(function () { return {}; }).then(function (j) { return { ok: res.ok, j: j }; }); });
    }

    // Saves whichever of the two changed. They are independent: if one is
    // refused the other still goes through, and the message says which.
    function saveRow(row, d, st, save) {
      const code = d.code;
      save.disabled = true;
      say("Saving " + code + "…", true);
      const next = { code: code, lot: d.lot, deckle: d.deckle };
      const notes = [], errors = [];
      let chain = Promise.resolve();
      if (st.lotDirty) {
        chain = chain.then(function () {
          return post(URL_LOT, { productCode: code, lastSerial: String(Number(st.lv) - 1) }).then(function (out) {
            if (out.ok) { next.lot = out.j.row; notes.push("Lot No = " + out.j.row.next); lotSaved(code, out.j.row); }
            else errors.push("Lot No: " + (out.j.error || "failed"));
          });
        });
      }
      if (st.deckleDirty) {
        chain = chain.then(function () {
          return post(URL_DECKLE, { productCode: code, lastSerial: String(Number(st.dv) - 1) }).then(function (out) {
            if (out.ok) { next.deckle = out.j.row; notes.push("Deckle = " + out.j.row.next); }
            else errors.push("Deckle: " + (out.j.error || "failed"));
          });
        });
      }
      chain.then(function () {
        const fresh = renderRow(next);
        row.replaceWith(fresh);
        if (code === CURRENT) {
          curLotNext = next.lot.next;
          curDeckleNext = Number(next.deckle.highest) + 1;
          showPreview();
        }
        applyFilter();
        if (errors.length) {
          // Re-open the box that was refused, still holding what was typed.
          if (st.lotDirty && next.lot === d.lot) fresh.querySelectorAll(".lnd-serial")[0].value = st.lv;
          if (st.deckleDirty && next.deckle === d.deckle) fresh.querySelectorAll(".lnd-serial")[1].value = st.dv;
          fresh.querySelectorAll(".lnd-serial")[0].dispatchEvent(new Event("input"));
        }
        if (!errors.length) forceBox.checked = false;
        say((notes.length ? "Saved " + code + ": " + notes.join(", ") + ". " : "") + errors.join(" "), !errors.length);
      }).catch(function (e) { say("Error: " + e.message, false); save.disabled = false; });
    }

    // The page's own Lot No is only a suggestion until the order has one of
    // its own: follow the series the moment it moves.
    function lotSaved(code, row) {
      const cell = document.getElementById("ln-cell");
      if (code === CURRENT && cell && cell.dataset.lotOwn !== "1") {
        const t = document.getElementById("ln-text");
        const h = document.getElementById("ln-input");
        if (t) t.textContent = row.next;
        if (h) h.value = row.next;
      }
    }

    function applyFilter() {
      const q = search.value.trim().toUpperCase();
      let n = 0, all = 0;
      body.querySelectorAll(".lnd-row").forEach(function (r) {
        all++;
        const hide = q && !r.dataset.code.includes(q);
        r.hidden = !!hide;
        if (!hide) n++;
      });
      shown.textContent = n;
      total.textContent = all;
      empty.hidden = n > 0;
      empty.textContent = all ? "No product code matches that filter." : "No Label Stock product codes yet.";
    }
    search.addEventListener("input", applyFilter);

    function getJson(url) {
      return fetch(url, { headers: { "Accept": "application/json" } })
        .then(function (res) { return res.json().catch(function () { return {}; }).then(function (j) { return { ok: res.ok, j: j }; }); });
    }

    function load() {
      say("", true);
      empty.hidden = false; empty.textContent = "Loading…";
      body.textContent = "";
      preview.classList.remove("is-on");
      Promise.all([getJson(URL_LOT), getJson(URL_DECKLE + "?pendingId=" + encodeURIComponent(ORDER_ID))])
        .then(function (res) {
          const lot = res[0], deckle = res[1];
          if (!lot.ok || !deckle.ok) {
            empty.textContent = (!lot.ok ? lot.j.error : deckle.j.error) || "Failed to load.";
            return;
          }
          fy = lot.j.fy; letter = lot.j.yearLetter;
          document.getElementById("lnd-fy").textContent = fy + " · " + letter;
          const deckleBy = new Map(deckle.j.rows.map(function (r) { return [r.code, r]; }));
          // Merge by product code. This order's product first, then its
          // variants, then everything else (both lists are already A-Z).
          const rows = lot.j.rows.map(function (l) {
            const k = deckleBy.get(l.code) || { highest: 0, last: "", next: "0001" };
            return { code: l.code, lot: l, deckle: k };
          });
          // This order's product (its master) first, then the rest A-Z.
          CURRENT = deckle.j.series || CURRENT;
          rows.sort(function (a, b) { return (b.code === CURRENT) - (a.code === CURRENT) || a.code.localeCompare(b.code); });
          rows.forEach(function (r) { body.appendChild(renderRow(r)); });
          const mine = rows.find(function (r) { return r.code === CURRENT; });
          if (mine) { curLotNext = mine.lot.next; curDeckleNext = Number(mine.deckle.highest) + 1; showPreview(); }
          applyFilter();
          const cur = body.querySelector(".lnd-row.is-current .lnd-serial");
          if (cur) cur.focus({ preventScroll: true });
        })
        .catch(function (e) { empty.textContent = "Failed to load: " + e.message; });
    }
    openBtn.addEventListener("click", function () {
      search.value = "";
      forceBox.checked = false;
      dlg.showModal();
      load(); // fresh every time: someone else may have moved a series
    });
    // Whatever happened in the dialog, the page's suggested Lot No ends up on
    // the series' real next number: re-read it from the server when the dialog
    // closes (any way it closes), so the page never lags behind a save.
    dlg.addEventListener("close", function () {
      getJson(URL_LOT).then(function (r) {
        if (!r.ok || !Array.isArray(r.j.rows)) return;
        const mine = r.j.rows.find(function (x) { return x.code === CURRENT; });
        if (mine) lotSaved(CURRENT, mine);
      }).catch(function () {});
    });
    document.getElementById("lnd-close").addEventListener("click", function () { dlg.close(); });
    // A click on the dimmed backdrop (the <dialog> box itself, not its content) closes it.
    dlg.addEventListener("mousedown", function (ev) { if (ev.target === dlg) dlg.close(); });
  })();
</script>

