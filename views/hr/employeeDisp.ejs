      <!-- Back/Next walk the same six steps the stepper at the top does, and
           are wired through the same aeSwitchTab() -- they are a second way
           to move, not a second idea of where you are. Both are DISABLED at
           their end of the run (Back on step 1, Next on the last step)
           rather than hidden, so the footer never reflows underneath the
           pointer as you step through.

           Save Employee appears only on the last step -- it is the end of the
           walk, not an option alongside it. Hiding it genuinely withholds the
           save rather than just the button: it is type="button" and sits
           OUTSIDE </form>, and the form carries no submit button of its own,
           so there is no implicit Enter-key submission to leak past it.

           Next is navigation only: it validates nothing, because the
           stepper's own numbered buttons don't either, and a Next that
           refused to move while the step beside it moved freely would be two
           rules for one journey. Validation still runs on Save, and bounces
           you to the panel holding the first bad field. -->
      <div class="ae-footer">
        <label style="display:flex;align-items:center;gap:6px;margin-right:auto;font-weight:700;font-size:13px;cursor:pointer;"><input type="checkbox" name="verified" value="on" form="addEmployeeForm" id="aeVerified" style="width:16px;height:16px;cursor:pointer;"> Verified</label>
        <button type="button" class="ae-btn ae-btn-ghost" onclick="closeAddEmployeeDialog()">Cancel</button>
        <button type="button" class="ae-btn ae-btn-ghost" id="aeBackBtn" onclick="aeGoStep(-1)">
          <i class="fa-solid fa-arrow-left"></i> Back
        </button>
        <button type="button" class="ae-btn ae-btn-ghost" id="aeNextBtn" onclick="aeGoStep(1)">
          Next <i class="fa-solid fa-arrow-right"></i>
        </button>
        <button type="button" class="ae-btn ae-btn-primary" id="aeSaveBtn" onclick="submitAddEmployee()">
          <i class="fa-solid fa-floppy-disk"></i> Save Employee
        </button>
      </div>
    </div>
  </div>

  <!-- ============ MARK INACTIVE (nested, create-time) ============ -->
  <div class="logout-modal" id="aeInactiveModal" aria-hidden="true">
    <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="aeInactiveModalTitle"
      style="width:min(460px,92vw); padding:0; border-radius:14px;">
      <div class="dialog-header" style="border-radius:14px 14px 0 0;">
        <h2 id="aeInactiveModalTitle" style="font-size:1.05rem;">Mark Employee Inactive</h2>
      </div>
      <div class="dialog-body" style="border-radius:0 0 14px 14px;">
        <label class="dialog-field-label" for="aeInactiveReasonInput">Reason for marking inactive <span class="ae-mandatory-star">*</span></label>
        <textarea id="aeInactiveReasonInput" rows="3" class="ae-input ae-textarea" placeholder="Why is this employee being marked inactive?" style="margin-bottom:4px;"></textarea>
        <p id="aeInactiveReasonError" style="color:#dc3545; font-size:0.82rem; margin:4px 0 0; display:none;">Please enter a reason.</p>
        <p class="dialog-field-label" style="margin-top:14px;">Assets surrendered</p>
        <div id="aeAssetCheckboxes" class="ae-asset-checkboxes"></div>
        <div class="dialog-actions">
          <button type="button" class="ae-btn ae-btn-ghost" id="aeInactiveCancelBtn">Cancel</button>
          <button type="button" class="ae-btn ae-btn-primary" id="aeInactiveConfirmBtn">Confirm</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const aeExistingProfileCodes = new Set(<%- safeJson(existingProfileCodes || []) %>);
    let aeReportingManagerChoices = null;

    function aeNormalizeLocationName(value) {
      return String(value || "").trim().toUpperCase().replace(/\s+/g, " ").replace(/^[.,]+|[.,]+$/g, "");
    }

    // ---- Open / close ----
    function openAddEmployeeDialog() {
      const dialog = document.getElementById("addEmployeeDialog");
      const form = document.getElementById("addEmployeeForm");
      form.reset();
      form.classList.remove("was-validated");
      aeClearFieldErrors();
      aeSwitchTab("employment");

      ["aeEmpPhotoPreview", "aeEmpAadhaarPreview", "aeEmpPanPreview", "aeEmpBiodataPreview"].forEach((id) => {
        const img = document.getElementById(id);
        if (img) { img.src = ""; img.style.display = "none"; }
      });
      ["aeRemoveEmpPhotoBtn", "aeRemoveEmpAadhaarImgBtn", "aeRemoveEmpPanImgBtn", "aeRemoveEmpBiodataBtn"].forEach((id) => {
        const btn = document.getElementById(id);
        if (btn) btn.style.display = "none";
      });
      ["aeRemoveEmpPhoto", "aeRemoveEmpAadhaarImg", "aeRemoveEmpPanImg", "aeRemoveEmpBiodata"].forEach((id) => {
        const field = document.getElementById(id);
        if (field) field.value = "false";
      });
      const aeBiodataChip = document.getElementById("aeEmpBiodataChip");
      if (aeBiodataChip) aeBiodataChip.style.display = "none";
      document.querySelectorAll("#aeAadhaarDropzone, #aePanDropzone, #aeBiodataDropzone").forEach((dz) => dz.classList.remove("is-dragover"));

      document.getElementById("aeDependentsList").innerHTML = "";
      document.getElementById("aeDependentsHeader").style.display = "none";
      document.getElementById("aeMarriageAnnivField").style.display = "none";
      document.getElementById("aeEmpInactiveReason").value = "";
      document.getElementById("aeEmpAssetsSurrenderedJson").value = "[]";

      aeSyncProfileCodeField();

      if (aeReportingManagerChoices) { aeReportingManagerChoices.destroy(); aeReportingManagerChoices = null; }
      const mgrSelect = document.getElementById("ae-emp-reporting-manager");
      aeReportingManagerChoices = new Choices(mgrSelect, { searchEnabled: true, itemSelectText: "", shouldSort: false });

      dialog.classList.add("show");
      dialog.setAttribute("aria-hidden", "false");
    }

    function closeAddEmployeeDialog() {
      const dialog = document.getElementById("addEmployeeDialog");
      dialog.classList.remove("show");
      dialog.setAttribute("aria-hidden", "true");
    }

    // ---- Stepper ----
    const AE_STEP_ORDER = ["employment", "personal", "identification", "banking", "payroll", "dependents"];
    function aeSwitchTab(tabName) {
      const activeIndex = AE_STEP_ORDER.indexOf(tabName);
      const steps = [...document.querySelectorAll("#aeTabs .ae-step")];
      steps.forEach((btn) => {
        const stepIndex = AE_STEP_ORDER.indexOf(btn.dataset.tab);
        btn.classList.toggle("active", stepIndex === activeIndex);
        btn.classList.toggle("completed", activeIndex >= 0 && stepIndex < activeIndex);
      });
      document.querySelectorAll("#aeTabs .ae-step-line").forEach((line) => {
        const lineIndex = Number(line.dataset.line); // line N sits after step N (1-based)
        line.classList.toggle("completed", activeIndex >= 0 && lineIndex <= activeIndex);
      });
      document.querySelectorAll("#addEmployeeForm .ae-panel").forEach((panel) => {
        panel.classList.toggle("active", panel.dataset.panel === tabName);
      });
      const form = document.getElementById("addEmployeeForm");
      if (form) form.scrollTop = 0;

      // The footer's Back/Next know where they are from here and nowhere
      // else, so they can't disagree with the stepper: every way of changing
      // step -- opening the dialog, clicking a numbered step, pressing Back
      // or Next -- ends up in this one function. An unrecognised tab name
      // (activeIndex -1, the same case the lines above already guard) leaves
      // both disabled rather than stepping off the ends of the array.
      const isLastStep = activeIndex === AE_STEP_ORDER.length - 1;
      const backBtn = document.getElementById("aeBackBtn");
      const nextBtn = document.getElementById("aeNextBtn");
      const saveBtn = document.getElementById("aeSaveBtn");
      if (backBtn) backBtn.disabled = activeIndex <= 0;
      if (nextBtn) nextBtn.disabled = activeIndex < 0 || isLastStep;
      // Save only on the last step. Hidden, not disabled: a greyed Save on
      // every step reads as "something is wrong with the form", when in fact
      // nothing is -- there are simply steps still to walk.
      if (saveBtn) saveBtn.hidden = !isLastStep;
    }
    // Back/Next. Moves one step from wherever the stepper currently is, and
    // is clamped rather than wrapped: off either end it simply does nothing,
    // which matches the disabled buttons above and means a stray call can
    // never land on an undefined step.
    function aeGoStep(delta) {
      const current = document.querySelector("#aeTabs .ae-step.active");
      const index = AE_STEP_ORDER.indexOf(current?.dataset.tab);
      if (index < 0) return;
      const next = index + delta;
      if (next < 0 || next >= AE_STEP_ORDER.length) return;
      aeSwitchTab(AE_STEP_ORDER[next]);
    }
    document.getElementById("aeTabs").addEventListener("click", (e) => {
      const btn = e.target.closest(".ae-step");
      if (btn) aeSwitchTab(btn.dataset.tab);
    });

    // ---- Operator profile code toggle ----
    function aeSyncProfileCodeField() {
      const profileInput = document.getElementById("ae-emp-profile");
      const codeInput = document.getElementById("ae-emp-profile-code");
      const codeSelect = document.getElementById("ae-emp-profile-code-select");
      if (!profileInput || !codeInput || !codeSelect) return;
      const isOperator = profileInput.value.trim().toUpperCase() === "OPERATOR";
      codeInput.style.display = isOperator ? "none" : "";
      codeInput.disabled = isOperator;
      codeSelect.style.display = isOperator ? "" : "none";
      codeSelect.disabled = !isOperator;
    }
    document.getElementById("ae-emp-profile")?.addEventListener("input", aeSyncProfileCodeField);

    // ---- Nick name auto-fill ----
    (function () {
      const nameInput = document.getElementById("ae-emp-name");
      const nickInput = document.getElementById("ae-emp-nick-name");
      if (!nameInput || !nickInput) return;
      const firstWord = (v) => String(v || "").trim().split(/\s+/)[0] || "";
      let autoFill = true;
      nickInput.addEventListener("input", () => { autoFill = false; });
      nameInput.addEventListener("input", () => { if (autoFill) nickInput.value = firstWord(nameInput.value); });
    })();

    // ---- Marital status toggle ----
    document.getElementById("ae-emp-martial-status")?.addEventListener("change", (e) => {
      const isMarried = e.target.value === "MARRIED";
      document.getElementById("aeMarriageAnnivField").style.display = isMarried ? "" : "none";
      if (!isMarried) document.getElementById("ae-emp-marriage-anniversary").value = "";
    });

    // ---- Mobile number formatting ----
    function aeFormatMobile(input) {
      let value = input.value.replace(/\D/g, "").substring(0, 10);
      if (value.length > 5) value = value.substring(0, 5) + " " + value.substring(5);
      input.value = value;
    }
    ["ae-emp-office-mob", "ae-emp-mobile1", "ae-emp-mobile2", "ae-emp-emergency-no1", "ae-emp-emergency-no2"].forEach((id) => {
      const input = document.getElementById(id);
      if (input) input.addEventListener("input", () => aeFormatMobile(input));
    });

    // ---- Image previews (avatar circle / dropzone) ----
    // Clicking a preview once it's set re-opens the file picker (to replace
    // it) rather than zooming -- one click, one meaning, no fighting between
    // a click-to-zoom listener on the <img> and the dropzone's own
    // click-to-upload listener on its parent.
    //
    // chipId is Biodata's escape hatch: a PDF has no thumbnail, so it shows
    // an icon + filename chip in the same dropzone instead of the <img>.
    function aeSetupImagePreview({ inputId, previewId, removeBtnId, removeFieldId, dropzoneId, chipId }) {
      const input = document.getElementById(inputId);
      const preview = document.getElementById(previewId);
      const removeBtn = document.getElementById(removeBtnId);
      const removeField = document.getElementById(removeFieldId);
      const dropzone = dropzoneId ? document.getElementById(dropzoneId) : null;
      const chip = chipId ? document.getElementById(chipId) : null;
      if (!input || !preview) return;

      const showFile = (file) => {
        if (!file) return;
        const isImage = file.type.startsWith("image/");
        const isPdf = file.type === "application/pdf" || /\.pdf$/i.test(file.name);
        if (!isImage && !(chip && isPdf)) return;

        if (removeField) removeField.value = "false";
        if (isImage) {
          if (chip) chip.style.display = "none";
          const reader = new FileReader();
          reader.onload = () => {
            preview.src = reader.result;
            preview.style.display = "block";
            if (removeBtn) removeBtn.style.display = "flex";
          };
          reader.readAsDataURL(file);
        } else {
          preview.src = "";
          preview.style.display = "none";
          chip.querySelector(".ae-file-chip-name").textContent = file.name;
          chip.style.display = "flex";
          if (removeBtn) removeBtn.style.display = "flex";
        }
      };

      input.addEventListener("change", () => showFile(input.files[0]));

      if (removeBtn) {
        removeBtn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          preview.src = ""; preview.style.display = "none"; removeBtn.style.display = "none";
          if (chip) chip.style.display = "none";
          input.value = "";
          if (removeField) removeField.value = "true";
        });
      }

      if (dropzone) {
        dropzone.addEventListener("click", () => input.click());
        dropzone.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); input.click(); }
        });
        dropzone.addEventListener("dragover", (e) => { e.preventDefault(); dropzone.classList.add("is-dragover"); });
        dropzone.addEventListener("dragleave", () => dropzone.classList.remove("is-dragover"));
        dropzone.addEventListener("drop", (e) => {
          e.preventDefault();
          dropzone.classList.remove("is-dragover");
          const file = e.dataTransfer?.files?.[0];
          if (!file) return;
          const dt = new DataTransfer();
          dt.items.add(file);
          input.files = dt.files; // so FormData(form) picks up the dropped file on submit
          showFile(file);
        });
      }
    }
    aeSetupImagePreview({ inputId: "ae-emp-photo", previewId: "aeEmpPhotoPreview", removeBtnId: "aeRemoveEmpPhotoBtn", removeFieldId: "aeRemoveEmpPhoto" });
    aeSetupImagePreview({ inputId: "ae-emp-aadhaar-img", previewId: "aeEmpAadhaarPreview", removeBtnId: "aeRemoveEmpAadhaarImgBtn", removeFieldId: "aeRemoveEmpAadhaarImg", dropzoneId: "aeAadhaarDropzone" });
    aeSetupImagePreview({ inputId: "ae-emp-pan-img", previewId: "aeEmpPanPreview", removeBtnId: "aeRemoveEmpPanImgBtn", removeFieldId: "aeRemoveEmpPanImg", dropzoneId: "aePanDropzone" });
    aeSetupImagePreview({ inputId: "ae-emp-biodata", previewId: "aeEmpBiodataPreview", removeBtnId: "aeRemoveEmpBiodataBtn", removeFieldId: "aeRemoveEmpBiodata", dropzoneId: "aeBiodataDropzone", chipId: "aeEmpBiodataChip" });

    // ---- Dependents ----
    function aeRenderDependents(count) {
      const container = document.getElementById("aeDependentsList");
      const header = document.getElementById("aeDependentsHeader");
      container.innerHTML = "";
      if (!count || count <= 0) { header.style.display = "none"; return; }
      header.style.display = "grid";
      for (let i = 0; i < count; i++) {
        container.insertAdjacentHTML("beforeend", `
          <div class="ae-dependent-row">
            <input type="text" name="dependentsDetails[${i}][dependentsName]" class="ae-input" placeholder="Name" required>
            <input type="date" name="dependentsDetails[${i}][dependentsDOB]" class="ae-input" required>
            <input type="text" name="dependentsDetails[${i}][dependentsRelation]" class="ae-input" placeholder="Relation" required>
          </div>
        `);
      }
    }
    document.getElementById("ae-dependents-count")?.addEventListener("input", (e) => {
      aeRenderDependents(parseInt(e.target.value, 10));
    });

    // ---- Mark inactive mini-dialog ----
    const aeAssetFields = ["empAssets1", "empAssets2", "empAssets3", "empAssets4"];
    function aeCurrentAssets() {
      return aeAssetFields
        .map((n) => (document.querySelector(`#addEmployeeForm [name="${n}"]`)?.value || "").trim())
        .filter(Boolean);
    }
    function aeEsc(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    }

    document.getElementById("ae-emp-status")?.addEventListener("change", (e) => {
      if (e.target.value === "inactive") aeOpenInactiveModal();
      else {
        document.getElementById("aeEmpInactiveReason").value = "";
        document.getElementById("aeEmpAssetsSurrenderedJson").value = "[]";
      }
    });

    function aeOpenInactiveModal() {
      const modal = document.getElementById("aeInactiveModal");
      document.getElementById("aeInactiveReasonInput").value = "";
      document.getElementById("aeInactiveReasonError").style.display = "none";
      const assets = aeCurrentAssets();
      const box = document.getElementById("aeAssetCheckboxes");
      box.innerHTML = assets.length
        ? assets.map((a) => `<label><input type="checkbox" value="${aeEsc(a)}"/> <span>${aeEsc(a)}</span></label>`).join("")
        : `<span class="ae-no-assets">No assets recorded yet.</span>`;
      modal.classList.add("show");
      modal.setAttribute("aria-hidden", "false");
      document.getElementById("aeInactiveReasonInput").focus();
    }
    function aeCloseInactiveModal(revert) {
      const modal = document.getElementById("aeInactiveModal");
      modal.classList.remove("show");
      modal.setAttribute("aria-hidden", "true");
      if (revert) {
        document.getElementById("ae-emp-status").value = "active";
        document.getElementById("aeEmpInactiveReason").value = "";
        document.getElementById("aeEmpAssetsSurrenderedJson").value = "[]";
      }
    }
    document.getElementById("aeInactiveCancelBtn")?.addEventListener("click", () => aeCloseInactiveModal(true));
    document.getElementById("aeInactiveConfirmBtn")?.addEventListener("click", () => {
      const reason = document.getElementById("aeInactiveReasonInput").value.trim();
      if (!reason) {
        document.getElementById("aeInactiveReasonError").style.display = "block";
        document.getElementById("aeInactiveReasonInput").focus();
        return;
      }
      document.getElementById("aeEmpInactiveReason").value = reason;
      const checked = Array.from(document.getElementById("aeAssetCheckboxes").querySelectorAll('input[type="checkbox"]:checked')).map((cb) => cb.value);
      document.getElementById("aeEmpAssetsSurrenderedJson").value = JSON.stringify(checked);
      aeCloseInactiveModal(false);
    });

    // ---- Mandatory stars ----
    (function () {
      document.querySelectorAll("#addEmployeeForm [required]").forEach((input) => {
        let label = null;
        if (input.id) label = document.querySelector(`label[for='${input.id}']`);
        if (!label && input.closest(".ae-field")) label = input.closest(".ae-field").querySelector("label");
        if (label && !label.querySelector(".ae-mandatory-star")) {
          label.insertAdjacentHTML("beforeend", ' <span class="ae-mandatory-star">*</span>');
        }
      });
    })();

    // ---- Validation ----
    function aeFieldAnchor(field) { return field.closest(".choices") || field; }
    function aeClearFieldErrors() {
      document.querySelectorAll("#addEmployeeDialog .field-error").forEach((el) => el.classList.remove("field-error"));
    }
    function aeHumanizeFieldName(name) {
      const parts = String(name || "").match(/[^[\]]+/g) || [];
      if (!parts.length) return "";
      const words = parts[parts.length - 1]
        .replace(/^(emp|dependents)(?=[A-Z])/, "")
        .replace(/([a-z0-9])([A-Z])/g, "$1 $2")
        .replace(/[_-]+/g, " ")
        .trim()
        .replace(/\b[a-z]/g, (c) => c.toUpperCase());
      const rowIndex = parts.length > 2 && /^\d+$/.test(parts[1]) ? Number(parts[1]) + 1 : null;
      return rowIndex ? `Dependent ${rowIndex} ${words}` : words;
    }
    function aeFieldLabelText(field) {
      let label = null;
      if (field.id) label = document.querySelector(`label[for='${field.id}']`);
      if (!label && field.closest(".ae-field")) label = field.closest(".ae-field").querySelector("label");
      const text = (label?.textContent || "").replace(/[*:\s]+$/, "").trim();
      return text || aeHumanizeFieldName(field.name) || field.placeholder || "This field";
    }
    function aeReportInvalidFields() {
      const form = document.getElementById("addEmployeeForm");
      const invalid = [...form.querySelectorAll("input:invalid, select:invalid, textarea:invalid")];
      if (!invalid.length) return false;

      invalid.forEach((field) => aeFieldAnchor(field).classList.add("field-error"));

      const missing = invalid.filter((f) => f.validity.valueMissing).map(aeFieldLabelText);
      const malformed = invalid.filter((f) => !f.validity.valueMissing);

      const list = (names) => {
        const shown = names.slice(0, 4).join(", ");
        return names.length > 4 ? `${shown} and ${names.length - 4} more` : shown;
      };

      const messages = [];
      if (missing.length === 1) messages.push(`Please fill in ${missing[0]}.`);
      else if (missing.length) messages.push(`${missing.length} required fields are missing: ${list(missing)}.`);
      if (malformed.length === 1) {
        messages.push(`${aeFieldLabelText(malformed[0])}: ${malformed[0].validationMessage}`);
      } else if (malformed.length) {
        messages.push(`Please check ${list(malformed.map(aeFieldLabelText))}.`);
      }
      showToast(messages.join(" "), true);

      const firstInvalid = invalid[0];
      const panel = firstInvalid.closest(".ae-panel");
      if (panel) aeSwitchTab(panel.dataset.panel);
      const anchor = aeFieldAnchor(firstInvalid);
      setTimeout(() => {
        anchor.scrollIntoView({ behavior: "smooth", block: "center" });
        if (anchor === firstInvalid) firstInvalid.focus({ preventScroll: true });
      }, 50);
      return true;
    }

    const addEmployeeForm = document.getElementById("addEmployeeForm");
    if (addEmployeeForm) {
      const aeClearOne = (e) => {
        const field = e.target;
        if (field?.matches?.("input, select, textarea")) aeFieldAnchor(field).classList.remove("field-error");
      };
      addEmployeeForm.addEventListener("input", aeClearOne, true);
      addEmployeeForm.addEventListener("change", aeClearOne, true);
    }

    async function submitAddEmployee() {
      const form = document.getElementById("addEmployeeForm");
      const profileCodeInput = document.getElementById("ae-emp-profile-code");
      const profileCodeSelect = document.getElementById("ae-emp-profile-code-select");
      const activeProfileCodeField = profileCodeSelect && !profileCodeSelect.disabled ? profileCodeSelect : profileCodeInput;
      const profileCode = (activeProfileCodeField?.value || "").trim().toUpperCase();
      const empLocValue = document.getElementById("ae-emp-loc")?.value || "";
      const profileCodeKey = `${profileCode}||${aeNormalizeLocationName(empLocValue)}`;

      if (profileCode && aeExistingProfileCodes.has(profileCodeKey)) {
        showToast("Profile Code already exists at this location. Please enter a different code.", true);
        aeSwitchTab("employment");
        if (activeProfileCodeField) { activeProfileCodeField.focus(); activeProfileCodeField.select?.(); }
        return;
      }

      aeClearFieldErrors();
      if (aeReportInvalidFields()) { form.classList.add("was-validated"); return; }
      form.classList.add("was-validated");

      const saveBtn = document.getElementById("aeSaveBtn");
      const originalHtml = saveBtn.innerHTML;
      saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
      saveBtn.disabled = true;

      try {
        const formData = new FormData(form);
        const res = await fetch(form.getAttribute("action"), {
          method: "POST",
          headers: { "Accept": "application/json" },
          body: formData,
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          showToast(data.message || "An error occurred during submission", true);
        } else {
          showToast(data.message || "Employee saved successfully!", false);
          closeAddEmployeeDialog();
          setTimeout(() => window.location.reload(), 900);
        }
      } catch (err) {
        console.error(err);
        showToast("Network error. Please check your connection and try again.", true);
      } finally {
        saveBtn.innerHTML = originalHtml;
        saveBtn.disabled = false;
      }
    }

    // Only Cancel / × / Esc close the dialog -- a stray backdrop click can't
    // discard a part-filled form (same rule the other master dialogs use).
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const inactiveModal = document.getElementById("aeInactiveModal");
      if (inactiveModal.classList.contains("show")) { aeCloseInactiveModal(true); return; }
      const dialog = document.getElementById("addEmployeeDialog");
      if (dialog.classList.contains("show")) closeAddEmployeeDialog();
    });
  </script>
</body>
