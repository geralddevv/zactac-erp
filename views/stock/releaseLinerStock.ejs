<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 2px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .header-action-btn:hover {
      background-color: #e4e4e4;
    }
    #release-masters-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
    .po-action-btn {
      padding: 4px 12px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      color: #fff;
      background: #044a78;
    }
    .po-action-btn:hover {
      background: #03365a;
    }
    /* Create PO is switched off for now (see the Purchase Order column).
       pointer-events: none so the click goes through to the row underneath
       rather than dying on a dead button -- the whole row opens the label
       dialog, and this cell shouldn't be the one hole in it. The reason is
       on the cell's own tooltip, which still works through it. */
    .po-action-btn:disabled {
      background: #e2e8f0;
      color: #94a3b8;
      pointer-events: none;
    }
    .add-stock-btn {
      padding: 4px 12px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      color: #fff;
      background: #15803d;
    }
    .add-stock-btn:hover {
      background: #116531;
    }
    .po-pending-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      background: #fef3c7;
      color: #92400e;
    }
    .dialog-header {
      background: #044A78;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .dialog-header h2 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
    }
    .dialog-close-btn {
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      line-height: 1;
      padding: 0 2px;
      opacity: 0.8;
      transition: opacity 0.15s;
    }
    .dialog-close-btn:hover {
      opacity: 1;
    }
    .dialog-body {
      padding: 24px;
    }
    .dialog-field-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 8px;
    }
    .dialog-error {
      color: #ef4444;
      font-size: 12px;
      margin-top: 5px;
      display: none;
    }
    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }
    .dialog-field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 12px;
    }

    /* Match Choices.js selects to the .premium-input look used by the rest
       of this dialog's fields. */
    .dialog-body .choices__inner {
      padding: 11px 14px !important;
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      background-color: #f8fafc !important;
      font-size: 14px !important;
      min-height: 0 !important;
      transition: all 0.2s ease !important;
    }
    .dialog-body .choices__list--single {
      padding: 0 !important;
    }
    .dialog-body .choices.is-focused .choices__inner,
    .dialog-body .choices.is-open .choices__inner {
      border-color: #044a78 !important;
      background-color: #ffffff !important;
      box-shadow: 0 0 0 4px rgba(4, 74, 120, 0.1) !important;
    }
    .dialog-body .choices[data-type*="select-one"]::after {
      display: block !important;
      content: "" !important;
      width: 12px !important;
      height: 8px !important;
      border-style: none !important;
      border-width: 0 !important;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E") !important;
      background-repeat: no-repeat !important;
      background-size: contain !important;
      position: absolute !important;
      right: 14px !important;
      top: 50% !important;
      margin-top: 0 !important;
      transform: translateY(-50%) !important;
    }
    .dialog-body .choices[data-type*="select-one"].is-open::after {
      transform: translateY(-50%) rotate(180deg) !important;
    }
    /* Dropdown list must render above the dialog overlay (see CLAUDE.md
       "Dialog / modal pattern" -- Choices.js in dialogs). */
    .dialog-body .choices__list--dropdown {
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      z-index: 99999 !important;
    }
    /* A long value (e.g. Vendor Name) shouldn't overflow its field or push
       against the dropdown arrow -- truncate with an ellipsis instead, both
       for the selected value shown in the closed field and for each option
       in the open dropdown list. Applies to every Choices.js select in this
       dialog, not just Vendor Name. */
    .dialog-body .choices__list--single .choices__item {
      display: block !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
      max-width: 100% !important;
      padding-right: 18px !important;
    }
    .dialog-body .choices__list--dropdown .choices__item {
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
    }

    .dialog-section-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.03em;
      color: #044a78;
      text-transform: uppercase;
      margin: 0 0 10px;
      flex: 0 0 auto;
    }
    .roll-row {
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      padding: 12px 14px;
      background: #f8fafc;
    }
    .roll-row-title {
      font-size: 12px;
      font-weight: 700;
      color: #044a78;
      margin-bottom: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }

    /* Rolls dropdown -- Tabulator's dataTree module, same pattern as
       FAIRTECH's Paper Re-Order page (views/inventory/orders/paperReorder.ejs):
       each master row expands via its own tree toggle into one child row per
       individual ReleaseLinerStock reel behind that master's stock count. */
    .tabulator-data-tree-control {
      width: 20px !important;
      height: 20px !important;
      border: none !important;
      border-radius: 4px !important;
      background: rgba(4, 74, 120, 0.1) !important;
      box-shadow: none !important;
      outline: none !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer !important;
      transition: background-color 0.15s ease !important;
    }
    .tabulator-data-tree-control:hover {
      background: rgba(4, 74, 120, 0.18) !important;
    }
    .tabulator-data-tree-control:focus,
    .tabulator-data-tree-control:focus-visible {
      outline: none !important;
      box-shadow: none !important;
    }
    .tabulator-data-tree-control-expand,
    .tabulator-data-tree-control-collapse {
      width: auto !important;
      height: auto !important;
      background: none !important;
      border: none !important;
    }
    .tabulator-data-tree-control-expand::before,
    .tabulator-data-tree-control-collapse::before {
      font-family: "Font Awesome 6 Free";
      font-weight: 900;
      content: "\f054"; /* chevron-right, one glyph for both states */
      font-size: 11px;
      line-height: 1;
      color: #044a78;
      display: inline-block;
      transition: transform 0.2s ease;
    }
    .tabulator-data-tree-control-collapse::before {
      transform: rotate(90deg);
    }
    .tabulator-data-tree-control-expand::after,
    .tabulator-data-tree-control-collapse::after {
      content: none !important;
      display: none !important;
    }
    #release-masters-table .tabulator-row.roll-detail-row {
      transition: background-color 0.15s ease;
    }
    #release-masters-table .tabulator-row.roll-detail-row:hover {
      background-color: #eef2f7 !important;
      border-top: 1px solid #e6eaf2 !important;
      border-right-style: none !important;
      border-bottom-style: none !important;
      border-left-style: none !important;
    }
    #release-masters-table .tabulator-row.roll-detail-row > .tabulator-cell,
    #release-masters-table .tabulator-row.roll-detail-row > .tabulator-col-resize-handle {
      display: none !important;
    }
    /* Invoice No is the one inward field that's still optional (see the Add
       dialog) -- a reel saved without one is flagged red here so it stands
       out for follow-up, with an Edit button (appended by rowFormatter)
       to fix it. */
    #release-masters-table .tabulator-row.roll-detail-row.roll-missing-invoice:hover {
      background-color: #fee2e2 !important;
    }
    .roll-edit-btn {
      padding: 3px 10px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 11.5px;
      font-weight: 700;
      color: #fff;
      background: #dc2626;
    }
    .roll-edit-btn:hover {
      background: #b91c1c;
    }
    /* Reel already has its Invoice No -- blue instead of the red "needs
       attention" color used for reels still missing one. */
    .roll-edit-btn.has-invoice {
      background: #044a78;
    }
    .roll-edit-btn.has-invoice:hover {
      background: #03365a;
    }
    /* Sits beside Edit on every reel row -- neutral slate, since printing a
       label is a routine step at inward, not a "needs attention" action. */
    .roll-print-btn {
      padding: 3px 10px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 11.5px;
      font-weight: 700;
      color: #fff;
      background: #475569;
    }
    .roll-print-btn:hover {
      background: #334155;
    }
    /* Last button on the reel row -- outlined rather than filled, so the one
       destructive action here doesn't read as loudly as Edit/Print and can't
       be hit by muscle memory. It goes solid red only on hover. */
    .roll-remove-btn {
      padding: 3px 10px;
      border: 1px solid #fca5a5;
      border-radius: 6px;
      cursor: pointer;
      font-size: 11.5px;
      font-weight: 700;
      color: #b91c1c;
      background: #fff;
    }
    .roll-remove-btn:hover:not(:disabled) {
      background: #dc2626;
      border-color: #dc2626;
      color: #fff;
    }
    /* Not currently used -- Remove is never disabled now (any reel can be
       removed whatever its status; see openRemoveRollDialog's warning
       instead) -- kept in case a future state needs to grey the button out
       again. */
    .roll-remove-btn:disabled {
      border-color: #e2e8f0;
      color: #94a3b8;
      cursor: not-allowed;
    }
    /* Exactly the physical sticker, so the preview is honestly "actual
       size". The dashed edge is an outline, not a border: a border would be
       inside the iframe's box and steal millimetres from the label, pushing
       every value off its pre-printed box. */
    .label-preview-frame {
      width: <%= labelSizeMm.width %>mm;
      height: <%= labelSizeMm.height %>mm;
      max-width: 100%;
      margin: 0 auto;
      background: #fff;
      outline: 1px dashed #94a3b8;
      box-shadow: 0 6px 20px rgba(15, 23, 42, 0.18);
    }
    #labelFrame {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .label-preview-caption {
      margin-top: 14px;
      text-align: center;
      font-size: 12px;
      font-weight: 600;
      color: #64748b;
    }
    /* ---- Print Reel Labels (whole-row click -> tick reels -> print) ---- */
    /* Every master row opens its own label dialog, so the row itself has to
       read as clickable -- reel rows don't (they carry their own buttons).
       The :hover state and the !important are both load-bearing: tableDisp.css
       sets `cursor: default !important` on ".tabulator .tabulator-row:hover",
       which beat a plain rule for the whole time the cursor was actually over
       the row -- the one moment the cursor is worth anything. The cells are
       named too, since the pointer is over a cell, not the row's own box. */
    #release-masters-table .tabulator-row:not(.roll-detail-row),
    #release-masters-table .tabulator-row:not(.roll-detail-row):hover,
    #release-masters-table .tabulator-row:not(.roll-detail-row) .tabulator-cell,
    #release-masters-table .tabulator-row:not(.roll-detail-row):hover .tabulator-cell {
      cursor: pointer !important;
    }
    /* Where the click leads: the reel count is drawn as a tag rather than a
       bare number, and lights up with the row, so the row's one clickable
       meaning is visible before it is clicked rather than only discoverable
       by trying it. */
    .rolls-chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 2px 10px;
      border-radius: 999px;
      background: #eef2f7;
      color: #334155;
      font-size: 12px;
      font-weight: 700;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .rolls-chip i { font-size: 10.5px; color: #64748b; }
    #release-masters-table .tabulator-row:hover .rolls-chip {
      background: #044a78;
      color: #fff;
    }
    #release-masters-table .tabulator-row:hover .rolls-chip i { color: #fff; }

    .pl-toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      padding: 12px 18px;
      border-bottom: 1px solid #e6eaf2;
      background: #f8fafc;
    }
    /* Sized off .premium-input (boilerplate.ejs) so the tick box and the
       search field sit on one line rather than one being half the other. */
    .pl-selectall {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin: 0;
      padding: 12px 14px;
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      background: #fff;
      font-size: 14px;
      font-weight: 700;
      color: #1f2a44;
      cursor: pointer;
      white-space: nowrap;
    }
    .pl-selectall:hover { border-color: #044a78; color: #044a78; }
    .pl-selectall input { width: 16px; height: 16px; accent-color: #044a78; cursor: pointer; margin: 0; flex: none; }
    /* Padding, radius and focus ring all come from .premium-input -- the
       app's own input style, which is also what every other field in these
       dialogs uses. Only the sizing and the white fill (so the box doesn't
       disappear into the toolbar it sits on) are this page's. */
    .pl-search {
      flex: 1 1 200px;
      min-width: 150px;
      margin: 0 2px;
      background-color: #fff !important;
    }
    .pl-search::placeholder { color: #94a3b8; }

    .pl-count {
      font-size: 12px;
      font-weight: 700;
      color: #475569;
      white-space: nowrap;
      margin-left: auto;
    }
    .pl-panes {
      flex: 1 1 auto;
      min-height: 0;
      overflow: auto;
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      padding: 14px 18px;
    }
    .pl-panes > * { height: min(52vh, 520px); }
    /* List and preview share one height: left to the content, a spec with
       two reels would shrink the row to 100px and leave the preview too
       short to show a single label. */
    .pl-list {
      flex: 1 1 320px;
      min-width: 260px;
      height: min(52vh, 520px);
      overflow-y: auto;
      border: 1px solid #e6eaf2;
      border-radius: 10px;
      background: #fff;
    }
    /* Whole row is the <label>, so the tick target is the row, not a 15px
       box -- these are read and ticked in a hurry at the inward bench. */
    .pl-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0;
      padding: 8px 12px;
      border-bottom: 1px solid #f1f5f9;
      cursor: pointer;
      font-weight: 500;
    }
    .pl-row:last-child { border-bottom: none; }
    .pl-row:hover { background: #f8fafc; }
    .pl-row input { width: 15px; height: 15px; accent-color: #044a78; cursor: pointer; margin: 0; flex: none; }
    /* Same marker a picked reel gets in Assign Production's layer tables --
       ticks stay findable when the list is scrolled. */
    .pl-row:has(input:checked) {
      background: #f4f9ff;
      box-shadow: inset 3px 0 0 #044a78;
    }
    .pl-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1 1 auto; }
    .pl-roll { font-size: 13px; font-weight: 800; color: #1f2a44; }
    .pl-meta { font-size: 11.5px; color: #64748b; }
    .pl-meta .pl-no-invoice { color: #dc2626; font-weight: 700; }
    .pl-badge {
      flex: none;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 10.5px;
      font-weight: 800;
      white-space: nowrap;
    }
    .pl-badge.allotted { background: #fef3c7; color: #92400e; }
    .pl-badge.inuse { background: #ccfbf1; color: #0f766e; }
    .pl-badge.used { background: #ede9fe; color: #6d28d9; }
    .pl-empty { padding: 26px 18px; text-align: center; font-size: 13px; color: #64748b; font-weight: 600; }
    /* The preview IS the print target (the same document the Print button
       hands to the browser), so what is on screen here is what comes off the
       printer -- sized to the real sticker, one per page, scrolled. */
    /* The sticker's own width, plus the frame's border and room for the
       scrollbar a stack of labels needs -- at exactly 101.5mm the label was
       two pixels wider than the box it sits in and the preview scrolled
       sideways. */
    .pl-preview {
      flex: 0 0 auto;
      width: calc(<%= labelSizeMm.width %>mm + 22px);
      max-width: 100%;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .pl-preview-frame {
      flex: 1 1 auto;
      min-height: 0;
      border: 1px solid #e6eaf2;
      border-radius: 10px;
      overflow: hidden;
      background: #eef2f7;
      position: relative;
    }
    #plFrame { display: block; width: 100%; height: 100%; border: 0; }
    .pl-preview-msg {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 16px;
      font-size: 12px;
      font-weight: 600;
      color: #64748b;
      background: #eef2f7;
    }
    .pl-preview-msg:empty { display: none; }
    .pl-preview-caption { font-size: 11px; font-weight: 700; color: #94a3b8; text-align: center; }
    .pl-footer {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      padding: 12px 18px;
      border-top: 1px solid #e6eaf2;
      background: #f8fafc;
      border-radius: 0 0 14px 14px;
    }
    .pl-footer .pl-hint { font-size: 11.5px; color: #64748b; font-weight: 600; }
    .pl-footer .pl-actions { margin-left: auto; display: flex; gap: 10px; flex-wrap: wrap; }

    /* ---- Find a reel by its own number (the box on the header bar) ----
       Every column header filter on this table matches MASTER rows only
       (dataTreeFilter: false), and a reel's own number lives on a child
       row inside a dropdown that starts collapsed -- so without this the
       only way to find one reel is to open every spec in turn.

       Drawn as a light chip on the dark .indi-head bar, like the value
       chips beside it, NOT as a translucent one: tableDisp.css line 13
       styles every `input` on the page with
       `background-color: #f8f9fa !important`, so a transparent field with
       white text is not possible here -- it renders as white-on-white. The
       bar is painted that same #f8f9fa so the field it wraps has no seam,
       and the text is the page blue. The rest of that global rule (20px
       height, 12px text, grey border, 6px radius) is plain enough to
       override from these class selectors; only the background needs
       !important to answer !important. */
    /* .indi-head itself is nowrap (tableDisp.css), so once the title +
       value chips (which wrap internally) outgrow the row, the find bar
       got squeezed onto the same line and started overlapping the chips
       instead of dropping to its own line underneath them. */
    .indi-head {
      flex-wrap: wrap;
      row-gap: 10px;
    }
    .stock-find-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 0 1 auto;
      min-width: 0;
      margin-left: auto;
    }
    .stock-find-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 0 1 180px;
      min-width: 130px;
      background: #f8f9fa;
      border: 1px solid #dbe4ee;
      border-radius: 8px;
      padding: 5px 10px;
    }
    .stock-find-bar:focus-within {
      border-color: #fff;
      box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.55);
    }
    .stock-find-icon {
      color: #044a78;
      font-size: 12.5px;
      flex: 0 0 auto;
    }
    .stock-find-input {
      flex: 1 1 auto;
      min-width: 0;
      height: auto;
      border: none;
      border-radius: 0;
      padding: 2px 0;
      outline: none;
      background-color: #f8f9fa !important;
      font-size: 13px;
      font-weight: 700;
      color: #044a78;
    }
    .stock-find-input::placeholder {
      color: #94a3b8;
      font-weight: 500;
    }
    .stock-find-clear {
      flex: 0 0 auto;
      border: none;
      background: #dbe4ee;
      color: #044a78;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      font-size: 13px;
      line-height: 1;
      padding: 0;
      cursor: pointer;
    }
    .stock-find-clear:hover {
      background: #c3d3e4;
    }
    /* Pale enough to read on the dark bar, and out of the way entirely
       until there is something to say. */
    .stock-find-status {
      flex: 0 0 auto;
      font-size: 12px;
      font-weight: 700;
      color: #bbf7d0;
      white-space: nowrap;
    }
    .stock-find-status.is-empty {
      color: #fecaca;
    }

  </style>

  <!-- Release Master rows are the only table here: current stock (total
       mtrs still on non-empty reels, matched by the same fields Release
       Master's own duplicate-check signature hashes) sits right on the spec
       it's stock of, alongside MSQ/shortage and the Inward/Create PO
       actions -- see routes/stock/releaseLinerStock.js's
       loadMastersWithStock. Every master is listed here even with zero
       reels. -->
  <div class="indi-head">
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 14px;">
      <div style="display: flex; align-items: center; gap: 10px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.3); padding: 8px 16px; border-radius: 10px;">
        <i class="fa-solid fa-scroll" style="font-size: 1.1rem; opacity: 0.9;"></i>
        <h1 style="margin: 0; letter-spacing: 0.02em;">Release Liner Stock</h1>
      </div>
      <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 10px;">
      <span style="font-size: 13px; font-weight: 700; color: #044a78; background: #eef2f7; padding: 6px 12px; border-radius: 8px;">
        Total Value: <span id="stockTotalValue" style="color: #15803d; font-size: 15px;">₹<%= Number(totalStockValue || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 }) %></span>
      </span>
      <span style="font-size: 13px; font-weight: 700; color: #044a78; background: #eef2f7; padding: 6px 12px; border-radius: 8px;"
        title="Release Liner's Stock (Kg) converted to running metres at each spec's own GSM and width -- specs with no GSM aren't included.">
        Total RM: <span id="stockTotalRm" style="color: #15803d; font-size: 15px;"><%= Number(totalRunningMeters || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 }) %> m</span>
      </span>
      <span style="width: 1px; align-self: stretch; background: rgba(255, 255, 255, 0.4);"></span>
      <span style="font-size: 13px; font-weight: 700; color: #044a78; background: #eef2f7; padding: 6px 12px; border-radius: 8px;">
        Facestock Value: <span id="stockFacestockValue" style="color: #15803d;">₹<%= Number(facestockValue || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 }) %></span>
      </span>
      <span style="font-size: 13px; font-weight: 700; color: #044a78; background: #eef2f7; padding: 6px 12px; border-radius: 8px;">
        Adhesive Value: <span id="stockAdhesiveValue" style="color: #15803d;">₹<%= Number(adhesiveValue || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 }) %></span>
      </span>
      <span style="font-size: 13px; font-weight: 700; color: #044a78; background: #eef2f7; padding: 6px 12px; border-radius: 8px; box-shadow: 0 0 0 2px #044a78, 0 0 0 3.5px #fff;">
        Release Liner Value: <span id="stockReleaseValue" style="color: #15803d;">₹<%= Number(releaseValue || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 }) %></span>
      </span>
      </div>
    </div>
    <!-- Find a reel: the column header filters search the spec rows, this
         searches the reels underneath them (see .stock-find-bar above). -->
    <div class="stock-find-wrap">
      <span id="stockFindStatus" class="stock-find-status"></span>
      <div class="stock-find-bar">
        <i class="fa-solid fa-magnifying-glass stock-find-icon"></i>
        <input type="text" id="stockFindInput" class="stock-find-input" autocomplete="off"
          placeholder="Search reel no."
          title="Searches every reel on this page by Roll ID, Vendor Roll ID or Invoice No, including the ones inside dropdowns that are still closed." />
        <button type="button" id="stockFindClear" class="stock-find-clear" title="Clear (Esc)" aria-label="Clear search" hidden>&times;</button>
      </div>
      <!-- The whole pool's history in one place -- a master row's own View
           button (added to the table below) only knows about reels still in
           stock; this page has every reel ever inwarded, used up or not. -->
      <a href="/app/releaselinerstock/timeline" class="header-action-btn">
        <i class="fa-solid fa-clock-rotate-left"></i> Inward Timeline
      </a>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="release-masters-table" class="tabulator tabulator-modern"></div>
</div>

