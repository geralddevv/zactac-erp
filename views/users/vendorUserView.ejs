<% layout('/layout/boilerplate') -%>

<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
<!-- Form-dialog style for the New Coordinator dialog (_vendorUserDialog.ejs) -->
<link href="/css/soDialog.css?v=2" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 2px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .header-action-btn:hover {
      background-color: #e4e4e4;
    }

    .col-count-center .tabulator-col-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      padding: 4px 2px 6px;
    }

    .tabulator .tabulator-header .tabulator-col.col-count-center {
      justify-content: center;
    }

    .col-count-center .tabulator-col-title-holder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: auto;
      width: 100%;
    }

    .col-count-center .tabulator-col-title {
      width: 100%;
      text-align: center;
      white-space: nowrap;
      line-height: 1.1;
    }

    .col-count-center .tabulator-header-filter {
      width: 100%;
      margin-top: 0;
    }

    .col-count-center .tabulator-header-filter input {
      width: 100%;
      box-sizing: border-box;
    }

    .tabulator-cell.col-count-center {
      text-align: center;
      vertical-align: middle;
    }

    .count-link {
      cursor: pointer;
      text-decoration: underline;
      font-weight: 600;
      color: #044a78;
    }

    /* Collapsed multi-commodity summary in the Commodities cell -- a vendor
       with many commodities can otherwise blow the row out to several lines
       or force the column wide; the full list is still on hover (title) and
       always visible one-per-row once the tree toggle is expanded. */
    .commodity-summary {
      display: block;
      max-width: 100%;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      color: #64748b;
    }

    /* Commodities dropdown -- Tabulator's dataTree module, same pattern as
       /sachiko/facestockstock's Rolls dropdown: a row supplying 2+
       commodities expands via its own tree toggle into one child row per
       commodity, instead of repeating the whole vendor/location row once
       per commodity. */
    .tabulator-data-tree-control {
      width: 20px !important;
      height: 20px !important;
      border: none !important;
      border-radius: 4px !important;
      background: rgba(4, 74, 120, 0.1) !important;
      box-shadow: none !important;
      outline: none !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer !important;
      transition: background-color 0.15s ease !important;
    }
    .tabulator-data-tree-control:hover {
      background: rgba(4, 74, 120, 0.18) !important;
    }
    .tabulator-data-tree-control:focus,
    .tabulator-data-tree-control:focus-visible {
      outline: none !important;
      box-shadow: none !important;
    }
    .tabulator-data-tree-control-expand,
    .tabulator-data-tree-control-collapse {
      width: auto !important;
      height: auto !important;
      background: none !important;
      border: none !important;
    }
    .tabulator-data-tree-control-expand::before,
    .tabulator-data-tree-control-collapse::before {
      font-family: "Font Awesome 6 Free";
      font-weight: 900;
      content: "\f054"; /* chevron-right, one glyph for both states */
      font-size: 11px;
      line-height: 1;
      color: #044a78;
      display: inline-block;
      transition: transform 0.2s ease;
    }
    .tabulator-data-tree-control-collapse::before {
      transform: rotate(90deg);
    }
    .tabulator-data-tree-control-expand::after,
    .tabulator-data-tree-control-collapse::after {
      content: none !important;
      display: none !important;
    }
    #master-table .tabulator-row.commodity-detail-row {
      transition: background-color 0.15s ease;
      background-color: #f8fafc;
      border-top: 1px solid #e6eaf2;
    }
    #master-table .tabulator-row.commodity-detail-row:hover {
      background-color: #eef2f7 !important;
    }
    #master-table .tabulator-row.commodity-detail-row > .tabulator-cell,
    #master-table .tabulator-row.commodity-detail-row > .tabulator-col-resize-handle {
      display: none !important;
    }

    #master-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
  </style>

  <div class="indi-head">
    <h1>Vendor Coordinator View</h1>

    <div style="display: flex; gap: 10px; align-items: center">
      <button type="button" class="header-action-btn" onclick="openVendorUserDialog()">
        <i class="fa-solid fa-plus" style="margin-right: 4px"></i> Coordinator
      </button>

      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span>
            <i class="fa-solid fa-file-arrow-down"></i>
            <span class="download-typo">Download</span>
          </span>
          <i class="fas fa-chevron-down download-selector__trigger-icon"></i>
        </button>
        <div class="download-selector__menu" id="downloads">
          <span class="download-selector__option" id="download-pdf">
            <i class="fas fa-file-pdf download-selector__option-icon"></i>
            <span>PDF</span>
          </span>
          <span class="download-selector__option" id="download-xlsx">
            <i class="fas fa-file-excel download-selector__option-icon"></i>
            <span>Excel</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table" class="tabulator tabulator-modern"></div>
</div>

<script src="/js/verification.js"></script>
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.20/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<script>
  const downloadSelector = document.getElementById("downloadSelector");
  const triggerBtn = downloadSelector.querySelector(".download-selector__trigger");

  triggerBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    downloadSelector.classList.toggle("download-selector--active");

    const icon = triggerBtn.querySelector(".download-selector__trigger-icon");
    icon.style.transform = downloadSelector.classList.contains("download-selector--active")
      ? "rotate(180deg)"
      : "rotate(0deg)";
  });

  document.addEventListener("click", () => {
    downloadSelector.classList.remove("download-selector--active");
    const icon = triggerBtn.querySelector(".download-selector__trigger-icon");
    icon.style.transform = "rotate(0deg)";
  });

  downloadSelector.querySelector(".download-selector__menu").addEventListener("click", (e) => {
    e.stopPropagation();
  });

  let tableData = [];
  try {
    tableData = <%- safeJson(jsonData || []) %>;
  } catch (err) {
    console.error("Vendor coordinator view JSON error", err);
  }

  // Mirrors utils/locations.js normalizeLocationName — see /master/view's same
  // per-location flatten for why this normalization matters.
  const normalizeLocationName = (value) =>
    String(value || "")
      .trim()
      .toUpperCase()
      .replace(/\s+/g, " ")
      .replace(/^[.,]+|[.,]+$/g, "");

  // One row per coordinator location — same pattern as /master/view, so a
  // coordinator with multiple locations shows up as multiple rows here too.
  const byLocation = [];
  tableData.forEach((row) => {
    const locs = Array.isArray(row.locationDetails) && row.locationDetails.length
      ? row.locationDetails
      : [{
          userLocation: row.userLocation,
          dispatchAddress: row.dispatchAddress,
          selfDispatch: row.SelfDispatch,
          transportName: row.transportName,
          transportContact: row.transportContact,
          dropLocation: row.dropLocation,
          dropLocation1: row.dropLocation1,
          deliveryMode: row.deliveryMode,
          deliveryLocation: row.deliveryLocation,
          deliveryLocation1: row.deliveryLocation1,
          vendorPayment: row.vendorPayment,
        }];

    locs.forEach((loc) => {
      byLocation.push({
        ...row,
        userLocation: normalizeLocationName(loc.userLocation) || row.userLocation,
        dispatchAddress: loc.dispatchAddress ?? row.dispatchAddress,
        SelfDispatch: loc.selfDispatch || "",
        transportName: loc.transportName || "",
        transportContact: loc.transportContact || "",
        dropLocation: loc.dropLocation || "",
        dropLocation1: loc.dropLocation1 || "",
        deliveryMode: loc.deliveryMode || "",
        deliveryLocation: loc.deliveryLocation || "",
        deliveryLocation1: loc.deliveryLocation1 || "",
        vendorPayment: loc.vendorPayment || "",
        dispatchType: loc.selfDispatch ? "Self Dispatch" : "Transport",
      });
    });
  });
  tableData = byLocation;

  // One row stays one row even when a vendor supplies several commodities --
  // this used to explode a row into a copy of itself per commodity, which
  // repeated every vendor/location detail as many times as the vendor had
  // commodities. The Commodities column now renders every commodity for the
  // row itself (a dropdown once there's more than one), so there's nothing
  // left to explode here.
  tableData = tableData.map((row) => {
    const dispatchType = row.dispatchType || (row.SelfDispatch ? "Self Dispatch" : "Transport");
    const rawCommodities = Array.isArray(row.commodities) && row.commodities.length > 0 ? row.commodities : ["-"];

    const commodityEntries = rawCommodities.map((commodity) => ({
      display: commodity,
      filter: typeof commodity === "string" && commodity.startsWith("OTHERS - ") ? "OTHERS" : commodity,
    }));

    return { ...row, dispatchType, commodityEntries };
  });

  // Commodity -> vendor-scoped binding-view URL. Only TTR/Tape have a
  // binding-view route; other commodities (Face Paper, Adhesive, etc.) stay
  // plain text.
  function commodityLink(commodity, rowId) {
    if (!rowId) return null;
    switch (String(commodity || "").trim().toUpperCase()) {
      case "TTR": return `/app/ttr-vendor/view?userId=${encodeURIComponent(rowId)}`;
      default: return null;
    }
  }

  let table;
  const withTextFilter = (column, placeholder = "Search") => ({
    headerFilter: "input",
    headerFilterPlaceholder: placeholder,
    ...column,
  });

  const withSelectFilter = (column, values) => ({
    headerFilter: "list",
    headerFilterParams: {
      values: values,
      clearable: true,
      autocomplete: true,
    },
    ...column,
  });

  // Flattens each row into Tabulator's dataTree shape: one row per
  // vendor/coordinator/location, with a _children row per extra commodity
  // when the row supplies more than one -- same "Rolls" dropdown pattern as
  // /sachiko/facestockstock. A row with 0 or 1 commodities gets no
  // _children key at all (not even an empty array -- Tabulator still draws
  // a toggle for that), so its leftmost column stays blank with nothing to
  // open.
  function buildVendorTreeData(rows) {
    return rows.map((r) => {
      const entries = r.commodityEntries && r.commodityEntries.length ? r.commodityEntries : [{ display: "-", filter: "-" }];
      const row = { ...r, isParent: true };
      if (entries.length > 1) {
        row._children = entries.map((e) => ({ _id: r._id, commodityEntries: [e], isParent: false }));
      }
      return row;
    });
  }

  function initTable() {
    table = new Tabulator("#master-table", {
      data: buildVendorTreeData(tableData),
      height: "100%",
      // layout: "fitColumns",
      virtualDom: true,
      responsiveLayout: false,
      initialSort: [{ column: "vendorName", dir: "asc" }],
      movableColumns: true,
      placeholder: "No data to display",
      dataTree: true,
      dataTreeStartExpanded: false,
      dataTreeChildField: "_children",
      // Child (commodity) rows don't carry a parent's own vendor/location
      // values -- scope header filtering to parent rows only, same as
      // facestockStock.ejs, so a matching parent's commodities still all
      // display under an active filter.
      dataTreeFilter: false,
      dataTreeElementColumn: "_toggle",
      // Child rows carry only one thing worth showing (the commodity itself)
      // -- hide every per-column cell on those rows and replace them with
      // one spanning detail bar instead, same pattern as facestockStock.ejs's
      // reel rows.
      rowFormatter: (row) => {
        const data = row.getData();
        if (data.isParent) return;
        const el = row.getElement();
        if (el.querySelector(".commodity-detail-span")) return;
        el.classList.add("commodity-detail-row");
        const entry = (data.commodityEntries || [])[0] || { display: "-", filter: "-" };
        const link = commodityLink(entry.filter, data._id);
        const bar = document.createElement("div");
        bar.className = "commodity-detail-span";
        bar.style.cssText = "flex:1; display:flex; align-items:center; gap:8px; padding:6px 12px; color:#4b5563; font-size:13px;";
        bar.append("↳ ");
        const label = document.createElement("span");
        label.textContent = entry.display;
        if (link) {
          label.className = "count-link";
          label.addEventListener("click", () => window.location.href = link);
        }
        bar.appendChild(label);
        el.appendChild(bar);
      },
      columns: [
        { title: "", field: "_toggle", width: 40, hozAlign: "center", headerSort: false },
        // getPosition(true) is the row's rank among currently sorted/filtered
        // rows, re-evaluated on every redraw -- stays correct after sorting or
        // filtering instead of a static index frozen at load time. Commodity
        // (child) rows don't get their own number, same as every other column
        // here.
        { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
          formatter: (cell) => cell.getRow().getData().isParent ? cell.getRow().getPosition(true) : "" },
        (() => {
          const distinct = Array.from(
            new Set(tableData.flatMap((r) => (r.commodityEntries || []).map((e) => e.filter)))
          ).filter((c) => c && c !== "-").sort();
          const filterValues = { "": "All" };
          distinct.forEach((c) => { filterValues[c] = c; });

          return {
            title: "Commodities",
            field: "commodityEntries",
            // A fixed width, not minWidth -- minWidth still let the column's
            // "fitData" sizing grow to fit a long comma-joined commodity
            // list, which is exactly what the ellipsis below was meant to
            // avoid. widthGrow: 0 stops it reclaiming any of that back too.
            width: 220,
            widthGrow: 0,
            headerSort: true,
            // Sorts on the first commodity's own text -- there's no single
            // scalar to sort a multi-commodity row on.
            sorter: (a, b, rowAData, rowBData) => {
              const da = (rowAData.commodityEntries || [])[0]?.display || "";
              const db = (rowBData.commodityEntries || [])[0]?.display || "";
              return String(da).localeCompare(String(db));
            },
            headerFilter: "list",
            headerFilterParams: { values: filterValues, clearable: true, autocomplete: true },
            // Default "list" filter compares the header's pick against a
            // single field value -- this row's field is an array, so the
            // match has to check whether ANY of the row's commodities is it.
            headerFilterFunc: (headerValue, rowValue, rowData) => {
              if (!headerValue) return true;
              return (rowData.commodityEntries || []).some((e) => e.filter === headerValue);
            },
            // Download (PDF/Excel) reads the plain field value, not the
            // formatter's DOM node -- without this it prints "[object Object]".
            accessorDownload: (value, data) => (data.commodityEntries || []).map((e) => e.display).join(", "),
            // A single commodity (a parent row that supplies just one, or a
            // commodity's own child row once expanded) renders exactly as
            // before -- plain text, or a link for TTR/Tape. A parent row
            // supplying 2+ just summarises them here; the tree toggle in the
            // leftmost column expands it into one clickable row per
            // commodity, instead of repeating the whole row once per
            // commodity.
            formatter: (cell) => {
              const data = cell.getRow().getData();
              const entries = data.commodityEntries && data.commodityEntries.length ? data.commodityEntries : [{ display: "-", filter: "-" }];

              if (entries.length === 1) {
                const entry = entries[0];
                const link = commodityLink(entry.filter, data._id);
                const span = document.createElement("span");
                span.textContent = entry.display;
                if (link) span.className = "count-link";
                return span;
              }

              const summary = entries.map((e) => e.display).join(", ");
              const span = document.createElement("span");
              span.className = "commodity-summary";
              span.textContent = summary;
              span.title = summary; // full list on hover, since the text itself is truncated below
              return span;
            },
            cellClick: (e, cell) => {
              const data = cell.getRow().getData();
              const entries = data.commodityEntries || [];
              if (entries.length !== 1) return;
              const link = commodityLink(entries[0].filter, data._id);
              if (link) window.location.href = link;
            },
          };
        })(),
        withTextFilter({
          title: "Vendor",
          field: "vendorName",
          headerSort: true,
          widthGrow: 2,
        }),
        withTextFilter({
          title: "Coordinator",
          field: "userName",
          headerSort: true,
          widthGrow: 2,
          formatter: (cell) => {
            const row = cell.getRow().getData();
            if (!row?._id) return cell.getValue() || "";
            return `<span style="display:inline-flex;align-items:center;gap:5px;"><span class="count-link">${cell.getValue() || ""}</span>${verifiedBadgeFor(row, 16)}</span>`;
          },
          cellClick: (e, cell) => {
            const row = cell.getRow().getData();
            if (!row?._id) return;
            window.location.href = `/app/vendor/coordinator/details/${encodeURIComponent(row._id)}`;
          },
        }),
        withSelectFilter({
          title: "Status",
          field: "vendorStatus",
          headerSort: true,
          width: 120,
        }, {
          "": "All",
          "ACTIVE": "ACTIVE",
          "INACTIVE": "INACTIVE",
          "BLACKLISTED": "BLACKLISTED",
          "OTHERS": "OTHERS"
        }),
        withTextFilter({
          title: "Location",
          field: "userLocation",
          headerSort: true,
          widthGrow: 2,
        }),
        withTextFilter({
          title: "Pick Up Loc",
          field: "deliveryLocation",
          headerSort: true,
          widthGrow: 2,
        }),
      ],
    });

    // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
    // `renderComplete:` key inside the options object above is silently
    // ignored (no error, callback just never runs). Subscribing via .on()
    // is the only way it actually fires. Reads straight off the rendered
    // DOM rather than Tabulator's row APIs (getRow().getPosition()/
    // getRows("active") were both observed to go stale after a sort) --
    // whatever's actually on screen, top to bottom, is renumbered 1..n
    // every time the table redraws. Commodity (child) rows are marked
    // ".commodity-detail-row" by rowFormatter above and skipped, same as
    // every other parent-only column.
    table.on("renderComplete", function () {
      document.querySelectorAll("#master-table .tabulator-row:not(.commodity-detail-row)").forEach((rowEl, i) => {
        const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
        if (cell) cell.textContent = i + 1;
      });
    });
  }

  window.addEventListener("load", initTable);

  document.getElementById("download-pdf").addEventListener("click", () => {
    if (!table) return;
    table.download("pdf", "vendor-coordinator-view.pdf", {
      orientation: "landscape",
      title: "Vendor Coordinator View",
    });
    downloadSelector.classList.remove("download-selector--active");
  });

  document.getElementById("download-xlsx").addEventListener("click", () => {
    if (!table) return;
    table.download("xlsx", "vendor-coordinator-view.xlsx", {
      sheetName: "Vendor Coordinator View",
    });
    downloadSelector.classList.remove("download-selector--active");
  });
</script>

<% if (notification && notification.length) { %>
<script>
  const vendorCoordinatorFlashMessage = <%- safeJson(notification[0]) %>;
  const vendorCoordinatorFlashType = /failed|not found|error/i.test(String(vendorCoordinatorFlashMessage)) ? "error" : "success";

  const showVendorCoordinatorFlash = () => {
    if (typeof hideStaticToast === "function") hideStaticToast();
    if (typeof showToast === "function") showToast(vendorCoordinatorFlashMessage, vendorCoordinatorFlashType);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", showVendorCoordinatorFlash, { once: true });
  } else {
    showVendorCoordinatorFlash();
  }
</script>
<% } %>

<!-- New Coordinator dialog, opened by the "+ Coordinator" button above and by
     "Add Coordinator" links on the vendor pages (?new=coordinator&vendorName=...). -->
<%- include('./_vendorUserDialog', { vendors }) %>
