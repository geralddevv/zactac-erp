<% layout('/layout/boilerplate') %>
<style>
  .label-stock-id-success {
    border: 2px solid #28a745 !important;
    background-color: #f3fff6;
    color: #155724;
    font-weight: 600;
  }

  .label-stock-id-error {
    border: 2px solid #dc3545 !important;
    background-color: #fff5f5;
    color: #721c24;
    font-weight: 600;
  }

  .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }

  #client-name-div .choices__list--dropdown .choices__item,
  #client-name-div .choices__list--single .choices__item {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<!-- The main content -->
<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px;">
  <form action="/app/form/label-stock-binding" method="post" onsubmit="return handleLabelStockBindingSubmit(event)" class="needs-validation" autocomplete="off" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="span-full form-heading">
      <h1>Client Label Stock</h1>
    </div>

    <div class="span-full form-subheading">
      <h1>Binding Details</h1>
    </div>

    <div id="label-stock-id-div" class="span-seven" style="display:none;">
      <label for="label-stock-id">SKU Code</label>
      <input type="text" id="label-stock-id" class="form-control" name="skuCode" placeholder="Will appear here" readonly />
    </div>

    <div id="client-name-div" class="span-seven">
      <div class="clientName-label"><label for="client-name">Client Name</label><span class="asterisk" style="font-size: 14px;"></span></div>
      <select name="clientName" id="client-name" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% for (let client of clients) { %>
        <option value="<%= client %>"><%= client %></option>
        <% } %>
      </select>
    </div>

    <div id="user-name-div" class="span-five">
      <label>User Name</label>
      <select id="client-user-name" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
      </select>
    </div>
    <div id="user-name-contact-div" class="span-four">
      <label for="user-contact">User Contact</label>
      <input type="text" id="user-contact" class="form-control" placeholder="Will appear here" required readonly />
    </div>
    <div id="client-location-div" class="span-three">
      <label for="client-location">Location</label>
      <select name="location" id="client-location" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select</option>
      </select>
    </div>
    <div id="sku-code-select-div" class="span-five">
      <label for="sku-code-select">SKU Code</label>
      <select id="sku-code-select" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Search</option>
        <% labelStocks?.forEach(ls => { %>
          <option value="<%= ls._id %>"><%= ls.productCode %></option>
        <% }) %>
      </select>
    </div>

    <div id="paper-size-div" class="span-four">
      <label for="paper-size">Paper Width</label>
      <input type="text" id="paper-size" name="paperSize" class="form-control" placeholder="Enter Paper Width" required />
    </div>

    <div id="running-meters-div" class="span-two">
      <label for="running-meters">RM</label>
      <input type="number" id="running-meters" name="runningMeters" class="form-control" placeholder="RM" required min="0" step="any" />
    </div>

    <div id="rate-div" class="span-two">
      <label for="rate">Rate</label>
      <input type="number" id="rate" name="rate" class="form-control" placeholder="Rate" required min="0" step="any" />
    </div>

    <div id="spec-blocks-section" style="display:none;">
    <div class="span-full form-subheading" style="display: flex; justify-content: space-between; align-items: center;">
      <h1>Label Stock Specifications</h1>
      <button type="button" id="reset-specs-btn" style="padding: 4px 12px; border-radius: 4px; background-color: #dc3545; color: white; border: none; cursor: pointer; font-size: 14px;">
        Reset
      </button>
    </div>

    <!-- Facestock -->
    <div style="grid-column: span 12; display: flex; flex-direction: column; gap: 1rem">
      <div class="span-full form-subheading">
        <h1>Facestock</h1>
      </div>
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem">
        <div class="span-six" style="grid-column: auto">
          <label>Family</label>
          <select id="fs-family" class="form-control select-tag">
            <option value="" disabled selected hidden>Search</option>
            <% fsFamilies?.forEach(v => { %>
              <option value="<%= v %>"><%= v %></option>
            <% }) %>
          </select>
        </div>
        <div class="span-six" style="grid-column: auto">
          <label>Type</label>
          <select id="fs-type" class="form-control select-tag">
            <option value="" disabled selected hidden>Search</option>
            <% fsTypes?.forEach(v => { %>
              <option value="<%= v %>"><%= v %></option>
            <% }) %>
          </select>
        </div>
        <div class="span-four" style="grid-column: auto">
          <label>GSM</label>
          <select id="fs-gsm" class="form-control select-tag">
            <option value="" disabled selected hidden>Search</option>
            <% fsGsms?.forEach(v => { %>
              <option value="<%= v %>"><%= v %></option>
            <% }) %>
          </select>
        </div>
        <div class="span-four" style="grid-column: auto">
          <label>Micron</label>
          <select id="fs-micron" class="form-control select-tag">
            <option value="" disabled selected hidden>Search</option>
            <% fsMicrons?.forEach(v => { %>
              <option value="<%= v %>"><%= v %></option>
            <% }) %>
          </select>
        </div>
      </div>
    </div>

    <!-- Adhesive -->
    <div style="grid-column: span 8; display: flex; flex-direction: column; gap: 1rem">
      <div class="span-full form-subheading">
        <h1>Adhesive</h1>
      </div>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem">
        <div class="span-seven" style="grid-column: auto">
          <label>Type</label>
          <select id="ad-type" class="form-control select-tag">
            <option value="" disabled selected hidden>Search</option>
            <% adTypes?.forEach(v => { %>
              <option value="<%= v %>"><%= v %></option>
            <% }) %>
          </select>
        </div>
        <div class="span-four" style="grid-column: auto">
          <label>GSM</label>
          <select id="ad-gsm" class="form-control select-tag">
            <option value="" disabled selected hidden>Search</option>
            <% adGsms?.forEach(v => { %>
              <option value="<%= v %>"><%= v %></option>
            <% }) %>
          </select>
        </div>
      </div>
    </div>

    <!-- Release Liner -->
    <div style="grid-column: span 12; display: flex; flex-direction: column; gap: 1rem">
      <div class="span-full form-subheading">
        <h1>Release Liner</h1>
      </div>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem">
        <div class="span-seven" style="grid-column: auto">
          <label>Type</label>
          <select id="rl-type" class="form-control select-tag">
            <option value="" disabled selected hidden>Search</option>
            <% rlTypes?.forEach(v => { %>
              <option value="<%= v %>"><%= v %></option>
            <% }) %>
          </select>
        </div>
        <div class="span-four" style="grid-column: auto">
          <label>Color</label>
          <select id="rl-color" class="form-control select-tag">
            <option value="" disabled selected hidden>Search</option>
            <% rlColors?.forEach(v => { %>
              <option value="<%= v %>"><%= v %></option>
            <% }) %>
          </select>
        </div>
        <div class="span-four" style="grid-column: auto">
          <label>GSM</label>
          <select id="rl-gsm" class="form-control select-tag">
            <option value="" disabled selected hidden>Search</option>
            <% rlGsms?.forEach(v => { %>
              <option value="<%= v %>"><%= v %></option>
            <% }) %>
          </select>
        </div>
      </div>
    </div>
    </div><!-- /#spec-blocks-section -->

    <div id="sku-layer-preview" class="span-full" style="display:none;">
      <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:16px 18px;max-width:600px;margin:0 auto;">
        <p id="sku-layer-title" style="margin:0 0 10px;font-size:13px;font-weight:700;color:#03365a;text-align:center;"></p>
        <div id="sku-layer-stack" class="custom-scrollbar" style="display:flex;flex-direction:column;gap:2px;max-height:320px;overflow-y:auto;padding:2px;"></div>
      </div>
    </div>

    <input type="hidden" name="labelStockId" id="resolved-label-stock-id">
    <input type="hidden" name="userId" id="user-id">

    <%- include('../partials/verifiedCheckbox', { doc: null }) %>

    <div class="btn-grp span-full">
      <button type="submit">Save Label Stock Binding</button>
    </div>
  </form>
</div>

<script>
  const labelStocksData = <%- safeJson(labelStocks || []) %>;

  function escSku(v) {
    return String(v ?? "—").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

  /* ── Physical layer stack builder (same layer order used on the Label Stock View page) ── */
  const SKU_LAYER_STYLE = {
    facestock: { bg: "#ffffff", border: "#93c5fd", text: "#000000", label: "FACESTOCK" },
    adhesive:  { bg: "#fffbeb", border: "#fcd34d", text: "#b45309", label: "ADHESIVE" },
    release:   { bg: "#eff6ff", border: "#93c5fd", text: "#1d4ed8", label: "RELEASE LINER" },
  };

  function skuLayerBlock(kind, title, parts) {
    const s = SKU_LAYER_STYLE[kind];
    const detail = parts.filter(Boolean).join(" · ");
    return `
      <div style="background:${s.bg};border:1.5px solid ${s.border};border-radius:6px;padding:8px 14px;display:flex;justify-content:space-between;align-items:center;gap:10px;">
        <span style="font-size:11px;font-weight:800;letter-spacing:0.04em;color:${s.text};">${s.label}</span>
        <span style="font-size:12px;font-weight:600;color:#334155;text-align:right;">${detail ? escSku(detail) : "—"}${title ? ` <span style="color:${s.text};font-weight:700;">(${escSku(title)})</span>` : ""}</span>
      </div>`;
  }

  function renderSkuLayerStack(ds) {
    const rollType = ds.rollType || "NORMAL";
    let layers = [
      skuLayerBlock("facestock", null, [ds.facestock?.facestockFamily, ds.facestock?.facestockType, ds.facestock?.facestockGsm != null ? ds.facestock.facestockGsm + " GSM" : null, ds.facestock?.facestockMicron != null ? ds.facestock.facestockMicron + " MIC" : null]),
      skuLayerBlock("adhesive", null, [ds.adhesive?.adhesiveType, ds.adhesive?.adhesiveGsm != null ? ds.adhesive.adhesiveGsm + " GSM" : null]),
    ];
    if (rollType === "DOUBLE FACESTOCK") {
      layers.push(
        skuLayerBlock("facestock", "Layer 2", [ds.facestock2?.facestockFamily, ds.facestock2?.facestockType, ds.facestock2?.facestockGsm != null ? ds.facestock2.facestockGsm + " GSM" : null, ds.facestock2?.facestockMicron != null ? ds.facestock2.facestockMicron + " MIC" : null]),
        skuLayerBlock("adhesive", "Layer 2", [ds.adhesive2?.adhesiveType, ds.adhesive2?.adhesiveGsm != null ? ds.adhesive2.adhesiveGsm + " GSM" : null]),
        skuLayerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
      );
    } else if (rollType === "DOUBLE RELEASE") {
      layers.push(
        skuLayerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
        skuLayerBlock("adhesive", "Layer 2", [ds.adhesive2?.adhesiveType, ds.adhesive2?.adhesiveGsm != null ? ds.adhesive2.adhesiveGsm + " GSM" : null]),
        skuLayerBlock("release", "Layer 2", [ds.releaseLiner2?.releaseLinerType, ds.releaseLiner2?.releaseLinerColor, ds.releaseLiner2?.releaseLinerGsm != null ? ds.releaseLiner2.releaseLinerGsm + " GSM" : null]),
      );
    } else {
      layers.push(
        skuLayerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
      );
    }

    return `
      <div style="display:flex;flex-direction:column;gap:2px;">
        ${layers.join(`
        <div style="display:flex;justify-content:center;margin:-2px 0;"><i class="fa-solid fa-caret-down" style="color:#cbd5e1;font-size:11px;"></i></div>
        `)}
      </div>`;
  }

document.addEventListener("DOMContentLoaded", () => {
  /* ================= ELEMENTS ================= */
  const submitBtn = document.querySelector("button[type='submit']");

  const clientSelect = document.getElementById("client-name");
  const userSelect = document.getElementById("client-user-name");

  const userIdInput = document.getElementById("user-id");
  const userContactInput = document.getElementById("user-contact");
  const locationSelect = document.getElementById("client-location");

  const labelStockIdInput = document.getElementById("resolved-label-stock-id");
  const labelStockIdDisplay = document.getElementById("label-stock-id");

  const skuSelect = document.getElementById("sku-code-select");
  const skuLayerPreview = document.getElementById("sku-layer-preview");
  const skuLayerTitle = document.getElementById("sku-layer-title");
  const skuLayerStack = document.getElementById("sku-layer-stack");

  const specFields = ["fs-family", "fs-type", "fs-gsm", "fs-micron", "ad-type", "ad-gsm", "rl-type", "rl-color", "rl-gsm"];

  // Map from element ID to the query param / API response key (same names on both ends).
  const fieldToKey = {
    "fs-family": "fsFamily",
    "fs-type": "fsType",
    "fs-gsm": "fsGsm",
    "fs-micron": "fsMicron",
    "ad-type": "adType",
    "ad-gsm": "adGsm",
    "rl-type": "rlType",
    "rl-color": "rlColor",
    "rl-gsm": "rlGsm",
  };

  submitBtn.disabled = true;

  /* ================= CHOICES INIT ================= */
  const clientChoices = new Choices(clientSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
  const userChoices = new Choices(userSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
  const locationChoices = new Choices(locationSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
  const skuChoices = new Choices(skuSelect, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

  /* ================= SKU CODE -> LAYER PREVIEW ================= */
  skuSelect.addEventListener("change", () => {
    const id = skuSelect.value;
    const ds = labelStocksData.find(d => String(d._id) === String(id));

    if (!ds) {
      labelStockIdInput.value = "";
      skuLayerPreview.style.display = "none";
      submitBtn.disabled = true;
      return;
    }

    labelStockIdInput.value = ds._id;
    skuLayerTitle.textContent = `${ds.productCode} · ${ds.skuCode}`;
    skuLayerStack.innerHTML = renderSkuLayerStack(ds);
    skuLayerPreview.style.display = "block";
    submitBtn.disabled = false;
  });

  // Full user docs for the selected client (kept for locationDetails lookup)
  let currentUsers = [];

  // Store Choices instances for spec fields
  const specChoices = {};
  specFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      specChoices[id] = new Choices(el, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
    }
  });

  /* ================= HELPERS ================= */
  function normalizeLocationName(value) {
    return String(value || "")
      .trim()
      .toUpperCase()
      .replace(/\s+/g, " ")
      .replace(/^[.,]+|[.,]+$/g, "");
  }

  function getUserLocationEntries(user) {
    const details = Array.isArray(user?.locationDetails) ? user.locationDetails : [];
    const entries = details
      .map((entry) => {
        const userLocation = normalizeLocationName(entry?.userLocation || entry?.location || "");
        if (!userLocation) return null;
        return { value: userLocation, label: userLocation };
      })
      .filter(Boolean);

    if (entries.length > 0) {
      const seen = new Set();
      return entries.filter((e) => (seen.has(e.value) ? false : seen.add(e.value)));
    }

    const fallbackLocation = normalizeLocationName(user?.userLocation || "");
    if (!fallbackLocation) return [];
    return [{ value: fallbackLocation, label: fallbackLocation }];
  }

  function clearLocationChoices() {
    locationChoices.clearStore();
    locationChoices.setChoices(
      [{ value: "", label: "Select location", disabled: true, selected: true }],
      "value",
      "label",
      true
    );
  }

  function populateLocationChoices(user) {
    const entries = getUserLocationEntries(user);
    if (entries.length === 0) {
      clearLocationChoices();
      return;
    }
    const autoSelect = entries.length === 1;
    locationChoices.clearStore();
    locationChoices.setChoices(
      [
        { value: "", label: "Select location", disabled: true, selected: !autoSelect, placeholder: true },
        ...entries.map((e, i) => ({ value: e.value, label: e.label, selected: autoSelect && i === 0 })),
      ],
      "value",
      "label",
      true
    );
  }

  function resetUserFields() {
    userIdInput.value = "";
    userContactInput.value = "";
    clearLocationChoices();
  }

  function hardResetUserSelection() {
    userChoices.removeActiveItems();
    userChoices.clearChoices();
    resetUserFields();
  }

  function resetResolvedLabelStock() {
    labelStockIdInput.value = "";
    labelStockIdDisplay.value = "";
    submitBtn.disabled = true;
    labelStockIdDisplay.classList.remove("label-stock-id-success", "label-stock-id-error");
  }

  /* ================= SMART FILTER ================= */
  async function filterSpecs(changedFieldId) {
    const params = new URLSearchParams();
    specFields.forEach(id => {
      const el = document.getElementById(id);
      if (el && el.value) {
        params.set(fieldToKey[id], el.value);
      }
    });

    try {
      const res = await fetch(`/app/form/label-stock-binding/filter-specs?${params}`);
      const data = await res.json();
      if (!data) return;

      const autoSelected = [];

      specFields.forEach(id => {
        if (id === changedFieldId) return;
        const choicesInstance = specChoices[id];
        if (!choicesInstance) return;

        const apiKey = fieldToKey[id];
        const filteredValues = data[apiKey] || [];
        const currentValue = document.getElementById(id)?.value || "";

        const newChoices = filteredValues.map(v => ({
          value: String(v),
          label: String(v),
          selected: String(v) === currentValue,
        }));

        if (changedFieldId !== "reset-all" && filteredValues.length === 1 && !currentValue) {
          newChoices[0].selected = true;
          autoSelected.push(id);
        }

        choicesInstance.clearStore();
        choicesInstance.setChoices(
          [{ value: "", label: "Search", disabled: true, selected: !newChoices.some(c => c.selected) }, ...newChoices],
          "value",
          "label",
          true
        );
      });

      if (autoSelected.length > 0) {
        await filterSpecs(autoSelected[0]);
        resolveLabelStock();
      }
    } catch (err) {
      console.error("Filter specs error:", err);
    }
  }

  /* ================= CLIENT → USER ================= */
  clientSelect.addEventListener("change", async () => {
    const clientName = clientSelect.value;

    hardResetUserSelection();

    const res = await fetch(`/app/form/label-stock-binding/client/${clientName}`);
    const clientData = await res.json();
    if (!clientData || !clientData.users) return;

    currentUsers = clientData.users;

    if (clientData.users.length === 1) {
      const u = clientData.users[0];

      userChoices.setChoices(
        [{
          value: u._id,
          label: u.userName,
          selected: true,
          customProperties: { mobile: u.userContact || "", location: u.userLocation || "" }
        }],
        "value",
        "label",
        true
      );

      userIdInput.value = u._id;
      userContactInput.value = u.userContact || "";
      populateLocationChoices(u);
      return;
    }

    userChoices.setChoices(
      clientData.users.map(u => ({
        value: u._id,
        label: u.userName,
        customProperties: { mobile: u.userContact || "", location: u.userLocation || "" }
      })),
      "value",
      "label",
      true
    );

    resetUserFields();
  });

  /* ================= USER CHANGE ================= */
  userSelect.addEventListener("change", () => {
    const selectedId = userChoices.getValue(true);
    if (!selectedId) return;

    const choice = userChoices._store.choices.find(c => c.value === selectedId);
    if (!choice) return;

    userIdInput.value = choice.value;
    userContactInput.value = choice.customProperties?.mobile || "";

    const selectedUser = currentUsers.find(u => String(u._id) === String(selectedId));
    populateLocationChoices(selectedUser || { userLocation: choice.customProperties?.location || "" });
  });

  /* ================= LABEL STOCK RESOLVE ================= */
  async function resolveLabelStock() {
    resetResolvedLabelStock();

    const values = {};
    for (let id of specFields) {
      const el = document.getElementById(id);
      if (!el || !el.value) return;
      values[id] = el.value;
    }

    const params = new URLSearchParams();
    specFields.forEach(id => params.set(fieldToKey[id], values[id]));

    const res = await fetch(`/app/form/label-stock-binding/resolve-label-stock?${params}`);

    if (!res.ok) {
      labelStockIdDisplay.value = "No matching Label Stock found";
      labelStockIdDisplay.classList.add("label-stock-id-error");
      return;
    }

    const data = await res.json();

    labelStockIdInput.value = data.labelStockId;
    labelStockIdDisplay.value = data.skuCode;
    labelStockIdDisplay.classList.add("label-stock-id-success");
    submitBtn.disabled = false;
  }

  /* ================= SPEC CHANGE HANDLER ================= */
  specFields.forEach(id => {
    document.getElementById(id)?.addEventListener("change", async () => {
      await filterSpecs(id);
      resolveLabelStock();
    });
  });

  /* ================= RESET SPECS ================= */
  const resetSpecsBtn = document.getElementById("reset-specs-btn");
  if (resetSpecsBtn) {
    resetSpecsBtn.addEventListener("click", async () => {
      specFields.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = "";
        if (specChoices[id]) specChoices[id].setChoiceByValue("");
      });

      resetResolvedLabelStock();

      if (typeof clientChoices !== "undefined") {
        clientChoices.setChoiceByValue("");
      }
      hardResetUserSelection();

      await filterSpecs("reset-all");
    });
  }
});

/* ================= CUSTOM TOAST ================= */
function showClientToast(message, isError = true) {
  const existingToast = document.getElementById("client-toast");
  if (existingToast) existingToast.remove();

  const toast = document.createElement("div");
  toast.id = "client-toast";
  toast.className = `toast-notification ${isError ? 'toast-error' : 'toast-success'}`;
  toast.innerHTML = `
    <span>${message}</span>
    <span class="toast-close" onclick="this.parentElement.remove()">×</span>
  `;

  document.body.appendChild(toast);

  setTimeout(() => {
    if (toast.parentElement) {
      toast.style.animation = "slideOut 0.5s forwards";
      setTimeout(() => toast.remove(), 500);
    }
  }, 5000);
}

/* ================= FORM SUBMIT ================= */
// The route always responds with JSON (success+redirect, or an error
// message -- e.g. the duplicate-binding check) rather than an HTML redirect,
// so the submit has to go through fetch and act on that response itself
// instead of letting the browser navigate natively.
async function handleLabelStockBindingSubmit(event) {
  event.preventDefault();

  const labelStockId = document.getElementById("resolved-label-stock-id").value;
  if (!labelStockId) {
    showClientToast("Please select a valid Label Stock specification.", true);
    return false;
  }

  const form = event.target;
  const submitBtn = form.querySelector("button[type='submit']");
  submitBtn.disabled = true;

  try {
    const res = await fetch(form.action, { method: "POST", body: new FormData(form) });
    const data = await res.json().catch(() => null);

    if (data?.success) {
      window.location.href = data.redirect || "/app/client/view";
    } else {
      showClientToast(data?.message || "Failed to save Label Stock binding.", true);
      submitBtn.disabled = false;
    }
  } catch {
    showClientToast("Server error. Please try again.", true);
    submitBtn.disabled = false;
  }

  return false;
}
</script>
