<% layout('/layout/boilerplate') -%>

<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
<link href="https://unpkg.com/tabulator-tables@5.6.2/dist/css/tabulator_modern.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 14px;">
  <style>
    #machine-queue-table {
      width: auto;
      flex: 1 1 auto;
      min-height: 0;
      border: 1px solid rgba(4, 74, 120, 0.14);
      border-radius: 8px;
      overflow: hidden;
    }
    #machine-queue-table .tabulator { border-radius: inherit; overflow: hidden; }

    .mq-count-badge {
      display: inline-block;
      min-width: 22px;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
    }
    .mq-count-badge.has-pending { background: #fff8e1; color: #7a5b00; border: 1px solid #f0c36d; }
    .mq-count-badge.empty { background: #f1f5f9; color: #94a3b8; border: 1px solid #e2e8f0; }

    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 4px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .header-action-btn:hover { background-color: #e4e4e4; }
    #viewToggleBtn { min-width: 150px; justify-content: center; }

    .seg-toggle {
      display: inline-flex;
      background: #f0f0f0;
      border-radius: 0.5rem;
      padding: 3px;
      gap: 2px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .seg-btn {
      border: none;
      background: transparent;
      color: #044a78;
      font-size: 14px;
      font-weight: 500;
      padding: 4px 16px;
      border-radius: 0.4rem;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      white-space: nowrap;
    }
    .seg-btn:hover:not(.active) { background: #e4e4e4; }
    .seg-btn.active { background: #044a78; color: #fff; font-weight: 600; }

    #machine-queue-cards { display: none; }
    #machine-queue-cards.mq-cards-shown {
      display: flex;
      flex-direction: column;
      gap: 20px;
      overflow-y: auto;
      flex: 1 1 auto;
      min-height: 0;
      padding-bottom: 4px;
      scrollbar-width: thin;
      scrollbar-color: #044a78 #f0f2f5;
    }
    #machine-queue-cards::-webkit-scrollbar { width: 8px; }
    #machine-queue-cards::-webkit-scrollbar-track { background: #f0f2f5; }
    #machine-queue-cards::-webkit-scrollbar-thumb { background: #044a78; border-radius: 6px; }
    .mq-unit { display: flex; flex-direction: column; gap: 12px; flex: 1 1 auto; min-height: 0; }
    .mq-unit-heading {
      font-size: 14px; font-weight: 700; letter-spacing: 0.3px;
      color: #044a78; text-transform: uppercase;
      padding-bottom: 6px; border-bottom: 2px solid rgba(4, 74, 120, 0.18);
      flex: 0 0 auto;
    }
    /* 2 cards per row -- Sachiko only has 4 machines, so a 2x2 grid uses the
       available width better than the 3-per-row layout FAIRTECH's larger
       shopfloor needed. Grid (not flex-wrap) so grid-auto-rows: 1fr stretches
       every row of cards to fill whatever vertical space is left, rather than
       leaving the cards capped at a fixed height with empty space below. */
    .mq-row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 1fr;
      gap: 14px;
      flex: 1 1 auto;
      min-height: 0;
    }
    .mq-card {
      min-width: 0;
      min-height: 0;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(4, 74, 120, 0.16);
      border-radius: 10px;
      background: #fff;
      overflow: hidden;
    }
    .mq-card-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; }
    .mq-card-body::-webkit-scrollbar { width: 8px; }
    .mq-card-body::-webkit-scrollbar-track { background: #f0f2f5; }
    .mq-card-body::-webkit-scrollbar-thumb { background: #044a78; border-radius: 6px; }
    .mq-card-body { scrollbar-width: thin; scrollbar-color: #044a78 #f0f2f5; }
    @media (max-width: 700px) {
      .mq-row { grid-template-columns: 1fr; }
    }
    .mq-card-head {
      flex: 0 0 auto;
      background: #044a78;
      color: #fff;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      cursor: pointer;
    }
    .mq-card-head:hover { background: #05598f; }
    .mq-card-name { font-size: 15px; font-weight: 700; line-height: 1.3; }
    /* Name, type and operator on a single row. */
    .mq-card-title { display: flex; align-items: center; flex-wrap: nowrap; gap: 12px; min-width: 0; overflow: hidden; }
    .mq-card-title .mq-card-name { flex: 0 0 auto; }
    .mq-card-meta { font-size: 11.5px; opacity: 0.85; margin-top: 0; display: flex; flex-wrap: nowrap; align-items: center; gap: 0; min-width: 0; }
    .mq-card-meta span { padding: 0 12px; border-left: 1px solid rgba(255, 255, 255, 0.4); }
    .mq-card-meta span:first-child { padding-left: 12px; }
    .mq-card-meta .mq-op { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
    .mq-card-meta span { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
    .mq-card-meta .mq-op { font-size: 14px; font-weight: 700; opacity: 1; }
    .mq-card-meta .mq-op i { font-size: 13px; }
    .mq-card-count {
      flex: 0 0 auto;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 999px;
      padding: 2px 10px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }
    .mq-job {
      border-top: 1px solid #eef2f6;
      padding: 8px 14px;
      display: flex;
      flex-wrap: nowrap;
      align-items: baseline;
      gap: 0 6px;
      font-size: 12.5px;
      color: #334155;
      text-decoration: none;
      overflow: hidden;
      transition: background 0.12s;
    }
    .mq-job:hover { background: #f8fafc; }
    .mq-job-sep { color: #cbd5e1; font-style: normal; }
    .mq-job > span, .mq-job > .mq-job-sep { flex: 0 0 auto; white-space: nowrap; }
    .mq-job > .mq-job-rolls { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .mq-job > span:last-child { font-weight: 600; flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    /* Slitting card view: one block per knife layout -- every detail on a
       single row, the progress bar full width beneath it, and a clear rule
       between one block and the next. */
    .mq-sgroup {
      display: flex; flex-direction: column; gap: 8px; padding: 12px 14px;
      border-top: 0; border-bottom: 2px solid #c3cfdc; color: #334155; text-decoration: none;
    }
    .mq-sgroup:last-child { border-bottom: 0; }
    .mq-sgroup.is-running { background: #dcfce7; }
    .mq-sg-row { display: flex; align-items: center; flex-wrap: nowrap; min-width: 0; overflow: hidden; font-size: 12.5px; }
    .mq-sg-row > span { flex: 0 0 auto; white-space: nowrap; padding: 0 10px; border-left: 1px solid #cbd5e1; color: #64748b; font-weight: 600; }
    .mq-sg-row > span:first-child { padding-left: 0; border-left: 0; }
    .mq-sg-row > span b { color: #1f2a44; font-weight: 700; }
    .mq-sg-row > .mq-sg-code { font-weight: 800; font-size: 13.5px; color: #044a78; }
    .mq-sg-row > .mq-sg-layout { flex: 0 1 auto; min-width: 40px; overflow: hidden; text-overflow: ellipsis; font-weight: 700; font-size: 13px; color: #1f2a44; }
    .mq-sg-row > .mq-sg-client { flex: 1 1 0; min-width: 30px; overflow: hidden; text-overflow: ellipsis; }
    .mq-sg-row > .mq-sg-count { font-size: 15px; color: #044a78; }
    .mq-sg-row > .mq-sg-count b { font-size: 16px; color: #044a78; }
    .mq-sg-run { margin-left: auto; flex: 0 0 auto; color: #15803d; font-size: 16px; padding-left: 10px; }
    .mq-sg-bar { width: 100%; height: 5px; border-radius: 3px; background: #dbe3ec; overflow: hidden; }
    .mq-sg-bar > i { display: block; height: 100%; background: #10b981; }
    .mq-sgroup.is-running .mq-sg-bar { background: #b7e4c7; }
    .mq-run-ico { color: #15803d; font-size: 16px; }
    .mq-card-empty { padding: 16px 14px; font-size: 12.5px; color: #94a3b8; text-align: center; border-top: 1px solid #eef2f6; }
  </style>

  <div class="indi-head">
    <h1><%= typeof heading !== "undefined" && heading ? heading : "Machine Queues" %></h1>
    <div style="display: flex; gap: 10px; align-items: stretch">
      <div class="seg-toggle" id="locationSeg" role="group" aria-label="Filter by location"></div>
      <button type="button" class="header-action-btn" id="viewToggleBtn" onclick="toggleView()">
        <i class="fa-solid fa-table-cells-large" id="viewToggleIcon"></i>
        <span id="viewToggleText">Card View</span>
      </button>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="machine-queue-table" class="tabulator tabulator-modern"></div>
  <div id="machine-queue-cards"></div>
</div>

<script id="machine-queue-data" type="application/json"><%- safeJson(rows) %></script>
<script id="machine-queue-flags" type="application/json"><%- safeJson({ isSlitting: !!(typeof isSlitting !== "undefined" && isSlitting) }) %></script>
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script>
  const machineQueueRows = JSON.parse(document.getElementById("machine-queue-data").textContent);

  const IS_SLITTING = !!JSON.parse(document.getElementById("machine-queue-flags").textContent).isSlitting;
  const withTextFilter = col => ({ headerFilter: "input", headerFilterPlaceholder: "Search", ...col });

  const typeValues = {};
  machineQueueRows.forEach(r => { if (r.machineType) typeValues[r.machineType] = r.machineType; });

  const locationValues = {};
  machineQueueRows.forEach(r => { if (r.locationName) locationValues[r.locationName] = r.locationName; });

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  const table = new Tabulator("#machine-queue-table", {
    data:             machineQueueRows,
    height:           "100%",
    responsiveLayout: false,
    movableColumns:   true,
    placeholder:      "No machines found.",
    rowClick: (e, row) => { window.location.href = `/app/machine/${row.getData()._id}/queue`; },
    columns: [
      {
        title: "S. No", formatter: "rownum", hozAlign: "center", headerHozAlign: "center",
        width: 70, headerSort: false,
      },
      withTextFilter({ title: "Machine Name", field: "machineName", minWidth: 200, sorter: "string" }),
      {
        title: "Type", field: "machineType", minWidth: 150, sorter: "string",
        formatter: cell => cell.getValue() || "—",
        headerFilter: "select",
        headerFilterParams: { values: { "": "All", ...typeValues } },
      },
      {
        title: "Location", field: "locationName", minWidth: 160, sorter: "string",
        formatter: cell => cell.getValue() || "—",
        headerFilter: "select",
        headerFilterParams: { values: { "": "All", ...locationValues } },
      },
      withTextFilter({ title: "Operator", field: "operatorName", minWidth: 160, sorter: "string", formatter: cell => cell.getValue() || "—" }),
      {
        title: "Running", field: "running", width: 90, hozAlign: "center", headerHozAlign: "center", sorter: "boolean",
        formatter: cell => (cell.getValue() ? '<i class="fa-solid fa-circle-play mq-run-ico" title="A job is running on this machine"></i>' : ""),
      },
      ...(IS_SLITTING ? [{
        title: "Deckles To Run", field: "deckleLeft", minWidth: 130, hozAlign: "center", headerHozAlign: "center", sorter: "number",
      }] : []),
      {
        title: IS_SLITTING ? "Cards" : "Pending Orders", field: "pendingCount", minWidth: 150, hozAlign: "center", sorter: "number",
        headerFilter: "input", headerFilterPlaceholder: "Search",
        formatter(cell) {
          const val = cell.getValue() || 0;
          const rowId = cell.getRow().getData()._id;
          const link = document.createElement("a");
          link.href = `/app/machine/${rowId}/queue`;
          link.className = "mq-count-badge " + (val > 0 ? "has-pending" : "empty");
          link.textContent = val;
          return link;
        },
      },
    ],
  });

  /* ─────────────────────────────────────────
     Card view — the same machines, with each queued job spelled out instead
     of collapsed into a count. Grouped dynamically by whatever locations are
     actually in the data (not a hard-coded shopfloor layout, since Sachiko's
     machine/unit arrangement isn't fixed the way FAIRTECH's is).
  ───────────────────────────────────────── */
  const dash = value => {
    const text = String(value ?? "").trim();
    return text && text !== "—" ? text : "";
  };

  // One block per job (same look as the slitting list): code, lot, size,
  // cut layout, rolls to run, quantity, client, material verdict, a green
  // play icon when a deckle is on the machine, and a progress bar beneath.
  const niceLayout = text => String(text || "").replace(/ \+ /g, " - ");
  const MATERIAL_TAGS = {
    match:   ['Material OK', '#15803d'],
    partial: ['Material partial', '#b45309'],
    short:   ['Material short', '#b91c1c'],
  };
  const LIVE_TAGS = { setting: 'Job setting', paused: 'Paused', started: 'Started' };
  function jobHtml(machineId, job) {
    const produced = Number(job.producedRolls) || 0;
    const left = Number(job.balanceRolls);
    const rollsTotal = Number(job.rolls);
    const total = Number(job.deckleTarget) || (Number.isFinite(rollsTotal) ? rollsTotal : 0);
    const leftN = Number.isFinite(left) ? left : Math.max(total - produced, 0);
    const pct = total ? Math.min(100, Math.round((produced / total) * 100)) : 0;
    const running = job.liveStatus === "running";
    const mat = MATERIAL_TAGS[job.materialStatus];
    const live = LIVE_TAGS[job.liveStatus];
    const rollIds = Array.isArray(job.rollIds) ? job.rollIds : [];
    const adv = job.advance
      ? `<span class="adv-tag" title="${Number(job.advance.rolls) || 0} roll(s) set in advance — no sales order yet">ADVANCE</span>`
      : "";
    return `
      <a class="mq-sgroup${running ? " is-running" : ""}" href="/app/machine/${encodeURIComponent(machineId)}/queue">
        <div class="mq-sg-row">
          <span class="mq-sg-code">${escapeHtml(dash(job.productCode) || "—")}</span>
          ${dash(job.lotNo) ? `<span title="Lot No">${escapeHtml(job.lotNo)}</span>` : ""}
          ${dash(job.paperSize) ? `<span title="Paper size"><b>${escapeHtml(job.paperSize)}</b></span>` : ""}
          ${job.layoutSummary ? `<span class="mq-sg-layout" title="Cut layout">${escapeHtml(niceLayout(job.layoutSummary))}</span>` : ""}
          <span class="mq-sg-count" title="${produced} of ${total} made, ${leftN} to run"><b>${produced}</b>${total ? ` / ${total}` : ""}</span>
          ${Number(job.quantity) > 0 ? `<span title="Ordered quantity">${Number(job.quantity).toLocaleString("en-IN")} qty</span>` : ""}
          <span class="mq-sg-client" title="${escapeHtml(job.clientName || "")}">${escapeHtml(dash(job.clientName) || "—")}</span>
          ${rollIds.length ? `<span title="${escapeHtml(rollIds.join(", "))}">${rollIds.length} roll${rollIds.length === 1 ? "" : "s"} allotted</span>` : ""}
          ${mat ? `<span style="color:${mat[1]};">${mat[0]}</span>` : ""}
          ${live && !running ? `<span style="color:#b45309;">${live}</span>` : ""}
          ${adv ? `<span>${adv}</span>` : ""}
          ${running ? '<i class="fa-solid fa-circle-play mq-sg-run" title="A deckle is running"></i>' : ""}
        </div>
        <div class="mq-sg-bar" title="${produced} of ${total} done"><i style="width:${pct}%"></i></div>
      </a>`;
  }

  // Slitting: cards cut to the same KNIFE LAYOUT are one block (as on the
  // machine's own queue), whatever their Product Code -- the setting on the
  // machine is what they share. The block names the pattern, how far the
  // layout's run has got, how many Deckles of it are still to run, and carries
  // a green play icon when one is running. Deliberately NOT a card count or a
  // lot count: one card is one Deckle and a slitting card's lot no IS its
  // Deckle id, so all three were the same number said three ways.
  function slitGroupsHtml(machine, jobs) {
    const groups = new Map();
    jobs.forEach(j => {
      const key = j.layoutKey || "none-" + j._id;
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key).push(j);
    });
    const sum = (list, f) => list.reduce((n, j) => n + (Number(j[f]) || 0), 0);
    const uniq = arr => [...new Set(arr.map(dash).filter(Boolean))];
    return [...groups.values()].map(list => {
      const first = list[0];
      const running = list.some(j => j.running);
      // The layout's run, not these cards alone: every Deckle at this setting,
      // finished cards included (buildLayoutRuns in routes/system/slitting.js).
      // One run per group, so the first card's figures are the group's.
      const total = Number(first.layoutRunTotal) || sum(list, "deckleCount");
      const done = Number(first.layoutRunDone) || 0;
      const left = total - done;
      // Deckles of this layout still on the queue. Read off the cards in the
      // block rather than as total - done, so the chip describes what is
      // actually listed here.
      const deckles = sum(list, "deckleLeft");
      const codes = uniq(list.map(j => j.productCode));
      const codeText = codes.length > 2 ? codes.length + " products" : codes.join(", ");
      const clients = uniq(list.map(j => j.clientName));
      const clientText = clients.length > 2 ? clients.length + " clients" : clients.join(", ");
      const pct = total ? Math.round((done / total) * 100) : 0;
      const curing = list.some(j => j.curing);
      return `
        <a class="mq-sgroup${running ? " is-running" : ""}" href="/app/machine/${encodeURIComponent(machine._id)}/queue">
          <div class="mq-sg-row">
            <span class="mq-sg-code" title="${escapeHtml(codes.join(", "))}">${escapeHtml(codeText || "—")}</span>
            <span class="mq-sg-layout" title="Cut layout">${escapeHtml(niceLayout(first.layoutKey) || "No layout")}</span>
            <span class="mq-sg-count" title="${done} of ${total} Deckle${total === 1 ? "" : "s"} made, ${left} to run"><b>${done}</b> / ${total}</span>
            <span title="${deckles} Deckle${deckles === 1 ? "" : "s"} of this layout still to run"><b>${deckles}</b> deckle${deckles === 1 ? "" : "s"}</span>
            ${clientText ? `<span class="mq-sg-client" title="${escapeHtml(clients.join(", "))}">${escapeHtml(clientText)}</span>` : ""}
            ${curing ? '<span style="color:#b45309;"><i class="fa-solid fa-hourglass-half"></i> curing</span>' : ""}
            ${running ? '<i class="fa-solid fa-circle-play mq-sg-run" title="A Deckle is running"></i>' : ""}
          </div>
          <div class="mq-sg-bar" title="${done} of ${total} Deckles done"><i style="width:${pct}%"></i></div>
        </a>`;
    }).join("");
  }

  function cardHtml(machine) {
    const jobs = Array.isArray(machine.jobs) ? machine.jobs : [];
    const meta = [
      ["fa-gears", dash(machine.machineType), ""],
      ["fa-user", dash(machine.operatorName), "mq-op"],
    ].filter(([, value]) => value);

    return `
      <div class="mq-card">
        <div class="mq-card-head" data-machine-id="${escapeHtml(machine._id)}"
             onclick="window.location.href='/app/machine/' + encodeURIComponent(this.dataset.machineId) + '/queue'">
          <div class="mq-card-title">
            <div class="mq-card-name">${escapeHtml(machine.machineName || "—")}</div>
            <div class="mq-card-meta">
              ${meta.map(([icon, value, cls]) => `<span${cls ? ` class="${cls}"` : ""}><i class="fa-solid ${icon}"></i>${escapeHtml(value)}</span>`).join("")}
            </div>
          </div>
          <span class="mq-card-count">${machine.running ? '<i class="fa-solid fa-circle-play" style="color:#86efac;margin-right:6px;" title="Running"></i>' : ""}${IS_SLITTING
            ? `${Number(machine.deckleLeft) || 0} left`
            : `${jobs.length} job${jobs.length === 1 ? "" : "s"}`}</span>
        </div>
        <div class="mq-card-body custom-scrollbar">
          ${jobs.length
            ? (IS_SLITTING ? slitGroupsHtml(machine, jobs) : jobs.map(job => jobHtml(machine._id, job)).join(""))
            : `<div class="mq-card-empty">Nothing queued on this machine.</div>`}
        </div>
      </div>`;
  }

  const cardsEl = document.getElementById("machine-queue-cards");
  const tableEl = document.getElementById("machine-queue-table");
  let showingCards = false;

  // Units are whatever locations are actually present in the data, in the
  // order they first appear -- no fixed shopfloor layout assumed.
  const unitOrder = [];
  machineQueueRows.forEach((m) => {
    const loc = m.locationName || "—";
    if (!unitOrder.includes(loc)) unitOrder.push(loc);
  });

  const locationSegEl = document.getElementById("locationSeg");
  let currentLocation = "";

  const segments = [{ value: "", label: "All" }, ...unitOrder.map((loc) => ({ value: loc, label: loc }))];
  locationSegEl.innerHTML = segments
    .map(
      (s) =>
        `<button type="button" class="seg-btn${s.value === currentLocation ? " active" : ""}" data-loc="${escapeHtml(s.value)}">${escapeHtml(s.label)}</button>`,
    )
    .join("");

  locationSegEl.addEventListener("click", (e) => {
    const btn = e.target.closest(".seg-btn");
    if (!btn) return;
    currentLocation = btn.dataset.loc || "";
    locationSegEl.querySelectorAll(".seg-btn").forEach((b) => b.classList.toggle("active", b === btn));
    if (showingCards) renderCards();
    table.setHeaderFilterValue("locationName", currentLocation);
  });

  function renderCards() {
    const units = unitOrder.filter((loc) => !currentLocation || loc === currentLocation);
    const html = units
      .map((loc) => {
        const machinesInUnit = machineQueueRows.filter((m) => (m.locationName || "—") === loc);
        if (!machinesInUnit.length) return "";
        return `<div class="mq-unit"><div class="mq-unit-heading">${escapeHtml(loc)}</div><div class="mq-row">${machinesInUnit.map(cardHtml).join("")}</div></div>`;
      })
      .filter(Boolean)
      .join("");
    cardsEl.innerHTML = html || `<div class="mq-card-empty" style="border:none;">No machines found.</div>`;
  }

  function toggleView() {
    showingCards = !showingCards;

    if (showingCards) renderCards();

    cardsEl.classList.toggle("mq-cards-shown", showingCards);
    tableEl.style.display = showingCards ? "none" : "";
    document.getElementById("viewToggleText").textContent = showingCards ? "Table View" : "Card View";
    document.getElementById("viewToggleIcon").className =
      showingCards ? "fa-solid fa-table-list" : "fa-solid fa-table-cells-large";
    if (!showingCards) table.redraw(true);
  }

  // Open on the card view by default; toggleView() flips showingCards false->true.
  toggleView();
</script>
