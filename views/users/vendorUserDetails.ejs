<% layout('/layout/boilerplate') -%>

<style>
  :root {
    --primary: #044a78;
    --secondary: #2c3e50;
    --accent: #3498db;
    --bg-light: #f8fafc;
    --border: #e2e8f0;
  }

  .client-profile-container {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 100%;
    margin: 0 auto;
  }

  /* Header Section */
  .profile-header-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .header-top {
    background: var(--primary);
    color: white;
    padding: 15px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header-info h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
  }

  .header-badges {
    display: flex;
    gap: 10px;
    margin-top: 5px;
  }

  .badge {
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .badge-type { background: rgba(255,255,255,0.2); color: white; border: 1px solid rgba(255,255,255,0.3); }
  .badge-user { background: #3498db; color: white; }

  .header-actions {
    display: flex;
    gap: 10px;
  }

  .action-btn-header {
    color: var(--primary);
    background: white;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px;
    border-radius: 6px;
    transition: background 0.2s;
    border: none;
    cursor: pointer;
  }

  .action-btn-header:hover { background: #f1f5f9; }
  .action-btn-header.danger { color: #e74c3c; }
  .action-btn-header.warn { color: #b45309; }

  .badge-active { background: #2ecc71; color: white; }
  .badge-inactive { background: #e74c3c; color: white; }

  /* Custom Scrollbar */
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: #f1f5f9;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #044A78;
    border-radius: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: var(--primary);
  }

  /* Info Grid */
  .info-section {
    padding: 20px 25px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 40px;
    flex-wrap: nowrap;
    overflow-x: auto;
    background: #fcfcfc;
    border-bottom: 1px solid var(--border);
  }

  .info-section.no-scroll {
    overflow-x: visible;
    gap: 20px;
  }

  .locations-scroll-wrapper {
    display: flex;
    gap: 20px;
    padding: 10px 0;
    overflow-x: auto;
    flex-grow: 1;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    white-space: nowrap;
  }

  .info-label {
    font-size: 11px;
    color: #64748b;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.025em;
  }

  .info-value {
    font-size: 15px;
    color: #1e293b;
    font-weight: 500;
  }

  /* Section Cards */
  .section-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .section-header {
    background: #f1f5f9;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .section-header h2 {
    margin: 0;
    font-size: 18px;
    color: var(--primary);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .info-section { flex-wrap: wrap; gap: 20px; }
  }

  /* Activity timeline */
  .activity-list {
    padding: 16px 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .activity-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #fcfcfc;
  }

  .activity-row.is-current {
    border-color: #bbe6cd;
    background: #f2fbf6;
  }

  .activity-dot {
    width: 9px;
    height: 9px;
    flex: 0 0 9px;
    border-radius: 50%;
    background: #cbd5e1;
  }

  .activity-row.is-current .activity-dot { background: #22c55e; }

  .activity-range {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    color: #1e293b;
  }

  .activity-sep { color: #94a3b8; font-size: 11px; }

  .activity-tag {
    margin-left: auto;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #64748b;
  }

  .activity-row.is-current .activity-tag { color: #1a7f45; }
</style>

<div class="client-profile-container">
  <!-- Header Card -->
  <div class="profile-header-card">
    <div class="header-top">
      <div class="header-info">
        <h1><%= vendorUser.vendorName %></h1>
        <div class="header-badges">
          <span class="badge badge-type">Vendor</span>
          <span class="badge <%= (vendorUser.coordinatorStatus || 'ACTIVE') === 'ACTIVE' ? 'badge-active' : 'badge-inactive' %>">
            <%= (vendorUser.coordinatorStatus || 'ACTIVE') === 'ACTIVE' ? 'Active' : 'Inactive' %>
          </span>
        </div>
      </div>
      <div class="header-actions">
        <button class="action-btn-header" onclick="window.location.href='/app/vendor/view?new=vendor'">
          <i class="fa-solid fa-building"></i> Add Vendor
        </button>
        <button class="action-btn-header" onclick="window.location.href='/app/vendor/coordinator/view?new=coordinator&vendorName=<%= encodeURIComponent(vendorUser.vendorName) %>'">
          <i class="fa-solid fa-user-plus"></i> Add Coordinator
        </button>
        <button type="button" class="action-btn-header" onclick="openEditVendorUserDialog()">
          <i class="fa-solid fa-pen"></i> Edit Coordinator
        </button>
        <% const coordStatus = (vendorUser.coordinatorStatus || 'ACTIVE'); %>
        <button class="action-btn-header <%= coordStatus === 'ACTIVE' ? 'warn' : '' %>" id="toggleStatusBtn"
          onclick="confirmToggleStatus()"
          data-current="<%= coordStatus %>"
          data-target="<%= coordStatus === 'ACTIVE' ? 'INACTIVE' : 'ACTIVE' %>">
          <i class="fa-solid <%= coordStatus === 'ACTIVE' ? 'fa-user-slash' : 'fa-user-check' %>"></i>
          <%= coordStatus === 'ACTIVE' ? 'Mark Inactive' : 'Mark Active' %>
        </button>
        <button class="action-btn-header danger" onclick="confirmDeleteCoordinator()">
          <i class="fa-solid fa-trash"></i> Delete
        </button>
      </div>
    </div>

    <!-- Contact & Location Info -->
    <div class="info-section custom-scrollbar">
      <div class="info-item">
        <span class="info-label">Vendor ID</span>
        <span class="info-value"><%= vendorUser.vendorId %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Coordinator Name</span>
        <span class="info-value" style="display:inline-flex;align-items:center;gap:6px;">
          <%= vendorUser.userName %>
          <span id="coordinatorVerifiedBadge"></span>
        </span>
      </div>
      <div class="info-item">
        <span class="info-label">H/O Location</span>
        <span class="info-value"><%= vendorUser.hoLocation || 'N/A' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Warehouse</span>
        <span class="info-value"><%= vendorUser.warehouseLocation || 'N/A' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Contact</span>
        <span class="info-value"><%= vendorUser.userContact || 'N/A' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Email</span>
        <span class="info-value"><%= vendorUser.userEmail || 'N/A' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">User Location</span>
        <span class="info-value"><%= vendorUser.userLocation || 'N/A' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Department</span>
        <span class="info-value"><%= vendorUser.userDepartment || 'N/A' %></span>
      </div>
    </div>

    <!-- Dispatch Info -->
    <div class="info-section custom-scrollbar" style="background: white;">
      <div class="info-item">
        <span class="info-label">Dispatch Address</span>
        <span class="info-value" style="white-space: nowrap;"><%= vendorUser.dispatchAddress || 'N/A' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Pick Up Mode</span>
        <span class="info-value"><%= vendorUser.deliveryMode || '-' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Pick Up Loc</span>
        <span class="info-value"><%= vendorUser.deliveryLocation || '-' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Payment</span>
        <span class="info-value"><%= vendorUser.vendorPayment || '-' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">GST</span>
        <span class="info-value"><%= vendorUser.vendorGst || (vendor ? vendor.vendorGst : 'N/A') %></span>
      </div>
    </div>
  </div>

  <!-- Activity Timeline Card -->
  <%
    const fmtDay = (value) => {
      if (!value) return "—";
      const d = new Date(value);
      return Number.isNaN(d.getTime())
        ? "—"
        : d.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
    };
    const coordIsActive = (vendorUser.coordinatorStatus || "ACTIVE") === "ACTIVE";
    let activity = Array.isArray(vendorUser.activityLog) ? vendorUser.activityLog.slice() : [];
    if (!activity.length) {
      const created = vendorUser._id && vendorUser._id.getTimestamp ? vendorUser._id.getTimestamp() : null;
      activity = [{ from: created, to: coordIsActive ? null : created }];
    }
    activity.sort((a, b) => new Date(a.from) - new Date(b.from));
  %>
  <div class="section-card">
    <div class="section-header">
      <h2>Activity</h2>
      <span class="badge <%= coordIsActive ? 'badge-active' : 'badge-inactive' %>" style="font-size: 11px;">
        <%= coordIsActive ? 'Active' : 'Inactive' %>
      </span>
    </div>

    <div class="activity-list">
      <% activity.forEach((period, idx) => { %>
        <div class="activity-row <%= !period.to ? 'is-current' : '' %>">
          <span class="activity-dot"></span>
          <span class="activity-range">
            <span class="activity-from"><%= fmtDay(period.from) %></span>
            <i class="fa-solid fa-arrow-right-long activity-sep"></i>
            <span class="activity-to"><%= period.to ? fmtDay(period.to) : 'Present' %></span>
          </span>
          <span class="activity-tag">
            <%= !period.to ? 'Currently active' : 'Was active' %>
          </span>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- Delete Modal -->
<form id="deleteCoordinatorForm" method="POST" action="/app/vendor/coordinator/details/<%= vendorUser._id %>/delete" style="display:none;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>

<div class="logout-modal" id="toggleStatusModal" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="toggleStatusTitle">
    <h2 class="logout-title" id="toggleStatusTitle">Change coordinator status?</h2>
    <p class="logout-text" id="toggleStatusText">This will change the coordinator status.</p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" id="toggleStatusCancel">Cancel</button>
      <button class="logout-btn primary" type="button" id="toggleStatusConfirm">OK</button>
    </div>
  </div>
</div>

<div class="logout-modal" id="deleteCoordinatorModal" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="deleteCoordinatorTitle">
    <h2 class="logout-title" id="deleteCoordinatorTitle">Delete coordinator?</h2>
    <p class="logout-text">This will permanently delete this coordinator and remove it from the vendor.</p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" id="deleteCoordinatorCancel">Cancel</button>
      <button class="logout-btn primary" type="button" id="deleteCoordinatorConfirm">Delete</button>
    </div>
  </div>
</div>

<script>
  const deleteCoordinatorModal = document.getElementById("deleteCoordinatorModal");
  const deleteCoordinatorCancel = document.getElementById("deleteCoordinatorCancel");
  const deleteCoordinatorConfirm = document.getElementById("deleteCoordinatorConfirm");

  function confirmDeleteCoordinator() {
    deleteCoordinatorModal.style.display = "flex";
    deleteCoordinatorModal.classList.add("show");
    deleteCoordinatorModal.setAttribute("aria-hidden", "false");
  }

  function closeDeleteCoordinatorModal() {
    deleteCoordinatorModal.classList.remove("show");
    deleteCoordinatorModal.setAttribute("aria-hidden", "true");
    deleteCoordinatorModal.style.display = "none";
  }

  deleteCoordinatorCancel.addEventListener("click", closeDeleteCoordinatorModal);
  deleteCoordinatorModal.addEventListener("click", (e) => {
    if (e.target === deleteCoordinatorModal) closeDeleteCoordinatorModal();
  });
  deleteCoordinatorConfirm.addEventListener("click", () => {
    closeDeleteCoordinatorModal();
    document.getElementById("deleteCoordinatorForm").submit();
  });

  /* ── Active / Inactive toggle ── */
  const coordinatorId = "<%= vendorUser._id %>";
  const toggleStatusBtn = document.getElementById("toggleStatusBtn");
  const toggleStatusModal = document.getElementById("toggleStatusModal");
  const toggleStatusText = document.getElementById("toggleStatusText");
  const toggleStatusCancel = document.getElementById("toggleStatusCancel");
  const toggleStatusConfirm = document.getElementById("toggleStatusConfirm");
  const getCsrfToken = () => document.querySelector('meta[name="csrf-token"]')?.getAttribute("content") || "";

  function confirmToggleStatus() {
    const target = toggleStatusBtn.dataset.target;
    toggleStatusText.textContent = target === "INACTIVE"
      ? "This will mark the coordinator inactive and close its current active period."
      : "This will mark the coordinator active and start a new active period.";
    toggleStatusModal.style.display = "flex";
    toggleStatusModal.classList.add("show");
    toggleStatusModal.setAttribute("aria-hidden", "false");
  }

  function closeToggleStatusModal() {
    toggleStatusModal.classList.remove("show");
    toggleStatusModal.setAttribute("aria-hidden", "true");
    toggleStatusModal.style.display = "none";
  }

  toggleStatusCancel.addEventListener("click", closeToggleStatusModal);
  toggleStatusModal.addEventListener("click", (e) => {
    if (e.target === toggleStatusModal) closeToggleStatusModal();
  });

  toggleStatusConfirm.addEventListener("click", async () => {
    toggleStatusConfirm.disabled = true;
    try {
      const res = await fetch(`/app/vendor/coordinator/details/${coordinatorId}/status`, {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": getCsrfToken() },
        body: JSON.stringify({ status: toggleStatusBtn.dataset.target }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || window.location.href;
      } else {
        toggleStatusText.textContent = data.message || "Failed to update status.";
        toggleStatusConfirm.disabled = false;
      }
    } catch {
      toggleStatusText.textContent = "Server error. Please try again.";
      toggleStatusConfirm.disabled = false;
    }
  });
</script>

<!-- Verified badge beside the name, then the Edit Coordinator dialog (opened by "Edit Coordinator" above) -->
<script src="/js/verification.js"></script>
<script type="application/json" id="coordinator-verified-data"><%- safeJson({ verified: !!vendorUser.verified, verifiedBy: vendorUser.verifiedBy || "", verifiedAt: vendorUser.verifiedAt || null }) %></script>
<script>
  document.getElementById("coordinatorVerifiedBadge").innerHTML =
    verifiedBadgeFor(JSON.parse(document.getElementById("coordinator-verified-data").textContent), 18);
</script>
<link href="/css/soDialog.css?v=2" rel="stylesheet" />
<%- include('./_editVendorUserDialog', { vendorUser, vendor, initialLocationDetails }) %>
