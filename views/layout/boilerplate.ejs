        </a>

        <% const permissions = authUser && authUser.permissions ? authUser.permissions : {}; %>
        
        <% const canView = isAdmin || isHod || isSales || permissions.master; %>
        <% const canStock = isAdmin || isHod || isSales || permissions.inventory; %>
        <% const canOrders = isAdmin || isHod || permissions.sales || isSales; %>
        <% const canAccounting = isAdmin || isHr || permissions.accounting; %>
        <% const canHr = isAdmin || isHr || permissions.hr; %>

        <% /* "Tape View" (below) is hidden app-wide -- for isAdmin/isHod it was
               one of two items here, so the dropdown still has Label Stock and
               stays as canView gated it before. For every other role it was
               the *only* item, so this whole dropdown is gated to isAdmin/isHod
               too now, rather than leaving a toggle that opens onto nothing. */ %>
        <% if (canView && (isAdmin || isHod)) { %>
        <div class="nav-opt-wrap">
          <%# Tape View below is hidden app-wide, so Label Stock is the only
              item this dropdown ever opens onto -- skip the toggle and go
              straight there. %>
          <a href="/app/label-stock/view" title="View" class="view-toggle nav-items" style="text-decoration: none; color: inherit; display: flex; align-items: center;">
            <i class="fa-solid fa-boxes-stacked" style="color: #ffffff"></i>
            <p class="nav-items-para">SKUs List</p>
            <i class="fa-solid fa-chevron-down" style="color: #ffffff; font-size: 12px; margin-left: auto; transition: transform 0.3s ease;"></i>
