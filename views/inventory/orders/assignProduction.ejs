<script id="all-machines-data" type="application/json"><%- safeJson(allMachines) %></script>
<script id="item-data" type="application/json"><%- safeJson(item) %></script>
<script id="allotted-layers-data" type="application/json"><%- safeJson(pp.allottedLayers || {}) %></script>
<script id="order-id-data" type="application/json"><%- safeJson(String(pp._id)) %></script>
<%# Every WEB this batch actually laminates -- width and how many deckles are
    cut from it, widest first (the same list the Material Details card prints).
    A mixed-web plan runs several, and which reels can physically be mounted
    depends on all of them, not on the single headline `deckleSize`: a 635 mm
    reel runs the 15 webs planned at 635 and the 3 at 510, and only the 8 at
    660 are out of its reach. Judging every reel against the widest web alone
    marked the batch's own main width unusable. %>
<%
  // Width -> how many deckles are cut from it and how many running metres
  // those come to. Mirrors utils/rawMaterialNeed.js's webRunsFor (same
  // per-layout length, same fallback for a batch with no layout rows) --
  // except that it keeps the widths APART instead of budgeting them all at
  // the widest, because which reels can be mounted depends on each one.
  const webRuns = [];
  (Array.isArray(pp.deckleLayout) ? pp.deckleLayout : []).forEach(function (L) {
    const w = Number(L.deckleSize) > 0 ? Number(L.deckleSize) : Number(pp.deckleSize);
    const len = Number(L.deckleRunningMeter) > 0 ? Number(L.deckleRunningMeter) : Number(pp.deckleRunningMeters);
    const n = Math.max(1, Math.floor(Number(L.count) || 1));
    if (!(w > 0) || !(len > 0)) return;
    const row = webRuns.find(function (x) { return x.w === w; });
    if (row) { row.webs += n; row.mtrs += len * n; }
    else webRuns.push({ w: w, webs: n, mtrs: len * n });
  });
  if (!webRuns.length && Number(pp.deckleSize) > 0 && Number(pp.deckleRunningMeters) > 0) {
    const n = Math.max(1, Math.floor(Number(pp.noOfRolls) || 1));
    webRuns.push({ w: Number(pp.deckleSize), webs: n, mtrs: Number(pp.deckleRunningMeters) * n });
  }
  webRuns.sort(function (a, b) { return b.w - a.w; });
%>
<script id="web-widths-data" type="application/json"><%- safeJson(webRuns) %></script>
<script src="/js/choices.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const ALL_MACHINES = JSON.parse(document.getElementById("all-machines-data").textContent);

    const machineSelectEl = document.getElementById("machine-select");
    const operatorSelectEl = document.getElementById("operator-select");
    const helperSelectEl = document.getElementById("helper-select");
    const submitBtn = document.querySelector(".ap-submit-btn");

    const machineChoices = new Choices(machineSelectEl, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
    const operatorChoices = new Choices(operatorSelectEl, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
    const helperChoices = new Choices(helperSelectEl, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    // Each Operator/Helper's Profile Code mirrors the Machine name they run
    // (e.g. Machine "R1" <-> Employee Profile Code "R1") -- picking a machine
    // auto-selects whichever operator/helper shares that code.
    function autoFillByMachineCode(machineName, selectEl, choicesInstance) {
      const wanted = (machineName || "").trim().toUpperCase();
      const match = wanted
        ? Array.from(selectEl.options).find(
            (o) => o.dataset.profilecode && o.dataset.profilecode.trim().toUpperCase() === wanted,
          )
        : null;
      choicesInstance.setChoiceByValue(match ? match.value : "");
    }

    machineSelectEl.addEventListener("change", function () {
      const machine = ALL_MACHINES.find((m) => String(m._id) === String(this.value));
      autoFillByMachineCode(machine?.machineName, operatorSelectEl, operatorChoices);
      autoFillByMachineCode(machine?.machineName, helperSelectEl, helperChoices);
    });

    const machineLabel = (m) => `${m.machineName} — ${m.location?.locationName || "?"}${m.machineType ? " (" + m.machineType + ")" : ""}`;
    const options = ALL_MACHINES.map((m) => ({ value: m._id, label: machineLabel(m) }));
    machineChoices.setChoices(
      [{ value: "", label: "Select Machine", disabled: true, selected: true }, ...options],
      "value", "label", true,
    );

    // What this order already had assigned, so re-opening it to edit shows
    // the previous machine/operator/helper instead of a blank form.
    const ASSIGNED = <%- safeJson({
      machineId: pp.assignedMachineId ? String(pp.assignedMachineId) : "",
      operatorId: pp.operatorId ? String(pp.operatorId) : "",
      helperId: pp.helperId ? String(pp.helperId) : "",
    }) %>;

    if (ASSIGNED.machineId) machineChoices.setChoiceByValue(String(ASSIGNED.machineId));
    if (ASSIGNED.operatorId) operatorChoices.setChoiceByValue(String(ASSIGNED.operatorId));
    if (ASSIGNED.helperId) helperChoices.setChoiceByValue(String(ASSIGNED.helperId));

    // ---- Raw Material Allotment ----
    // One inline column per raw-material layer this item's recipe calls
    // for -- Facestock/Adhesive/Release Liner reel picks travel straight in
    // the main form (checkbox inputs named rawLayers[<key>]; a layer can
    // have more than one checked at once, e.g. combining two undersized
    // reels onto one order) and are recorded server-side as allottedLayers,
    // as part of this same Assign & Continue submit -- no Deckle gets
    // laminated from this page for now (see the doc comment above
    // #rawLayersGrid). Columns are scoped to the selected machine's own
    // location, so nothing here is choosable until a machine is picked.
    //
    // LAYER_ORDER / LAYER_META mirror the server copy in
    // utils/labelStockProduction.js (and labelStockForm.ejs's
    // ROLL_TYPE_ORDER) -- keep all three in step.
    const LAYER_ORDER = {
      NORMAL: ["facestock", "adhesive", "releaseLiner"],
      "DOUBLE RELEASE": ["facestock", "adhesive", "releaseLiner", "adhesive2", "releaseLiner2"],
      "DOUBLE FACESTOCK": ["facestock", "adhesive", "facestock2", "adhesive2", "releaseLiner"],
    };
    const LAYER_META = {
      facestock: { pool: "facestock", label: "Facestock", specField: "facestock", typeField: "facestockType" },
      adhesive: { pool: "adhesive", label: "Adhesive", specField: "adhesive", typeField: "adhesiveType" },
      releaseLiner: { pool: "release", label: "Release Liner", specField: "releaseLiner", typeField: "releaseLinerType" },
      facestock2: { pool: "facestock", label: "Facestock (Layer 2)", specField: "facestock2", typeField: "facestockType" },
      adhesive2: { pool: "adhesive", label: "Adhesive (Layer 2)", specField: "adhesive2", typeField: "adhesiveType" },
      releaseLiner2: { pool: "release", label: "Release Liner (Layer 2)", specField: "releaseLiner2", typeField: "releaseLinerType" },
    };

    const ITEM = JSON.parse(document.getElementById("item-data").textContent);
    const requiredLayerKeys = () => LAYER_ORDER[ITEM.rollType] || LAYER_ORDER.NORMAL;
    const layerReelsCache = {}; // layerKey -> reels fetched for the current machine's location
    // layerKey -> whether the adhesive layer's Label Stock has a binding
    // configured (models/sachiko/labelStockAdhesiveBinding.js) -- a binding
    // is mandatory for the adhesive pool now, so an empty reel list has two
    // different real causes the empty-state message has to tell apart: "no
    // binding set yet" vs. "bound, but nothing in stock matches it".
    // Irrelevant (stays true) for Facestock/Release Liner, which have no
    // binding concept.
    const layerHasBindingCache = {};
    // "<layerKey>|<reel id>" for every reel the last Auto Allot run ticked --
    // purely so those rows can be marked in the tables (renderLayerRows).
    // Nothing downstream reads it: an auto pick and a hand pick submit
    // identically, which is the point.
    const AUTO_PICKED = new Set();

    // What this order already had picked per raw-material layer (see
    // models/inventory/pendingProduction.js's allottedLayers) -- so
    // re-opening a partially-allocated order to top up one layer doesn't
    // silently drop what was already picked for the others. Only used as a
    // fallback default the first time a layer renders; once the checkbox
    // group exists in the DOM, renderLayerRows() carries the live DOM selection
    // forward instead (see previouslyChecked below), same as any other pick.
    const ALLOTTED_LAYERS = JSON.parse(document.getElementById("allotted-layers-data").textContent) || {};
    const ORDER_ID = JSON.parse(document.getElementById("order-id-data").textContent);

    // The one-line recipe this layer has to be matched against, shown beside
    // the layer's name. Adhesive lists exactly what reelMatchesLayer()
    // (utils/labelStockProduction.js POOL_MATCH_FIELDS) checks: type alone.
    //
    // Facestock and Release Liner deliberately do NOT. Release Liner reads
    // Sensing only -- the one property of a liner the press itself cares
    // about, and the ONLY thing Release Liner is matched on at all (not
    // Type/Make/Vendor/Vendor SKU Code/Colour/Size/GSM -- see POOL_MATCH_FIELDS
    // and the /raw-stock route, which doesn't even query on Type for this
    // pool). Facestock reads Family / GSM / Type only,
    // the three a picker actually recognises the paper by. Make, Vendor SKU
    // Code and Micron are still part of the match (a reel failing them never
    // reaches the table below) -- they're just not spelled out here; the full
    // spec is on the Material Details card at the top of the page. GSM is the
    // other way round: shown here, but NOT matched on, so a reel whose GSM
    // differs can still be a candidate. Everything else per-reel (Vendor
    // Name, Size, ...) belongs in reelDetail() below instead.
    function specSummary(spec, layerKey) {
      if (!spec) return "—";
      const bits = [];
      if (layerKey.startsWith("facestock")) {
        if (spec.facestockFamily) bits.push(spec.facestockFamily);
        if (spec.facestockGsm) bits.push(`${spec.facestockGsm} GSM`);
        if (spec.facestockType) bits.push(spec.facestockType);
      } else if (layerKey.startsWith("adhesive")) {
        // Nothing shown here for adhesive -- the recipe's own Type is no
        // longer what decides which drums are offered (a Label Stock <->
        // Adhesive binding is, and one SKU can carry more than one binding,
        // potentially spanning different types -- see
        // /sachiko/form/label-stock-adhesive-binding). Printing the recipe's
        // single Type next to the heading implied it still gated the picker,
        // which it doesn't anymore.
      } else {
        // Sensing alone -- whether the liner carries the mark the press's
        // eye-mark sensor needs (models/sachiko/sachikoLabelStock.js's
        // releaseLinerSensing). It's the ONLY thing Release Liner is matched
        // on (POOL_MATCH_FIELDS) -- Type/Make/Vendor/Vendor SKU Code/Colour/
        // Size/GSM are shown for reference (Material Details card / the
        // table's own columns) but never narrow the picker.
        if (spec.releaseLinerSensing) bits.push(spec.releaseLinerSensing);
      }
      return bits.join(" · ") || "—";
    }

    // Per-candidate-reel counterpart to specSummary() above: shows the
    // fields specSummary DOESN'T (the ones POOL_MATCH_FIELDS no longer
    // narrows on) and that have no column of their own in POOL_COLUMNS
    // below -- Facestock: nothing (Vendor/Make/Code/Size/GSM are all
    // columns); Adhesive: Viscosity/Cohesion/Shear/Density (Vendor/Make/Code
    // are columns); Release Liner: nothing (Vendor/Sensing/Size/GSM are all
    // columns). Since those fields can differ
    // between reels that still count as a match, this is what a picker
    // actually needs to tell candidates apart by. For a pool whose columns
    // cover everything visible, this is what the row's hover tooltip carries
    // instead, alongside the system Roll ID.
    function reelDetail(layerKey, r) {
      const bits = [];
      if (layerKey.startsWith("facestock")) {
        // Vendor/Make/Code/Size/GSM are all columns of their own now, so
        // nothing is left over -- reelTitle falls back to the bare Roll ID.
      } else if (layerKey.startsWith("adhesive")) {
        // Vendor/Make/Code each have their own column now -- not repeated here.
        if (r.viscosity) bits.push(`Visc ${r.viscosity}`);
        if (r.cohesion) bits.push(`Coh ${r.cohesion}`);
        if (r.shear) bits.push(`Shear ${r.shear}`);
        if (r.density) bits.push(`Dens ${r.density}`);
      } else {
        // Release Liner: Vendor/Size/GSM are all columns of their own now,
        // so nothing is left over -- reelTitle falls back to the bare Roll
        // ID for these.
      }
      return bits.join(" · ") || "—";
    }

    // ---- Columns, per raw-material pool ----
    // The pools don't show the same fields, because a picker tells their
    // candidates apart by different things: a facestock reel by Size/GSM
    // beside its vendor line, an adhesive drum by Vendor/Make/Code outright.
    // Everything downstream -- the <colgroup> widths, both header rows, the
    // per-column filter boxes, the row cells and every colspan -- is derived
    // from this one list, so a column can't go missing from one of them.
    //
    //   key   : ties a cell to the filter box above it (data-col)
    //   col   : <colgroup> class, i.e. a fixed width from the stylesheet.
    //           Omitted = flexible: fixed table layout splits whatever the
    //           fixed columns leave over equally between them.
    //   trunc : long text -- ellipsise rather than let it push the table
    //   title : hover tooltip; also searchable, so the Roll ID rides here
    // Tooltip for a row's first cell: the system Roll ID, plus whatever
    // reelDetail still has to say that no column of this pool shows. Adhesive
    // drums with no viscosity/cohesion/shear/density recorded have nothing
    // left over, so they get the bare Roll ID rather than "ROLL -- —".
    // The reel's age rides in that tooltip too. It has no column of its own --
    // there is no width left for one (see the <colgroup> notes above) -- but
    // it is what Auto Allot orders the whole pick by, so it has to be visible
    // somewhere the operator can check it. Being in the tooltip also makes it
    // searchable: the Vendor filter box matches a row's tooltip as well as its
    // text, so typing a date narrows to the reels inwarded then.
    const fmtInward = (r) => {
      const d = new Date(r.inwardDate || r.createdAt || "");
      if (isNaN(d)) return "";
      const on = `${String(d.getDate()).padStart(2, "0")}/${String(d.getMonth() + 1).padStart(2, "0")}/${d.getFullYear()}`;
      return r.inwardDate ? `in ${on}` : `entered ${on}`;   // no inward date recorded -- say which date this is
    };
    const reelTitle = (r, k) => {
      const bits = [String(r.rollId || "")];
      const detail = reelDetail(k, r);
      if (detail !== "—") bits.push(detail);
      const inward = fmtInward(r);
      if (inward) bits.push(inward);
      return bits.join(" -- ");
    };
    // ---- what a reel on the shelf gives: kg and running metres ---------------
    // Raw stock is held in kilograms (FacestockStock/AdhesiveStock/
    // ReleaseLinerStock `reelMtrs` is really kg); this page works in area, so
    // every reel is converted for display and for the tally. Same formula as
    // utils/rawMaterialNeed.js kgToSqMetres -- kept in step with it:
    //
    //     area (m2) = kg x 1000 / gsm
    //
    // No width involved, which is the point: a reel's area is what it covers
    // however it is slit, so reels of different widths compare directly and a
    // drum -- which has no width at all -- converts on the same footing.
    //
    // The GSM is the reel's own where it has one. Where it does not, the Raw
    // Material Required strip hands down the recipe's on the layer's cell
    // (data-gsm): the pools are filtered to this recipe's spec, so it is the
    // same material. For adhesive that fallback is the only source and it is
    // the WET figure -- a drum holds wet adhesive, and no drum records a coat
    // weight of its own. With neither, the reel cannot be measured.
    const needCellFor = (layerKey) =>
      document.querySelector(`.rm-need-cell[data-layer="${layerKey}"]`);

    const numOr = (v) => {
      const n = Number(String(v ?? "").replace(/[^0-9.]/g, ""));
      return Number.isFinite(n) && n > 0 ? n : null;
    };

    const isAdhesiveLayer = (layerKey) => layerKey.startsWith("adhesive");

    // The GSM a reel's kilograms are turned into metres with. A web reel's own
    // where it has one, falling back to the recipe's (the pools are filtered to
    // this recipe's spec, so it is the same material). For adhesive there is no
    // reel GSM to use -- no drum records a coat weight -- so it is always the
    // recipe's WET figure, handed down on the need cell.
    function reelGsmUsed(reel, layerKey) {
      const recipeGsm = numOr(needCellFor(layerKey)?.dataset.gsm);
      return isAdhesiveLayer(layerKey) ? recipeGsm : (numOr(reel.gsm) ?? recipeGsm);
    }

    // The width a reel's kilograms are spread over to give a length.
    //
    //   web reel   its OWN width -- that is its true physical length, however
    //              wide it is.
    //   drum       the job's web width, handed down on the need cell: adhesive
    //              has no width of its own, it coats whatever is running.
    function reelWidthUsed(reel, layerKey) {
      const jobWidth = numOr(needCellFor(layerKey)?.dataset.width);
      return isAdhesiveLayer(layerKey) ? jobWidth : numOr(reel.size);
    }

    // What this reel holds, in kilograms (as stocked) and in running metres.
    //
    //     metres = kg x 1e6 / (gsm x widthMm)
    //
    // `reelMtrs` on every raw pool is really KILOGRAMS -- despite the name --
    // so the kg side needs no conversion at all. Metres are null when there is
    // no GSM or no width to work from; the reel then counts as nothing on that
    // side of the tally and is called out rather than quietly dropped.
    function reelKg(reel) {
      return numOr(reel.reelMtrs);
    }
    function reelMtrs(reel, layerKey) {
      const kg = reelKg(reel);
      const gsm = reelGsmUsed(reel, layerKey);
      const width = reelWidthUsed(reel, layerKey);
      if (kg == null || gsm == null || width == null) return null;
      return Math.round(((kg * 1e6) / (gsm * width)) * 100) / 100;
    }

    const fmtNum = (n) => Number(n).toLocaleString("en-IN", { maximumFractionDigits: 2 });

    // Two columns now -- Kg as stocked, and the running metres it works out to.
    // Both are returned as bare numbers (no thousands separators), and metres
    // as null when they cannot be worked out: the row builder renders null as
    // "—", the column sort reads a number, and the column's search box matches
    // the digits typed. All three would break on a formatted string.
    const kgCell = (r) => reelKg(r);
    const mtrsCell = (r, layerKey) => reelMtrs(r, layerKey);

    // The width the REQUIREMENT is budgeted at -- the widest web in the plan
    // (utils/rawMaterialNeed.js's webRunsFor). It is what an adhesive drum's
    // weight is spread over to give a length, and nothing else: it is not the
    // test of whether a reel fits, because on a mixed-web batch most of the
    // webs are narrower than it.
    const jobWidthMm = () => numOr(document.querySelector(".rm-need-cell[data-jobwidth]")?.dataset.jobwidth);

    // Every web this batch actually laminates -- [{ w, webs }], widest first.
    // A mixed-web plan runs more than one (660 x 8 + 635 x 15 + 510 x 3), and
    // a reel only has to fit ONE of them to be worth mounting.
    const WEB_WIDTHS = (JSON.parse(document.getElementById("web-widths-data").textContent) || [])
      .map((x) => ({ w: Number(x.w), webs: Number(x.webs) || 0, mtrs: Number(x.mtrs) || 0 }))
      .filter((x) => x.w > 0);
    const TOTAL_WEBS = WEB_WIDTHS.reduce((n, x) => n + x.webs, 0);
    // The narrowest web in the plan: below this a reel cannot carry a single
    // deckle of this batch, which is the only width test that is actually
    // true. Falls back to the budget width for a batch with no layout rows.
    const minWebMm = () => (WEB_WIDTHS.length ? Math.min(...WEB_WIDTHS.map((x) => x.w)) : jobWidthMm());
    const widestWebMm = () => (WEB_WIDTHS.length ? Math.max(...WEB_WIDTHS.map((x) => x.w)) : jobWidthMm());
    // How many of this batch's deckles a reel of this width could be run for.
    const websCarried = (w) => (w == null ? TOTAL_WEBS
      : WEB_WIDTHS.reduce((n, x) => n + (x.w <= w + 0.5 ? x.webs : 0), 0));

    // A reel narrower than EVERY web this batch runs cannot be mounted on any
    // of them, however many metres it holds -- and metres alone would happily
    // read "covered" off a reel that physically will not fit. That, and only
    // that, is what gets flagged: a 635 mm reel on a batch whose main run is
    // 635 mm is the right reel, and marking it short of the 660 mm webs it was
    // never going to be used for made the page contradict its own Size filter.
    // Flagged rather than dropped -- the Size column and its filter are still
    // where the planner chooses, and a narrow reel can have legitimate uses.
    const reelTooNarrow = (r, layerKey) => {
      if (isAdhesiveLayer(layerKey)) return false;        // a drum has no width to be short of
      const w = numOr(r.size);
      const min = minWebMm();
      return w != null && min != null && w < min - 0.5;
    };
    // Usable, but not for the whole batch -- it fits some of the webs and not
    // the widest. Not an error and not coloured; said in the row's tooltip, and
    // counted in the Auto Allot summary so a pick of these is never silent.
    const reelPartialWebs = (r, layerKey) => {
      if (isAdhesiveLayer(layerKey) || reelTooNarrow(r, layerKey)) return null;
      const w = numOr(r.size);
      if (w == null || !WEB_WIDTHS.length) return null;
      const n = websCarried(w);
      return n > 0 && n < TOTAL_WEBS ? n : null;
    };

    // ---- only this batch's own web width is offered -------------------------
    // The table lists reels of the width(s) this deckle is actually cut at and
    // nothing else. A store holds every size the plant runs; scrolling past
    // 510 mm and 1020 mm reels to find the 635s -- and being able to tick one
    // by mistake -- is not a choice worth offering on a page whose whole job
    // is one deckle size.
    //
    // A drum has no width, so the adhesive column is never narrowed. A reel
    // with no Size recorded can't be shown to fit and is hidden with the rest;
    // both it and the wrong-width reels are counted under the column heading,
    // so nothing disappears silently -- and a wider reel that is genuinely
    // wanted can still be ticked from Raw Material stock pages.
    //
    // With no widths recorded at all (a legacy batch with no layouts and no
    // deckle size) there is nothing to narrow by, so everything shows, exactly
    // as it did before.
    const reelFitsBatchWeb = (r, layerKey) => {
      if (isAdhesiveLayer(layerKey) || !WEB_WIDTHS.length) return true;
      const w = numOr(r.size);
      return w != null && WEB_WIDTHS.some((x) => Math.abs(x.w - w) < 0.5);
    };

    // ...with one way back. A store can simply run out of the right width
    // while a wider reel that would physically run sits on the shelf, and a
    // page that hides it outright leaves the job unassignable for no good
    // reason. So the count of hidden reels under the column heading is a
    // toggle: off by default (which is the whole point), one click to see the
    // rest. Per layer, because it is per shelf.
    const showOtherWidths = {};
    const otherWidthsShown = (layerKey) => !!showOtherWidths[layerKey];

    // What this layer currently has ticked, read off the live checkboxes.
    const checkedIdsFor = (layerKey) => new Set(
      Array.from(document.querySelectorAll(
        `#rawLayersGrid input[type="checkbox"][name="rawLayers[${layerKey}]"]:checked`,
      )).map((el) => el.value),
    );

    // The reels this layer's table shows -- and the only ones Auto Allot may
    // pick, so the button can never tick a row the operator cannot see.
    //
    // A reel that is already TICKED is always shown, whatever its width. It is
    // the only rule that can't be skipped here: the tick lives in the checkbox
    // itself, so a reel filtered out of the table takes its tick with it, and
    // hiding the other widths again after deliberately picking a 640 mm reel
    // for a 635 mm web would quietly un-allot it.
    const visibleReelsFor = (layerKey, keep) =>
      (layerReelsCache[layerKey] || []).filter((r) =>
        otherWidthsShown(layerKey) || reelFitsBatchWeb(r, layerKey) || (keep && keep.has(r._id)));

    const batchWebsText = () => WEB_WIDTHS.map((x) => `${fmtNum(x.w)} mm`).join(" / ");

    const mtrsTitle = (r, layerKey) => {
      const kg = reelKg(r);
      const m = reelMtrs(r, layerKey);
      const gsm = reelGsmUsed(r, layerKey);
      const width = reelWidthUsed(r, layerKey);
      if (m == null) {
        return `${kg != null ? fmtNum(kg) + " kg" : "No kg"} — ${gsm == null ? "no GSM" : "no width"} to work a length from`;
      }
      if (isAdhesiveLayer(layerKey)) {
        return `${fmtNum(kg)} kg spread at ${fmtNum(gsm)} GSM wet over a ${fmtNum(width)} mm web`;
      }
      // Which of this batch's deckles this reel can actually be run for --
      // the figure that decides whether its metres are any use here.
      const partial = reelPartialWebs(r, layerKey);
      const fit = reelTooNarrow(r, layerKey)
        ? ` — TOO NARROW for every web this batch runs (narrowest ${fmtNum(minWebMm())} mm)`
        : partial != null
          ? ` — runs ${partial} of this batch's ${TOTAL_WEBS} deckles`
          : "";
      return `${fmtNum(kg)} kg at ${fmtNum(gsm)} GSM, ${fmtNum(width)} mm wide${fit}`;
    };

    const POOL_COLUMNS = {
      facestock: [
        { key: "vendor", label: "Vendor", trunc: true, value: (r) => r.vendorName, title: reelTitle },
        { key: "make", label: "Make", trunc: true, value: (r) => r.make },
        { key: "code", label: "Code", trunc: true, value: (r) => r.vendorSkuCode },
        { key: "size", label: "Size", col: "rl-col-size", value: (r) => r.size },
        { key: "gsm", label: "GSM", col: "rl-col-gsm", value: (r) => r.gsm },
        { key: "kg", label: "Kg", col: "rl-col-kg", value: kgCell },
        { key: "mtrs", label: "R.Mtrs", col: "rl-col-sqm", value: mtrsCell, title: mtrsTitle },
      ],
      adhesive: [
        { key: "vendor", label: "Vendor", trunc: true, value: (r) => r.vendorName, title: reelTitle },
        { key: "make", label: "Make", trunc: true, value: (r) => r.make },
        { key: "code", label: "Code", trunc: true, value: (r) => r.vendorSkuCode },
        // `reelMtrs` on a drum is kilograms already; Mtrs is how much web that
        // weight coats at the recipe's wet GSM over this job's width.
        { key: "kg", label: "Kg", col: "rl-col-kg", value: kgCell },
        { key: "mtrs", label: "R.Mtrs", col: "rl-col-sqm", value: mtrsCell, title: mtrsTitle },
      ],
      release: [
        { key: "vendor", label: "Vendor", trunc: true, value: (r) => r.vendorName, title: reelTitle },
        { key: "sensing", label: "Sensing", col: "rl-col-sensing", trunc: true, value: (r) => r.sensing },
        { key: "size", label: "Size", col: "rl-col-size", value: (r) => r.size },
        { key: "gsm", label: "GSM", col: "rl-col-gsm", value: (r) => r.gsm },
        { key: "kg", label: "Kg", col: "rl-col-kg", value: kgCell },
        { key: "mtrs", label: "R.Mtrs", col: "rl-col-sqm", value: mtrsCell, title: mtrsTitle },
      ],
    };
    const layerColumns = (layerKey) => POOL_COLUMNS[LAYER_META[layerKey].pool];
    // +1 for the checkbox column, which every table has and none of the
    // lists above carries (nothing to search or size about it).
    const layerColCount = (layerKey) => layerColumns(layerKey).length + 1;

    // Reel values come straight from the raw-stock endpoint into innerHTML
    // and into title="..." attributes -- escape so an apostrophe or quote in
    // a vendor name can't break the row it's rendered into.
    const escAttr = (v) =>
      String(v == null ? "" : v)
        .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;").replace(/\'/g, "&#39;");

    function layerColumnHtml(layerKey, meta) {
      const columns = layerColumns(layerKey);
      // <colgroup> is what actually sets these columns' widths -- the table
      // runs table-layout: fixed, so the px values live in one place in the
      // stylesheet (see "LAYER TABLE COLUMN WIDTHS" above) instead of being
      // fought over by per-cell rules.
      const cols = columns.map((c) => (c.col ? `<col class="${c.col}" />` : "<col />")).join("");
      // Each column gets its own filter box, in a row inside the table's
      // header under the labels -- they narrow independently and combine
      // (Make "3M" + Kg "50" shows only drums that are both). The checkbox
      // column has nothing to search, so its cell stays empty. Inputs carry
      // no `name`: they're a view-only filter over the rows already fetched
      // for this column, never part of the submit. The "n selected hidden"
      // note rides under the first box, the widest cell to read it in.
      const searchBox = (colKey, label) =>
        `<input type="search" class="raw-layer-search" data-search="${layerKey}" data-col="${colKey}"`
        + ` placeholder="${label}" title="Filter by ${label}" autocomplete="off" />`;
      const note = `<div class="raw-layer-hidden-note" data-hidden-note="${layerKey}" hidden></div>`;
      return `
        <div class="raw-layer-col" data-layer="${layerKey}" data-pool="${meta.pool}">
          <div class="raw-layer-head">
            <span class="raw-layer-title">${meta.label}</span>
            <span class="raw-layer-spec">${specSummary(ITEM[meta.specField], layerKey)}</span>
            <!-- Which width this column is listing, and how many reels of
                 other widths are at this location but not shown. The table
                 only offers reels this deckle can be cut from, so the ones it
                 leaves out are said out loud rather than just missing. -->
            <span class="raw-layer-web" data-web-note="${layerKey}" hidden></span>
          </div>
          <!-- Header lives in its own, non-scrolling table -- entirely
               outside the scrollable body below, rather than "stuck" on top
               of it via position: sticky. Sticky positioning inside a
               scrolling table fights the table's own layout/paint and drifted
               visibly on scroll; two stacked tables that share the same
               <colgroup> column widths just can't drift, because the header
               was never part of the thing that scrolls in the first place.

               Both tables sit inside ONE .raw-layer-scroll, so that where the
               column is too narrow for them (see the min track note in the
               stylesheet) they slide sideways together and stay aligned.
               Wrapping only the body would put the header back in exactly the
               drifting-apart position this arrangement exists to avoid. -->
          <div class="raw-layer-scroll custom-scrollbar">
          <table class="ap-table roll-table raw-layer-table raw-layer-table-head">
            <colgroup><col class="rl-col-check" />${cols}</colgroup>
            <thead>
              <tr>
                <th class="roll-check-cell"></th>
                ${columns.map((c) => `<th class="rl-sortable" data-sort="${c.key}" title="Sort by ${c.label}">${c.label}</th>`).join("")}
              </tr>
              <tr class="raw-layer-search-row">
                <th class="roll-check-cell"></th>
                ${columns.map((c, i) => `<th>${searchBox(c.key, c.label)}${i === 0 ? note : ""}</th>`).join("")}
              </tr>
            </thead>
          </table>
          <div class="ap-table-wrap raw-layer-table-wrap custom-scrollbar"><table class="ap-table roll-table raw-layer-table">
            <colgroup><col class="rl-col-check" />${cols}</colgroup>
            <tbody data-body="${layerKey}"><tr><td colspan="${layerColCount(layerKey)}" style="color:#94a3b8; font-style:italic;">Select a machine first</td></tr></tbody>
          </table></div>
          </div>
        </div>`;
    }

    // ---- Sorting ----
    // One pick per layer table (column + direction), set by clicking a
    // heading. Nothing here until a heading is clicked: the default order is
    // whatever the raw-stock route sent, which is smallest reel first -- the
    // one most worth using up.
    const layerSort = {};

    // Numbers compare as numbers (so Kg 90 sorts under 100, not between 10
    // and 19) and everything else as text, case-insensitively, with embedded
    // digits still read as numbers ("A2" before "A10"). Blanks are always
    // last, in both directions -- a reel with no Size recorded is never the
    // most interesting row in the table.
    function compareReels(colDef, layerKey, dir) {
      return (a, b) => {
        const av = colDef.value(a, layerKey);
        const bv = colDef.value(b, layerKey);
        const aBlank = av == null || av === "";
        const bBlank = bv == null || bv === "";
        if (aBlank || bBlank) return aBlank && bBlank ? 0 : aBlank ? 1 : -1;
        const an = Number(av);
        const bn = Number(bv);
        if (Number.isFinite(an) && Number.isFinite(bn)) return (an - bn) * dir;
        return String(av).localeCompare(String(bv), undefined, { numeric: true, sensitivity: "base" }) * dir;
      };
    }

    // Sorts a copy, never layerReelsCache itself, so the cache keeps the
    // server's own order intact underneath whatever the user is looking at.
    //
    // Whatever is TICKED sits at the top, always, ahead of whichever column
    // the table is sorted by. A layer can hold several reels and the list can
    // run to fifty rows: with the picks scattered down it, checking what is
    // actually allotted meant scrolling the whole column, and a reel ticked
    // and then sorted out of view was easy to forget. The column sort still
    // decides the order inside each half.
    function sortedReelsFor(layerKey, reels, columns, checked) {
      const state = layerSort[layerKey];
      const colDef = state ? columns.find((c) => c.key === state.colKey) : null;
      const byColumn = colDef ? compareReels(colDef, layerKey, state.dir) : null;
      const isChecked = (r) => !!(checked && checked.has(r._id));
      return [...reels].sort((a, b) => {
        const ca = isChecked(a);
        const cb = isChecked(b);
        if (ca !== cb) return ca ? -1 : 1;
        return byColumn ? byColumn(a, b) : 0;
      });
    }

    // Renders (or re-renders) one layer column's rows from its cached reels.
    // Every reel is always selectable -- no quantity gates this anymore (no
    // "Kg to Produce" field: this page only records which reels are allotted
    // to the order, it doesn't laminate a Deckle -- see the doc comment above
    // #rawLayersGrid). Doesn't refetch, so re-renders don't hit the server.
    // layerReelsCache[key] is `null` until a location has actually been
    // fetched for it (distinct from `[]`, fetched-but-empty), so re-renders
    // before a machine is picked don't claim "no reels" when really nothing
    // has been looked up yet.
    function renderLayerRows(layerKey) {
      const tbody = document.querySelector(`#rawLayersGrid tbody[data-body="${layerKey}"]`);
      if (!tbody) return;
      // Rebuilding the tbody below replaces every checkbox, which would
      // otherwise silently drop whatever was picked -- carry every
      // currently-checked id forward (a layer can hold more than one picked
      // reel at once, e.g. combining two undersized drums onto one order).
      // Before anything's been checked yet (this layer's first render since
      // page load), fall back to whatever was already allotted server-side
      // -- reads both the current `stockIds` array shape and the legacy
      // single `stockId` shape orders assigned before this changed still
      // have saved (see utils/labelStockProduction.js's pickStockIds).
      //
      // Worked out BEFORE the width filter below, because it feeds it: a
      // ticked reel stays listed whatever its width, so that hiding the other
      // widths can never take an allotment with it.
      const checkedNow = Array.from(tbody.querySelectorAll("input[type='checkbox']:checked")).map((el) => el.value);
      const allotted = ALLOTTED_LAYERS[layerKey];
      const previouslyChecked = new Set(
        checkedNow.length ? checkedNow : allotted?.stockIds || (allotted?.stockId ? [allotted.stockId] : []),
      );

      // Only the reels of this batch's own web width (see reelFitsBatchWeb),
      // plus whatever is ticked. `null` still means "no location fetched yet",
      // which is not the same as "nothing fits".
      const allReels = layerReelsCache[layerKey];
      const reels = allReels ? visibleReelsFor(layerKey, previouslyChecked) : allReels;
      // Counted against the batch's web, not against what is on screen -- so
      // the badge still says how many are off-width once they are revealed.
      const offWidth = allReels ? allReels.filter((r) => !reelFitsBatchWeb(r, layerKey)).length : 0;

      // Which width this column lists, and what it is therefore leaving out.
      const webNote = document.querySelector(`[data-web-note="${layerKey}"]`);
      if (webNote) {
        const narrowed = !isAdhesiveLayer(layerKey) && WEB_WIDTHS.length > 0;
        webNote.hidden = !narrowed;
        if (narrowed) {
          const shown = otherWidthsShown(layerKey);
          webNote.classList.toggle("is-open", shown);
          webNote.innerHTML = escAttr(batchWebsText())
            + (offWidth
              ? ` <button type="button" class="rl-web-toggle" data-show-others="${layerKey}">`
                + `${shown ? "hide" : `${offWidth} in other width${offWidth === 1 ? "" : "s"}`}</button>`
              : "");
          webNote.title = shown
            ? `Showing every width at this location. This deckle is cut at ${batchWebsText()}; anything else has to be trimmed to it.`
            : `Only reels this deckle can be cut from are listed${offWidth ? `; ${offWidth} of another width are in stock here` : ""}.`;
        }
      }

      if (!reels) {
        tbody.innerHTML = `<tr><td colspan="${layerColCount(layerKey)}" style="color:#94a3b8; font-style:italic;">Select a machine first</td></tr>`;
        filterLayerRows(layerKey);
        return;
      }
      if (!reels.length) {
        // The adhesive pool requires a binding (models/sachiko/labelStockAdhesiveBinding.js)
        // -- an empty list here has three different real causes now, and only
        // one of them is "nothing in stock". Distinguish them so the operator
        // isn't left guessing whether to look for stock, go configure a
        // binding, or buy paper of the right width.
        const message = layerKey.startsWith("adhesive") && layerHasBindingCache[layerKey] === false
          ? 'No binding configured for this Label Stock — set one at <a href="/app/form/label-stock-adhesive-binding" target="_blank" rel="noopener">Label Stock Adhesive Binding</a> before assigning.'
          : offWidth
            ? `No ${escAttr(batchWebsText())} reels in stock at this location — ${offWidth} reel${offWidth === 1 ? " is" : "s are"} here in other widths. Use “${offWidth} in other widths” above to see them.`
            : "No reels in stock at this location";
        // table-layout: fixed (see .raw-layer-table.roll-table above) means a
        // long, unbroken run of text -- the binding link's full sentence in
        // particular -- would otherwise push past this cell instead of
        // wrapping inside it. white-space: normal is already the table
        // default, but word-break/overflow-wrap are what actually force a
        // break rather than letting the cell's fixed width overflow.
        tbody.innerHTML = `<tr><td colspan="${layerColCount(layerKey)}" style="color:#94a3b8; font-style:italic; white-space:normal; word-break:break-word; overflow-wrap:break-word;">${message}</td></tr>`;
        filterLayerRows(layerKey);
        return;
      }

      const columns = layerColumns(layerKey);
      const orderedReels = sortedReelsFor(layerKey, reels, columns, previouslyChecked);

      // Checkboxes -- a layer can hold more than one picked reel at once,
      // so every row is independently selectable with no single-select
      // enforcement (unlike a native radio group). data-col ties each cell
      // to the header filter box above it.
      //
      // A reel with no invoice number recorded can't be assigned -- inward
      // without an invoice usually means the entry is still incomplete/
      // provisional, so the row is shown (an operator can see it's there and
      // go fix the stock record) but marked unselectable rather than offered
      // as a normal candidate.
      tbody.innerHTML = orderedReels.map((r) => {
        const noInvoice = !r.invoiceNo;
        const checked = previouslyChecked.has(r._id) && !!r.invoiceNo;
        const cells = columns.map((c) => {
          const raw = c.value(r, layerKey);
          const text = raw == null || raw === "" ? "—" : escAttr(raw);
          const title = c.title ? ` title="${escAttr(c.title(r, layerKey))}"` : "";
          const cls = c.trunc ? ' class="raw-layer-detail-cell"' : "";
          return `<td data-col="${c.key}"${cls}${title}>${text}</td>`;
        }).join("");
        const narrow = !noInvoice && reelTooNarrow(r, layerKey);
        // Auto Allot's own picks are flagged as well as ticked (see
        // AUTO_PICKED), so the rows a run chose can be told from ones ticked
        // by hand afterwards -- the class rides through every re-render
        // (sort/filter/refresh) because it is rebuilt from that set here.
        const classes = [];
        let rowTitle = "";
        if (noInvoice) { classes.push("raw-layer-row-no-invoice"); rowTitle = "No invoice"; }
        else if (narrow) {
          classes.push("raw-layer-row-narrow");
          rowTitle = `${escAttr(r.size)} mm — narrower than every web this batch runs`
            + ` (${escAttr(WEB_WIDTHS.map((x) => `${x.w} × ${x.webs}`).join(", ") || jobWidthMm() || "")}),`
            + ` so it cannot be mounted for any of them`;
        } else {
          // Fits some of the webs but not all -- legitimate, so no colour;
          // said here so a pick is made knowing which deckles it can run.
          const partial = reelPartialWebs(r, layerKey);
          if (partial != null) {
            rowTitle = `${escAttr(r.size)} mm — runs ${partial} of this batch's ${TOTAL_WEBS} deckles;`
              + ` too narrow for the ${escAttr(widestWebMm())} mm ${TOTAL_WEBS - partial === 1 ? "web" : "webs"}`;
          }
        }
        if (checked) classes.push("raw-layer-row-picked");
        if (checked && AUTO_PICKED.has(`${layerKey}|${r._id}`)) classes.push("raw-layer-row-auto");
        const rowAttrs = (classes.length ? ` class="${classes.join(" ")}"` : "")
          + (rowTitle ? ` title="${rowTitle}"` : "");
        return `<tr${rowAttrs}>` +
          `<td class="roll-check-cell"><input type="checkbox" name="rawLayers[${layerKey}]" value="${r._id}"` +
            ` data-kg="${reelKg(r) ?? ""}" data-mtrs="${reelMtrs(r, layerKey) ?? ""}"` +
            ` data-roll="${escAttr(r.rollId || "")}" data-usedgsm="${reelGsmUsed(r, layerKey) ?? ""}"` +
            ` data-usedwidth="${reelWidthUsed(r, layerKey) ?? ""}"` +
            `${checked ? " checked" : ""}${noInvoice ? " disabled" : ""} /></td>` +
          cells +
        `</tr>`;
      }).join("");

      // The tbody was just rebuilt from scratch -- re-apply whatever this
      // column's search box currently holds, so a refresh doesn't quietly
      // un-filter it.
      filterLayerRows(layerKey);
      updateRawNeed(layerKey);
    }

    // ---- Raw Material Required <- Raw Material Allotment -------------------
    // Every layer is tallied against its OWN pool -- facestock against the
    // facestock reels, adhesive against the adhesive drums -- on both sides of
    // the same material:
    //
    //   Kg     what the store issues. Straight off the reel: `reelMtrs` on
    //          every raw pool is really kilograms, so nothing is converted.
    //   Mtrs   what the machine runs. kg x 1e6 / (gsm x width) -- a web reel
    //          at its own width and GSM, a drum spread at the recipe's wet GSM
    //          over this job's web.
    //
    // The bar fills on whichever side is further behind, so it only goes green
    // when BOTH are covered: enough weight but not enough length (or the other
    // way round) is still short. A reel whose metres cannot be worked out
    // counts on the kg side only and is called out by name.
    function updateRawNeed(onlyLayer) {
      const cells = document.querySelectorAll(
        onlyLayer ? `.rm-need-cell[data-layer="${onlyLayer}"]` : ".rm-need-cell[data-layer]",
      );
      cells.forEach((cell) => {
        const track = cell.querySelector(".rm-need-track");
        const left = cell.querySelector(".rm-need-left");
        if (!track || !left) return;

        const needKg = Number(cell.dataset.needKg);
        const needMtrs = Number(cell.dataset.needMtrs);
        const hasKg = Number.isFinite(needKg) && needKg > 0;
        const hasMtrs = Number.isFinite(needMtrs) && needMtrs > 0;
        if (!hasKg && !hasMtrs) return;                  // deckle not described yet

        const boxes = Array.from(document.querySelectorAll(
          `#rawLayersGrid input[type="checkbox"][name="rawLayers[${cell.dataset.layer}]"]:checked`,
        ));
        if (!boxes.length) {                             // nothing ticked yet -- stay quiet
          track.hidden = true;
          left.hidden = true;
          return;
        }

        let pickedKg = 0;
        let pickedMtrs = 0;
        let noMtrs = 0;
        boxes.forEach((el) => {
          const kg = Number(el.dataset.kg);
          const m = Number(el.dataset.mtrs);
          if (Number.isFinite(kg) && kg > 0) pickedKg += kg;
          if (Number.isFinite(m) && m > 0) pickedMtrs += m;
          else noMtrs += 1;
        });
        pickedKg = Math.round(pickedKg * 100) / 100;
        pickedMtrs = Math.round(pickedMtrs * 100) / 100;

        const part = (label, picked, need, on) => {
          if (!on) return "";
          const short = Math.round((need - picked) * 100) / 100;
          return short <= 0
            ? `<span class="rm-part is-covered">${label} <b>covered</b> <span class="rm-need-of">${fmtNum(picked)} of ${fmtNum(need)}</span></span>`
            : `<span class="rm-part"><b>${fmtNum(short)} ${label} short</b> <span class="rm-need-of">${fmtNum(picked)} of ${fmtNum(need)}</span></span>`;
        };

        // Furthest behind of the two -- the bar is the honest one, not the
        // flattering one.
        const pct = (picked, need, on) => (on ? Math.min(100, (picked / need) * 100) : 100);
        const fill = Math.min(pct(pickedKg, needKg, hasKg), pct(pickedMtrs, needMtrs, hasMtrs));
        const covered = fill >= 100;

        track.hidden = false;
        left.hidden = false;
        track.querySelector("i").style.width = fill + "%";
        track.classList.toggle("is-covered", covered);
        left.classList.toggle("is-covered", covered);
        left.innerHTML = part("kg", pickedKg, needKg, hasKg)
          + part("R.Mtrs", pickedMtrs, needMtrs, hasMtrs)
          + (noMtrs ? `<span class="rm-need-unknown">${noMtrs} reel${noMtrs === 1 ? "" : "s"} with no length</span>` : "");
      });

      // Always rebuilt whole, not just the layer that changed -- it is one
      // list across every layer, and a per-layer patch would leave the others
      // stale.
      renderPickedWorking();
    }

    // The same sums the bars above run, written out reel by reel under step 4
    // of the working, so both totals can be checked by hand. Each line is the
    // conversion as it was actually applied -- this reel's kilograms, the GSM
    // and width they were spread over, and the metres that gave.
    function renderPickedWorking() {
      const host = document.getElementById("rm-work-picked");
      if (!host) return;

      const blocks = [];
      document.querySelectorAll(".rm-need-cell[data-layer]").forEach((cell) => {
        const layerKey = cell.dataset.layer;
        const title = cell.querySelector(".rm-need-label")?.textContent || layerKey;
        const needKg = Number(cell.dataset.needKg);
        const needMtrs = Number(cell.dataset.needMtrs);
        const boxes = Array.from(document.querySelectorAll(
          `#rawLayersGrid input[type="checkbox"][name="rawLayers[${layerKey}]"]:checked`,
        ));
        if (!boxes.length) return;

        let totKg = 0;
        let totMtrs = 0;
        const rows = boxes.map((el) => {
          const kg = Number(el.dataset.kg);
          const m = Number(el.dataset.mtrs);
          const gsm = Number(el.dataset.usedgsm);
          const width = Number(el.dataset.usedwidth);
          if (Number.isFinite(kg) && kg > 0) totKg += kg;
          const okM = Number.isFinite(m) && m > 0;
          if (okM) totMtrs += m;
          return `
            <tr>
              <td class="rm-work-roll">${escAttr(el.dataset.roll || "—")}</td>
              <td class="ta-r">${Number.isFinite(kg) && kg > 0 ? fmtNum(kg) : '<span class="rm-work-warn">—</span>'}</td>
              <td class="rm-work-note">${
                Number.isFinite(gsm) && gsm > 0 && Number.isFinite(width) && width > 0
                  ? `× 1e6 ÷ (${fmtNum(gsm)} GSM × ${fmtNum(width)} mm)`
                  : '<span class="rm-work-warn">no GSM/width</span>'
              }</td>
              <td class="ta-r">${okM ? fmtNum(m) : '<span class="rm-work-warn">—</span>'}</td>
            </tr>`;
        }).join("");

        totKg = Math.round(totKg * 100) / 100;
        totMtrs = Math.round(totMtrs * 100) / 100;
        const cls = (picked, need) =>
          (!(Number.isFinite(need) && need > 0) ? "" : picked >= need ? "is-covered" : "is-short");

        blocks.push(`
          <div class="rm-work-sub">${escAttr(title)} — ticked so far</div>
          <table class="rm-work-table">
            <thead><tr><th>Reel</th><th class="ta-r">Kg</th><th>Spread over</th><th class="ta-r">R.Mtrs</th></tr></thead>
            <tbody>
              ${rows}
              <tr class="rm-work-sum">
                <td>Picked</td>
                <td class="ta-r ${cls(totKg, needKg)}">${fmtNum(totKg)}</td>
                <td class="rm-work-note">needs ${Number.isFinite(needKg) && needKg > 0 ? fmtNum(needKg) + " kg" : "—"}
                  &nbsp;·&nbsp; ${Number.isFinite(needMtrs) && needMtrs > 0 ? fmtNum(needMtrs) + " R.Mtrs" : "—"}</td>
                <td class="ta-r ${cls(totMtrs, needMtrs)}">${fmtNum(totMtrs)}</td>
              </tr>
            </tbody>
          </table>`);
      });

      host.innerHTML = blocks.join("");
    }

    // Filters one layer column's candidate reels from its own header row of
    // per-column boxes (whichever columns this pool has, see POOL_COLUMNS):
    // each narrows its own column, and a row has to satisfy every box that
    // has text in it (Size "1020" + GSM "90" = only reels that are both).
    // Within one box, each whitespace-separated term must appear in that
    // column -- so one box takes "3M ACME".
    //
    // Rows are hidden, never removed: a reel already checked stays checked
    // (and stays submitted) while it's filtered out of view, which the note
    // under the Details box calls out so nothing is silently allotted
    // off-screen. Rows with no checkbox are the placeholder/empty-state ones
    // and are never filtered.
    function filterLayerRows(layerKey) {
      const col = document.querySelector(`#rawLayersGrid .raw-layer-col[data-layer="${layerKey}"]`);
      if (!col) return;
      const tbody = col.querySelector(`tbody[data-body="${layerKey}"]`);
      const note = col.querySelector(`[data-hidden-note="${layerKey}"]`);
      const boxes = Array.from(col.querySelectorAll(".raw-layer-search"));
      if (!tbody || !boxes.length) return;

      const filters = boxes
        .map((el) => ({ colKey: el.dataset.col, terms: el.value.trim().toLowerCase().split(/\s+/).filter(Boolean) }))
        .filter((f) => f.terms.length);
      const rows = Array.from(tbody.querySelectorAll("tr")).filter((tr) => tr.querySelector("input[type='checkbox']"));

      tbody.querySelector("tr.raw-layer-noresult")?.remove();

      let visible = 0;
      let hiddenChecked = 0;
      rows.forEach((tr) => {
        const match = filters.every(({ colKey, terms }) => {
          const cell = tr.querySelector(`[data-col="${colKey}"]`);
          if (!cell) return false;
          // A cell's tooltip counts as part of it: that's where the full
          // text of a truncated cell lives, and where the Roll ID rides
          // (see POOL_COLUMNS) -- searching a reel by its ID is the one
          // thing a picker most often has in hand.
          const haystack = `${cell.textContent} ${cell.title || ""}`.toLowerCase();
          return terms.every((t) => haystack.includes(t));
        });
        tr.style.display = match ? "" : "none";
        if (match) visible += 1;
        else if (tr.querySelector("input[type='checkbox']").checked) hiddenChecked += 1;
      });

      if (rows.length && !visible) {
        const empty = document.createElement("tr");
        empty.className = "raw-layer-noresult";
        empty.innerHTML = `<td colspan="${layerColCount(layerKey)}" style="color:#94a3b8; font-style:italic;">No reel matches this search</td>`;
        tbody.appendChild(empty);
      }

      if (note) {
        note.hidden = !hiddenChecked;
        note.textContent = hiddenChecked
          ? `${hiddenChecked} selected reel${hiddenChecked > 1 ? "s" : ""} hidden by this search`
          : "";
      }
    }

    async function refreshLayerOptions(layerKey, location) {
      const meta = LAYER_META[layerKey];
      const spec = ITEM[meta.specField];
      const type = spec ? spec[meta.typeField] : "";
      const tbody = document.querySelector(`#rawLayersGrid tbody[data-body="${layerKey}"]`);
      if (!tbody) return;

      if (!location) {
        layerReelsCache[layerKey] = null;
        layerHasBindingCache[layerKey] = true;
        renderLayerRows(layerKey);
        return;
      }
      // Adhesive no longer needs the recipe's own Type -- a binding decides
      // the drums now (see the matching server-side change in
      // routes/sachiko/labelStockProduction.js's /raw-stock), so a blank
      // adhesiveType here isn't an incomplete spec for this layer anymore.
      if (!type && !layerKey.startsWith("adhesive")) {
        layerReelsCache[layerKey] = [];
        layerHasBindingCache[layerKey] = true;
        tbody.innerHTML = `<tr><td colspan="${layerColCount(layerKey)}" style="color:#ef4444;">Spec incomplete on this SKU</td></tr>`;
        filterLayerRows(layerKey);
        return;
      }

      try {
        const res = await fetch(`/app/labelstockproduction/raw-stock?layerKey=${encodeURIComponent(layerKey)}&itemId=${encodeURIComponent(ITEM._id)}&location=${encodeURIComponent(location)}&orderId=${encodeURIComponent(ORDER_ID)}`);
        const data = await res.json();
        layerReelsCache[layerKey] = data.reels || [];
        layerHasBindingCache[layerKey] = data.hasBinding !== false;
      } catch {
        layerReelsCache[layerKey] = [];
        layerHasBindingCache[layerKey] = true;
      }
      renderLayerRows(layerKey);
    }

    function currentMachineLocation() {
      const machine = ALL_MACHINES.find((m) => String(m._id) === String(machineSelectEl.value));
      return machine?.location?.locationName || "";
    }

    // The reels of every layer, re-fetched for whatever machine is selected
    // now. The promise is kept because Auto Allot has to wait on it -- pressing
    // the button straight after picking a machine would otherwise plan against
    // half-loaded (or still-empty) columns and quietly under-allot.
    let layersReady = Promise.resolve();
    function refreshAllLayerOptions() {
      const location = currentMachineLocation();
      layersReady = Promise.all(requiredLayerKeys().map((key) => refreshLayerOptions(key, location)));
      return layersReady;
    }

    // ---- Auto Allot (FIFO) --------------------------------------------------
    // Ticks the reels this job needs, for every layer at once, instead of
    // leaving a picker to read three tables and do the arithmetic by hand.
    // It only ticks checkboxes -- exactly the ones a person could have ticked
    // themselves -- so what gets submitted, validated and saved is unchanged
    // (POST /labels/production/assign/:id neither knows nor cares that a pick
    // came from here). Nothing is reserved until Assign & Continue.
    //
    // The rule, in order:
    //
    //   1. Only reels that can actually be mounted. A reel with no invoice is
    //      unpickable on this page already (the row is disabled -- an inward
    //      without an invoice is treated as provisional), and a web reel
    //      NARROWER than the width this job is budgeted at physically cannot
    //      carry it however many metres it holds. Both are skipped and both
    //      are named in the summary rather than silently dropped.
    //   2. Exact width before wider. A 1020 mm reel run for a 660 mm web
    //      loses 360 mm to trim for the whole length of the job -- far more
    //      material than any FIFO gain is worth. So reels that match the web
    //      exactly go first, and wider ones are only reached once those run
    //      out. (A drum has no width, so the adhesive pool is one tier.)
    //   3. FIFO within a tier -- oldest Inward Date first, falling back to
    //      when the record was created for a reel that has none. This is the
    //      point of the button: paper ages, and the oldest reel of an
    //      otherwise identical spec is the one that should move.
    //   4. Stop as soon as the layer is covered on BOTH sides, kg and R.Mtrs
    //      -- the same two-sided test the progress bars above run. Picking
    //      past that would lock reels this job cannot use away from every
    //      other order (the raw-stock picker hides a reel another open order
    //      holds).
    //   5. Every layer matched to the SHORTEST one. If the release liner at
    //      this location only covers 23,000 of the 26,260 R.Mtrs the batch
    //      needs, then 23,000 is all that can be laminated, whatever else is
    //      in stock -- so the facestock and adhesive are allotted for 23,000
    //      too, and the rest stays free for other orders. The summary says
    //      which layer set the limit and by how much the job falls short;
    //      untick "Match layers to the shortest" to allot every layer the
    //      full requirement regardless.
    //
    // A layer with NOTHING pickable (no binding configured, nothing matching
    // in stock) can't set a limit -- scaling every other layer to zero would
    // just allot nothing at all -- so it is left out of the arithmetic and
    // reported as a blocker instead: the job cannot run until it is sorted
    // out, and the summary says so in as many words.
    const rmaRun = document.getElementById("rmaRun");
    const rmaClear = document.getElementById("rmaClear");
    const rmaBalance = document.getElementById("rmaBalance");
    const rmaBody = document.getElementById("rmaBody");

    const rmaShowError = (msg) => { rmaBody.innerHTML = `<div class="rma-err">${escAttr(msg)}</div>`; };

    // What this layer has to cover, straight off the Raw Material Required
    // strip -- the same two figures its progress bar is measured against, so
    // the button can never aim at a different number than the page shows.
    function layerNeed(layerKey) {
      const cell = needCellFor(layerKey);
      if (!cell) return null;
      const kg = Number(cell.dataset.needKg);
      const mtrs = Number(cell.dataset.needMtrs);
      return {
        kg: Number.isFinite(kg) && kg > 0 ? kg : null,
        mtrs: Number.isFinite(mtrs) && mtrs > 0 ? mtrs : null,
        title: cell.querySelector(".rm-need-label")?.textContent || LAYER_META[layerKey].label,
      };
    }

    // Oldest first. Inward Date is the real arrival (backdatable at inward --
    // see the field's comment on models/inventory/facestockStock.js);
    // createdAt is only when the row was typed in, so it is the fallback, not
    // the key. A reel with neither sorts last rather than first: an unknown
    // age is not evidence of being old.
    function reelFifoTime(r) {
      const t = Date.parse(r.inwardDate || "");
      if (Number.isFinite(t)) return t;
      const c = Date.parse(r.createdAt || "");
      return Number.isFinite(c) ? c : Number.POSITIVE_INFINITY;
    }

    // Splits this layer's fetched reels into the ones Auto Allot may pick,
    // in the order it will pick them, and the ones it won't -- each with the
    // reason, which the summary prints. Nothing is dropped quietly.
    function autoCandidates(layerKey) {
      // The same list the table shows -- so the button can never tick a reel
      // the operator cannot see, nor plan against one.
      const reels = visibleReelsFor(layerKey, checkedIdsFor(layerKey));
      const usable = [];
      const skipped = [];
      reels.forEach((r) => {
        const kg = reelKg(r);
        const mtrs = reelMtrs(r, layerKey);
        if (!r.invoiceNo) { skipped.push({ r, why: "no invoice recorded" }); return; }
        if (reelTooNarrow(r, layerKey)) {
          skipped.push({ r, why: `${fmtNum(numOr(r.size))} mm — narrower than every web this batch runs` });
          return;
        }
        if (kg == null) { skipped.push({ r, why: "no kg recorded" }); return; }
        // Length is half of what a layer is measured on, so a reel whose
        // metres cannot be worked out cannot be allotted against a metre
        // requirement without guessing. Tick it by hand if you know better.
        if (mtrs == null) { skipped.push({ r, why: "no GSM/width to work a length from" }); return; }
        usable.push({ r, kg, mtrs, width: isAdhesiveLayer(layerKey) ? null : numOr(r.size), t: reelFifoTime(r) });
      });
      // Left unsorted: which reel comes first depends on the WEB it is being
      // considered for (an exact fit for that width goes before a wider one),
      // and that is per demand -- planRawAllotment's orderFor() does it.
      return { usable, skipped };
    }

    const rmaFmt = (n) => fmtNum(Math.round(n * 100) / 100);
    const rmaPct = (f) => `${Math.round(f * 1000) / 10}%`;

    function autoAllot() {
      const layerKeys = requiredLayerKeys();
      if (!currentMachineLocation()) {
        rmaShowError("Select a machine first — the reel lists are scoped to its location.");
        return;
      }
      if (!document.querySelector(".rm-need-cell[data-layer]")) {
        rmaShowError("This batch has no deckle size or running metres yet, so there is nothing to allot against. Set the deckle on the Deckle Set page first.");
        return;
      }

      if (typeof planRawAllotment !== "function") {
        rmaShowError("Auto Allot's planner (/js/rawAutoAllot.js) didn't load. Reload the page, or tick the reels by hand.");
        return;
      }

      // ---- 1. measure: what each layer needs, and what it can choose from ---
      // Everything measured here (a reel's weight, the length that gives, how
      // much of the requirement belongs to each web) is this page's business;
      // the choosing is planRawAllotment's. See public/js/rawAutoAllot.js.
      //
      // The requirement is split ACROSS THE WEBS the batch actually runs,
      // because a reel can only be mounted for a web it is wide enough for.
      // The split is by share, so the parts still add up to exactly the
      // figures on the Raw Material Required strip above and the bars and this
      // panel can never disagree:
      //   metres -- by each width's share of the running metres;
      //   kg     -- by each width's share of the area (a wider web eats more
      //             paper per metre, so it is area, not length, that carries
      //             the weight).
      const totalWebMtrs = WEB_WIDTHS.reduce((a, x) => a + (x.mtrs || 0), 0);
      const totalWebArea = WEB_WIDTHS.reduce((a, x) => a + (x.w / 1000) * (x.mtrs || 0), 0);
      const demandsFor = (need, layerKey) => {
        // A drum has no width and coats whatever web is running, so the
        // adhesive states ONE demand for the whole job. Splitting it per web
        // would round a part-drum up once per width and lock drums the job
        // never needed.
        if (isAdhesiveLayer(layerKey) || !WEB_WIDTHS.length || !(totalWebMtrs > 0)) {
          return [{
            width: isAdhesiveLayer(layerKey) ? null : jobWidthMm(),
            webs: TOTAL_WEBS, kg: need?.kg ?? null, mtrs: need?.mtrs ?? null,
          }];
        }
        return WEB_WIDTHS.map((x) => ({
          width: x.w,
          webs: x.webs,
          kg: need?.kg != null && totalWebArea > 0
            ? Math.round(need.kg * (((x.w / 1000) * (x.mtrs || 0)) / totalWebArea) * 100) / 100 : null,
          mtrs: need?.mtrs != null
            ? Math.round(need.mtrs * ((x.mtrs || 0) / totalWebMtrs) * 100) / 100 : null,
        }));
      };

      const input = layerKeys.map((key) => {
        const need = layerNeed(key);
        const { usable, skipped } = autoCandidates(key);
        return {
          key,
          pool: LAYER_META[key].pool,
          label: need?.title || LAYER_META[key].label,
          demands: demandsFor(need, key),
          reels: usable.map((c) => ({
            id: c.r._id, rollId: c.r.rollId || "", kg: c.kg, mtrs: c.mtrs, width: c.width, time: c.t,
          })),
          skipped: skipped.map((s) => ({ rollId: s.r.rollId || "—", why: s.why })),
        };
      });
      if (input.every((L) => L.demands.every((d) => d.kg == null && d.mtrs == null))) {
        rmaShowError("No layer has a requirement to allot against — the Raw Material Required strip is empty.");
        return;
      }

      // ---- 2. plan -----------------------------------------------------------
      const plan = planRawAllotment({ layers: input, balance: !!rmaBalance.checked });

      // ---- 3. tick what it picked --------------------------------------------
      let replaced = 0;
      AUTO_PICKED.clear();
      plan.layers.forEach((L) => {
        const boxes = Array.from(document.querySelectorAll(
          `#rawLayersGrid input[type="checkbox"][name="rawLayers[${L.key}]"]`,
        ));
        const want = new Set(L.picked.map((r) => r.id));
        boxes.forEach((el) => {
          if (el.checked && !want.has(el.value)) replaced += 1;
          el.checked = want.has(el.value);
        });
        want.forEach((id) => AUTO_PICKED.add(`${L.key}|${id}`));
        renderLayerRows(L.key);                 // re-render so the picked rows carry their flag
      });
      updateRawNeed();

      plan.replaced = replaced;
      renderAutoSummary(plan);
    }

    // What the run did and, just as importantly, what it could not do. Every
    // figure here is read back off the reels actually ticked, not off the plan
    // that chose them -- so it says what the form will submit.
    function renderAutoSummary(plan) {
      const { layers, balance, blockedLayers, shortLayers, jobNeedMtrs, runMtrs, totalReels } = plan;
      const fullyCovered = !blockedLayers.length && !shortLayers.length;
      const names = (list) => list.map((L) => L.label).join(", ");

      const chip = (k, v, cls) =>
        `<div class="rma-stat"><span class="k">${escAttr(k)}</span><span class="v${cls ? " " + cls : ""}">${v}</span></div>`;
      const runCls = runMtrs <= 0 ? "bad" : runMtrs >= jobNeedMtrs - 0.01 ? "good" : "warn";

      // The widths that could not be fully served, and what stopped each one
      // -- "635 mm (Release Liner)". On a single-width batch this reads as it
      // always did; on a mixed-web one it is the only honest answer, since a
      // shortage at one width says nothing about the others.
      const limitText = blockedLayers.length
        ? names(blockedLayers)
        : plan.limitWidths.length
          ? plan.limitWidths.map((W) =>
              `${W.width != null ? `${fmtNum(W.width)} mm` : "job"}${W.limitLabels.length ? ` (${W.limitLabels.join(", ")})` : ""}`).join(", ")
          : "nothing";

      const chips = [
        chip("Job needs", `${rmaFmt(jobNeedMtrs)} R.Mtrs`),
        chip("Can run", `${rmaFmt(runMtrs)} R.Mtrs`, runCls),
        chip("Covered", rmaPct(jobNeedMtrs > 0 ? Math.min(1, runMtrs / jobNeedMtrs) : 1), runCls),
        chip("Limited by", escAttr(limitText),
          blockedLayers.length ? "bad" : plan.limitWidths.length ? "warn" : "good"),
        chip("Reels ticked", `${totalReels}`),
      ].join("");

      const of = (v) => ` <span style="color:#94a3b8;font-weight:600;">of ${rmaFmt(v)}</span>`;
      const rows = layers.map((L) => {
        const tag = L.blocked
          ? `<span class="rma-tag none">nothing to allot</span>`
          : L.covered >= 0.9999
            ? `<span class="rma-tag ok">covered</span>`
            : `<span class="rma-tag short">${rmaPct(L.covered)}</span>`;
        return `<tr>
          <td class="rma-layer">${escAttr(L.label)}</td>
          <td>${tag}</td>
          <td class="ta-r">${L.picked.length}</td>
          <td class="ta-r">${rmaFmt(L.got.kg)}${L.need.kg != null ? of(L.need.kg) : ""}</td>
          <td class="ta-r">${rmaFmt(L.got.mtrs)}${L.need.mtrs != null ? of(L.need.mtrs) : ""}</td>
          <td class="rma-reels">${
            !L.picked.length ? "—"
              : L.byWidth.length > 1
                // Which reel is for which web -- on a mixed-web batch a flat
                // list of Roll IDs hides the one thing that matters about it.
                ? L.byWidth.filter((W) => W.picked.length).map((W) =>
                    `<b>${W.width != null ? fmtNum(W.width) + " mm" : "any"}</b> (${W.webs}): `
                    + W.picked.map((r) => escAttr(r.rollId || "—")).join(", ")).join("<br>")
                : L.picked.map((r) => escAttr(r.rollId || "—")).join(", ")
          }</td>
        </tr>`;
      }).join("");

      // ---- the notes: every reason this run went the way it did ------------
      // `text` is escaped on the way out; `html` is for the one note that
      // needs a link (the adhesive binding page it tells you to go and set).
      const notes = [];

      blockedLayers.forEach((L) => {
        const tail = ` This job cannot be laminated until it is, whatever the other layers hold.`;
        if (L.key.startsWith("adhesive") && layerHasBindingCache[L.key] === false) {
          notes.push({
            cls: "is-bad",
            html: `${escAttr(L.label)}: NOTHING could be allotted — no adhesive binding is configured for this Label Stock.`
              + ` Set one at <a href="/app/form/label-stock-adhesive-binding" target="_blank" rel="noopener">Label Stock Adhesive Binding</a>, then run this again.`
              + escAttr(tail),
          });
          return;
        }
        const why = L.reels.length
          ? "its reels were all needed by another layer of the same material"
          : L.skipped.length
            ? "every reel matching it at this location was unusable (see below)"
            : "nothing matching it is in stock at this location";
        notes.push({ cls: "is-bad", text: `${L.label}: NOTHING could be allotted — ${why}.${tail}` });
      });

      // Short, and short AT WHICH WEB -- "enough for the 510 mm webs, 2 of the
      // 15 at 635 mm" is what a planner can act on; a single percentage of the
      // batch is not, and on a mixed-web job it is not even true.
      shortLayers.forEach((L) => {
        const perWeb = L.shortWidths.map((W) => {
          const web = W.width != null ? `${fmtNum(W.width)} mm` : "this job";
          const canRun = Math.floor(W.webs * W.covered);
          return W.none
            ? `nothing wide enough for the ${web} ${W.webs === 1 ? "web" : "webs"} (${W.webs})`
            : `only ${canRun} of the ${W.webs} ${web} ${W.webs === 1 ? "web" : "webs"} (${rmaPct(W.covered)})`;
        });
        notes.push({
          cls: "is-warn",
          text: `${L.label} is short — ${perWeb.join("; ")}.`
            + ` Ticked ${rmaFmt(L.got.mtrs)} of ${rmaFmt(L.need.mtrs || 0)} R.Mtrs`
            + ` (${rmaFmt(L.got.kg)} of ${rmaFmt(L.need.kg || 0)} kg).`
            + (L.leftOver <= 0
              ? ` Every usable reel of it at this location is already ticked; the rest has to be bought in or found elsewhere.`
              : ` ${L.leftOver} more usable ${L.leftOver === 1 ? "reel is" : "reels are"} on the shelf, but not of a width that closes this gap.`),
        });
      });

      // Why the layers that WEREN'T short got less than the order calls for --
      // the one thing about this run that looks like a bug until it is said out
      // loud (facestock reading "80%" with a shelf full of it). Stated in reels
      // actually held back, not as a percentage: whole reels mean a layer often
      // comes out at the same pick either way, and claiming a layer was cut
      // back when it wasn't is how a button like this loses trust.
      if (balance && plan.heldBackLayers.length) {
        notes.push({
          cls: "",
          text: `${plan.heldBackLayers.map((L) => `${L.label} (${L.heldBackReels} ${L.heldBackReels === 1 ? "reel" : "reels"}, ${rmaFmt(L.heldBackMtrs)} R.Mtrs)`).join(", ")}`
            + ` held back: only ${rmaFmt(runMtrs)} of ${rmaFmt(jobNeedMtrs)} R.Mtrs can be laminated — as much as`
            + ` ${limitText} allows — so the rest stays free for other orders`
            + ` instead of being locked to a job that cannot use it.`
            + ` Untick “Match layers to the shortest” to allot the full requirement anyway.`,
        });
      }

      if (!balance) {
        notes.push({ cls: "", text: `Matching to the shortest layer is off — every layer was allotted the batch's full requirement wherever the stock was there to do it.` });
      }

      // Deliberately NOT listed here: which reels were skipped and why, how
      // many were left on the shelf, and a restatement of the rule the button
      // follows. They were noise -- true, but nothing anyone acts on, and they
      // buried the two lines that matter (what is short, and what was held
      // back). A skipped reel's reason is still on its own row's tooltip, and
      // the count of reels not shown at all is under the column heading.

      if (plan.replaced) {
        notes.push({ cls: "", text: `${plan.replaced} ${plan.replaced === 1 ? "reel that was" : "reels that were"} ticked before this run ${plan.replaced === 1 ? "is" : "are"} no longer ticked. Nothing is saved until Assign & Continue.` });
      }

      if (WEB_WIDTHS.length > 1) {
        notes.push({
          cls: "",
          text: `This batch runs ${WEB_WIDTHS.map((x) => `${fmtNum(x.w)} mm × ${x.webs}`).join(" + ")}.`
            + ` A reel can only be mounted for a web it is at least as wide as, so the requirement was split`
            + ` across those widths and each was allotted its own reels — widest web first, since those have`
            + ` the least to choose from.`,
        });
      }

      // The per-layer table is the detail behind the chips, not the headline --
      // three rows of Roll IDs that are worth reading once a run looks wrong,
      // so it is folded away and opened on demand. Nothing that has to be seen
      // lives only in here: the chips above carry what can be run and what
      // limited it, and every problem is spelled out in the notes below.
      const layerWord = layers.length === 1 ? "layer" : "layers";
      const reelWord = totalReels === 1 ? "reel" : "reels";
      rmaBody.innerHTML =
        `<div class="rma-result">${chips}</div>`
        + `<details class="rma-detail"><summary>`
        + `<i class="fa-solid fa-chevron-right rma-caret"></i>Per-layer detail`
        + `<span class="rma-detail-sub">${layers.length} ${layerWord} · ${totalReels} ${reelWord} ticked</span>`
        + `</summary>`
        + `<table class="rma-table"><thead><tr>`
        + `<th>Layer</th><th>Status</th><th class="ta-r">Reels</th><th class="ta-r">Kg</th><th class="ta-r">R.Mtrs</th><th>Ticked</th>`
        + `</tr></thead><tbody>${rows}</tbody></table></details>`
        + `<div class="rma-notes"><ul>${notes
            .map((n) => `<li${n.cls ? ` class="${n.cls}"` : ""}>${n.html || escAttr(n.text)}</li>`)
            .join("")}</ul></div>`;

      if (typeof showToast === "function") {
        showToast(
          blockedLayers.length
            ? `Auto Allot: ${totalReels} reel(s) ticked, but ${names(blockedLayers)} could not be allotted at all — read the summary.`
            : fullyCovered
              ? `Auto Allot: ${totalReels} reel(s) ticked — every layer covered for the full ${rmaFmt(jobNeedMtrs)} R.Mtrs.`
              : `Auto Allot: ${totalReels} reel(s) ticked — only ${rmaFmt(runMtrs)} of ${rmaFmt(jobNeedMtrs)} R.Mtrs can be run. Read the summary.`,
          blockedLayers.length || !fullyCovered ? "error" : "success",
        );
      }
    }

    rmaRun.addEventListener("click", async () => {
      rmaRun.disabled = true;
      const label = rmaRun.innerHTML;
      rmaRun.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i> Allotting…`;
      try {
        await layersReady;                     // the columns must be loaded before they can be planned against
        autoAllot();
      } catch (err) {
        rmaShowError("Auto Allot could not read the reel lists. Tick the reels by hand, or re-select the machine and try again.");
      } finally {
        rmaRun.disabled = false;
        rmaRun.innerHTML = label;
      }
    });

    // Un-ticks every layer -- the way back from a run that picked the wrong
    // thing, without reloading the page and losing the machine/operator.
    rmaClear.addEventListener("click", () => {
      AUTO_PICKED.clear();
      requiredLayerKeys().forEach((key) => {
        document.querySelectorAll(`#rawLayersGrid input[type="checkbox"][name="rawLayers[${key}]"]`)
          .forEach((el) => { el.checked = false; });
        renderLayerRows(key);
      });
      updateRawNeed();
      rmaBody.innerHTML = "";
    });

    // Checkbox rows are click-to-select on the whole row, matching the Rolls
    // table above. Each layer can hold more than one reel checked at once --
    // there's no single-select enforcement -- so this just toggles whichever
    // row was clicked, same as clicking its checkbox directly.
    // A tick re-renders that column, which is what lifts the reel to the top
    // of its table (see sortedReelsFor). The row under the cursor moves, but a
    // pinned block of picks is worth more than a row staying put: this column
    // can be fifty reels long, and a pick two thirds of the way down it was
    // invisible from the top of the page.
    const layerKeyOf = (el) => (el?.name || "").match(/^rawLayers\[(.+)\]$/)?.[1] || null;

    document.getElementById("rawLayersGrid").addEventListener("click", (e) => {
      if (e.target.closest("input[type='checkbox']")) return; // browser toggles it natively
      if (e.target.closest("[data-show-others]")) return;     // the width badge, handled below
      const row = e.target.closest(".raw-layer-table tbody tr");
      const checkbox = row?.querySelector("input[type='checkbox']");
      if (checkbox && !checkbox.disabled) {
        checkbox.checked = !checkbox.checked;
        // Set in code, so no "change" event fires -- retally by hand.
        const key = layerKeyOf(checkbox);
        if (key) renderLayerRows(key); else updateRawNeed();
      }
    });

    document.getElementById("rawLayersGrid").addEventListener("change", (e) => {
      if (!e.target.matches("input[type='checkbox']")) return;
      const key = layerKeyOf(e.target);
      if (key) renderLayerRows(key); else updateRawNeed();
    });

    // The "N in other widths" badge under a column heading -- reveals the
    // reels this deckle's own web width filtered out, and hides them again.
    document.getElementById("rawLayersGrid").addEventListener("click", (e) => {
      const btn = e.target.closest("[data-show-others]");
      if (!btn) return;
      const key = btn.dataset.showOthers;
      showOtherWidths[key] = !showOtherWidths[key];
      renderLayerRows(key);
    });

    // Clicking a column heading sorts that table by it -- ascending on the
    // first click, descending on the next, and it stays on that column until
    // another heading is clicked. Only the rows are rebuilt, so whatever is
    // ticked stays ticked (renderLayerRows carries the checked ids across)
    // and the column's own filter is re-applied on the way out.
    document.getElementById("rawLayersGrid").addEventListener("click", (e) => {
      const th = e.target.closest("th[data-sort]");
      if (!th) return;
      const layerKey = th.closest(".raw-layer-col")?.dataset.layer;
      if (!layerKey) return;
      const colKey = th.dataset.sort;
      const current = layerSort[layerKey];
      const dir = current && current.colKey === colKey && current.dir === 1 ? -1 : 1;
      layerSort[layerKey] = { colKey, dir };
      renderLayerRows(layerKey);
    });

    // Typing in a column's search box filters that column alone. Delegated,
    // since the columns are built (and their rows rebuilt) after this runs.
    // "input" covers the native clear (x) button on type=search as well as
    // typing; Enter inside it would otherwise submit the assign form.
    document.getElementById("rawLayersGrid").addEventListener("input", (e) => {
      const searchEl = e.target.closest(".raw-layer-search");
      if (searchEl) filterLayerRows(searchEl.dataset.search);
    });
    document.getElementById("rawLayersGrid").addEventListener("keydown", (e) => {
      if (e.key === "Enter" && e.target.closest(".raw-layer-search")) e.preventDefault();
    });

    // Build the columns once -- they don't change shape after load, only
    // their reel options do, as the machine changes. Both header rows stick
    // together as one block now (see `.raw-layer-table thead` above), so
    // there's no offset to measure or keep in sync on resize/font-load
    // anymore -- the browser just handles it.
    document.getElementById("rawLayersGrid").innerHTML =
      requiredLayerKeys().map((key) => layerColumnHtml(key, LAYER_META[key])).join("");

    machineSelectEl.addEventListener("change", () => {
      // A different machine is a different location, so the reels the last
      // Auto Allot run reported are no longer the reels on offer -- drop the
      // summary rather than leave one describing another store's stock.
      AUTO_PICKED.clear();
      rmaBody.innerHTML = "";
      refreshAllLayerOptions();
    });
    // Covers re-opening an order that already has a machine assigned --
    // Choices.js's setChoiceByValue() (used below to restore ASSIGNED.machineId)
    // isn't guaranteed to fire a "change" event the way a real user pick does,
    // so run this once unconditionally rather than depending on that.
    refreshAllLayerOptions();

    // Submits straight away -- no Kg-to-produce quantity or "some layers
    // unallocated" gate anymore, since this page only records which reels
    // are allotted (see the doc comment above #rawLayersGrid); a partial
    // pick, or none at all, is always a fine thing to submit.
    const assignForm = document.getElementById("assign-form");
    const assignSubmitBtn = document.getElementById("assignSubmitBtn");
    assignSubmitBtn.addEventListener("click", () => assignForm.requestSubmit());

    // ---- Deckle Size dialog ----
    // Opens automatically, before anything else on this page is worth
    // acting on -- purely a client-side convenience, never submitted: it
    // just echoes onto the Material Details card above and pre-fills the
    // Size filter box on every Facestock/Release Liner allotment column
    // (whichever layer keys this recipe actually has -- DOUBLE FACESTOCK
    // adds facestock2, DOUBLE RELEASE adds releaseLiner2), so picking the
    // right-width reel doesn't need re-typing the size once a machine is
    // chosen and those columns' reels are fetched. No close button/backdrop
    // -dismiss -- there's nothing sensible to fall back to unanswered.
    const deckleSizeDialog = document.getElementById("deckleSizeDialog");
    const deckleSizeInput = document.getElementById("deckleSizeInput");
    const deckleSizeError = document.getElementById("deckleSizeError");
    const deckleSizeConfirmBtn = document.getElementById("deckleSizeConfirmBtn");

    // `echoOntoCard` is false when the card already says something better than
    // this single number -- a mixed-web batch prints every width it runs, and
    // overwriting that with the headline `deckleSize` hid two thirds of the
    // plan behind one figure (and then the table flagged the reels for those
    // hidden webs as "too narrow", which is how this came to light).
    //
    // `seedFilters` types the size into each column's Size filter box. That is
    // only worth doing when the tables are NOT already narrowed to this
    // batch's web (reelFitsBatchWeb) -- i.e. a legacy batch with no layouts
    // and no recorded widths. Everywhere else every listed reel is already
    // that size, and pre-filling the box just looked like a filter someone
    // had left on.
    function applyDeckleSize(value, { echoOntoCard = true, seedFilters = true } = {}) {
      if (echoOntoCard) document.getElementById("midDeckleSize").textContent = value;
      if (!seedFilters) return;
      requiredLayerKeys().forEach((key) => {
        const pool = LAYER_META[key].pool;
        if (pool !== "facestock" && pool !== "release") return;
        const box = document.querySelector(`.raw-layer-col[data-layer="${key}"] .raw-layer-search[data-col="size"]`);
        if (!box) return;
        box.value = value;
        filterLayerRows(key);
      });
    }

    function confirmDeckleSize() {
      const value = deckleSizeInput.value.trim();
      if (!value) {
        deckleSizeError.textContent = "Enter the deckle size to continue.";
        deckleSizeInput.focus();
        return;
      }
      deckleSizeError.textContent = "";
      applyDeckleSize(value);
      deckleSizeDialog.classList.remove("show");
      deckleSizeDialog.setAttribute("aria-hidden", "true");
    }

    deckleSizeConfirmBtn.addEventListener("click", confirmDeckleSize);
    deckleSizeInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") { e.preventDefault(); confirmDeckleSize(); }
    });

    // Normal case: the Deckle Set page already chose this order's size
    // (see pp.deckleSize) before it ever reached Assign Production, so just
    // apply it straight away -- no dialog. Only a legacy order that got here
    // without one (assigned before Deckle Set existed) still gets asked.
    //
    // A MIXED-WEB batch gets no size filter at all. Seeding one width there
    // hides the reels for every other width the plan runs -- on a 660 x 8 +
    // 635 x 15 + 510 x 3 batch it left only the 635 mm reels visible, and
    // those are precisely the ones a single-width reading of the plan then
    // called too narrow. All three widths are reels this job needs, so all
    // three have to be pickable; the widths are on the card above and in
    // every row's tooltip instead.
    const existingDeckleSize = <%- safeJson(pp.deckleSize ?? null) %>;
    const MIXED_WEBS = <%- safeJson(!!mixedWebs) %>;
    if (existingDeckleSize && !MIXED_WEBS) {
      applyDeckleSize(existingDeckleSize, { seedFilters: !WEB_WIDTHS.length });
    } else if (existingDeckleSize) {
      // Mixed webs: leave both the card and the Size filters alone.
    } else {
      deckleSizeDialog.classList.add("show");
      deckleSizeDialog.setAttribute("aria-hidden", "false");
      deckleSizeInput.focus();
    }
  });
</script>
