<% layout('/layout/boilerplate') -%>

<style>
  :root {
    --primary: #044a78;
    --secondary: #2c3e50;
    --accent: #3498db;
    --bg-light: #f8fafc;
    --border: #e2e8f0;
  }

  .vendor-profile-container {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 100%;
    margin: 0 auto;
  }

  /* ---------- Header ---------- */
  .profile-header-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .header-top {
    background: var(--primary);
    color: white;
    padding: 15px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
  }

  .header-info h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
  }

  .header-badges {
    display: flex;
    gap: 8px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  .badge {
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .badge-status { background: #2ecc71; color: white; }
  .status-inactive { background: #e74c3c; }
  .badge-commodity {
    background: rgba(255, 255, 255, 0.18);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.35);
    letter-spacing: 0.02em;
  }

  .edit-btn {
    color: var(--primary);
    background: white;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 16px;
    border-radius: 6px;
    transition: background 0.2s;
    white-space: nowrap;
    border: none;
    cursor: pointer;
  }

  .edit-btn:hover { background: #f1f5f9; }

  .info-section {
    padding: 20px 25px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 40px;
    flex-wrap: nowrap;
    overflow-x: auto;
    background: #fcfcfc;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    white-space: nowrap;
  }

  .info-label {
    font-size: 11px;
    color: #64748b;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.025em;
  }

  .info-value {
    font-size: 15px;
    color: #1e293b;
    font-weight: 500;
  }

  /* ---------- Section shell ---------- */
  .section-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .section-header {
    background: #f1f5f9;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .section-header h2 {
    margin: 0;
    font-size: 16px;
    color: var(--primary);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-count {
    background: var(--primary);
    color: white;
    padding: 2px 10px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
  }

  .header-action-btn {
    background: var(--primary);
    color: white;
    border: none;
    padding: 6px 14px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .header-action-btn:hover { background: #033a5e; }

  .empty-state {
    padding: 36px 20px;
    text-align: center;
    color: #94a3b8;
    font-size: 14px;
  }

  .empty-state i {
    font-size: 28px;
    margin-bottom: 10px;
    display: block;
    opacity: 0.7;
  }

  /* ---------- Supply tabs ---------- */
  .supply-tabs {
    display: flex;
    gap: 4px;
    padding: 10px 20px 0 20px;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }

  .supply-tab {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }

  .supply-tab:hover { color: var(--primary); }

  /* NOT `.active` -- common.css carries a bare, global
     `.active { background-color: #03365a; }`, which paints any element
     using that class name dark blue. */
  .supply-tab.is-open {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }

  .supply-tab .tab-count {
    background: #e2e8f0;
    color: #475569;
    padding: 1px 8px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
  }

  .supply-tab.is-open .tab-count {
    background: var(--primary);
    color: white;
  }

  .supply-tab.is-empty { opacity: 0.55; }

  .supply-panel { display: none; }
  .supply-panel.is-open { display: block; }

  .table-scroll { overflow-x: auto; }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .spec-table th {
    background: #f8fafc;
    text-align: left;
    padding: 12px 16px;
    font-size: 12.5px;
    color: #334155;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  .spec-table td {
    padding: 11px 16px;
    color: #334155;
    border-bottom: 1px solid #f1f5f9;
    white-space: nowrap;
  }

  .spec-table tbody tr:last-child td { border-bottom: none; }
  .spec-table tbody tr:hover td { background: #f8fafc; }

  .spec-table .cell-primary {
    font-weight: 700;
    color: var(--primary);
  }

  .cell-muted { color: #cbd5e1; }

  /* Rates read as a group at the end of the row: tabular figures so the
     digits line up column to column, and one divider marking where the
     spec stops and the price history starts. */
  .spec-table .cell-rate {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .spec-table .cell-rate-first {
    border-left: 1px solid var(--border);
  }

  .spec-table td.cell-rate { color: #1e293b; font-weight: 600; }

  /* ---------- Coordinator list ---------- */
  .coordinator-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .coordinator-list li { border-bottom: 1px solid #f1f5f9; }
  .coordinator-list li:last-child { border-bottom: none; }

  .coordinator-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }

  .coordinator-row:hover { background: #f8fafc; }

  .coordinator-avatar {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    border-radius: 50%;
    background: #e8f1f8;
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
  }

  .coordinator-main { min-width: 0; flex: 1 1 auto; }

  /* The whole row is already the link to the coordinator's details page, so
     the name is a <span>, not a nested <a> (which HTML doesn't allow) --
     it just carries the link's look so it's obvious the row is clickable. */
  .coordinator-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    display: block;
  }

  .coordinator-row:hover .coordinator-name {
    text-decoration-thickness: 2px;
  }

  .coordinator-name-row {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }

  /* Location, department, phone and email all sit on one wrapping line under
     the name -- read left-to-right with the name instead of being parked
     against the far right edge of a wide row, where they went unnoticed. */
  .coordinator-sub {
    font-size: 12.5px;
    color: #475569;
    margin-top: 5px;
    display: flex;
    gap: 8px 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .coordinator-sub .meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .coordinator-sub .meta i {
    color: var(--primary);
    opacity: 0.65;
    font-size: 11px;
  }

  .coordinator-chevron { color: #cbd5e1; font-size: 13px; }

  /* ---------- Coordinator activity timeline ---------- */
  .coordinator-activity {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 7px;
  }

  .activity-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 100px;
    background: #f1f5f9;
    color: #475569;
    white-space: nowrap;
  }

  .activity-chip.current {
    background: #e7f7ee;
    color: #1a7f45;
  }

  .activity-chip.current i {
    font-size: 7px;
    color: #22c55e;
  }

  .activity-chip.inactive {
    background: #fdecea;
    color: #c0392b;
  }

  .activity-chip.inactive i { font-size: 7px; color: #e74c3c; }

  .activity-chip.ended i { font-size: 9px; color: #94a3b8; }

  @media (max-width: 768px) {
    .info-section { gap: 24px; }
    .coordinator-sub { gap: 4px 12px; }
  }
</style>

<div class="vendor-profile-container">
  <!-- ---------- Header ---------- -->
  <div class="profile-header-card">
    <div class="header-top">
      <div class="header-info">
        <h1 style="display:inline-flex;align-items:center;gap:8px;"><%= vendor.vendorName %><span id="vendor-verified-badge"></span></h1>
        <div class="header-badges">
          <span class="badge badge-status <%= vendor.vendorStatus !== 'ACTIVE' ? 'status-inactive' : '' %>">
            <%= vendor.vendorStatus %>
          </span>
          <% (vendor.commodities || []).forEach(commodity => { %>
            <span class="badge badge-commodity"><%= commodity %></span>
          <% }) %>
        </div>
      </div>
      <button type="button" class="edit-btn" onclick="openEditVendorDialog()">
        <i class="fa-solid fa-pen"></i> Edit Details
      </button>
    </div>

    <div class="info-section">
      <div class="info-item">
        <span class="info-label">Vendor ID</span>
        <span class="info-value"><%= vendor.vendorId %></span>
      </div>
      <div class="info-item">
        <span class="info-label">H/O Location</span>
        <span class="info-value"><%= vendor.hoLocation %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Warehouse Location</span>
        <span class="info-value"><%= vendor.warehouseLocation || '-' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">GST Number</span>
        <span class="info-value"><%= vendor.vendorGst || '-' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">PAN Number</span>
        <span class="info-value"><%= vendor.vendorPan || '-' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">MSME ID</span>
        <span class="info-value"><%= vendor.vendorMsme || '-' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Gumasta ID</span>
        <span class="info-value"><%= vendor.vendorGumasta || '-' %></span>
      </div>
    </div>
  </div>

  <!-- ---------- Coordinators ---------- -->
  <div class="section-card">
    <div class="section-header">
      <h2>
        <i class="fa-solid fa-user-tie"></i> Coordinators
        <span class="section-count"><%= (vendor.users || []).length %></span>
      </h2>
      <button
        class="header-action-btn"
        onclick="window.location.href='/app/vendor/coordinator/view?new=coordinator&vendorName=<%= encodeURIComponent(vendor.vendorName) %>'"
      >
        <i class="fa-solid fa-plus"></i> Add Coordinator
      </button>
    </div>

    <%
      const fmtDay = (value) => {
        if (!value) return "—";
        const d = new Date(value);
        return Number.isNaN(d.getTime())
          ? "—"
          : d.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
      };
      // Every activation stint, oldest first. Legacy coordinators with no
      // recorded log fall back to a single open stint from the _id timestamp.
      const activityPeriods = (user) => {
        const log = Array.isArray(user.activityLog) ? user.activityLog.slice() : [];
        if (!log.length) {
          const created = user._id && user._id.getTimestamp ? user._id.getTimestamp() : null;
          return [{ from: created, to: (user.coordinatorStatus || "ACTIVE") === "ACTIVE" ? null : created }];
        }
        return log.sort((a, b) => new Date(a.from) - new Date(b.from));
      };
    %>
    <% if ((vendor.users || []).length > 0) { %>
      <ul class="coordinator-list">
        <% vendor.users.forEach(user => { %>
          <li>
            <a class="coordinator-row" href="/app/vendor/coordinator/details/<%= user._id %>">
              <span class="coordinator-avatar"><%= String(user.userName || '?').trim().charAt(0).toUpperCase() %></span>
              <span class="coordinator-main">
                <%
                  const periods = activityPeriods(user);
                  const coordActive = (user.coordinatorStatus || 'ACTIVE') === 'ACTIVE';
                  const openPeriod = periods.find(p => !p.to);
                  const endedPeriods = periods.filter(p => p.to);
                  const lastEnd = endedPeriods.length ? endedPeriods[endedPeriods.length - 1].to : null;
                %>
                <span class="coordinator-name-row">
                  <span class="coordinator-name"><%= user.userName %></span>
                  <% if (coordActive) { %>
                    <span class="activity-chip current">
                      <i class="fa-solid fa-circle"></i>
                      Currently active<% if (openPeriod && openPeriod.from) { %> — since <%= fmtDay(openPeriod.from) %><% } %>
                    </span>
                  <% } else { %>
                    <span class="activity-chip inactive">
                      <i class="fa-solid fa-circle"></i>
                      Inactive<% if (lastEnd) { %> — since <%= fmtDay(lastEnd) %><% } %>
                    </span>
                  <% } %>
                </span>
                <span class="coordinator-sub">
                  <span class="meta"><i class="fa-solid fa-location-dot"></i> <%= user.userLocation || '—' %></span>
                  <span class="meta"><i class="fa-solid fa-briefcase"></i> <%= user.userDepartment || '—' %></span>
                  <span class="meta"><i class="fa-solid fa-phone"></i> <%= user.userContact || '—' %></span>
                  <span class="meta"><i class="fa-solid fa-envelope"></i> <%= user.userEmail || '—' %></span>
                </span>
                <% if (endedPeriods.length) { %>
                  <span class="coordinator-activity">
                    <% endedPeriods.forEach(period => { %>
                      <span class="activity-chip ended">
                        <i class="fa-regular fa-clock"></i> Active <%= fmtDay(period.from) %> – <%= fmtDay(period.to) %>
                      </span>
                    <% }) %>
                  </span>
                <% } %>
              </span>
              <i class="fa-solid fa-chevron-right coordinator-chevron"></i>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="empty-state">
        <i class="fa-solid fa-users-slash"></i>
        No coordinators associated with this vendor yet.
      </div>
    <% } %>
  </div>

  <!-- ---------- Items purchased from this vendor ---------- -->
  <%
    // A blank/zero-less cell renders as a muted dash rather than an empty gap,
    // so a short row still lines up with the header above it.
    const cellText = (value) =>
      value === undefined || value === null || String(value).trim() === "" ? null : String(value);
    // A spec never inwarded yet has no rate at all -- a dash, not "₹0".
    const cellMoney = (value) => {
      const amount = Number(value);
      if (!Number.isFinite(amount) || amount <= 0) return null;
      return "₹" + amount.toLocaleString("en-IN", { maximumFractionDigits: 2 });
    };
    const firstFilled = supplyCategories.find((category) => category.items.length > 0);
  %>
  <div class="section-card">
    <div class="section-header">
      <h2>
        <i class="fa-solid fa-boxes-stacked"></i> Items
        <span class="section-count"><%= supplyTotal %></span>
      </h2>
    </div>

    <% if (supplyTotal === 0) { %>
      <div class="empty-state">
        <i class="fa-solid fa-box-open"></i>
        No facestock, adhesive, release liner or core master has been added against this vendor yet.
      </div>
    <% } else { %>
      <div class="supply-tabs" role="tablist">
        <% supplyCategories.forEach(category => { %>
          <button
            type="button"
            class="supply-tab <%= category.key === firstFilled.key ? 'is-open' : '' %> <%= category.items.length === 0 ? 'is-empty' : '' %>"
            data-panel="supply-panel-<%= category.key %>"
          >
            <i class="fa-solid <%= category.icon %>"></i>
            <%= category.label %>
            <span class="tab-count"><%= category.items.length %></span>
          </button>
        <% }) %>
      </div>

      <% supplyCategories.forEach(category => { %>
        <div
          class="supply-panel <%= category.key === firstFilled.key ? 'is-open' : '' %>"
          id="supply-panel-<%= category.key %>"
        >
          <% if (category.items.length === 0) { %>
            <div class="empty-state">
              <i class="fa-solid <%= category.icon %>"></i>
              No <%= category.label.toLowerCase() %> purchased from this vendor.
            </div>
          <% } else { %>
            <div class="table-scroll">
              <table class="spec-table">
                <thead>
                  <tr>
                    <% category.columns.forEach(column => { %>
                      <th class="<%= column.money ? 'cell-rate' : '' %><%= column.rateGroupStart ? ' cell-rate-first' : '' %>"><%= column.title %></th>
                    <% }) %>
                  </tr>
                </thead>
                <tbody>
                  <% category.items.forEach(item => { %>
                    <tr>
                      <% category.columns.forEach(column => { %>
                        <% const text = column.money ? cellMoney(item[column.field]) : cellText(item[column.field]); %>
                        <td class="<%= column.primary ? 'cell-primary' : '' %><%= column.money ? ' cell-rate' : '' %><%= column.rateGroupStart ? ' cell-rate-first' : '' %>">
                          <% if (text === null) { %>
                            <span class="cell-muted">—</span>
                          <% } else { %>
                            <%= text %>
                          <% } %>
                        </td>
                      <% }) %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } %>
  </div>

</div>

<script>
  document.querySelectorAll(".supply-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".supply-tab").forEach((t) => t.classList.remove("is-open"));
      document.querySelectorAll(".supply-panel").forEach((p) => p.classList.remove("is-open"));
      tab.classList.add("is-open");
      document.getElementById(tab.dataset.panel).classList.add("is-open");
    });
  });
</script>

<script src="/js/verification.js"></script>
<script type="application/json" id="vendor-verified-data"><%- safeJson({ verified: !!vendor.verified, verifiedBy: vendor.verifiedBy || "", verifiedAt: vendor.verifiedAt || null }) %></script>
<script>
  (function () {
    const v = JSON.parse(document.getElementById("vendor-verified-data").textContent);
    document.getElementById("vendor-verified-badge").innerHTML = verifiedBadgeFor(v, 24);
  })();
</script>

<!-- Edit Vendor dialog (opened by "Edit Details" above) -->
<link href="/css/soDialog.css?v=2" rel="stylesheet" />
<%- include('./_editVendorDialog', { vendor }) %>
