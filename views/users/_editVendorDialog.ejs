<%#
  Edit Vendor dialog -- opened by "Edit Details" on /vendor/profile/:id (and by
  old /vendor/edit/:id links, which redirect to /vendor/profile/:id?edit=1).
  Same look as the New Vendor dialog (_vendorDialog.ejs); the Vendor Id is
  fixed. Posts to POST /vendor/edit/:id, which answers JSON (soFormDialog.js
  sends Accept: application/json).
  Styles: /css/soDialog.css (link it from the page). Locals: `vendor` (the
  vendor), `csrfToken`. Choices.js loads with `defer`, so it is created on
  DOMContentLoaded.
%>
<%
  const evdCsrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
  const evdVendor = vendor;

  const evdPredefined = ["FACE PAPER", "ADHESIVE", "RELEASE PAPER", "SL (PAPER)", "PACKAGING", "TTR", "TAPE", "POS ROLL", "TAFFETA", "PRINTERS", "SCANNERS", "SPARES", "CORE", "FOIL", "IT", "DIE", "BLOCK", "COLOR"];
  const evdPredefinedStatuses = ["ACTIVE", "INACTIVE", "BLACKLISTED", "OTHERS"];

  const evdSelected = Array.isArray(evdVendor.commodities)
    ? evdVendor.commodities.map((c) => String(c).toUpperCase())
    : typeof evdVendor.commodities === "string" && evdVendor.commodities
      ? [String(evdVendor.commodities).toUpperCase()]
      : [];

  // "Others" is stored as "OTHERS - <what>" (or, in older rows, as the bare
  // free text): split it back into the OTHERS tag plus its text box.
  const evdOthersSelected = evdSelected.some((c) => c === "OTHERS" || c.startsWith("OTHERS - ") || !evdPredefined.includes(c));
  let evdOtherCommodity = "";
  const evdOtherRaw = evdSelected.find((c) => c.startsWith("OTHERS - ")) || evdSelected.find((c) => !evdPredefined.includes(c) && c !== "OTHERS");
  if (evdOtherRaw) evdOtherCommodity = evdOtherRaw.replace(/^(OTHERS - )+/, "");

  let evdOtherStatus = "";
  let evdStatus = evdVendor.vendorStatus || "";
  if (evdStatus.startsWith("OTHERS - ")) {
    evdOtherStatus = evdStatus.replace(/^(OTHERS - )+/, "");
    evdStatus = "OTHERS";
  } else if (!evdPredefinedStatuses.includes(evdStatus)) {
    evdOtherStatus = evdStatus;
    evdStatus = "OTHERS";
  }
%>
<style>
  #edit-vendor-form {
    height: 760px;
  }
</style>

<div id="edit-vendor-dialog" class="so-dialog-backdrop" aria-hidden="true">
  <form id="edit-vendor-form" class="so-dialog so-dialog--xl" action="/app/vendor/edit/<%= evdVendor._id %>" method="post" autocomplete="off" novalidate data-so-form role="dialog" aria-modal="true" aria-labelledby="evd-title">
    <input type="hidden" name="_csrf" value="<%= evdCsrf %>" />

    <div class="so-dialog__head">
      <span class="so-dialog__icon"><i class="fa-solid fa-pen"></i></span>
      <div>
        <h3 class="so-dialog__title" id="evd-title">Edit Vendor</h3>
        <p class="so-dialog__desc">The Vendor Id is fixed — change everything else.</p>
      </div>
    </div>

    <div class="so-dialog__body">
      <div class="so-dialog__section">Vendor Details</div>
      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="evd-vendor-id">Vendor Id</label>
          <input type="text" id="evd-vendor-id" value="<%= evdVendor.vendorId %>" readonly tabindex="-1" />
        </div>
        <div class="so-dialog__field">
          <label for="evd-vendor-name">Vendor Name <span class="so-req">*</span></label>
          <input type="text" id="evd-vendor-name" name="vendorName" value="<%= evdVendor.vendorName %>" placeholder="Enter Vendor Name" required data-so-autofocus />
        </div>
        <div class="so-dialog__field">
          <label for="evd-vendor-status">Vendor Status <span class="so-req">*</span></label>
          <select name="vendorStatus" id="evd-vendor-status" required>
            <% evdPredefinedStatuses.forEach((s) => { %>
              <option value="<%= s %>" <%= evdStatus === s ? "selected" : "" %>><%= s %></option>
            <% }) %>
          </select>
          <input type="text" name="otherStatus" id="evd-other-status" value="<%= evdOtherStatus %>" placeholder="Please specify status" style="display: <%= evdStatus === 'OTHERS' ? 'block' : 'none' %>; margin-top: 8px;" <%= evdStatus === 'OTHERS' ? 'required' : 'disabled' %> />
        </div>
      </div>
      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="evd-ho-location">H/O Location <span class="so-req">*</span></label>
          <input type="text" id="evd-ho-location" name="hoLocation" value="<%= evdVendor.hoLocation %>" placeholder="Enter H/O Location" required />
        </div>
        <div class="so-dialog__field">
          <label for="evd-warehouse-location">Warehouse Location <span class="so-req">*</span></label>
          <input type="text" id="evd-warehouse-location" name="warehouseLocation" value="<%= evdVendor.warehouseLocation %>" placeholder="Enter Warehouse Location" required />
        </div>
      </div>

      <div class="so-dialog__section">Commodities</div>
      <div class="so-dialog__field">
        <label for="evd-commodities-select">Commodities</label>
        <select name="commodities" id="evd-commodities-select" multiple>
          <% evdPredefined.forEach((c) => { %>
            <option value="<%= c %>" <%= evdSelected.includes(c) ? "selected" : "" %>><%= c %></option>
          <% }) %>
          <option value="Others" <%= evdOthersSelected ? "selected" : "" %>>OTHERS</option>
        </select>
        <input type="text" name="commodities" id="evd-other-commodity" value="<%= evdOtherCommodity %>" placeholder="Please specify Others" style="display: <%= evdOthersSelected ? 'block' : 'none' %>; margin-top: 8px;" <%= evdOthersSelected ? 'required' : 'disabled' %> />
      </div>

      <div class="so-dialog__section">Compliance</div>
      <div class="so-dialog__row">
        <div class="so-dialog__field">
          <label for="evd-vendor-gst">GST <span class="so-req">*</span></label>
          <input type="text" maxlength="15" id="evd-vendor-gst" name="vendorGst" value="<%= evdVendor.vendorGst %>" placeholder="Enter GST" required />
        </div>
        <div class="so-dialog__field">
          <label for="evd-vendor-msme">MSME <span class="so-req">*</span></label>
          <input type="text" maxlength="15" id="evd-vendor-msme" name="vendorMsme" value="<%= evdVendor.vendorMsme %>" placeholder="Enter MSME" required />
        </div>
        <div class="so-dialog__field">
          <label for="evd-vendor-gumasta">Gumasta <span class="so-req">*</span></label>
          <input type="text" id="evd-vendor-gumasta" name="vendorGumasta" value="<%= evdVendor.vendorGumasta %>" placeholder="Enter GUMASTA" required />
        </div>
        <div class="so-dialog__field">
          <label for="evd-vendor-pan">PAN <span class="so-req">*</span></label>
          <input type="text" maxlength="10" id="evd-vendor-pan" name="vendorPan" value="<%= evdVendor.vendorPan %>" placeholder="Enter PAN" required />
        </div>
      </div>
    </div>

    <div class="so-dialog__foot">
      <div style="display: flex; flex-direction: column; gap: 2px; margin: 0 auto 0 0;">
        <label for="evd-verified" style="display: flex; align-items: center; gap: 8px; margin: 0; font-size: 13.5px; font-weight: 600; color: var(--so-ink); cursor: pointer;">
          <input type="checkbox" id="evd-verified" name="verified" value="on" style="width: 16px; height: 16px; accent-color: var(--so-brand);" <%= evdVendor.verified ? "checked" : "" %> />
          Verified &mdash; data checked and approved
        </label>
        <% if (evdVendor.verified) { %>
          <span style="margin-left: 24px; font-size: 12px; color: var(--so-faint);">
            Approved by <%= evdVendor.verifiedBy || "—" %><%= evdVendor.verifiedAt ? " on " + new Date(evdVendor.verifiedAt).toLocaleString("en-IN") : "" %>
          </span>
        <% } %>
      </div>
      <button type="button" class="so-btn so-btn--ghost" onclick="soDialog.close('edit-vendor-dialog')">Cancel</button>
      <button type="submit" class="so-btn so-btn--primary"><i class="fa-solid fa-check"></i> Update Vendor Details</button>
    </div>
  </form>
</div>

<script type="application/json" id="evd-initial"><%- safeJson({ commodities: evdSelected.filter((c) => evdPredefined.includes(c)).concat(evdOthersSelected ? ["Others"] : []) }) %></script>
<script>
  /* ================= EDIT VENDOR: status / commodities / GST -> PAN =====
     Runs on DOMContentLoaded: Choices.js is loaded with `defer`. */
  document.addEventListener("DOMContentLoaded", function () {
    const $ = (id) => document.getElementById(id);
    const form = $("edit-vendor-form");
    const statusSelect = $("evd-vendor-status");
    const otherStatus = $("evd-other-status");
    const commoditiesSelect = $("evd-commodities-select");
    const otherCommodity = $("evd-other-commodity");
    const gstInput = $("evd-vendor-gst");
    const panInput = $("evd-vendor-pan");
    const initial = JSON.parse($("evd-initial").textContent || "{}");
    let commoditiesChoices = null;

    function syncOtherStatus() {
      const on = statusSelect.value === "OTHERS";
      otherStatus.style.display = on ? "block" : "none";
      otherStatus.disabled = !on;
      otherStatus.required = on;
      if (!on) otherStatus.value = "";
    }
    statusSelect.addEventListener("change", syncOtherStatus);

    function syncOtherCommodity() {
      const on = commoditiesChoices ? commoditiesChoices.getValue(true).includes("Others") : false;
      otherCommodity.style.display = on ? "block" : "none";
      otherCommodity.disabled = !on;
      otherCommodity.required = on;
      if (!on) otherCommodity.value = "";
    }
    commoditiesSelect.addEventListener("change", syncOtherCommodity);

    try {
      commoditiesChoices = new Choices(commoditiesSelect, {
        removeItemButton: true,
        searchEnabled: true,
        shouldSort: false,
        placeholder: true,
        placeholderValue: "Select Commodities",
        itemSelectText: "",
      });
    } catch (e) {
      console.error("Commodities Choices initialization failed:", e);
    }

    gstInput.addEventListener("input", function () {
      const gst = this.value.toUpperCase();
      this.value = gst;
      panInput.value = gst.length >= 12 ? gst.substring(2, 12) : "";
      panInput.dispatchEvent(new Event("input"));
      const gstRegex = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;
      this.setCustomValidity(gst.length > 0 && !gstRegex.test(gst) ? "Invalid GST format (e.g., 22AAAAA0000A1Z5)" : "");
    });

    panInput.addEventListener("input", function () {
      const pan = this.value.toUpperCase();
      this.value = pan;
      const panRegex = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;
      this.setCustomValidity(pan.length > 0 && !panRegex.test(pan) ? "Invalid PAN format (e.g., ABCDE1234F)" : "");
    });

    // After a Cancel / re-open the native reset restores the plain inputs
    // (and the saved "specify" text) but not the Choices widget, which
    // doesn't watch its <select>: put the saved commodities back by hand,
    // then re-derive which "specify" boxes show.
    const otherCommodityText = otherCommodity.defaultValue;
    const otherStatusText = otherStatus.defaultValue;
    form.addEventListener("reset", () => {
      commoditiesChoices?.removeActiveItems();
      (initial.commodities || []).forEach((v) => commoditiesChoices?.setChoiceByValue(v));
      setTimeout(() => {
        syncOtherStatus();
        syncOtherCommodity();
        if (statusSelect.value === "OTHERS") otherStatus.value = otherStatusText;
        if (commoditiesChoices?.getValue(true).includes("Others")) otherCommodity.value = otherCommodityText;
      }, 0);
    });

    window.openEditVendorDialog = function () {
      soDialog.open("edit-vendor-dialog");
    };

    const params = new URLSearchParams(window.location.search);
    if (params.get("edit") === "1") {
      window.openEditVendorDialog();
      params.delete("edit");
      const qs = params.toString();
      history.replaceState(null, "", window.location.pathname + (qs ? "?" + qs : ""));
    }
  });
</script>
<script src="/js/soFormDialog.js?v=1"></script>
