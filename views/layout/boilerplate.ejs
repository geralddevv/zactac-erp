      <% if (!isOperator) { %><div class="side-nav-backdrop" id="fdNavBackdrop"></div><% } %>

      <!--- Loading Content --->
      <div class="page-content" id="pageContent"></div>
      <div class="main-content">
        <%- body -%>
      </div>
    </div>

    <script src="/js/common.js?v=pwa-2" defer></script>
    <%# After common.js (defer keeps the order), so the bell's POSTs go through
        that file's CSRF-injecting fetch wrapper. %>
    <script src="/js/notifications.js?v=1" defer></script>
    <script src="/js/navSearch.js" defer></script>
    <script src="/js/pwa.js?v=1" defer></script>
    <script src="/bootstrap/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/BTStrap.js" defer></script>
    <script src="/js/choices.min.js" defer></script>
    <% if(JS) { %>
    <script src="/js/<%= JS %>" defer></script>
    <% } %>

    <script>
      // Instantly hide and remove table spinners after page fully loads
      window.addEventListener("load", () => {
        document.querySelectorAll('.table-spinner').forEach(el => {
          el.remove();
        });
      });

      // Choices.js focus ring: toggle class on focusin/focusout
      document.addEventListener("focusin", (e) => {
        const choicesEl = e.target.closest(".choices");
        if (choicesEl) choicesEl.classList.add("choices--focused");
      });
      document.addEventListener("focusout", (e) => {
        const choicesEl = e.target.closest(".choices");
        if (choicesEl) choicesEl.classList.remove("choices--focused");
      });

      const fdLogout = document.getElementById("fdLogout");
      const logoutModal = document.getElementById("logoutModal");
      const logoutCancel = document.getElementById("logoutCancel");
      
      const fdProfileBtn = document.getElementById("fdProfileBtn");
      const fdProfileMenu = document.getElementById("fdProfileMenu");
      const openPasswordModal = document.getElementById("openPasswordModal");
      const passwordModal = document.getElementById("passwordModal");
      const passwordCancel = document.getElementById("passwordCancel");
      const changePasswordForm = document.getElementById("changePasswordForm");
      const newPasswordInput = document.getElementById("newPasswordInput");
      const submitPasswordBtn = changePasswordForm?.querySelector('button[type="submit"]');

      window.togglePasswordVisibility = function(icon) {
        const input = icon.parentElement.querySelector('input');
        if (input.type === 'password') {
          input.type = 'text';
          icon.classList.remove('fa-eye');
          icon.classList.add('fa-eye-slash');
        } else {
          input.type = 'password';
          icon.classList.remove('fa-eye-slash');
          icon.classList.add('fa-eye');
        }
      };

      if (newPasswordInput) {
        newPasswordInput.addEventListener('input', () => {
          const val = newPasswordInput.value;
          const checks = {
            length: val.length >= 10,
            uppercase: /[A-Z]/.test(val),
            lowercase: /[a-z]/.test(val),
            number: /[0-9]/.test(val),
            special: /[!@#$%^&*(),.?":{}|<>]/.test(val)
          };

          let allMet = true;
          Object.keys(checks).forEach(key => {
            const el = document.querySelector(`.password-requirement[data-req="${key}"]`);
            if (el) {
              if (checks[key]) {
                el.classList.add('met');
                el.querySelector('i').className = 'fa-solid fa-circle-check';
              } else {
                el.classList.remove('met');
                el.querySelector('i').className = 'fa-solid fa-circle';
                allMet = false;
              }
            }
          });

          if (submitPasswordBtn) {
            submitPasswordBtn.disabled = !allMet;
            submitPasswordBtn.style.opacity = allMet ? '1' : '0.6';
            submitPasswordBtn.style.cursor = allMet ? 'pointer' : 'not-allowed';
          }
        });
      }

      if (fdLogout) {
        fdLogout.addEventListener("click", (e) => {
          e.preventDefault();
          if (fdProfileMenu) fdProfileMenu.classList.remove("show");
          if (logoutModal) {
            logoutModal.classList.add("show");
            logoutModal.setAttribute("aria-hidden", "false");
          }
        });
      }

      if (logoutCancel && logoutModal) {
        logoutCancel.addEventListener("click", () => {
          logoutModal.classList.remove("show");
          logoutModal.setAttribute("aria-hidden", "true");
        });
      }

      if (logoutModal) {
        logoutModal.addEventListener("click", (e) => {
          if (e.target === logoutModal) {
            logoutModal.classList.remove("show");
            logoutModal.setAttribute("aria-hidden", "true");
          }
        });
      }

      /* Profile Dropdown Logic */
      if (fdProfileBtn && fdProfileMenu) {
        fdProfileBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          fdProfileMenu.classList.toggle("show");
        });

        document.addEventListener("click", (e) => {
          if (!fdProfileMenu.contains(e.target) && e.target !== fdProfileBtn) {
            fdProfileMenu.classList.remove("show");
          }
        });
      }

      /* Notification Bell: open/close only. The feed itself (count, rows,
         mark-read, polling) is public/js/notifications.js -- see
         NOTIFICATIONS.md. That file is deferred, so it hooks the same button
         after this handler and reads .show to know the panel just opened. */
      const fdNotifBtn = document.getElementById("fdNotifBtn");
      const fdNotifMenu = document.getElementById("fdNotifMenu");
      if (fdNotifBtn && fdNotifMenu) {
        fdNotifBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          if (fdProfileMenu) fdProfileMenu.classList.remove("show");
          // One header dropdown at a time: opening notifications closes the
          // search results (this handler stops propagation, so the search's
          // own outside-click close never sees the click).
          const nsBox = document.getElementById("fdNavSearchResults");
          if (nsBox) nsBox.classList.remove("is-open");
          const nsInput = document.getElementById("fdNavSearch");
          if (nsInput && document.activeElement === nsInput) nsInput.blur();
          fdNotifMenu.classList.toggle("show");
        });
        document.addEventListener("click", (e) => {
          if (!fdNotifMenu.contains(e.target)) fdNotifMenu.classList.remove("show");
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") fdNotifMenu.classList.remove("show");
        });
        if (fdProfileBtn) fdProfileBtn.addEventListener("click", () => fdNotifMenu.classList.remove("show"));
      }

      /* Password Modal Logic */
      if (openPasswordModal) {
        openPasswordModal.addEventListener("click", () => {
          fdProfileMenu.classList.remove("show");
          if (passwordModal) {
            passwordModal.classList.add("show");
            passwordModal.setAttribute("aria-hidden", "false");
          }
        });
      }

      if (passwordCancel && passwordModal) {
        passwordCancel.addEventListener("click", () => {
          passwordModal.classList.remove("show");
          passwordModal.setAttribute("aria-hidden", "true");
        });
      }

      if (passwordModal) {
        passwordModal.addEventListener("click", (e) => {
          if (e.target === passwordModal) {
            passwordModal.classList.remove("show");
            passwordModal.setAttribute("aria-hidden", "true");
          }
        });
      }

      if (changePasswordForm) {
        changePasswordForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const formData = new FormData(changePasswordForm);
          const data = Object.fromEntries(formData.entries());

          try {
            const resp = await fetch("/app/profile/password", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(data)
            });
            const resData = await resp.json();
            if (resData.success) {
              showToast("Password updated successfully", "success");
              passwordModal.classList.remove("show");
              passwordModal.setAttribute("aria-hidden", "true");
              changePasswordForm.reset();
            } else {
              showToast(resData.message || "Failed to update password", true);
            }
          } catch (err) {
            showToast("Server error occurred", true);
          }
        });
      }
    </script>
  </body>
</html>
