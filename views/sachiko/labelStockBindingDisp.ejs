<!-- Link to boilerplate.ejs -->
<% layout('/layout/boilerplate') -%>

<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    #master-table { width: 100%; flex: 1 1 auto; min-height: 0; }
    @keyframes labelStockPopIn {
      from { transform: scale(0.95); opacity: 0; }
      to   { transform: scale(1);    opacity: 1; }
    }
  </style>

  <div class="indi-head">
    <h1>Label Stock Bindings</h1>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table" class="tabulator tabulator-modern"></div>
</div>

<script src="/js/verification.js"></script>
<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<form id="deleteBindingForm" method="POST" style="display:none;"></form>
<div class="logout-modal" id="deleteBindingModal" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="deleteBindingTitle">
    <h2 class="logout-title" id="deleteBindingTitle">Remove binding?</h2>
    <p class="logout-text">This will permanently remove this Label Stock binding.</p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" id="deleteBindingCancel">Cancel</button>
      <button class="logout-btn primary" type="button" id="deleteBindingConfirm">Remove</button>
    </div>
  </div>
</div>

<div class="logout-modal" id="statusBindingModal" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="statusBindingTitle">
    <h2 class="logout-title" id="statusBindingTitle">Change binding status?</h2>
    <p class="logout-text" id="statusBindingText">This will change the binding status.</p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" id="statusBindingCancel">Cancel</button>
      <button class="logout-btn primary" type="button" id="statusBindingConfirm">OK</button>
    </div>
  </div>
</div>

<!-- View Modal -->
<div id="label-stock-view-modal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.55);z-index:10000;justify-content:center;align-items:center;padding:24px;backdrop-filter:blur(4px);">
  <div id="label-stock-view-body" style="background:#fff;border-radius:14px;overflow:hidden;width:min(480px,95vw);box-shadow:0 20px 50px rgba(4,74,120,0.2);animation:labelStockPopIn 0.2s ease-out;"></div>
</div>

<script>
  const raw = <%- safeJson(jsonData) %>;
  const clientName = <%- safeJson(clientName) %>;
  const userName = <%- safeJson(userName) %>;
  const userId = <%- safeJson(userId) %>;

  // Just what's actually entered when the binding is created via the Sales
  // Order form's Product Code/Paper Size/RM flow -- not the full label spec
  // (that lives on the Label Stock master itself, see /sachiko/label-stock/view).
  const tableData = raw.map(binding => {
    const labelStock = binding.labelStock || {};
    return {
      _id: String(binding._id),
      clientName,
      userName,
      productCode: labelStock.productCode || "",
      rollOrSheet: labelStock.rollOrSheet || "",
      paperSize: binding.paperSize || "",
      runningMeters: binding.runningMeters ?? "",
      status: binding.status || "ACTIVE",
      verified: !!binding.verified,
      verifiedBy: binding.verifiedBy || "",
      verifiedAt: binding.verifiedAt || null,
      // Total units actually sent to this client against this binding --
      // summed server-side from every non-cancelled Sales Order's
      // dispatchedQuantity (routes/sachiko/labelStockBinding.js).
      sentQuantity: binding.sentQuantity ?? 0,
      // Last / Lowest / Highest from every Sales Order placed against this
      // binding (server-computed from each order's rate). Undefined when the
      // binding has never been ordered at a real price.
      lastRate: binding.lastRate,
      lowestRate: binding.lowestRate,
      highestRate: binding.highestRate,
    };
  });

  // "₹1,234.50" for a real rate, a muted dash when the binding was never
  // ordered at a price -- mirrors the vendor profile's price history.
  const rateFormatter = (cell) => {
    const amount = Number(cell.getValue());
    if (!Number.isFinite(amount) || amount <= 0) {
      return '<span style="color:#94a3b8;">—</span>';
    }
    return "₹" + amount.toLocaleString("en-IN", { maximumFractionDigits: 2 });
  };

  const withTextFilter = (col) => ({ headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100, ...col });

  const table = new Tabulator("#master-table", {
    data: tableData,
    height: "100%",
    responsiveLayout: false,
    movableColumns: true,
    placeholder: "No Label Stock bindings for this client",
    columns: [
      {
        title: "Actions",
        hozAlign: "center",
        headerHozAlign: "center",
        width: 132,
        minWidth: 132,
        widthGrow: 0,
        widthShrink: 0,
        formatter: function (cell) {
          const row = cell.getRow().getData();
          if (!row._id) return '';
          return `
            <div style="display:flex;align-items:center;justify-content:center;gap:6px;">
              <button
                onclick="viewLabelStockBinding('${row._id}')"
                style="padding:2px 7px;background:#044A78;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                title="View Binding">
                <i class="fa-solid fa-eye"></i>
              </button>
              <button
                onclick="window.location.href='/app/label-stock-binding/edit/${row._id}'"
                style="padding:2px 7px;background:#e67e22;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                title="Edit Binding">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              <button
                onclick="promptToggleStatus('${row._id}', '${row.status || 'ACTIVE'}')"
                style="padding:2px 7px;background:${(row.status || 'ACTIVE') === 'ACTIVE' ? '#28a745' : '#6c757d'};color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                title="${(row.status || 'ACTIVE') === 'ACTIVE' ? 'Set Inactive' : 'Set Active'}">
                <i class="fa-solid ${(row.status || 'ACTIVE') === 'ACTIVE' ? 'fa-toggle-on' : 'fa-toggle-off'}"></i>
              </button>
              <button
                onclick="promptDeleteBinding('${row._id}')"
                style="padding:2px 7px;background:#d9534f;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                title="Remove Binding">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          `;
        },
      },
      {
        title: "Order",
        hozAlign: "center",
        formatter: (cell) => {
          const row = cell.getRow().getData();
          // Must match the salesOrderForm Item Type select's actual option
          // values (ROLL/SHEET) -- "LABEL_STOCK" isn't one of them and left
          // the form's Item Type (and everything downstream of it) unset.
          const itemType = String(row.rollOrSheet || "").toUpperCase();
          return `
            <button
              onclick="window.location.href='/app/sales/order?type=${encodeURIComponent(itemType)}&client=${encodeURIComponent(clientName)}&user=${userId}&item=${row._id}'"
              style="padding:2px 10px;background:#044A78;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">
              <i class="fa-solid fa-cart-plus"></i>
            </button>
          `;
        }
      },
      {
        title: "Status",
        field: "status",
        hozAlign: "center",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        minWidth: 100,
        formatter: (cell) => {
          const val = cell.getValue() || "ACTIVE";
          const bg = val === "ACTIVE" ? "#28a745" : "#dc3545";
          return `<span style="background:${bg};color:#fff;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600;">${val}</span>`;
        },
      },
      withTextFilter({ title: "Client Name", field: "clientName", minWidth: 180 }),
      withTextFilter({ title: "User Name", field: "userName", minWidth: 150 }),
      withTextFilter({ title: "Product Code", field: "productCode", minWidth: 150, formatter: (cell) => `<span style="display:inline-flex;align-items:center;gap:5px;font-weight:700;color:#044a78;">${esc(cell.getValue())}${verifiedBadgeFor(cell.getRow().getData(), 16)}</span>` }),
      withTextFilter({ title: "Size", field: "paperSize", minWidth: 110 }),
      withTextFilter({ title: "Running Mtrs", field: "runningMeters", minWidth: 130 }),
      { title: "Sent", field: "sentQuantity", hozAlign: "right", headerHozAlign: "right", minWidth: 100,
        formatter: (cell) => Number(cell.getValue() || 0).toLocaleString("en-IN") },
      { title: "Last Rate", field: "lastRate", hozAlign: "right", headerHozAlign: "right", minWidth: 110, formatter: rateFormatter },
      { title: "Lowest", field: "lowestRate", hozAlign: "right", headerHozAlign: "right", minWidth: 100, formatter: rateFormatter },
      { title: "Highest", field: "highestRate", hozAlign: "right", headerHozAlign: "right", minWidth: 100, formatter: rateFormatter },
    ],
  });

  /* ── View Modal ── */
  function esc(v) {
    return String(v ?? "—").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

  function fmtRate(v) {
    const amount = Number(v);
    if (!Number.isFinite(amount) || amount <= 0) return "—";
    return "₹" + amount.toLocaleString("en-IN", { maximumFractionDigits: 2 });
  }

  window.viewLabelStockBinding = function (id) {
    const row = tableData.find(r => r._id === id);
    if (!row) return;
    const modal = document.getElementById("label-stock-view-modal");
    document.getElementById("label-stock-view-body").innerHTML = `
      <div style="background:linear-gradient(135deg,#044a78 0%,#03365a 100%);padding:22px 24px 20px;color:#fff;display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
        <div>
          <h2 style="margin:0;font-size:20px;font-weight:700;display:inline-flex;align-items:center;gap:8px;">${esc(row.productCode)}${verifiedBadgeFor(row, 22)}</h2>
          <p style="margin:6px 0 0;font-size:13px;opacity:0.85;">${esc(row.clientName)} / ${esc(row.userName)}</p>
        </div>
        <button onclick="document.getElementById('label-stock-view-modal').style.display='none'"
          style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);color:#fff;border-radius:999px;padding:5px 12px;cursor:pointer;font-size:13px;font-weight:700;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div style="padding:20px 24px;display:flex;flex-direction:column;gap:16px;overflow-y:auto;max-height:calc(90vh - 120px);">
        ${[
          { label: "Client Name", value: row.clientName },
          { label: "User Name", value: row.userName },
          { label: "Product Code", value: row.productCode },
          { label: "Size", value: row.paperSize },
          { label: "Running Mtrs", value: row.runningMeters },
          { label: "Sent", value: Number(row.sentQuantity || 0).toLocaleString("en-IN") },
          { label: "Last Rate", value: fmtRate(row.lastRate) },
          { label: "Lowest Rate", value: fmtRate(row.lowestRate) },
          { label: "Highest Rate", value: fmtRate(row.highestRate) },
          { label: "Status", value: row.status },
        ].concat(row.verified ? [{ label: "Verified", value: verifiedText(row) }] : []).map(r => `
          <div style="display:flex;justify-content:space-between;border-bottom:1px solid #f1f5f9;padding-bottom:10px;">
            <span style="font-size:13px;color:#64748b;font-weight:600;">${r.label}</span>
            <span style="font-size:13px;color:#03365a;font-weight:700;">${esc(r.value)}</span>
          </div>`).join("")}
      </div>`;
    modal.style.display = "flex";
  };

  document.getElementById("label-stock-view-modal").addEventListener("click", function (e) {
    if (e.target === this) this.style.display = "none";
  });

  /* ── Delete ── */
  let bindingToDelete = "";
  const deleteModal = document.getElementById("deleteBindingModal");
  const deleteForm = document.getElementById("deleteBindingForm");
  const deleteConfirmBtn = document.getElementById("deleteBindingConfirm");
  const deleteCancelBtn = document.getElementById("deleteBindingCancel");
  const getCsrfToken = () => document.querySelector('meta[name="csrf-token"]')?.getAttribute("content") || "";

  window.promptDeleteBinding = function (bindingId) {
    bindingToDelete = String(bindingId || "");
    deleteModal.classList.add("show");
    deleteModal.setAttribute("aria-hidden", "false");
  };

  function closeDeleteModal() {
    deleteModal.classList.remove("show");
    deleteModal.setAttribute("aria-hidden", "true");
    bindingToDelete = "";
  }

  deleteCancelBtn.addEventListener("click", closeDeleteModal);
  deleteModal.addEventListener("click", (e) => {
    if (e.target === deleteModal) closeDeleteModal();
  });
  deleteConfirmBtn.addEventListener("click", () => {
    if (!bindingToDelete) return closeDeleteModal();
    let csrfInput = deleteForm.querySelector('input[name="_csrf"]');
    if (!csrfInput) {
      csrfInput = document.createElement("input");
      csrfInput.type = "hidden";
      csrfInput.name = "_csrf";
      deleteForm.appendChild(csrfInput);
    }
    csrfInput.value = getCsrfToken();
    deleteForm.action = `/app/label-stock-binding/delete/${bindingToDelete}`;
    deleteForm.submit();
  });

  /* ── Toggle Status ── */
  let statusBindingId = "";
  let statusTarget = "INACTIVE";
  const statusModal = document.getElementById("statusBindingModal");
  const statusText = document.getElementById("statusBindingText");
  const statusConfirmBtn = document.getElementById("statusBindingConfirm");
  const statusCancelBtn = document.getElementById("statusBindingCancel");

  window.promptToggleStatus = function (bindingId, currentStatus) {
    statusBindingId = String(bindingId || "");
    const current = (currentStatus || "ACTIVE") === "INACTIVE" ? "INACTIVE" : "ACTIVE";
    statusTarget = current === "ACTIVE" ? "INACTIVE" : "ACTIVE";
    statusText.textContent = `This will mark the binding as ${statusTarget}.`;
    statusModal.classList.add("show");
    statusModal.setAttribute("aria-hidden", "false");
  };

  function closeStatusModal() {
    statusModal.classList.remove("show");
    statusModal.setAttribute("aria-hidden", "true");
    statusBindingId = "";
  }

  statusCancelBtn.addEventListener("click", closeStatusModal);
  statusModal.addEventListener("click", (e) => {
    if (e.target === statusModal) closeStatusModal();
  });

  statusConfirmBtn.addEventListener("click", async () => {
    if (!statusBindingId) return closeStatusModal();
    statusConfirmBtn.disabled = true;
    const endpoint = statusTarget === "ACTIVE" ? "set-active" : "set-inactive";
    try {
      const res = await fetch(`/app/label-stock-binding/${endpoint}/${statusBindingId}`, {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": getCsrfToken() },
      });
      if (res.ok) {
        closeStatusModal();
        window.location.reload();
      }
    } finally {
      statusConfirmBtn.disabled = false;
    }
  });
</script>
