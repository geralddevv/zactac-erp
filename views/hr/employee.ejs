<script>
document.addEventListener("DOMContentLoaded", () => {
  /* ================= REPORTING MANAGER CHOICES ================= */
  const reportingManagerSelect = document.getElementById("emp-reporting-manager");
  if (reportingManagerSelect) {
    new Choices(reportingManagerSelect, {
      searchEnabled: true,
      itemSelectText: "",
      shouldSort: false
    });
  }

  /* ================= MARRIAGE ANNIVERSARY TOGGLE ================= */
  const martialStatusSelect = document.getElementById("emp-martial-status");
  const marriageAnnivContainer = document.getElementById("marriage-anniv-container");
  const martialLayoutFields = [
    document.getElementById("emp-emergency-no1-container"),
    document.getElementById("emp-emergency-no2-container"),
    document.getElementById("emp-email-container"),
    document.getElementById("emp-martial-status-container")
  ].filter(Boolean);

  function updateMartialLayout(status) {
    const isMarried = status === "MARRIED";
    const useDualLayout = status !== "MARRIED";

    martialLayoutFields.forEach((field) => {
      const normalSpan = field.dataset.normalSpan;
      if (!normalSpan) return;

      field.classList.remove("span-dual", "span-four", "span-five", "span-six", "span-seven", "span-eight", "span-penta", "span-hexa");
      if (field.id === "emp-martial-status-container") {
        field.classList.add(isMarried ? normalSpan : "span-dual");
      } else {
        field.classList.add(useDualLayout ? "span-dual" : normalSpan);
      }
    });

    if (marriageAnnivContainer) {
      marriageAnnivContainer.style.display = isMarried ? "block" : "none";
    }

    if (!isMarried) {
      const annivInput = document.getElementById("emp-marriage-anniversary");
      if (annivInput) annivInput.value = "";
    }
  }

  if (martialStatusSelect) {
    martialStatusSelect.addEventListener("change", (e) => {
      updateMartialLayout(e.target.value);
    });

    updateMartialLayout(martialStatusSelect.value);
  }

  /* ================= ADD MANDATORY STARS ================= */
  const requiredInputs = document.querySelectorAll("input[required], select[required], textarea[required]");
  requiredInputs.forEach(input => {
    let label = null;
    if (input.id) label = document.querySelector(`label[for='${input.id}']`);
    if (!label && input.parentElement) label = input.parentElement.querySelector("label");
    if (label && !label.querySelector('.mandatory-star')) {
      label.insertAdjacentHTML('beforeend', ' <span class="mandatory-star" style="color: red; font-weight: bold;">*</span>');
    }
  });

  /* ================= FORMAT MOBILE NUMBERS ================= */
  const mobileInputs = [
    "emp-office-mob",
    "emp-mobile1",
    "emp-mobile2",
    "emp-emergency-no1",
    "emp-emergency-no2"
  ];
  
  function formatMobileNumber(inputElement) {
    let value = inputElement.value.replace(/\D/g, "");
    value = value.substring(0, 10);
    if (value.length > 5) {
      value = value.substring(0, 5) + " " + value.substring(5);
    }
    inputElement.value = value;
  }

  mobileInputs.forEach(id => {
    const input = document.getElementById(id);
    if (input) {
      // Format on page load for existing DB data
      formatMobileNumber(input);
      // Format on user input dynamically
      input.addEventListener("input", () => formatMobileNumber(input));
    }
  });

  /* ================= MODAL ELEMENTS ================= */
  const modal = document.getElementById("imageModal");
  const modalImg = document.getElementById("modalImage");
  const closeBtn = document.querySelector(".close-btn");

  /* ================= GENERIC PREVIEW SETUP ================= */
  function setupImagePreview({ inputId, previewId, existingPath, removeBtnId, removeFieldId }) {
    const input = document.getElementById(inputId);
    const preview = document.getElementById(previewId);
    const removeBtn = removeBtnId ? document.getElementById(removeBtnId) : null;
    const removeField = removeFieldId ? document.getElementById(removeFieldId) : null;

    if (!preview) return;

    // show existing image (edit mode)
    if (existingPath) {
      preview.src = existingPath;
      preview.style.display = "block";
      if (removeBtn) removeBtn.style.display = "flex";
    }

    // live preview on file select
    if (input) {
      input.addEventListener("change", () => {
        const file = input.files[0];
        if (!file || !file.type.startsWith("image/")) {
          preview.src = "";
          preview.style.display = "none";
          if (removeBtn) removeBtn.style.display = "none";
          return;
        }

        // A freshly chosen file replaces whatever "remove" state was pending.
        if (removeField) removeField.value = "false";

        const reader = new FileReader();
        reader.onload = () => {
          preview.src = reader.result;
          preview.style.display = "block";
          if (removeBtn) removeBtn.style.display = "flex";
        };
        reader.readAsDataURL(file);
      });
    }

    // remove → clear preview, clear the chosen file, flag for deletion on save
    if (removeBtn) {
      removeBtn.addEventListener("click", () => {
        preview.src = "";
        preview.style.display = "none";
        removeBtn.style.display = "none";
        if (input) input.value = "";
        if (removeField) removeField.value = "true";
      });
    }

    // click → open modal
    preview.addEventListener("click", () => {
      if (!preview.src) return;
      modalImg.src = preview.src;
      modal.style.display = "flex";
    });
  }

  /* ================= EMPLOYEE PHOTO ================= */
  setupImagePreview({
    inputId: "emp-photo",
    previewId: "empPhotoPreview",
    removeBtnId: "removeEmpPhotoBtn",
    removeFieldId: "removeEmpPhoto",
    existingPath:
      <% if (employee?.empPhoto) { %>
        "/images/empimg/<%= employee.empPhoto %>"
      <% } else { %>
        null
      <% } %>
  });

  /* ================= AADHAAR IMAGE ================= */
  setupImagePreview({
    inputId: "emp-aadhaar-img",
    previewId: "empAadhaarPreview",
    removeBtnId: "removeEmpAadhaarImgBtn",
    removeFieldId: "removeEmpAadhaarImg",
    existingPath:
      <% if (employee?.empAadhaarImg) { %>
        "/images/aadhaar/<%= employee.empAadhaarImg %>"
      <% } else { %>
        null
      <% } %>
  });

  /* ================= PAN IMAGE ================= */
  setupImagePreview({
    inputId: "emp-pan-img",
    previewId: "empPanPreview",
    removeBtnId: "removeEmpPanImgBtn",
    removeFieldId: "removeEmpPanImg",
    existingPath:
      <% if (employee?.empPanImg) { %>
        "/images/pan/<%= employee.empPanImg %>"
      <% } else { %>
        null
      <% } %>
  });

  /* ================= MODAL CLOSE ================= */
  closeBtn.addEventListener("click", () => {
    modal.style.display = "none";
  });

  modal.addEventListener("click", (e) => {
    if (e.target === modal) {
      modal.style.display = "none";
    }
  });

/* ================= DEPENDENTS INPUTS BY COUNT ================= */
const dependentsCountInput = document.getElementById("dependents-count");
const dependentsContainer = document.getElementById("dependents-details");

function renderDependents(count) {
  dependentsContainer.innerHTML = "";

  if (!count || count <= 0) return;

  for (let i = 0; i < count; i++) {
    dependentsContainer.insertAdjacentHTML("beforeend", `
      <div class="dependents-details" style="
        margin-bottom: 10px;
        padding: 10px;
        border-radius: 5px;
        border: 2px solid #044A78;
        display: flex;
        gap: 10px;
      ">
        <input
          type="text"
          name="dependentsDetails[${i}][dependentsName]"
          class="form-control"
          placeholder="Name"
          required
        />
        <input
          type="date"
          name="dependentsDetails[${i}][dependentsDOB]"
          class="form-control"
          required
        />
        <input
          type="text"
          name="dependentsDetails[${i}][dependentsRelation]"
          class="form-control"
          placeholder="Relation"
          required
        />
      </div>
    `);
  }
}

/* listen to count change */
dependentsCountInput.addEventListener("input", (e) => {
  const count = parseInt(e.target.value, 10);
  renderDependents(count);
});

/* ================= REQUIRED FIELD REPORTING ================= */
// The form is novalidate, so the browser never raises its own "please fill in
// this field" bubble -- pressing Submit with something missing simply did
// nothing at all. Name the offending fields in the toast instead, which is
// also the only workable option for the Choices.js selects: their real
// <select> is hidden, so there is no visible element for a native bubble to
// point at.

// Turn a control's name into something readable, for the handful of fields
// that carry no label (the dependents rows are built in JS without one):
// empDateOfJoining -> "Date Of Joining",
// dependentsDetails[0][dependentsDOB] -> "Dependent 1 DOB".
function humanizeFieldName(name) {
  const parts = String(name || "").match(/[^[\]]+/g) || [];
  if (!parts.length) return "";
  const words = parts[parts.length - 1]
    .replace(/^(emp|dependents)(?=[A-Z])/, "")
    .replace(/([a-z0-9])([A-Z])/g, "$1 $2")
    .replace(/[_-]+/g, " ")
    .trim()
    .replace(/\b[a-z]/g, (c) => c.toUpperCase());
  const rowIndex = parts.length > 2 && /^\d+$/.test(parts[1]) ? Number(parts[1]) + 1 : null;
  return rowIndex ? `Dependent ${rowIndex} ${words}` : words;
}

// Same label lookup the mandatory-star pass uses, minus the star it appended.
function fieldLabelText(field) {
  let label = null;
  if (field.id) label = document.querySelector(`label[for='${field.id}']`);
  if (!label && field.parentElement) label = field.parentElement.querySelector("label");
  const text = (label?.textContent || "").replace(/[*:\s]+$/, "").trim();
  return text || humanizeFieldName(field.name) || field.placeholder || "This field";
}

// Where to put the red outline / scroll to: the Choices wrapper when there is
// one, since the control itself is hidden.
const fieldAnchor = (field) => field.closest(".choices") || field;

function clearFieldErrors(form) {
  form.querySelectorAll(".field-error").forEach((el) => el.classList.remove("field-error"));
}

function reportInvalidFields(form) {
  const invalid = [...form.querySelectorAll("input:invalid, select:invalid, textarea:invalid")];
  if (!invalid.length) return false;

  invalid.forEach((field) => fieldAnchor(field).classList.add("field-error"));

  const missing = invalid.filter((f) => f.validity.valueMissing).map(fieldLabelText);
  const malformed = invalid.filter((f) => !f.validity.valueMissing);

  const list = (names) => {
    const shown = names.slice(0, 4).join(", ");
    return names.length > 4 ? `${shown} and ${names.length - 4} more` : shown;
  };

  const messages = [];
  if (missing.length === 1) messages.push(`Please fill in ${missing[0]}.`);
  else if (missing.length) messages.push(`${missing.length} required fields are missing: ${list(missing)}.`);
  if (malformed.length === 1) {
    messages.push(`${fieldLabelText(malformed[0])}: ${malformed[0].validationMessage}`);
  } else if (malformed.length) {
    messages.push(`Please check ${list(malformed.map(fieldLabelText))}.`);
  }
  showToast(messages.join(" "), true);

  const anchor = fieldAnchor(invalid[0]);
  anchor.scrollIntoView({ behavior: "smooth", block: "center" });
  // A Choices wrapper is not focusable and focusing a hidden <select> throws
  // in some browsers -- the outline plus the scroll is the feedback there.
  if (anchor === invalid[0]) invalid[0].focus({ preventScroll: true });
  return true;
}

/* ================= ASYNC FORM SUBMISSION ================= */
const empForm = document.getElementById("employeeForm");
// Drop a field's red outline as soon as it is touched. Capture, so the change
// Choices.js fires on its hidden <select> is caught too.
if (empForm) {
  const clearOne = (e) => {
    const field = e.target;
    if (field?.matches?.("input, select, textarea")) fieldAnchor(field).classList.remove("field-error");
  };
  empForm.addEventListener("input", clearOne, true);
  empForm.addEventListener("change", clearOne, true);
}
if (empForm) {
  empForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const profileCodeInput = document.getElementById("emp-profile-code");
    const profileCodeSelect = document.getElementById("emp-profile-code-select");
    const activeProfileCodeField = profileCodeSelect && !profileCodeSelect.disabled ? profileCodeSelect : profileCodeInput;
    const profileCode = (activeProfileCodeField?.value || "").trim().toUpperCase();

    // A Profile Code only has to be unique per location -- same code at a
    // different location is fine (see routes/hr/employee.js's
    // profileCodeLocationKey), so the key has to match the server's.
    const normalizeLocationName = (value) => String(value || "")
      .trim().toUpperCase().replace(/\s+/g, " ").replace(/^[.,]+|[.,]+$/g, "");
    const empLocValue = document.getElementById("emp-loc")?.value || "";
    const profileCodeKey = `${profileCode}||${normalizeLocationName(empLocValue)}`;

    if (profileCode && existingProfileCodes.has(profileCodeKey)) {
      showToast("Profile Code already exists at this location. Please enter a different code.", true);
      if (activeProfileCodeField) {
        activeProfileCodeField.focus();
        if (activeProfileCodeField.select) activeProfileCodeField.select();
      }
      return;
    }

    clearFieldErrors(empForm);
    if (reportInvalidFields(empForm)) {
      empForm.classList.add("was-validated");
      return;
    }
    
    // Optional: Keep the validated styles while saving
    empForm.classList.add("was-validated");
    
    const submitBtn = empForm.querySelector(".submit-btn");
    const originalText = submitBtn.textContent;
    submitBtn.textContent = "Saving...";
    submitBtn.disabled = true;

    try {
      const formData = new FormData(empForm);
      const action = empForm.getAttribute("action");
      
      const res = await fetch(action, {
        method: "POST",
        headers: { "Accept": "application/json" },
        body: formData
      });
      
      const data = await res.json();
      
      if (!res.ok || !data.success) {
        showToast(data.message || "An error occurred during submission", true);
      } else {
        showToast(data.message || "Employee saved successfully!", false);
        if (data.redirect) {
          setTimeout(() => window.location.href = data.redirect, 1500);
        }
      }
    } catch (err) {
      console.error(err);
      showToast("Network error. Please check your connection and try again.", true);
    } finally {
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
    }
  });
}

});

const toast = document.getElementById("toast");
const toastMsg = document.getElementById("toast-msg");
let toastTimer = null;
function showToast(message, isError) {
  if (!toast) return;
  toastMsg.textContent = message;
  toast.style.borderLeftColor = isError ? "#dc3545" : "#0a3646";
  toast.style.backgroundColor = isError ? "#f8d7da" : "#d1e7dd";
  toast.style.color = isError ? "#842029" : "#0a3646";
  
  toast.style.animation = "none";
  toast.offsetHeight; // trigger reflow
  toast.style.display = "flex";
  toast.style.animation = "slideIn 0.5s forwards";

  // A validation toast that never leaves sits on top of the page while the
  // fields it names are being filled in. An error list takes longer to read
  // than a "saved" confirmation, so give it more time.
  clearTimeout(toastTimer);
  toastTimer = setTimeout(hideToast, isError ? 7000 : 4000);
}

function hideToast() {
  if (toast) {
    clearTimeout(toastTimer);
    toast.style.animation = "slideOut 0.5s forwards";
    setTimeout(() => { toast.style.display = "none"; }, 500);
  }
}
</script>
