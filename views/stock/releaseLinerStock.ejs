<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="locations-data" type="application/json"><%- safeJson(locations) %></script>
<script id="release-specs-data" type="application/json"><%- safeJson({ types, colors, sizes, gsms, vendors, makes, vendorSkuCodes }) %></script>
<script id="release-masters-data" type="application/json"><%- safeJson(masters) %></script>
<script>
  let mastersData = JSON.parse(document.getElementById("release-masters-data").textContent);
  const locationsData = JSON.parse(document.getElementById("locations-data").textContent);
  const releaseSpecsData = JSON.parse(document.getElementById("release-specs-data").textContent);

  function locationOptionsHtml(selectedName) {
    return locationsData
      .map((l) => `<option value="${l.locationName}" ${l.locationName === selectedName ? "selected" : ""}>${l.locationName}</option>`)
      .join("");
  }

  // Rebuilds a smart-filtered select's full (unfiltered) option list -- used
  // to reset the Add dialog's pickers back to every Release Master value
  // each time the dialog is (re)opened, since filterAddSpecs narrows them in
  // place while it's open.
  function specOptionsHtml(values, noneLabel, noneDisabled) {
    const noneOption = `<option value="" ${noneDisabled ? "disabled selected hidden" : ""}>${noneLabel}</option>`;
    return noneOption + values.map((v) => `<option value="${v}">${v}</option>`).join("");
  }

  // Same, for the Vendor Name picker -- its options are {vendorId, vendorName}
  // pairs, not plain scalars, so it needs its own value/label mapping.
  function vendorOptionsHtml(vendors) {
    return `<option value="">— None —</option>` + vendors.map((v) => `<option value="${v.vendorId}">${v.vendorName}</option>`).join("");
  }

  let addTypeChoices = null, addColorChoices = null, addSizeChoices = null, addGsmChoices = null;
  let addVendorChoices = null, addMakeChoices = null, addVendorSkuCodeChoices = null, addLocationChoices = null;

  // ---- Add (inward) dialog: smart filter for Type/Color/Size/GSM/Vendor/
  // Make/Vendor SKU Code ---- Narrows each field's options to combinations
  // that actually exist in Release Master as the others are picked -- same
  // pattern as Tape Stock inward (routes/stock/tapeStock.js) and Facestock
  // Stock inward (routes/stock/facestockStock.js).
  const addSpecFields = ["addTypeSelect", "addColorSelect", "addSizeSelect", "addGsmSelect", "addVendorSelect", "addMakeSelect", "addVendorSkuCodeSelect"];
  const addSpecFieldToKey = {
    addTypeSelect: "type",
    addColorSelect: "color",
    addSizeSelect: "size",
    addGsmSelect: "gsm",
    addVendorSelect: "vendorId",
    addMakeSelect: "make",
    addVendorSkuCodeSelect: "vendorSkuCode",
  };
  const addSpecFieldToDataKey = {
    addTypeSelect: "types",
    addColorSelect: "colors",
    addSizeSelect: "sizes",
    addGsmSelect: "gsms",
    addVendorSelect: "vendors",
    addMakeSelect: "makes",
    addVendorSkuCodeSelect: "vendorSkuCodes",
  };
  // Vendor's options are {vendorId, vendorName} pairs; every other field's
  // are plain scalars -- this is the one place that difference matters.
  const addSpecFieldToChoice = {
    addVendorSelect: (v) => ({ value: v.vendorId, label: v.vendorName }),
  };
  function toChoiceOption(fieldId, value, currentValue) {
    const mapper = addSpecFieldToChoice[fieldId] || ((v) => ({ value: String(v), label: String(v) }));
    const { value: val, label } = mapper(value);
    return { value: val, label, selected: val === currentValue };
  }
  // Color/GSM/Vendor/Make/Vendor SKU Code are all optional on a stock reel
  // (Color defaults to WHITE server-side if left blank), so their reset
  // choice is a real selectable "— None —"; Type is required, so it stays a
  // disabled placeholder like the rest of this dialog's required selects.
  const addSpecFieldPlaceholder = {
    addTypeSelect: { label: "Select type", disabled: true },
    addColorSelect: { label: "— None —", disabled: false },
    addSizeSelect: { label: "— None —", disabled: false },
    addGsmSelect: { label: "— None —", disabled: false },
    addVendorSelect: { label: "— None —", disabled: false },
    addMakeSelect: { label: "— None —", disabled: false },
    addVendorSkuCodeSelect: { label: "— None —", disabled: false },
  };
  function addSpecChoicesInstance(id) {
    if (id === "addTypeSelect") return addTypeChoices;
    if (id === "addColorSelect") return addColorChoices;
    if (id === "addSizeSelect") return addSizeChoices;
    if (id === "addGsmSelect") return addGsmChoices;
    if (id === "addVendorSelect") return addVendorChoices;
    if (id === "addMakeSelect") return addMakeChoices;
    if (id === "addVendorSkuCodeSelect") return addVendorSkuCodeChoices;
    return null;
  }

  async function filterAddSpecs(changedFieldId) {
    const params = new URLSearchParams();
    addSpecFields.forEach((id) => {
      const el = document.getElementById(id);
      if (el && el.value) params.set(addSpecFieldToKey[id], el.value);
    });

    try {
      const res = await fetch(`/app/releaselinerstock/filter-specs?${params}`);
      const data = await res.json();
      if (!data) return;

      const autoSelected = [];

      addSpecFields.forEach((id) => {
        if (id === changedFieldId) return;
        const choicesInstance = addSpecChoicesInstance(id);
        if (!choicesInstance) return;

        const filteredValues = data[addSpecFieldToDataKey[id]] || [];
        const currentValue = document.getElementById(id)?.value || "";

        const newChoices = filteredValues.map((v) => toChoiceOption(id, v, currentValue));

        if (filteredValues.length === 1 && !currentValue) {
          newChoices[0].selected = true;
          autoSelected.push(id);
        }

        const ph = addSpecFieldPlaceholder[id];
        choicesInstance.clearStore();
        choicesInstance.setChoices(
          [{ value: "", label: ph.label, disabled: ph.disabled, selected: !newChoices.some((c) => c.selected) }, ...newChoices],
          "value", "label", true
        );
      });

      if (autoSelected.length > 0) await filterAddSpecs(autoSelected[0]);
    } catch (err) {
      console.error("Release liner filter specs error:", err);
    }
  }

  addSpecFields.forEach((id) => {
    document.getElementById(id)?.addEventListener("change", () => filterAddSpecs(id));
  });

  // Truncates a long cell value with an ellipsis (title attribute carries
  // the full text as a hover tooltip) -- used for free-text fields like
  // Vendor Name that can run longer than the column is wide.
  function ellipsisFormatter(cell) {
    const value = cell.getValue();
    if (!value) return "—";
    cell.getElement().style.cssText += "overflow:hidden;text-overflow:ellipsis;white-space:nowrap;";
    cell.getElement().title = value;
    return value;
  }

  // ---- Helpers ----
  function openModal(id) {
    const d = document.getElementById(id);
    d.classList.add("show");
    d.setAttribute("aria-hidden", "false");
  }
  function closeModal(id) {
    const d = document.getElementById(id);
    d.classList.remove("show");
    d.setAttribute("aria-hidden", "true");
  }
  function showError(elId, msg) {
    const el = document.getElementById(elId);
    el.textContent = msg;
    el.style.display = "block";
  }
  function hideError(elId) {
    document.getElementById(elId).style.display = "none";
  }
  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.disabled = loading;
    btn.style.opacity = loading ? "0.7" : "";
  }

  ["addDialog", "poDialog", "editRollDialog", "removeRollDialog"].forEach(id => {
    document.getElementById(id).addEventListener("click", function (e) {
      if (e.target === this) closeModal(id);
    });
  });

  // Same backdrop-click dismissal as the others, but through its own closer
  // so the iframe is unloaded with it.
  document.getElementById("labelDialog").addEventListener("click", function (e) {
    if (e.target === this) closeLabelDialog();
  });
  document.getElementById("printLabelsDialog").addEventListener("click", function (e) {
    if (e.target === this) closePrintLabelsDialog();
  });

  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    ["addDialog", "poDialog", "editRollDialog", "removeRollDialog"].forEach(id => {
      if (document.getElementById(id).classList.contains("show")) closeModal(id);
    });
    // Routed through its own closer rather than the list above, so the
    // iframe is unloaded on Escape too and not left holding the last reel.
    if (document.getElementById("labelDialog").classList.contains("show")) closeLabelDialog();
    if (document.getElementById("printLabelsDialog").classList.contains("show")) closePrintLabelsDialog();
  });

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    })[c]);
  }

  function formatRollDate(value) {
    if (!value) return "—";
    const d = new Date(value);
    return Number.isNaN(d.getTime()) ? "—" : d.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
  }

  const fmt = (n) => (n === null || n === undefined ? "—" : Number(n).toLocaleString("en-IN"));

  const fmtKg = (n) => {
    const value = Math.round(((Number(n) || 0) + Number.EPSILON) * 100) / 100;
    return value.toLocaleString("en-IN", { maximumFractionDigits: 2 });
  };

  // The running metres a Kg figure works out to at its own GSM and width --
  // same conversion Assign Production's Auto Allot uses to say how far a
  // reel's weight will run (views/inventory/orders/assignProduction.ejs's
  // reelMtrs()):
  //
  //     metres = kg x 1e6 / (gsm x widthMm)
  //
  // null (not 0) when there's no GSM or width to convert with -- a
  // micron-only spec has no weight-to-length relationship to give, and that
  // has to read as "can't say" rather than a wrong number.
  function kgToRm(kg, gsm, widthMm) {
    const k = Number(kg);
    const g = Number(gsm);
    const w = Number(widthMm);
    if (!(k > 0) || !(g > 0) || !(w > 0)) return null;
    return Math.round(((k * 1e6) / (g * w)) * 100) / 100;
  }

  const fmtRm = (n) => (n === null || n === undefined ? "—" : fmtKg(n));

  // Looks a reel's own Release Master back up by scanning mastersData's own
  // rolls arrays, instead of Tabulator's row.getTreeParent() -- more direct
  // for finding the spec (type/vendor/etc) a reel's Edit dialog summary
  // needs, and avoids depending on the tree row's parent link still being
  // intact after the row's own re-renders.
  function findMasterForRoll(rollId) {
    return mastersData.find((m) => (m.rolls || []).some((r) => r._id === rollId)) || {};
  }

  // Flattens each master into Tabulator's dataTree shape: one row per
  // Release Master, with the individual ReleaseLinerStock reels behind its
  // stock count (see routes/stock/releaseLinerStock.js's loadMastersWithStock)
  // as _children rows -- same "Rolls" dropdown pattern as FAIRTECH's Paper
  // Re-Order page (paperReorder.ejs). A master with no reels in stock gets no
  // _children key at all (not even an empty array -- Tabulator still draws a
  // toggle for that), so its leftmost column stays blank with nothing to open.
  function buildMastersTreeData(masters) {
    return masters.map((m) => {
      const rolls = Array.isArray(m.rolls) ? m.rolls : [];
      const row = { ...m, isParent: true };
      if (rolls.length) row._children = rolls.map((r) => ({ ...r, isParent: false }));
      return row;
    });
  }

  // ---- Masters & Reorder table ----
  const mastersTable = new Tabulator("#release-masters-table", {
    data: buildMastersTreeData(mastersData),
    height: "100%",
    responsiveLayout: false,
    movableColumns: true,
    placeholder: "No release liner masters added yet.",
    dataTree: true,
    dataTreeStartExpanded: false,
    dataTreeChildField: "_children",
    dataTreeFilter: false,
    dataTreeElementColumn: "_toggle",
    // Reel rows carry free-text identity (Roll ID, Vendor Roll ID, Remarks...)
    // that doesn't fit a fixed column width -- hide every per-column cell on
    // those rows and replace them with one spanning detail bar instead,
    // exactly like paperReorder.ejs's order rows.
    rowFormatter: (row) => {
      const data = row.getData();
      if (data.isParent) return;
      const el = row.getElement();
      if (el.querySelector(".roll-detail-span")) return;
      const missingInvoice = !data.invoiceNo;
      el.style.backgroundColor = missingInvoice ? "#fef2f2" : "#f8fafc";
      el.style.borderTop = missingInvoice ? "1px solid #fecaca" : "1px solid #e6eaf2";
      el.classList.add("roll-detail-row");
      if (missingInvoice) el.classList.add("roll-missing-invoice");
      const bar = document.createElement("div");
      bar.className = "roll-detail-span";
      bar.style.cssText = "flex:1; display:flex; align-items:center; flex-wrap:wrap; gap:8px; padding:6px 12px; color:#4b5563; font-size:13px;";
      // "Running Stock" -- same ALLOTTED/USED/IN USE NOW badges as Facestock
      // Stock's own rowFormatter (views/stock/facestockStock.ejs); see
      // loadReleaseReelUsage in routes/stock/releaseLinerStock.js for how
      // both are derived.
      const allottedBadge = data.allottedTo
        ? `<span style="background:#fef3c7;color:#92400e;font-weight:700;padding:2px 8px;border-radius:999px;font-size:11.5px;white-space:nowrap;" title="Reserved for this order, not yet drawn on -- free to re-pick in Assign Production if it can't be reached.">ALLOTTED · ${escapeHtml(data.allottedTo.lotNo || data.allottedTo.productCode || "—")}</span>`
        : "";
      const usedBadge = data.usedBy
        ? (data.usedBy.live
            ? `<span style="background:#ccfbf1;color:#0f766e;font-weight:700;padding:2px 8px;border-radius:999px;font-size:11.5px;white-space:nowrap;" title="Scanned and Start was just punched on a job card for this order -- Kg used isn't reported until Save Production Entry.">IN USE NOW · ${escapeHtml(data.usedBy.lots.join(", ") || "—")}</span>`
            : `<span style="background:#ede9fe;color:#6d28d9;font-weight:700;padding:2px 8px;border-radius:999px;font-size:11.5px;white-space:nowrap;" title="Kg drawn off this reel via a job card's Material Used dialog -- still in stock at the reduced Kg shown, not fully consumed.">PARTIALLY USED · ${escapeHtml(data.usedBy.lots.join(", ") || "—")} (${fmtKg(data.usedBy.totalKg)})</span>`)
        : "";
      // Own reel's Kg at the master's GSM and width -- every reel under a
      // master shares its spec exactly, so this is the same conversion the
      // master row's Stock (RM) column applies.
      const rollMaster = findMasterForRoll(data._id);
      const reelRm = kgToRm(data.reelMtrs, rollMaster.gsm, rollMaster.size);
      // Serial No.: the reel's place in its spec's list (the master's Sr. No.
      // is the same idea one level up). Counted over the whole list, not the
      // search results, so the number doesn't move while a search is on.
      const serialNo = (findMasterForRoll(data._id).rolls || []).findIndex((r) => r._id === data._id) + 1;
      const parts = [
        `↳ <b style="color:#1f2a44;">${escapeHtml(data.rollId || "—")}</b>`,
        allottedBadge,
        usedBadge,
        data.vendorRollId ? `Vendor Roll ID: ${escapeHtml(data.vendorRollId)}` : "",
        `<b style="color:#1f2a44;font-weight:800;">Kg ${fmtKg(data.reelMtrs)}</b>`,
        reelRm != null ? `RM ${fmtRm(reelRm)}` : "",
        data.location ? escapeHtml(data.location) : "",
        data.rate != null ? `Rate ₹${fmt(data.rate)}` : "",
        data.invoiceNo ? `Invoice ${escapeHtml(data.invoiceNo)}` : `<span style="color:#dc2626; font-weight:700;">No Invoice</span>`,
        `Date ${formatRollDate(data.inwardDate || data.createdAt)}`,
        data.remarks ? escapeHtml(data.remarks) : "",
      ].filter(Boolean);
      bar.innerHTML = parts.map((p, i) => (i === 0 ? p : `<span>${p}</span>`)).join('<span style="color:#334155; font-size:16px; font-weight:700; line-height:1;">&middot;</span>');
      const editBtn = document.createElement("button");
      editBtn.type = "button";
      editBtn.className = data.invoiceNo ? "roll-edit-btn has-invoice" : "roll-edit-btn";
      editBtn.innerHTML = '<i class="fa-solid fa-pen"></i> Edit';
      editBtn.addEventListener("click", () => openEditRollDialog(data, findMasterForRoll(data._id)));
      bar.insertBefore(editBtn, bar.firstChild);
      // S.No sits in front of Edit, as its own label (not part of the detail text).
      if (serialNo) {
        const sno = document.createElement("span");
        sno.className = "roll-sno";
        sno.style.cssText = "background:#e2e8f0;color:#1f2a44;font-weight:800;padding:4px 9px;border-radius:6px;font-size:12.5px;white-space:nowrap;align-self:center;";
        sno.textContent = serialNo;
        bar.insertBefore(sno, bar.firstChild);
      }
      const printBtn = document.createElement("button");
      printBtn.type = "button";
      printBtn.className = "roll-print-btn";
      printBtn.title = "Print this reel's label";
      printBtn.innerHTML = '<i class="fa-solid fa-print"></i> Print';
      printBtn.addEventListener("click", () => openLabelDialog(data));
      bar.insertBefore(printBtn, editBtn.nextSibling);
      // Remove this reel from stock -- for an inward keyed in by mistake
      // (wrong spec, duplicated reel, reel that never physically arrived),
      // or simply to take a reel off the books whatever its status.
      // Removable regardless -- allotted, used, even live on a machine
      // (routes/stock/releaseLinerStock.js's DELETE /:id no longer blocks
      // on usage, only releases the allotment first so nothing dangles);
      // the dialog warns rather than refusing.
      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.className = "roll-remove-btn";
      removeBtn.title = data.usedBy
        ? "Already in use / drawn on by a job card -- remove anyway"
        : (data.allottedTo
          ? "Remove this reel from stock -- it is allotted to an order and will be released from it"
          : "Remove this reel from stock");
      removeBtn.innerHTML = '<i class="fa-solid fa-trash"></i> Remove';
      removeBtn.addEventListener("click", () => openRemoveRollDialog(data, findMasterForRoll(data._id)));
      bar.insertBefore(removeBtn, printBtn.nextSibling);
      el.appendChild(bar);
    },
    columns: [
      { title: "", field: "_toggle", width: 40, hozAlign: "center", headerSort: false },
      // getPosition(true) is the row's rank among currently sorted/filtered
      // rows, re-evaluated on every redraw -- stays correct after sorting or
      // filtering instead of a static index frozen at load time. Reel (child)
      // rows don't get their own number, same as every other column here.
      { title: "Sr. No.", field: "_srNo", width: 60, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => (cell.getRow().getData().isParent ? cell.getRow().getPosition(true) : "") },
      {
        title: "Inward",
        width: 110,
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isParent) return "";
          const btn = document.createElement("button");
          btn.className = "add-stock-btn";
          btn.title = "Add stock reels for this spec";
          btn.innerHTML = '<i class="fa-solid fa-plus"></i> Add';
          btn.addEventListener("click", () => openAddDialog(row));
          return btn;
        },
      },
      { title: "SKU ID", field: "skuId", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150 },
      { title: "Vendor Name", field: "vendorName", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150, maxWidth: 220, formatter: ellipsisFormatter },
      { title: "Vendor SKU Code", field: "vendorSkuCode", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 130, formatter: (cell) => cell.getValue() || "—" },
      { title: "Type", field: "type", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110 },
      { title: "Make", field: "make", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 120, formatter: (cell) => cell.getValue() || "—" },
      {
        title: "Sensing",
        field: "sensing",
        minWidth: 120,
        formatter: (cell) => cell.getValue() || "—",
        // Only two real values exist (Release Master's own Sensing select,
        // see routes/system/releaseMaster.js's SENSING_OPTIONS) -- a dropdown
        // picks between them instead of a free-text box guessing at spelling.
        headerFilter: "list",
        headerFilterParams: {
          values: { "": "All", "SENSING": "SENSING", "NON-SENSING": "NON-SENSING" },
          clearable: true,
        },
        headerFilterFunc: "=",
      },
      { title: "Color", field: "color", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100 },
      { title: "Size", field: "size", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100, formatter: (cell) => cell.getValue() || "—" },
      { title: "GSM", field: "gsm", headerFilter: "input", headerFilterPlaceholder: "Search", hozAlign: "center", minWidth: 80, formatter: (cell) => cell.getValue() ?? "—" },
      {
        title: "Stock (Rolls)",
        field: "rollCount",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 110,
        headerTooltip: "Reels of this spec in stock. Click a row to tick them off and print their labels.",
        formatter: (cell) => {
          if (!cell.getRow().getData().isParent) return "";
          const count = cell.getValue() || 0;
          if (!count) return `<span style="color:#94a3b8;">0</span>`;
          return `<span class="rolls-chip" title="Click this row to print labels for these reels"><i class="fa-solid fa-tag"></i>${count}</span>`;
        },
      },
      {
        title: "Stock (RM)",
        field: "currentStock",
        headerFilter: false,
        hozAlign: "center",
        minWidth: 130,
        headerTooltip: "Running metres this Kg works out to at this spec's own GSM and width -- kg x 1e6 / (GSM x width mm), the same conversion Assign Production's Auto Allot uses. Blank where this spec has no GSM (a micron-only spec can't convert weight to length).",
        // Shares the "currentStock" field with the Stock (Kg) column, so
        // sorting needs its own comparator over the computed metres -- the
        // default would sort by raw Kg (the field's real value) instead.
        sorter: (_a, _b, aRow, bRow) => {
          const ra = aRow.getData();
          const rb = bRow.getData();
          const va = kgToRm(ra.currentStock, ra.gsm, ra.size);
          const vb = kgToRm(rb.currentStock, rb.gsm, rb.size);
          return (va ?? -Infinity) - (vb ?? -Infinity);
        },
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isParent) return "";
          return fmtRm(kgToRm(row.currentStock, row.gsm, row.size));
        },
      },
      { title: "Stock (Kg)", field: "currentStock", headerFilter: "input", headerFilterPlaceholder: "Search", hozAlign: "center", minWidth: 130,
        formatter: (cell) => (cell.getRow().getData().isParent ? fmtKg(cell.getValue()) : "") },
      {
        title: "Allotted (Kg)",
        field: "allotted",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 130,
        headerTooltip: "Kg committed to WIP (assigned to a machine, not-yet-produced) Label Stock orders needing this spec -- including material already laminated into a Deckle, which has left Stock.",
        formatter: (cell) => {
          if (!cell.getRow().getData().isParent) return "";
          const value = cell.getValue() || 0;
          if (!value) return "—";
          // Reads as the shopfloor says it: "1000 mtrs, 1 roll allotted".
          const rolls = cell.getRow().getData().allottedRolls || 0;
          const rollPart = rolls
            ? ` <span style="font-size:11px; font-weight:600; color:#b45309;">(${rolls} roll${rolls === 1 ? "" : "s"})</span>`
            : "";
          return `<span style="font-weight:700; color:#92400e;">${fmtKg(value)}</span>${rollPart}`;
        },
      },
      {
        title: "Used (Kg)",
        field: "liveRolls",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 170,
        headerTooltip: "Rolls of this spec currently scanned and Start-punched on a job that's still in progress -- no Kg reported yet (see each reel's own badge under the dropdown). A reel goes back to plain Available stock, at its reduced Kg, once Save Production Entry runs.",
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isParent) return "";
          const liveRolls = row.liveRolls || 0;
          if (!liveRolls) return "—";
          return `<span style="font-size:11px; font-weight:700; color:#0f766e;">${liveRolls} in use now</span>`;
        },
      },
      {
        title: "Available (Kg)",
        field: "available",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 130,
        formatter: (cell) => {
          if (!cell.getRow().getData().isParent) return "";
          const value = cell.getValue() || 0;
          const color = value < 0 ? "#dc2626" : "#15803d";
          return `<span style="font-weight:800; color:${color};">${fmtKg(value)}</span>`;
        },
      },
      {
        title: "Available (RM)",
        field: "available",
        headerFilter: false,
        hozAlign: "center",
        minWidth: 130,
        headerTooltip: "Available (Kg) converted to running metres at this spec's own GSM and width, same conversion as Stock (RM). Blank where this spec has no GSM.",
        // Shares the "available" field with Available (Kg) -- same reason
        // Stock (RM) needs its own sorter over "currentStock" above.
        sorter: (_a, _b, aRow, bRow) => {
          const ra = aRow.getData();
          const rb = bRow.getData();
          const va = kgToRm(ra.available, ra.gsm, ra.size);
          const vb = kgToRm(rb.available, rb.gsm, rb.size);
          return (va ?? -Infinity) - (vb ?? -Infinity);
        },
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isParent) return "";
          return fmtRm(kgToRm(row.available, row.gsm, row.size));
        },
      },
      {
        title: "Shortage",
        field: "shortage",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 110,
        formatter: (cell) => (cell.getRow().getData().isParent ? `<span style="font-weight:800; color:#dc2626;">${fmtKg(cell.getValue())}</span>` : ""),
      },
      { title: "MSQ", field: "msq", headerFilter: "input", headerFilterPlaceholder: "Search", hozAlign: "center", minWidth: 90, formatter: (cell) => cell.getValue() ?? "—" },
      {
        title: "Purchase Order",
        width: 150,
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isParent) return "";
          if (row.hasActivePO) return `<span class="po-pending-badge">PO Pending</span>`;
          const btn = document.createElement("button");
          btn.className = "po-action-btn";
          btn.textContent = "Create PO";
          btn.addEventListener("click", () => openPoDialog(row));
          // Raising purchase orders from here is switched off for now. Shown
          // greyed rather than taken away, so the column still says what this
          // row is for and an existing PO still reads "PO Pending". To turn it
          // back on, drop these two lines -- the dialog and POST /purchase-order
          // behind it are untouched and still work.
          btn.disabled = true;
          cell.getElement().title = "Creating purchase orders is switched off for now.";
          return btn;
        },
      },
    ],
  });

  // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
  // `renderComplete:` key inside the options object above is silently
  // ignored (no error, callback just never runs). Subscribing via .on() is
  // the only way it actually fires. Reads straight off the rendered DOM
  // rather than Tabulator's row APIs (getRow().getPosition()/getRows("active")
  // were both observed to go stale after a sort) -- whatever master rows
  // are actually on screen, top to bottom, get renumbered 1..n every time
  // the table redraws. Reel (child) rows are marked ".roll-detail-row" by
  // rowFormatter above and skipped, same as every other master-only column.
  mastersTable.on("renderComplete", function () {
    document.querySelectorAll("#release-masters-table .tabulator-row:not(.roll-detail-row)").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });

  // A master row is a spec, and the one thing wanted of a whole spec at once
  // is its reels' labels -- so the row opens the Print Reel Labels dialog.
  // Everything on the row that already means something else keeps meaning it:
  // the Add / Create PO buttons, and the tree control that drops the reels
  // down under it.
  mastersTable.on("rowClick", (e, row) => {
    const data = row.getData();
    if (!data.isParent) return;                                  // reel rows carry their own buttons
    if (e.target.closest("button")) return;                      // Add / Create PO
    if (e.target.closest(".tabulator-data-tree-control")) return; // the reels dropdown
    openPrintLabelsDialog(data);
  });

  // ---- Find a reel by its own number -------------------------------------
  // A reel's number (Roll ID / Vendor Roll ID / Invoice No) sits on a child
  // row inside a master's dropdown, and the column header filters match
  // master rows only (dataTreeFilter: false), so neither of them can find
  // one reel -- you had to open each spec in turn and read down it. This
  // searches every reel behind every master at once and re-seats the table
  // on just the specs holding a hit, each already open, showing only the
  // reels that matched.
  //
  // mastersData itself is never touched and the rows handed to Tabulator are
  // copies, so a master row still carries ALL of that spec's reels in
  // `rolls` and the Print Reel Labels dialog a row opens still offers
  // the lot of them. Clearing the box puts the full table back.
  const STOCK_FIND_FIELDS = ["rollId", "vendorRollId", "invoiceNo"];

  // "SP | REL | 000123" read off a sticker gets typed as "rel 000123",
  // "000123" or just "123" -- compare letters and digits alone, from both
  // sides, so the separators and the spacing never decide a match.
  const stockFindKey = (value) => String(value ?? "").toLowerCase().replace(/[^a-z0-9]/g, "");

  const stockFindInput = document.getElementById("stockFindInput");
  const stockFindStatus = document.getElementById("stockFindStatus");
  const stockFindClearBtn = document.getElementById("stockFindClear");
  let stockFindNeedle = "";
  let stockFindTimer = null;

  // keepOpen: a Set of master _ids to leave expanded (see refreshStockTable).
  function runStockFind(keepOpen) {
    const needle = stockFindKey(stockFindInput.value);
    stockFindClearBtn.hidden = !stockFindInput.value;
    if (needle === stockFindNeedle) return;
    stockFindNeedle = needle;

    if (!needle) {
      stockFindStatus.textContent = "";
      stockFindStatus.title = "";
      stockFindStatus.classList.remove("is-empty");
      mastersTable.setData(buildMastersTreeData(mastersData)).then(() => {
        if (!keepOpen) return;
        mastersTable.getRows().forEach((row) => {
          const d = row.getData();
          if (d._children && keepOpen.has(String(d._id))) row.treeExpand();
        });
      });
      return;
    }

    let hits = 0;
    const rows = [];
    mastersData.forEach((m) => {
      const matched = (m.rolls || []).filter((r) =>
        STOCK_FIND_FIELDS.some((f) => {
          const key = stockFindKey(r[f]);
          return key && key.includes(needle);
        })
      );
      if (!matched.length) return;
      hits += matched.length;
      rows.push({ ...m, isParent: true, _children: matched.map((r) => ({ ...r, isParent: false })) });
    });

    stockFindStatus.textContent = hits
      ? `${hits} reel${hits === 1 ? "" : "s"} · ${rows.length} spec${rows.length === 1 ? "" : "s"}`
      : "No match";
    stockFindStatus.title = hits
      ? `Only the reels that matched are listed under each spec — clear the box to see every reel again.`
      : "No reel on this page carries that number.";
    stockFindStatus.classList.toggle("is-empty", hits === 0);

    // Opened after the data has landed rather than through
    // dataTreeStartExpanded -- that is a constructor option, so setting it
    // here would be read by nothing.
    mastersTable.setData(rows).then(() => {
      mastersTable.getRows().forEach((row) => {
        if (row.getData()._children) row.treeExpand();
      });
    });
  }

  function clearStockFind() {
    clearTimeout(stockFindTimer);
    stockFindInput.value = "";
    runStockFind();
    stockFindInput.focus();
  }

  stockFindInput.addEventListener("input", () => {
    clearTimeout(stockFindTimer);
    stockFindTimer = setTimeout(runStockFind, 180);
  });
  stockFindInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      clearTimeout(stockFindTimer);
      runStockFind();
    }
    // Escape empties the box instead of reaching the page's own Escape
    // handler, which is there to close dialogs.
    if (e.key === "Escape") {
      e.stopPropagation();
      clearStockFind();
    }
  });
  stockFindClearBtn.addEventListener("click", clearStockFind);

  // Tabulator's placeholder is fixed at construction, and "No release liner masters added yet."
  // is the wrong answer to a search that found nothing -- so it is
  // rewritten on each redraw instead. The element only exists while the
  // table is empty, so there is nothing to change until there is.
  const STOCK_FIND_PLACEHOLDER = "No release liner masters added yet.";
  mastersTable.on("renderComplete", () => {
    const ph = document.querySelector("#release-masters-table .tabulator-placeholder-contents");
    if (!ph) return;
    ph.textContent = stockFindNeedle
      ? `Nothing matching "${stockFindInput.value.trim()}" -- clear the box to see every spec again.`
      : STOCK_FIND_PLACEHOLDER;
  });


  // ---- Create Purchase Order dialog ----
  let poLocationChoices = null;
  let poMasterId = null;

  function openPoDialog(row) {
    poMasterId = row._id;
    document.getElementById("poSkuDisplay").value = row.skuId;
    document.getElementById("poVendorDisplay").value = row.vendorName || "—";
    document.getElementById("poQtyInput").value = row.shortage || "";
    document.getElementById("poNumberInput").value = "";
    document.getElementById("poRemarksInput").value = "";

    const inSevenDays = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);
    document.getElementById("poDateInput").value = inSevenDays.toISOString().slice(0, 10);

    if (poLocationChoices) { poLocationChoices.destroy(); poLocationChoices = null; }
    const locSel = document.getElementById("poLocationSelect");
    locSel.innerHTML = locationOptionsHtml("");
    poLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    hideError("poError");
    openModal("poDialog");
  }
  function closePoDialog() {
    closeModal("poDialog");
    poMasterId = null;
  }

  async function submitPo() {
    const quantity = document.getElementById("poQtyInput").value;
    const poNumber = document.getElementById("poNumberInput").value.trim();
    const userLocation = document.getElementById("poLocationSelect").value;
    const estimatedDate = document.getElementById("poDateInput").value;
    if (!quantity || Number(quantity) <= 0) return showError("poError", "Quantity is required.");
    if (!poNumber) return showError("poError", "PO Number is required.");
    if (!userLocation) return showError("poError", "Delivery location is required.");
    if (!poMasterId) return;

    hideError("poError");
    setLoading("poSubmitBtn", true);
    try {
      const res = await fetch("/app/releaselinerstock/purchase-order", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          masterId: poMasterId,
          quantity,
          poNumber,
          estimatedDate,
          userLocation,
          remarks: document.getElementById("poRemarksInput").value.trim(),
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || "/app/purchase/pending";
      } else {
        showError("poError", data.message || "Failed to create Purchase Order.");
      }
    } catch {
      showError("poError", "Server error. Please try again.");
    } finally {
      setLoading("poSubmitBtn", false);
    }
  }

  // ---- ADD (batch inward) ----

  // Row group markup for one physical reel of the batch's shared spec --
  // Roll ID is filled in after the fact by refreshRollIdPreviews(), never typed.
  function rollRowHtml(index, prev) {
    return `
      <div class="roll-row" data-index="${index}">
        <div class="roll-row-title">Roll ${index + 1}</div>
        <label class="dialog-field-label">Roll ID</label>
        <input type="text" class="form-control premium-input roll-id-preview" readonly style="margin-bottom: 10px; background: #f1f5f9;" />
        <label class="dialog-field-label">Vendor Roll ID</label>
        <input type="text" class="form-control premium-input roll-vendor-id" placeholder="Vendor's own roll no" value="${prev.vendorRollId || ""}" style="margin-bottom: 10px;" />
        <label class="dialog-field-label">Kg</label>
        <input type="number" class="form-control premium-input roll-mtrs" min="0" step="any" placeholder="Enter Kg" value="${prev.mtrs || ""}" />
      </div>`;
  }

  // Rebuilds the roll rows for the given count, keeping whatever the user
  // already typed into rows that are still present -- only rows past the
  // new count are dropped, and new rows are always appended at the end so an
  // existing row's index never shifts while it's on screen.
  function renderRollRows(count, preserveValues) {
    const container = document.getElementById("addRollsContainer");
    const existing = preserveValues
      ? Array.from(container.querySelectorAll(".roll-row")).map((row) => ({
          vendorRollId: row.querySelector(".roll-vendor-id").value,
          mtrs: row.querySelector(".roll-mtrs").value,
        }))
      : [];
    container.innerHTML = Array.from({ length: count }, (_, i) => rollRowHtml(i, existing[i] || {})).join("");
    refreshRollIdPreviews();
    updateBatchSummary();
  }

  // Live roll count / total mtrs shown in the dialog header as rows are
  // added/removed and Mtrs values are typed.
  // What the rolls add up to, against what the invoice says (Total Kg).
  // Two figures that must agree: keying 5 of an 8-roll delivery, or a
  // fat-fingered 1500 where 150 was meant, is the mistake this catches -- and
  // only here, while the person still has the invoice in front of them. The
  // header shows the difference as they type; submitAdd() refuses on the same
  // test, over OR under.
  const KG_TOLERANCE = 0.01;   // the kg figures are carried to 2 decimals
  function unitsTotal() {
    return Array.from(document.querySelectorAll("#addRollsContainer .roll-row"))
      .reduce((sum, row) => sum + (Number(row.querySelector(".roll-mtrs").value) || 0), 0);
  }
  const fmtKgNum = (n) => (Number.isInteger(n) ? String(n) : n.toFixed(2).replace(/0$/, "").replace(/\.$/, ""));

  // null when the two agree (or there is nothing to compare yet); otherwise
  // the difference and which way it is out.
  function kgMismatch() {
    const total = Number(document.getElementById("addTotalKgInput").value);
    if (!Number.isFinite(total) || total <= 0) return null;
    const rows = document.querySelectorAll("#addRollsContainer .roll-row");
    if (!rows.length) return null;
    const sum = unitsTotal();
    const diff = Math.round((sum - total) * 100) / 100;
    return Math.abs(diff) <= KG_TOLERANCE ? null : { diff, over: diff > 0, sum, total };
  }

  function updateBatchSummary() {
    const rows = document.querySelectorAll("#addRollsContainer .roll-row");
    const sum = unitsTotal();
    document.getElementById("summaryRollCount").textContent = rows.length;
    document.getElementById("summaryTotalMtrs").textContent = fmtKgNum(sum);

    const note = document.getElementById("summaryKgCheck");
    const total = Number(document.getElementById("addTotalKgInput").value);
    const bad = kgMismatch();
    if (!Number.isFinite(total) || total <= 0) {
      note.textContent = "";
    } else if (bad) {
      note.textContent = `${bad.over ? "+" : "−"}${fmtKgNum(Math.abs(bad.diff))} kg ${bad.over ? "more" : "less"} than Total Kg (${fmtKgNum(total)})`;
      note.style.color = bad.over ? "#fca5a5" : "#fde68a";
    } else {
      note.textContent = `matches Total Kg (${fmtKgNum(total)})`;
      note.style.color = "#86efac";
    }
  }
  document.getElementById("addRollsContainer").addEventListener("input", (e) => {
    if (e.target.classList.contains("roll-mtrs")) updateBatchSummary();
  });
  // The other half of the same comparison -- typing the invoice total has to
  // re-check it just as typing a roll does.
  document.getElementById("addTotalKgInput").addEventListener("input", updateBatchSummary);

  async function refreshRollIdPreviews() {
    const rows = document.querySelectorAll("#addRollsContainer .roll-row");
    if (!rows.length) return;
    try {
      const res = await fetch(`/app/releaselinerstock/preview-roll-ids?count=${rows.length}`);
      const data = await res.json();
      const ids = data.rollIds || [];
      rows.forEach((row, i) => {
        row.querySelector(".roll-id-preview").value = ids[i] || "";
      });
    } catch {
      // Preview is cosmetic only -- the server assigns the real id on save.
    }
  }

  document.getElementById("addRollCountInput").addEventListener("change", function () {
    const count = Math.min(Math.max(parseInt(this.value, 10) || 1, 1), 100);
    this.value = count;
    renderRollRows(count, true);
  });

  // masterPrefill (optional): a row from the Masters & Reorder panel below --
  // when given, every spec field is pre-set to that master's own spec
  // instead of left blank, so "Add Stock" on a master row jumps straight to
  // entering roll rows rather than re-picking a spec the smart filters would
  // narrow down to anyway.
  let selectedReleaseMaster = {};

  function openAddDialog(masterPrefill) {
    selectedReleaseMaster = masterPrefill || {};

    // Populate masters table with selected master only - show ALL master data
    const tbody = document.getElementById("releaseMastersRef").querySelector("tbody");
    if (selectedReleaseMaster && selectedReleaseMaster.type) {
      tbody.innerHTML = `
        <tr style="border-bottom: 1px solid #e2e8f0;">
          <td style="padding: 10px; font-weight: 700; color: #044a78; border-right: 1px solid #e2e8f0;">Vendor</td>
          <td style="padding: 10px; color: #0f172a;" colspan="6">${selectedReleaseMaster.vendorName || "—"}</td>
        </tr>
        <tr style="border-bottom: 1px solid #e2e8f0;">
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Type</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Make</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Sensing</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">SKU</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Color</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Size</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px;">GSM</td>
        </tr>
        <tr>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedReleaseMaster.type || ""}">${selectedReleaseMaster.type || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedReleaseMaster.make || ""}">${selectedReleaseMaster.make || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedReleaseMaster.sensing || ""}">${selectedReleaseMaster.sensing || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedReleaseMaster.vendorSkuCode || ""}">${selectedReleaseMaster.vendorSkuCode || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedReleaseMaster.color || ""}">${selectedReleaseMaster.color || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedReleaseMaster.size || ""}">${selectedReleaseMaster.size || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedReleaseMaster.gsm || ""}">${selectedReleaseMaster.gsm || "—"}</td>
        </tr>
      `;
    } else {
      tbody.innerHTML = '<tr><td colspan="7" style="padding: 12px; text-align: center; color: #64748b;">Select a master to inward</td></tr>';
    }

    document.getElementById("addDateInput").value = new Date().toISOString().slice(0, 10);
    document.getElementById("addInvoiceNoInput").value = "";
    document.getElementById("addTotalKgInput").value = "";
    document.getElementById("addRateInput").value = "";
    document.getElementById("addRollCountInput").value = "1";
    document.getElementById("addRemarksInput").value = "";

    if (addLocationChoices) { addLocationChoices.destroy(); addLocationChoices = null; }
    const locSel = document.getElementById("addLocationSelect");
    locSel.innerHTML = locationOptionsHtml("");
    addLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    renderRollRows(1, false);

    hideError("addReleaseError");
    openModal("addDialog");
  }
  function closeAddDialog() {
    closeModal("addDialog");
  }

  async function submitAdd() {
    if (!selectedReleaseMaster || !selectedReleaseMaster._id) return showError("addReleaseError", "Please select a master to inward.");

    const location = document.getElementById("addLocationSelect").value;
    if (!location) return showError("addReleaseError", "Location is required.");

    const inwardDate = document.getElementById("addDateInput").value;
    if (!inwardDate) return showError("addReleaseError", "Date is required.");

    const totalKg = document.getElementById("addTotalKgInput").value;
    if (!totalKg || Number(totalKg) <= 0) return showError("addReleaseError", "Total Kg is required.");

    const rate = document.getElementById("addRateInput").value;
    if (!rate || Number(rate) <= 0) return showError("addReleaseError", "Rate is required.");

    const rollRows = Array.from(document.querySelectorAll("#addRollsContainer .roll-row"));
    const rolls = rollRows.map((row) => ({
      reelMtrs: row.querySelector(".roll-mtrs").value,
      vendorRollId: row.querySelector(".roll-vendor-id").value.trim(),
    }));
    const emptyIndex = rolls.findIndex((r) => !r.reelMtrs || Number(r.reelMtrs) <= 0);
    if (emptyIndex !== -1) return showError("addReleaseError", `Kg is required for roll ${emptyIndex + 1}.`);
    const emptyVendorRollIdIndex = rolls.findIndex((r) => !r.vendorRollId);
    if (emptyVendorRollIdIndex !== -1) return showError("addReleaseError", `Vendor Roll ID is required for roll ${emptyVendorRollIdIndex + 1}.`);

    // The roll have to add up to what the invoice says -- too much and one
    // has been keyed twice or a figure is wrong; too little and one is
    // missing. Both are wrong on the shelf, so both stop here.
    const mismatch = kgMismatch();
    if (mismatch) {
      return showError("addReleaseError",
        `The ${rolls.length} roll${rolls.length === 1 ? "" : "s"} add up to ${fmtKgNum(mismatch.sum)} kg,`
        + ` which is ${fmtKgNum(Math.abs(mismatch.diff))} kg ${mismatch.over ? "MORE" : "LESS"} than the Total Kg of ${fmtKgNum(mismatch.total)}.`
        + ` ${mismatch.over ? "Check the roll weights, or raise the Total Kg." : "Check for a missing roll, or lower the Total Kg."}`);
    }

    hideError("addReleaseError");
    setLoading("addSubmitBtn", true);
    try {
      const res = await fetch("/app/releaselinerstock/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          type: selectedReleaseMaster.type,
          color: selectedReleaseMaster.color,
          size: selectedReleaseMaster.size,
          gsm: selectedReleaseMaster.gsm,
          vendorId: selectedReleaseMaster.vendorId,
          make: selectedReleaseMaster.make,
          vendorSkuCode: selectedReleaseMaster.vendorSkuCode,
          sensing: selectedReleaseMaster.sensing,
          rate: document.getElementById("addRateInput").value,
          location,
          inwardDate,
          invoiceNo: document.getElementById("addInvoiceNoInput").value,
          remarks: document.getElementById("addRemarksInput").value,
          // Checked again server-side against the rows (POST /create).
          totalKg,
          rolls,
        }),
      });
      const data = await res.json();
      if (data.success) {
        closeAddDialog();
        await afterStockChange(`${data.added} reels added.`);
      } else {
        showError("addReleaseError", data.message || "Failed to add release liner stock.");
      }
    } catch {
      showError("addReleaseError", "Server error. Please try again.");
    } finally {
      setLoading("addSubmitBtn", false);
    }
  }

  // ---- EDIT (fix a single existing reel -- e.g. one missing its Invoice No,
  // flagged red by rowFormatter above) ----
  // ---- Print Roll Label dialog ----
  // Nothing about the label is built here: the iframe loads
  // /label/:stockId, which is the print target itself, and everything --
  // values, positions, the fit-to-box pass, the rotation state -- lives in
  // that page (views/stock/releaseLinerRollLabel.ejs) behind window.labelApi.
  // This only opens it, forwards the two buttons, and tears it down.
  function labelWindow() {
    const frame = document.getElementById("labelFrame");
    // try/catch, not just a null check: if the frame ends up on a document
    // the browser treats as another origin -- which is what a blocked or
    // errored frame becomes -- then merely READING .labelApi throws a
    // SecurityError. Returning null instead lets the caller report "couldn't
    // load" rather than the dialog dying with an uncaught exception.
    try {
      return frame.contentWindow && frame.contentWindow.labelApi ? frame.contentWindow : null;
    } catch (e) {
      return null;
    }
  }

  function syncLabelRotateBtn() {
    const win = labelWindow();
    const btn = document.getElementById("labelRotateBtn");
    const flipped = Boolean(win && win.labelApi.isFlipped());
    btn.textContent = flipped ? "Rotated 180°" : "Rotate 180°";
  }

  // Both controls drive the framed document, so neither can do anything
  // until it has loaded. Disabled rather than left clickable-but-inert:
  // a button that silently does nothing reads as broken, which is exactly
  // how this looked before.
  function setLabelControlsReady(ready) {
    ["labelPrintBtn", "labelRotateBtn"].forEach((id) => {
      const btn = document.getElementById(id);
      btn.disabled = !ready;
      btn.style.opacity = ready ? "" : "0.6";
      btn.style.cursor = ready ? "" : "not-allowed";
    });
    document.getElementById("labelLoading").style.display = ready ? "none" : "block";
  }

  function labelMessage(text) {
    document.getElementById("labelLoading").textContent = text;
  }

  // Fetched and written in as srcdoc rather than pointed at with frame.src.
  //
  // Navigating the frame to the URL made the browser follow whatever came
  // back, and an unauthenticated request answers 302 -> /sachiko/login, a
  // page that (like the whole app) sends X-Frame-Options: DENY. The frame
  // then died on the REDIRECT TARGET with "localhost refused to connect" --
  // a session problem wearing the costume of a server outage, and not
  // something a header on the label route can fix, because the block happens
  // on a different path entirely.
  //
  // fetch carries the session cookie the same way, but hands us the outcome
  // instead of acting on it: a redirect becomes res.redirected, an error
  // becomes a status we can read aloud. srcdoc then renders the HTML with no
  // navigation at all, so X-Frame-Options never applies -- it governs
  // navigations, not inline documents. The frame is same-origin with this
  // page, so window.labelApi stays reachable and printing still works.
  async function openLabelDialog(reel) {
    document.getElementById("labelDialogTitle").textContent = `Roll Label — ${reel.rollId || ""}`;
    setLabelControlsReady(false);
    labelMessage("Loading label…");
    const frame = document.getElementById("labelFrame");
    frame.removeAttribute("srcdoc");
    openModal("labelDialog");

    let res;
    try {
      res = await fetch(`/app/releaselinerstock/label/${reel._id}`, { credentials: "same-origin" });
    } catch (e) {
      return labelMessage("Couldn't reach the server to build this label.");
    }
    // A redirect here is the app bouncing us to the login page -- the
    // request went out without a valid session.
    if (res.redirected || !res.ok) {
      if (res.redirected) {
        return labelMessage("Your session has ended. Reload this page and sign in again to print.");
      }
      // The route answers failures as a small HTML document (it normally
      // renders into this frame), so strip the markup to get the sentence.
      const detail = (await res.text()).replace(/<[^>]*>/g, " ").trim();
      return labelMessage(`Couldn't load the label (${res.status}). ${detail}`);
    }

    frame.onload = () => {
      if (!labelWindow()) return labelMessage("The label loaded but couldn't be read.");
      setLabelControlsReady(true);
      syncLabelRotateBtn();
    };
    // Always re-fetched rather than reused: Mfg Date is generated per
    // request, so a stale document would print the wrong reel.
    frame.srcdoc = await res.text();
  }

  function closeLabelDialog() {
    const frame = document.getElementById("labelFrame");
    frame.onload = null;
    // Dropped so the next open can't flash the previous reel's label.
    frame.removeAttribute("srcdoc");
    closeModal("labelDialog");
  }

  function printLabel() {
    const win = labelWindow();
    if (!win) return; // controls are disabled until the frame is ready
    win.labelApi.print();
  }

  function toggleLabelRotation() {
    const win = labelWindow();
    if (!win) return;
    win.labelApi.toggleFlip();
    syncLabelRotateBtn();
  }
  // ---- Print Reel Labels dialog (a whole spec's reels in one print run) ----
  // Opened by clicking any master row. The reel a sticker belongs to is
  // decided here by ticking it; the sticker itself is still built entirely by
  // the server (/labels?ids=...) and previewed in the very iframe that gets
  // printed, so this file never draws a label of its own.
  //
  // Nothing here writes: printing a label changes no stock. An allotted or
  // part-used reel is therefore still listed and still printable -- it is a
  // physical reel on the floor that needs a sticker on it like any other --
  // with its state shown as a badge rather than as a bar.
  const LABEL_FLIP_KEY = "releaseLinerLabelFlip180";   // same key the label page reads (srcdoc shares this origin's storage)
  let plReels = [];
  const plSelected = new Set();
  let plPreviewKey = null;      // the id list the frame is currently showing
  let plPreviewTimer = null;
  let plPreviewSeq = 0;         // guards a slow response from landing on a newer selection

  // Ticked reels in the order the list shows them, so the stack coming off
  // the printer runs the same way as the rows on the screen.
  function plSelectedIds() {
    return plReels.filter((r) => plSelected.has(String(r._id))).map((r) => String(r._id));
  }

  function plSearchText(reel) {
    return [reel.rollId, reel.vendorRollId, reel.invoiceNo, reel.location, reel.remarks]
      .filter(Boolean).join(" ").toLowerCase();
  }

  function plVisibleReels() {
    const q = document.getElementById("plSearch").value.trim().toLowerCase();
    return q ? plReels.filter((r) => plSearchText(r).includes(q)) : plReels.slice();
  }

  function plRowHtml(reel) {
    const id = String(reel._id);
    const badge = reel.allottedTo
      ? `<span class="pl-badge allotted" title="Reserved for this order -- printing its label changes nothing.">ALLOTTED</span>`
      : reel.usedBy
        ? (reel.usedBy.live
            ? `<span class="pl-badge inuse" title="Scanned and running on a job card right now.">IN USE</span>`
            : `<span class="pl-badge used" title="${fmtKg(reel.usedBy.totalKg)} kg already drawn off this reel.">PART USED</span>`)
        : "";
    const meta = [
      `${fmtKg(reel.reelMtrs)} kg`,
      reel.location ? escapeHtml(reel.location) : "",
      reel.invoiceNo ? `Invoice ${escapeHtml(reel.invoiceNo)}` : `<span class="pl-no-invoice">No Invoice</span>`,
      formatRollDate(reel.inwardDate || reel.createdAt),
    ].filter(Boolean).join(" &middot; ");
    return `<label class="pl-row">
      <input type="checkbox" value="${escapeHtml(id)}" ${plSelected.has(id) ? "checked" : ""} />
      <span class="pl-main">
        <span class="pl-roll">${escapeHtml(reel.rollId || "—")}</span>
        <span class="pl-meta">${meta}</span>
      </span>
      ${badge}
    </label>`;
  }

  function renderPlRows() {
    const list = document.getElementById("plList");
    if (!plReels.length) {
      list.innerHTML = `<div class="pl-empty">No reels in stock for this spec.<br />Key an inward in with <b>Add</b>, and its labels can be printed from here.</div>`;
      return;
    }
    const rows = plVisibleReels();
    list.innerHTML = rows.length
      ? rows.map(plRowHtml).join("")
      : `<div class="pl-empty">No reel here matches that search.</div>`;
  }

  // The count, the Select all box and the Print button all say the same thing
  // three ways, so they are set from one place and can't disagree.
  function updatePlState() {
    const visible = plVisibleReels();
    const picked = plSelectedIds().length;
    const searching = document.getElementById("plSearch").value.trim() !== "";
    document.getElementById("plCount").textContent = plReels.length
      ? `${picked} of ${plReels.length} selected${searching ? ` · ${visible.length} shown` : ""}`
      : "";

    const visiblePicked = visible.filter((r) => plSelected.has(String(r._id))).length;
    const selectAll = document.getElementById("plSelectAll");
    selectAll.disabled = !visible.length;
    selectAll.checked = visible.length > 0 && visiblePicked === visible.length;
    selectAll.indeterminate = visiblePicked > 0 && visiblePicked < visible.length;

    const printBtn = document.getElementById("plPrintBtn");
    printBtn.disabled = picked === 0;
    printBtn.style.opacity = picked === 0 ? "0.6" : "";
    printBtn.style.cursor = picked === 0 ? "not-allowed" : "";
    printBtn.textContent = picked ? `Print ${picked} label${picked === 1 ? "" : "s"}` : "Print";

    document.getElementById("plPreviewCaption").textContent = picked
      ? `${picked} label${picked === 1 ? "" : "s"} · one per page`
      : "";
  }

  function setPlPreviewMsg(text) {
    document.getElementById("plPreviewMsg").textContent = text || "";
  }

  function plFrameWindow() {
    // try/catch rather than a null check, for the same reason as
    // labelWindow() above: reading .labelApi on a frame the browser treats
    // as another origin throws instead of returning undefined.
    try {
      const frame = document.getElementById("plFrame");
      return frame.contentWindow && frame.contentWindow.labelApi ? frame.contentWindow : null;
    } catch (e) {
      return null;
    }
  }

  // Loads the ticked reels' labels into the frame. Fetched and written in as
  // srcdoc for the same reason the single-reel dialog does it (see
  // openLabelDialog): navigating a frame to the URL dies on the login
  // redirect's X-Frame-Options rather than saying the session has ended.
  async function loadPlPreview() {
    const ids = plSelectedIds();
    const key = ids.join(",");
    const frame = document.getElementById("plFrame");
    const seq = ++plPreviewSeq;
    plPreviewKey = null;

    if (!ids.length) {
      frame.removeAttribute("srcdoc");
      setPlPreviewMsg("Tick a reel to see the label that will print.");
      return false;
    }

    setPlPreviewMsg(`Building ${ids.length} label${ids.length === 1 ? "" : "s"}…`);
    let res;
    try {
      res = await fetch(`/app/releaselinerstock/labels?ids=${encodeURIComponent(key)}`, { credentials: "same-origin" });
    } catch (e) {
      if (seq === plPreviewSeq) setPlPreviewMsg("Couldn't reach the server to build these labels.");
      return false;
    }
    if (seq !== plPreviewSeq) return false;              // a newer selection is already on its way

    if (res.redirected) {
      setPlPreviewMsg("Your session has ended. Reload this page and sign in again to print.");
      return false;
    }
    if (!res.ok) {
      // The route answers failures as a small HTML document (it normally
      // renders into this frame), so strip the markup to get the sentence.
      const detail = (await res.text()).replace(/<[^>]*>/g, " ").trim();
      setPlPreviewMsg(`Couldn't build the labels (${res.status}). ${detail}`);
      return false;
    }

    const html = await res.text();
    if (seq !== plPreviewSeq) return false;

    await new Promise((resolve) => {
      frame.onload = resolve;
      frame.srcdoc = html;
    });
    if (seq !== plPreviewSeq) return false;

    if (!plFrameWindow()) {
      setPlPreviewMsg("The labels loaded but couldn't be read.");
      return false;
    }
    plPreviewKey = key;
    setPlPreviewMsg("");
    syncPlRotateBtn();
    return true;
  }

  // Ticking runs through a whole batch a row at a time, so the preview waits
  // for the ticking to stop rather than re-rendering every label on every
  // click.
  function schedulePlPreview() {
    clearTimeout(plPreviewTimer);
    const ids = plSelectedIds();
    if (!ids.length) {
      plPreviewSeq++;
      plPreviewKey = null;
      document.getElementById("plFrame").removeAttribute("srcdoc");
      setPlPreviewMsg("Tick a reel to see the label that will print.");
      return;
    }
    setPlPreviewMsg(`${ids.length} label${ids.length === 1 ? "" : "s"} selected…`);
    plPreviewTimer = setTimeout(loadPlPreview, 300);
  }

  function openPrintLabelsDialog(master) {
    plReels = Array.isArray(master.rolls) ? master.rolls.slice() : [];
    plSelected.clear();
    plPreviewKey = null;
    plPreviewSeq++;
    clearTimeout(plPreviewTimer);

    // What identifies a spec in THIS pool -- the Release master's own fields,
    // which are the columns this page shows. Sensing and Colour are in:
    // two liners can be alike in every other respect and differ only there.
    const specBits = [
      master.type, master.make, master.vendorName, master.vendorSkuCode,
      master.sensing, master.color,
      master.size ? `${master.size} mm` : null,
      master.gsm != null ? `${master.gsm} GSM` : null,
    ].filter(Boolean);
    document.getElementById("printLabelsTitle").textContent = `Print Reel Labels — ${master.skuId || ""}`;
    const specLine = document.getElementById("printLabelsSpec");
    specLine.textContent = specBits.join(" · ") || "—";
    specLine.title = specLine.textContent;   // the line is ellipsised; the whole spec is still readable

    document.getElementById("plSearch").value = "";
    document.getElementById("plFrame").removeAttribute("srcdoc");
    hideError("plError");
    renderPlRows();
    updatePlState();
    setPlPreviewMsg(plReels.length ? "Tick a reel to see the label that will print." : "Nothing to print for this spec yet.");
    syncPlRotateBtn();
    openModal("printLabelsDialog");
  }

  function closePrintLabelsDialog() {
    clearTimeout(plPreviewTimer);
    plPreviewSeq++;
    const frame = document.getElementById("plFrame");
    frame.onload = null;
    // Dropped so the next open can't flash the previous spec's labels.
    frame.removeAttribute("srcdoc");
    plPreviewKey = null;
    plReels = [];
    plSelected.clear();
    closeModal("printLabelsDialog");
  }

  document.getElementById("plList").addEventListener("change", (e) => {
    if (!e.target.matches("input[type='checkbox']")) return;
    const id = e.target.value;
    if (e.target.checked) plSelected.add(id); else plSelected.delete(id);
    updatePlState();
    schedulePlPreview();
  });

  // Ticks or clears every reel the list is CURRENTLY showing -- with a search
  // typed in, "Select all" means the reels in front of you, not the ones the
  // search is hiding.
  document.getElementById("plSelectAll").addEventListener("change", (e) => {
    const visible = plVisibleReels();
    visible.forEach((r) => {
      if (e.target.checked) plSelected.add(String(r._id)); else plSelected.delete(String(r._id));
    });
    renderPlRows();
    updatePlState();
    schedulePlPreview();
  });

  document.getElementById("plSearch").addEventListener("input", () => {
    renderPlRows();
    updatePlState();
  });

  function syncPlRotateBtn() {
    const win = plFrameWindow();
    let flipped = false;
    if (win) {
      flipped = Boolean(win.labelApi.isFlipped());
    } else {
      // No labels loaded yet -- read the remembered setting straight off this
      // origin's storage, which is the same storage the framed label writes
      // to (srcdoc inherits this page's origin).
      try { flipped = localStorage.getItem(LABEL_FLIP_KEY) === "1"; } catch (e) { flipped = false; }
    }
    document.getElementById("plRotateBtn").textContent = flipped ? "Rotated 180°" : "Rotate 180°";
  }

  // Which way the stock feeds is a property of the printer, not of the reel,
  // so this is the one setting that is remembered on this PC -- and it is the
  // same setting the single-reel dialog sets.
  function togglePrintLabelsRotation() {
    const win = plFrameWindow();
    if (win) {
      win.labelApi.toggleFlip();
    } else {
      try {
        localStorage.setItem(LABEL_FLIP_KEY, localStorage.getItem(LABEL_FLIP_KEY) === "1" ? "0" : "1");
      } catch (e) { /* private mode -- the label still prints, just unremembered */ }
    }
    syncPlRotateBtn();
  }

  async function printSelectedLabels() {
    const ids = plSelectedIds();
    if (!ids.length) return;
    hideError("plError");

    // The frame is the print target, so it has to be showing exactly this
    // selection before it is handed to the printer -- a debounce still in
    // flight would otherwise print the previous set.
    if (plPreviewKey !== ids.join(",")) {
      clearTimeout(plPreviewTimer);
      const btn = document.getElementById("plPrintBtn");
      btn.textContent = "Preparing…";
      setLoading("plPrintBtn", true);
      const ready = await loadPlPreview();
      setLoading("plPrintBtn", false);
      updatePlState();                       // puts "Print N labels" back
      if (!ready) return showError("plError", "The labels couldn't be prepared — see the preview panel.");
    }

    const win = plFrameWindow();
    if (!win) return showError("plError", "The labels loaded but couldn't be read. Close this and try again.");
    win.labelApi.print();
  }


  let editLocationChoices = null;
  let editingRollId = null;
  // The reel's parent master row (type/make/vendor/vendor SKU code/color/
  // size/gsm) -- every reel under a master shares its spec exactly (that's
  // how it got grouped there; see releaseSpecKey in
  // routes/stock/releaseLinerStock.js), so it's safe to source these
  // straight from the master and resubmit them unchanged rather than
  // re-picking a spec here, same as openAddDialog's masterPrefill.
  let editingRollSpec = null;

  function openEditRollDialog(reel, masterSpec) {
    editingRollId = reel._id;
    editingRollSpec = masterSpec || {};

    const specBits = [
      editingRollSpec.type, editingRollSpec.make,
      editingRollSpec.vendorName, editingRollSpec.vendorSkuCode,
      editingRollSpec.color,
      editingRollSpec.gsm != null ? `${editingRollSpec.gsm} GSM` : null,
    ].filter(Boolean);
    document.getElementById("editRollSpecSummary").textContent = `${reel.rollId || ""} — ${specBits.join(" · ") || "—"}`;

    if (editLocationChoices) { editLocationChoices.destroy(); editLocationChoices = null; }
    const locSel = document.getElementById("editLocationSelect");
    locSel.innerHTML = locationOptionsHtml(reel.location || "");
    editLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    document.getElementById("editDateInput").value = reel.inwardDate ? new Date(reel.inwardDate).toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10);
    document.getElementById("editInvoiceNoInput").value = reel.invoiceNo || "";
    document.getElementById("editRateInput").value = reel.rate != null ? reel.rate : "";
    document.getElementById("editVendorRollIdInput").value = reel.vendorRollId || "";
    document.getElementById("editKgInput").value = reel.reelMtrs != null ? reel.reelMtrs : "";
    document.getElementById("editRemarksInput").value = reel.remarks || "";

    hideError("editRollError");
    openModal("editRollDialog");
  }
  function closeEditRollDialog() {
    closeModal("editRollDialog");
    editingRollId = null;
  }

  // ---- Keeping the table in step ----
  // An edit, a remove or an inward used to end in window.location.reload(),
  // which threw away the open specs, the find box and the scroll position.
  // Now the figures are re-read and the tree is rebuilt in place. Specs that
  // were open stay open, and the find box is applied again to the new rows.
  const STOCK_TOTAL_FMT = { maximumFractionDigits: 2 };
  function setStockTotals(t) {
    document.getElementById("stockTotalValue").textContent = `₹${Number(t.totalStockValue || 0).toLocaleString("en-IN", STOCK_TOTAL_FMT)}`;
    document.getElementById("stockTotalRm").textContent = `${Number(t.totalRunningMeters || 0).toLocaleString("en-IN", STOCK_TOTAL_FMT)} m`;
    document.getElementById("stockFacestockValue").textContent = `₹${Number(t.facestockValue || 0).toLocaleString("en-IN", STOCK_TOTAL_FMT)}`;
    document.getElementById("stockAdhesiveValue").textContent = `₹${Number(t.adhesiveValue || 0).toLocaleString("en-IN", STOCK_TOTAL_FMT)}`;
    document.getElementById("stockReleaseValue").textContent = `₹${Number(t.releaseValue || 0).toLocaleString("en-IN", STOCK_TOTAL_FMT)}`;
  }

  async function refreshStockTable() {
    const keepOpen = new Set(
      mastersTable.getRows()
        .filter((row) => row.getData()._children && row.isTreeExpanded())
        .map((row) => String(row.getData()._id))
    );
    const res = await fetch("/app/releaselinerstock/figures", { credentials: "same-origin" });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.message || "Failed to refresh stock.");
    mastersData = data.masters;
    setStockTotals(data.totals);
    // runStockFind skips a redraw when the find text hasn't changed, so forget
    // the last one to make it apply the box to the fresh rows.
    stockFindNeedle = null;
    runStockFind(keepOpen);
  }

  // Called once the server has saved the change. The change is already
  // committed, so if the re-read fails the page reloads rather than showing
  // figures that no longer match the database.
  async function afterStockChange(message) {
    try {
      await refreshStockTable();
      showToast(message, "success");
    } catch (err) {
      console.error(err);
      window.location.reload();
    }
  }

  async function submitEditRoll() {
    if (!editingRollId) return;

    const location = document.getElementById("editLocationSelect").value;
    if (!location) return showError("editRollError", "Location is required.");

    const inwardDate = document.getElementById("editDateInput").value;
    if (!inwardDate) return showError("editRollError", "Date is required.");

    const rate = document.getElementById("editRateInput").value;
    if (!rate || Number(rate) <= 0) return showError("editRollError", "Rate is required.");

    const vendorRollId = document.getElementById("editVendorRollIdInput").value.trim();
    if (!vendorRollId) return showError("editRollError", "Vendor Roll ID is required.");

    const reelMtrs = document.getElementById("editKgInput").value;
    if (!reelMtrs || Number(reelMtrs) <= 0) return showError("editRollError", "Kg is required.");

    hideError("editRollError");
    setLoading("editRollSubmitBtn", true);
    try {
      const res = await fetch(`/app/releaselinerstock/${editingRollId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          type: editingRollSpec.type,
          color: editingRollSpec.color,
          size: editingRollSpec.size,
          gsm: editingRollSpec.gsm,
          vendorId: editingRollSpec.vendorId,
          make: editingRollSpec.make,
          vendorSkuCode: editingRollSpec.vendorSkuCode,
          sensing: editingRollSpec.sensing,
          location,
          inwardDate,
          rate,
          invoiceNo: document.getElementById("editInvoiceNoInput").value,
          remarks: document.getElementById("editRemarksInput").value,
          reelMtrs,
          vendorRollId,
        }),
      });
      const data = await res.json();
      if (data.success) {
        closeEditRollDialog();
        await afterStockChange("Reel updated.");
      } else {
        showError("editRollError", data.message || "Failed to update release liner reel.");
      }
    } catch {
      showError("editRollError", "Server error. Please try again.");
    } finally {
      setLoading("editRollSubmitBtn", false);
    }
  }

  // ---- Remove Reel dialog ----
  let removingRollId = null;

  function openRemoveRollDialog(reel, master) {
    removingRollId = reel._id;
    const allotWarn = document.getElementById("removeRollAllotWarn");
    if (reel.usedBy) {
      allotWarn.textContent = reel.usedBy.live
        ? "This reel is scanned and live on a machine right now. Removing it leaves that job card's run pointing at a reel that no longer exists."
        : `This reel already has ${fmtKg(reel.usedBy.totalKg)} kg drawn off it via a job card (lot ${reel.usedBy.lots.join(", ") || "—"}). That usage stays on record; only the reel itself is removed.`;
      allotWarn.style.display = "block";
    } else if (reel.allottedTo) {
      allotWarn.textContent = `This reel is allotted to ${reel.allottedTo.lotNo || reel.allottedTo.productCode || "an order"}. Removing it also takes it out of that order's allotment -- the order will need another reel picked in Assign Production.`;
      allotWarn.style.display = "block";
    } else {
      allotWarn.style.display = "none";
    }
    const specBits = [
      master.family, master.type, master.make, master.vendorName, master.vendorSkuCode,
      master.gsm != null ? `${master.gsm} GSM` : (master.micron != null ? `${master.micron} MIC` : null),
    ].filter(Boolean);
    const detail = [
      `Kg ${fmtKg(reel.reelMtrs)}`,
      reel.location || "",
      reel.invoiceNo ? `Invoice ${reel.invoiceNo}` : "No Invoice",
    ].filter(Boolean).join(" \u00b7 ");
    const summary = document.getElementById("removeRollSummary");
    summary.textContent = `${reel.rollId || "\u2014"} \u2014 ${specBits.join(" \u00b7 ") || "\u2014"}\n${detail}`;
    summary.style.whiteSpace = "pre-line";

    hideError("removeRollError");
    openModal("removeRollDialog");
  }
  function closeRemoveRollDialog() {
    closeModal("removeRollDialog");
    removingRollId = null;
  }

  async function submitRemoveRoll() {
    if (!removingRollId) return;
    hideError("removeRollError");
    setLoading("removeRollSubmitBtn", true);
    try {
      const res = await fetch(`/app/releaselinerstock/${removingRollId}`, { method: "DELETE" });
      const data = await res.json();
      if (data.success) {
        closeRemoveRollDialog();
        await afterStockChange(data.released && data.released.length
          ? `Reel removed and released from ${data.released.join(", ")}.`
          : "Reel removed.");
      } else {
        showError("removeRollError", data.message || "Failed to remove this reel.");
      }
    } catch {
      showError("removeRollError", "Server error. Please try again.");
    } finally {
      setLoading("removeRollSubmitBtn", false);
    }
  }
</script>
